<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology/"
     xml:base="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:relational="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#"
     xmlns:custom_ontology="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#usesProcedure -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#usesProcedure">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#Package"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#procedure"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#usesTable -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#usesTable">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#procedure"/>
        <rdfs:range rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Table"/>
        <rdfs:label>usesTable</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#hasColumn -->

    <owl:ObjectProperty rdf:about="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#hasColumn">
        <rdfs:domain rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Table"/>
        <rdfs:range rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>A Table has a set of Columns.</rdfs:comment>
        <rdfs:label>hasColumn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#Package -->

    <owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#Package">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment></rdfs:comment>
        <rdfs:label>Package</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#procedure -->

    <owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#procedure">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#Package"/>
        <rdfs:comment></rdfs:comment>
        <rdfs:label>Procedure</rdfs:label>
    </owl:Class>
    


    <!-- https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column -->

    <owl:Class rdf:about="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column">
        <rdfs:subClassOf rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Table"/>
        <rdfs:comment>A Table has a set of Columns.</rdfs:comment>
        <rdfs:label>Column</rdfs:label>
    </owl:Class>
    


    <!-- https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Table -->

    <owl:Class rdf:about="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Table">
        <rdfs:label>Table</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#ABS_VOLUME -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#ABS_VOLUME">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Absolute volume of balance change.</rdfs:comment>
        <rdfs:label>ABS_VOLUME</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#ACTIVATION_DATE -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#ACTIVATION_DATE">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Subscriber activation date.</rdfs:comment>
        <rdfs:label>ACTIVATION_DATE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#BALANCE -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#BALANCE">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>The amount of the client&apos;s current balance.</rdfs:comment>
        <rdfs:label>BALANCE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#BALANCE_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#BALANCE_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Resource balance code identifier. Foreign key to the BALANCE_ID field of the BALANCE table.</rdfs:comment>
        <rdfs:label>BALANCE_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#BAL_LEVEL -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#BAL_LEVEL">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Balance threshold.</rdfs:comment>
        <rdfs:label>BAL_LEVEL</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#BILL_CHRG_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#BILL_CHRG_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Primary key.</rdfs:comment>
        <rdfs:label>BILL_CHRG_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CHARGE_DATE -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CHARGE_DATE">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Charge date.</rdfs:comment>
        <rdfs:label>CHARGE_DATE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CHRG_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CHRG_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Primary key.</rdfs:comment>
        <rdfs:label>CHRG_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CHTYPE_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CHTYPE_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Charge type. Foreign key to the CHTYPE_ID field of the CHARGE_TYPE table.</rdfs:comment>
        <rdfs:label>CHTYPE_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CLNT_BAL_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CLNT_BAL_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Balance ID. Foreign key to the CLNT_BAL_ID field of the CLIENT_BALANCE table.</rdfs:comment>
        <rdfs:label>CLNT_BAL_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CLNT_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CLNT_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Unique identifier of the client&apos;s personal account. Foreign key to the CLNT_ID field of the CLIENT table.</rdfs:comment>
        <rdfs:label>CLNT_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CORR_DATE -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CORR_DATE">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Date of adjustment.</rdfs:comment>
        <rdfs:label>CORR_DATE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CORR_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CORR_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Primary key</rdfs:comment>
        <rdfs:label>CORR_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CORR_TYPE_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CORR_TYPE_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Foreign key on the CORR_TYPE_ID field of the CORR_TYPE table.</rdfs:comment>
        <rdfs:label>CORR_TYPE_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CT_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CT_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Client type identifier. Foreign key to the CT_ID field of the CLIENT_TYPE table.</rdfs:comment>
        <rdfs:label>CT_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CURR_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CURR_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>rdfs:label &quot;Currency code. Foreign key to the CURR_ID field of the CURRENCY table.&quot;</rdfs:comment>
        <rdfs:label>CURR_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CUSTOMER_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#CUSTOMER_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Unique customer identifier. Foreign key to the CUSTOMER_ID field of the CUSTOMER table.</rdfs:comment>
        <rdfs:label>CUSTOMER_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#DATE -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#DATE">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Order completion date.</rdfs:comment>
        <rdfs:label>DATE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#END_DATE -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#END_DATE">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>End date of the billing period.</rdfs:comment>
        <rdfs:label>END_DATE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#END_INTERVAL -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#END_INTERVAL">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>The end date of the billing period for the service.</rdfs:comment>
        <rdfs:label>END_INTERVAL</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#END_TIME -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#END_TIME">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>The end date of the service history.</rdfs:comment>
        <rdfs:label>END_TIME</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#ERROR_MESSAGE -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#ERROR_MESSAGE">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Error message if an error occurred while processing a pending order.</rdfs:comment>
        <rdfs:label>ERROR_MESSAGE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#EXPIRED_DATE -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#EXPIRED_DATE">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Balance expiration date.</rdfs:comment>
        <rdfs:label>EXPIRED_DATE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#MSISDN -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#MSISDN">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Phone number.</rdfs:comment>
        <rdfs:label>MSISDN</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#ORDB_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#ORDB_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Order ID. Primary key.</rdfs:comment>
        <rdfs:label>ORDB_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#ORD_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#ORD_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Order ID. Primary key.</rdfs:comment>
        <rdfs:label>ORD_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PAY_DATE -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PAY_DATE">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Payment (transaction) date.</rdfs:comment>
        <rdfs:label>PAY_DATE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PHONE_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PHONE_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Phone number identifier. Foreign key to the PHONE_ID field of the PHONE table.</rdfs:comment>
        <rdfs:label>PHONE_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PM_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PM_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Payment method identifier (operation type). Foreign key to the PM_ID field of the PAY_MODE table.</rdfs:comment>
        <rdfs:label>PM_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PRIORITY -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PRIORITY">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Balance priority.</rdfs:comment>
        <rdfs:label>PRIORITY</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PROLONG_PERIOD_END_DATE -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PROLONG_PERIOD_END_DATE">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Prolong period end date. The date until which the billing period of the service is extended.</rdfs:comment>
        <rdfs:label>PROLONG_PERIOD_END_DATE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PROLONG_PERIOD_NUMBER -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#PROLONG_PERIOD_NUMBER">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Number of completed extensions of the billing period.</rdfs:comment>
        <rdfs:label>PROLONG_PERIOD_NUMBER</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#QUOTA -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#QUOTA">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Quota volume (maximum amount of funds available to the subscriber from the balance).</rdfs:comment>
        <rdfs:label>QUOTA</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#QUOTA_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#QUOTA_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Quota ID. Foreign key to the QUOTA_ID field of the QUOTA table. Primary key.</rdfs:comment>
        <rdfs:label>QUOTA_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#REL_VOLUME -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#REL_VOLUME">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Relative amount of balance change.</rdfs:comment>
        <rdfs:label>REL_VOLUME</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#RES_BAL_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#RES_BAL_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Resource balance identifier. Primary key.</rdfs:comment>
        <rdfs:label>RES_BAL_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#RES_PAY_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#RES_PAY_ID">
        <rdf:type rdf:resource="https://www.dbs.cs.uni-duesseldorf.de/RDF/relational.owl#Column"/>
        <rdfs:comment>Operation ID. Primary key.</rdfs:comment>
        <rdfs:label>RES_PAY_ID</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#SACT_ID -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/custom_ontology#SACT_ID">
