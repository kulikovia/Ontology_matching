</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_SID_v1#tpeType -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_SID_v1#tpeType">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_SID_v1#Attribute"/><TMF_SID_v1:hasOrigin>TerminationPointEncapsulation</TMF_SID_v1:hasOrigin>
<TMF_SID_v1:hasStereotype></TMF_SID_v1:hasStereotype><rdf:label>tpeType</rdf:label>
<rdfs:comment>This attribute represents the name of the specification that describes the construction of the TPE emphasising for example the access to the TPE and whether it is associated with a physical port directly or not. Amongst other things this attribute would identify whether the TPE is a PTP, CTP or FTP.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_SID_v1#tradingName -->

