<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_SID_v1#Attribute"/><TMF_SID_v1:hasOrigin>SignatureSecurityEvent</TMF_SID_v1:hasOrigin>
