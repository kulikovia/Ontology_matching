<TMF_SID_v1:hasStereotype>«required»</TMF_SID_v1:hasStereotype><rdf:label>tradingName</rdf:label>
<rdfs:comment>The name that the organization (unit) trades under</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_SID_v1#trafficClass -->

