<TMF_SID_v1:hasStereotype></TMF_SID_v1:hasStereotype><rdf:label>fieldId</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_SID_v1#fieldName -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_SID_v1#fieldName">
