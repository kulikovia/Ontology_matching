</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_SID_v1#bankName -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_SID_v1#bankName">
