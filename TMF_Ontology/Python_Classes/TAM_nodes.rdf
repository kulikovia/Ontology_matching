</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Dynamic Work Order Assigning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Dynamic Work Order Assigning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dynamic Work Order Assigning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dynamic Work Order Assigning takes into consideration the following criteria: 

	Work order priority
	Associated SLAs
	Work order due date
	Required skills to perform work
	Dependencies between work items/orders  
	Job location relative to other assignments made to the dispatchable staff
	Workload of staff
	Staff availability hours.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Periodic Bulk Work Order Assigning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Periodic Bulk Work Order Assigning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Periodic Bulk Work Order Assigning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Periodic Bulk Work Order Assigning takes into consideration the following criteria:

	Work order priority
	Associated SLAs
	Work order due date
	Required skills to perform work
	Dependencies between work items/orders  
	Job location relative to other assignments made to the dispatchable staff
	Workload of staff
	Staff availability hours.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Coordination -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Coordination">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Coordination</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Coordination function for coordinating work between dependent or related work orders for Resource dispatchable staff.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Information Transferring -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Information Transferring">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Information Transferring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Information Transferring provides information transfer between the operator's workforce management system(s) and those of external third parties (when the infrastructure is owned and operated by third parties).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Re-assigning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Re-assigning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Re-assigning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Initiates re-assignments as needed based on changing priorities, technician progress on other job assignments, etc.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Manual Activities Determining -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Manual Activities Determining">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Manual Activities Determining</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Manual Activities Determining function provides the necessary functionality to analyze the work order and determine what manual activities are necessary.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Closing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Closing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Closing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Closing function closes completed work orders</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workflow Delay Jeopardy Analyzing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workflow Delay Jeopardy Analyzing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workflow Delay Jeopardy Analyzing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workflow Delay Jeopardy Analyzing function should be found in any process or workflow management system and warns when a delay in the due date of a task or process step will prevent subsequent tasks from starting, or affect the overall end date of the process, also including escalation function for issues as required.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Voucher Distribution (Deleted) -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Voucher Distribution (Deleted)">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Voucher Distribution (Deleted)</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Voucher Distribution to dealers including shipment and validation of reception of actual vouchers</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Facility Selection -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Facility Selection">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Facility Selection</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Facility Selection function selects and assigns appropriate network facility route(s) and configures facility equipment per engineering rules as well as obtains new assets from network plan and build (capacity management) if required.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Status Monitoring -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Status Monitoring">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Status Monitoring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Monitors the status and progress of the various manual activities, including the various states of the work order</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Performance Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Performance Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Performance Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Performance Reporting provides the functionality required to generate reports about the performance of the service provider's resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Fault Correction & Restoration Support -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Fault Correction & Restoration Support">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Fault Correction & Restoration Support</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Fault Correction & Restoration Support functions are used during repair or replacement of faulty resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Number Porting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Number Porting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Number Porting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Number Porting implements the changes to transfer the management of a number from one Service Provider to another, and on request provides status on the implementation of the changes.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Procurement Requisition to Order Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Procurement Requisition to Order Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Procurement Requisition to Order Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Procurement Requisition to Order Management manages the requisitions for material and place the orders with the contracted supplier/partner.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Shipment Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Shipment Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shipment Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shipment Management function provides workflow and orchestration for the planning of materials (including vouchers) to be shipped to and from different locations. It includes shipment design and implementation.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Inventory Check -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Inventory Check">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Inventory Check</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Stock Item Inventory Check (a.k.a. stock taking) performs physical inventory of entire inventory or specific sub inventories.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Material Warehousing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Material Warehousing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Material Warehousing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Material Warehousing is a Logistics Management functionality for Put-away of materials to targeted storage locations and Picking of materials to fulfill orders including Staging and assembly of materials as required.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Supply Chain Order Shipment Tracking -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Supply Chain Order Shipment Tracking">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supply Chain Order Shipment Tracking</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supply Chain Order Shipment Tracking provides the necessary functionality to track the movement of shipments from point of origin through cross-docks, and to the final destination.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Vulnerability Assessment Planning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Vulnerability Assessment Planning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Vulnerability Assessment Planning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Vulnerability Assessment Planning function for Assessing networks and systems for vulnerabilities and taking proactive action to reduce the vulnerabilities or limit the impacts if they are exploited.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Software Update Planning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Software Update Planning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Software Update Planning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Software Update Planning for applying the software patches and upgrades that address known vulnerabilities in a timely manner.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Anomaly Monitoring -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Anomaly Monitoring">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Anomaly Monitoring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">System and network monitoring activity, determining whether it is normal or anomalous, based on rules, signatures or heuristics.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Anomaly Monitoring Data Analyzing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Anomaly Monitoring Data Analyzing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Anomaly Monitoring Data Analyzing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Anomaly Monitoring Data Analyzing function is analyzing monitoring Data Events by Log Correlation and Intrusion Detection Systems analysis.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Level Tracking and Replenishment -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Level Tracking and Replenishment">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Level Tracking and Replenishment</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Level Tracking and Replenishment supports reconciliation including retrieval and update with updated stock movements notifications (i.e. Replenishment or Booking stock item requests).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Fraud & Anomaly Detection -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Fraud & Anomaly Detection">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Fraud & Anomaly Detection</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Fraud & Anomaly Detection function indicates fraudulent use of networks or systems. This is achieved by effective Fraud Management systems coupled with the instrumentation and monitoring that enables potential fraudulent activities to be identified. There are close linkages between fraud identification and anomaly detection.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Geographical Coverage Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Geographical Coverage Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Geographical Coverage Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Geographical Coverage identifies the geographical areas that are, or are planned to be served by resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Work Item Sequence Execution -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Work Item Sequence Execution">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Work Item Sequence Execution</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Because of the Resource Task Item Decomposition of an orchestration request the result may be several actions that needs to take place in a specific sequence. The Resource Work Item Sequence Execution function executes each individual item in sequence to fulfill, or roll back according to a pre-defined configuration, and reports the sequence carry through result.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Work Item Sequence Execution Configuration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Work Item Sequence Execution Configuration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Work Item Sequence Execution Configuration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Resource Work Item Sequence Execution function controls so that the sequence is fulfilled, or rolled back. The rules for the sequence execution will set the conditions for the fulfillment, or roll-back, and for the reporting and notification. The Resource Task Item Sequence Carry Through configuration is a management of the application function that defines how the execution of the orchestration sequence will be done.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Diagnostic Design -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Diagnostic Design">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Diagnostic Design</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Diagnostic Design Function defines diagnostic actions to identify the resource problem cause. It includes:

	Diagnostic actions and rules to identify the resource trouble. This step permits to identify the installed resource(s) at fault

   - For example: simple resource test or resource test scenario, inventories consultation to identify installed resource and expected configuration characteristics, test historic consultation, etc.

	Diagnostic actions  and rules to identify the resource trouble cause(s) and the possible root cause . This step permits to identify why the related installed resource(s) is (are) at fault.

   - For example: Plan workforce intervention to check an equipment, launch resource test scenario, query QoS historic, followed by resource test launch if the installed resource has a decreasing QoS, query resource usage historic, equipment logs, anomaly historic, etc.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Response Capture Measurement -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Response Capture Measurement">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Response Capture Measurement</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Response Capture Measurement measures the quantity and quality of the responses of the resources with verification instrumentation.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource End-To-End Performance Supervision -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource End-To-End Performance Supervision">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource End-To-End Performance Supervision</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource End-To-End Performance Supervision provides integration with ERP applications for End - End supervising the resource performance.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Parameters Allocation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Parameters Allocation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Parameters Allocation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Parameters Allocation allocates the right resource parameters to fulfill resource orders.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Performance Event Filtering -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Performance Event Filtering">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Performance Event Filtering</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Performance Event Filtering provides performance event filtering in resource performance monitoring.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Pre-formatted Location Information Presentation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Pre-formatted Location Information Presentation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Pre-formatted Location Information Presentation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Pre-formatted Location Information Presentation generates different views for different business cases (e.g. different format of address strings).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Strategic Sites Determining -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Strategic Sites Determining">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Strategic Sites Determining</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Strategic Sites Determining determines which locations are to become strategic sites.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Strategic Network Sizing Decision Support -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Strategic Network Sizing Decision Support">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Strategic Network Sizing Decision Support</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Support Strategic Network Sizing Decisions supports strategic decisions as to which locations and which links to grow or shrink across the network.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Forecasting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Forecasting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Forecasting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Forecasting supports forecasting functionality to be applied at different levels of detail and over different time frames. Some types of forecast are more relevant to Strategic and others more relevant to Tactical Planning. Both product volume forecasts and utilization trends are relevant to this automation function.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Test Resources Availability Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Test Resources Availability Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Test Resources Availability Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Test Resources Availability Management manage that end to end test resources and test heads are available including acquisition of test resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Testing Rules Configuration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Testing Rules Configuration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Testing Rules Configuration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Testing Rules Configuration provides management of resource end to end testing rules.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Test Result Analysis Policy Configuration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Test Result Analysis Policy Configuration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Test Result Analysis Policy Configuration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Test Result Analysis Policy Configuration function provides the necessary functionality to manage how the Resource Test Strategy and Policy Management test results should be interpreted. Strategies can range from simple (e.g. - check the status of a router) to complex (e.g. - perform an end-to-end test on a circuit and sectionalize the problem).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Specification Repository Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Specification Repository Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Specification Repository Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Specification Repository Management is able to create, modify and delete Resource Specification.
This includes the ability to manage the state of an entity during its lifecycle (e.g. planned, deployed, in operation, replaced by locked).
It includes Resource Specifications retrieval, integrity rules check and versioning management.
It also provides Product Specification and Offering views adapted to the different roles.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Specification to Supplier Product Specification Relationship Design -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Specification to Supplier Product Specification Relationship Design">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Specification to Supplier Product Specification Relationship Design</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Specification to Supplier Product Specification Relationship Design identifies, when it corresponds to equipment rented to a Supplier  (devices, network equipments, hardware &amp; software, etc).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Specification Action Skill Design -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Specification Action Skill Design">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Specification Action Skill Design</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Specification Action Skill Design manages the links to the Skill catalog to identify for each type of resource, or of Action on a resource, which type of skill is necessary to make the intervention.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Specification Change Auditing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Specification Change Auditing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Specification Change Auditing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Specification Change Auditing manages the implications of Resource Specifications changes to determine the consequences of any given change. Resource Specifications changes may impact other Resource Specifications and Resource Facing Service Specit supports
The function logs Resource Specifications changes and supports the analysis of relationships between Resource Specifications. 
In addition, it tracks the history of changes in an easy and accessible manner.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Task Item Policy Control Configuration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Task Item Policy Control Configuration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Task Item Policy Control Configuration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Defines and configures the policies which will be implemented during the Resource task item lifecycle.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Logical and Software Resources Designing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Logical and Software Resources Designing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Logical and Software Resources Designing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Logical and Software Resources Designing supports physical, logical, and software design of resources including definition of configuration variables and initial parameters.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Physical Network Planning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Physical Network Planning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Physical Network Planning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Physical Network Planning function focuses on the long-term network design of OSI layers 0-3 (physical network). This includes analysis of the network impact of a new resources, optimization of network resources, failure survivability analysis, forecasting and expansion to meet forecasted demand, and what-if analysis for new technology or different network designs. Responsible for engineering of all OSI layer 0-3 capacity and thereby monitors all equipment accordingly. Also manages capacity augmentation through hand-offs of provisioned capacity to network operations and coordinates the optimization of access facilities.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Configurable Network Planning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Configurable Network Planning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Configurable Network Planning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Configurable Network Planning function is responsible for the planning and capacity management of configurable switch and wireless networks (OSI layers 4+). This includes actively managing firewalls, security, planning and capacity management of our national data centers responsible for SMS and MMS messaging. Additionally, this includes management of the VoIP platforms as well as trunk planning and forecasting for wireline and wireless networks.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Strategic Planning and Engineering -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Strategic Planning and Engineering">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Strategic Planning and Engineering</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Strategic Planning and Engineering function provides fundamental planning and engineering of wired and wireless networks across the globe. This function coordinates closely with technology labs,  network operations and network construction & engineering, as well as other functions. Externally, this function works with the equipment vendors and regulatory bodies on matters affecting the industry.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Change Notification -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Change Notification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Change Notification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Change Notification function supports identifying concerned parties and for originating notifications to them about changes to the communications network that may affect them, along with status updates for those changes.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Design Automation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Design Automation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Design Automation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Provides design automation, applying algorithmic and heuristic analysis of the network in order, for example, to determine the optimum topology of a green field national, where geography and population distribution need to be taken into account.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Planning Analyzing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Planning Analyzing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Planning Analyzing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Planning Analyzing provides complex algorithmic and heuristic analysis capability for network planning and make use of market forecasts and utilization trends, and can be used to optimize the network for capacity and resilience.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Deployment and Retirement -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Deployment and Retirement">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Deployment and Retirement</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Deployment and Retirement Function is responsible for implementing the resource strategy high level plan and develop the resource infrastructure (network, PFS, IT...). 

The Resource Installed Base is updated and the resources are pre-configured and pre-activated if needed, for example for non-customer specific parameters, via the Resource Order Initialization and Installed Resource Management functions.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Supervision Measure Definition -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Supervision Measure Definition">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Supervision Measure Definition</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Supervision Measure Definition Function defines indicators (measures) associated with the resource type, with thresholds, calculation rules and consequences.
Examples:

	indicators with threshold: pressure, temperature
	indicators with calculation rules: storage occupation rate, load rate.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource End to End Test Configuration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource End to End Test Configuration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource End to End Test Configuration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource End to End Test Configuration provides setting up and tearing down resource testing, including configuration end to end.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Data Transformation/Parsing Rules Configuration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Data Transformation/Parsing Rules Configuration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Data Transformation/Parsing Rules Configuration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Data Transformation/Parsing Rules Configuration provides tools to set up and maintain resource data parsing rules.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Location Information Updating -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Location Information Updating">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Location Information Updating</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Location Information Updating provides means to update the repository with new/updated location information from external sources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Location Information Searching -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Location Information Searching">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Location Information Searching</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Location Information Searching provides the ability to search for a provided location/address, as part of the Location Management, including the ability to return near matches if an exact match is not found.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Number Reservation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Number Reservation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Number Reservation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Provides the functionality to manage the reservation of numbers.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Configuration Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Configuration Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Configuration Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Configuration Management provides configuration database and management of the configurations of the individual resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource for Service Deployment Designing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource for Service Deployment Designing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource for Service Deployment Designing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource for Service Deployment Designing provides End-to-end resource design and architecture to support service deployments.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Multi-layer Design and Modeling Support -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Multi-layer Design and Modeling Support">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Multi-layer Design and Modeling Support</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Multi-layer Design and Modeling Support provides real world multi-layer modeling and design (physical, data, transport, etc.).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.AI Model Integration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.AI Model Integration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">AI Model Integration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">AI Model Integrator function is integrates AI models with other systems or applications. It ensures that the models can interact correctly with other components in a system.
    - Input: AI models and target systems or applications for integration.
    - Output: Successfully Integrated AI models with other systems or applications.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Agent Interaction Handling -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Agent Interaction Handling">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Agent Interaction Handling</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Agent Interaction Handling function handles the interactions between different agents. It determines how agents communicate and interact with each other.
    - Input: Information about the agents and their intended interactions.
    - Output: Updated state of the agents after the interactions.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource End to End Test Execution -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource End to End Test Execution">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource End to End Test Execution</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource End to End Test Execution provides test execution of the end to end resource testing.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Automated Resource Test Invocation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Automated Resource Test Invocation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Automated Resource Test Invocation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Automated Resource Test Invocation does invocation of Resource Test Services for test and retrieval of results from the resource testing capabilities. Automatic testing is performed to verify or dismiss an error indication by the automatic performance and quality super vision function.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Definition -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Definition">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Definition</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Stock Item Definition Function enables defining Stock Items with their characteristics and values.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Construction and Engineering -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Construction and Engineering">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Construction and Engineering</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Construction and Engineering function is responsible for planning, design, construction and capital maintenance of the network physical infrastructure.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Change Capture -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Change Capture">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Change Capture</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Change Capture function enables capturing detected changes and receiving planned changes to the communications network.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Provisioning Logical Design -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Provisioning Logical Design">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Provisioning Logical Design</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Provisioning Logical Design function supports the design of layers 2-4 (per the OSI (Open Systems Interconnection) stack) of the service provider network in order to prepare for implementing a resource-based solution for either a standard service (for implementation of product specifications) or custom (for customer-specific services).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Provisioning Oversight -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Provisioning Oversight">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Provisioning Oversight</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Provisioning Oversight coordinates the implementation and activation of resources, and provides status of this provisioning on request.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Configuration Implementation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Configuration Implementation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Configuration Implementation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Resource Configuration Implementation Function is in charge of changing Resource Configuration and its parameters.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Activation and Deactivation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Activation and Deactivation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Activation and Deactivation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Activation and Deactivation Function turns on and off configured resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Diagnostic and Test Rules Improvement -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Diagnostic and Test Rules Improvement">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Diagnostic and Test Rules Improvement</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Diagnostic and Test Rules Improvement Function provides improvements used to update the definition of diagnostic rules and correction actions in the Resource Problem Policy Management function and the definition of tests in the Resource Test Policy Management function.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Deployment Optimization -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Deployment Optimization">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Deployment Optimization</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Deployment Optimization determines optimum network deployments, such as tier structuring and resilient topologies.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Supply Sourcing Planning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Supply Sourcing Planning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supply Sourcing Planning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supply Sourcing Planning plans sourcing taking into account current inventory and forecast demand, in collaboration with all suppliers.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Analysis -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Analysis">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Analysis</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Performance Forecast Function calculates forecast (ex: loads linked to the uses, number of failures, etc.) concerning the resource performance indicators based on Resource Performance Analysis.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Radio Planning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Radio Planning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Radio Planning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Provides Radio Planning for cell site coverage and quality and for cell-to-cell coverage is a specialist function used in Implementation Planning.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Deployment Constraint Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Deployment Constraint Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Deployment Constraint Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Deployment Constraint Management Function is responsible to manage constraints (like legal constraints or the need of a validation by authorities) and notify other companies, local authorities or governments of the effective deployment or retirement of resources like the implementation of FTTH (Fiber To The Home) technology in a building.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Number Portability Policy Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Number Portability Policy Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Number Portability Policy Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Number Portability Policy Management regulates policies, standards, definitions and restrictions defined by the entities involved in Resource Number Portability (country-specific regulatory entities).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Supervision Rules Definition -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Supervision Rules Definition">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Supervision Rules Definition</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Supervision Rules Definition Function defines alarm activation and Trouble Ticket creation rules:

	for alarm activation

          -  For example if a dysfunction is detected in its power supply, or in the functioning of the elements which constitutes it (card, port, internal ventilator) and also if its temperature exceeds a threshold.

	for a Trouble ticket creation next to a resource alarm qualification.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource End to End Test Scheduling -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource End to End Test Scheduling">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource End to End Test Scheduling</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource End to End Test Scheduling provides scheduling of end to end testing of resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Types and Rules Design -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Types and Rules Design">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Types and Rules Design</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Types and Rules Design Function allows to manage the resource problem typology describing all the types of known troubles related to a resource type.
It is also possible to define rules to manage Resource Trouble Tickets and Resource Trouble priorities, depending on criteria such as:

	Priority of the related Service Trouble Ticket(s) or Service Trouble(s) 
	Number of Product Trouble Tickets that can be expected, linked to the usage of the installed resource.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Specification Design -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Specification Design">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Specification Design</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Specification Design manages Resource Specifications including constraints, characteristics and type of usages.
It specifies Physical, Logical and Compound Resource Specifications.
It includes resource types that as a Service Provider we don't own or commercialize (ex: mobile phones used by our customers).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Specification Classification -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Specification Classification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Specification Classification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Specification Classification provides classification of different types of manual activities provide the necessary functionality to appropriately classify the working activity types and related information.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Availability Validation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Availability Validation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Availability Validation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Availability Validation function validates that the resource or resources specified on the resource order are available at the specified customer/service location and feasible from a network point of view. This includes the following:
- Resource address validation 
- Resource availability validation 
- Resource feasibility validation 
- Establishment of service termination points 
- Determination of delivery interval
 It includes checking appropriate network facility route(s) according to engineering rules.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Location Change History Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Location Change History Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Location Change History Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Location Change History Management tracks all changes of location data, making available attributes according their historical values in certain periods.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Number Inventory Establishing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Number Inventory Establishing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Number Inventory Establishing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Number Inventory Establishing manages the establishment of a number inventory.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Parameters Reservation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Parameters Reservation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Parameters Reservation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Parameters Reservation reserves the right resource parameters based on resource specification and resource inventory.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Resources Scanning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Resources Scanning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Resources Scanning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Resources Scanning functions are responsible for discovering the resources and their details through out a management channel. These functions may either directly communicate with the Network resources or communicate through a Resource Domain Manager. The functions should be able to support retrieving the overall resource information or the detailed resource information which can include sub-components.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Locating -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Locating">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Locating</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Locating tracks and provides when requested the geographic location of resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Data Translation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Data Translation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Data Translation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Data Translation provides the functions that enable the OSS and the networked resource to exchange data and command and control by parsing of data from one format to another.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Physical Implementation Information Capturing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Physical Implementation Information Capturing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Physical Implementation Information Capturing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Physical Implementation Information Capturing provides levels of implementation details that tactical planning does not need to specify, such as duct routes and the frame appearances of device ports.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Architecture Modeling Support -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Architecture Modeling Support">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Architecture Modeling Support</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Architecture Modeling Support provide architecture modeling tools to include resources or resource changes.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.AI Model Repository Manager -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.AI Model Repository Manager">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">AI Model Repository Manager</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">AI Model Repository Manager function manages the storage of AI models in a central repository. It supports storing and easy access and sharing of models among different users, business partners or systems.
    - Input: AI models to be stored.
    - Output: A central repository with stored AI models.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Test Devices Accessing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Test Devices Accessing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Test Devices Accessing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Test Devices Accessing of various resource test devices or network elements required to perform resource testing.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Test Results Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Test Results Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Test Results Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Test Results Management provides management of resource end to end test results.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Testing Results Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Testing Results Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Testing Results Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Testing Results Reporting provides reporting of resource end to end test results back to the client.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Root Cause Analyzing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Root Cause Analyzing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Root Cause Analyzing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Root Cause Analyzing function includes the ability to isolate the root cause based on the correlation analysis, fault isolation and problem identification with the help of supporting integrated systems for rule based testing as well as integration with trouble ticketing systems.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Assignment Dispatching -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Assignment Dispatching">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Assignment Dispatching</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Dispatching of work order assignments to dispatchable staff.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Orders Initiation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Orders Initiation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Orders Initiation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Orders Initiation initiates workforce orders for Resource preventive and corrective maintenance and change.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Capacity Analysis -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Capacity Analysis">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Capacity Analysis</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Capacity Analysis function is responsible for reviewing network traffic monitoring data, performing trend analysis, utilization history analysis and problem history analysis to determine anticipated and actual network asset utilization.   For ports, bandwidth and memory measures, this includes measures such as the current consumption, months to exhaust, and average monthly consumption.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Traffic Monitoring -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Traffic Monitoring">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Traffic Monitoring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Traffic Monitoring function enables performing real-time and historical surveillance of network traffic to detect traffic problems or other anomalous traffic patterns, and to trigger alerts as necessary in order to enable resolution of traffic problems.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Order Initiation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Order Initiation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Order Initiation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Order Initiation function issues valid and complete resource orders, and stores the order into an appropriate data store. As part of order publication, additional data might be obtained or derived to support downstream functions that are not provided in the resource order request.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Order Configuration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Order Configuration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Order Configuration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Order Configuration implements the request of Resource configuration specified in a Resource Order. Resource configuration can be derived from Resource order details in addition to inherent business rules from Resource specifications.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Local Tactical Plans Implementation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Local Tactical Plans Implementation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Local Tactical Plans Implementation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Local Tactical Plans Implementation implements tactical plans locally at individual CSP sites and at street level.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Receiving Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Receiving Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Receiving Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Receiving Management provides logistics management functionality controlling quality of resources received from suppliers' or from movements coming from a warehouse (quantity, status).
It also includes controlling materials returned by customers.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Tracking -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Tracking">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Tracking</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Tracking function tracks Resources (through the Barcode) corresponding to each Stock Item for each Warehouse.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Request Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Request Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Request Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Requests may come from Customer orders or Stock Level replenishment rules.
Stock Item Request Management function 
   - collects Stock Item Requests,
   - determines actions (including Procurement or reallocation) to be triggered according to Stock Item Requests, Stock Item availability and Stock Level Rules. 
If the Stock Item is available where it is requested, it will assign Stock Item to the request. If it isn't available, it identifies either Stock Item Shipment (to the customer location or a warehouse) or a purchase request realized via Business Partner Order Management.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Capability Specification Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Capability Specification Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Capability Specification Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">This function involves the creation, editing, storage and retrieval of capability specifications. The capability specifications represent the general, common and invariant characteristics of resource that may be realized in more than one type of specific resource. Examples of capability are Layer2, Data, radio and Transport.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Test Head Capacity Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Test Head Capacity Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Test Head Capacity Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Test Head Capacity Management provides management of end to end test head resource capacity.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Inventory Reconciliation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Inventory Reconciliation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Inventory Reconciliation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Inventory Reconciliation Function entails a reconciling function for the Repository with inventory discovered from another source (typically, the network). When new inventory information is discovered, this is tried to be matched with an entity or entities already known and updated accordingly and if there is no match then new information is created. It can work periodically or on demand in real-time.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Order Tracking -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Order Tracking">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Order Tracking</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Order Tracking tracks the various resource orders until completed.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Cause Identification -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Cause Identification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Cause Identification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Cause Identification Function supports the trouble causes identification, that is to say the reasons why the installed resource is in trouble and among these reasons the root cause of the resource trouble.
It implements Resource Problem Policy composed of diagnostic actions (Test, inventories and historic consultation, workforce intervention, etc.) 

The identification of the resource trouble cause can be made through:

	Analysis of associated Service Trouble Ticket Information (first diagnostic)
	Analysis of associated Resource Trouble Ticket Information (first diagnostic)
	Analysis of Resource alarm events (fault of performance data)
	Issuing resource tests, including one time tests or a series of tests over a period of time
	Analysis of previous resource test results, resource usage historic, QoS historic, equipment logs, anomaly historics, etc.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Resolution -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Resolution">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Resolution</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Resolution Function identifies the necessary resolution actions to solve the Resource Trouble according to Resource Problem Policy. It is based on diagnostic results.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Ticket Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Ticket Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Ticket Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Ticket Reporting Function reports Resource Trouble Tickets progress.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Ticket Repository Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Ticket Repository Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Ticket Repository Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Ticket Repository Management Function records Resource Trouble Tickets and manages its lifecycle.
It also manages corresponding registered Resource Troubles and relationships between Resource Troubles.
A Resource Trouble Ticket can be created 

	further to a Product Trouble Ticket resulting from the qualification of a problem indicated by a customer on a material product, 
	or to a Service Trouble Ticket when the resource(s) responsible for the service trouble is (are) identified,
	or following resource validated alarms,
	or QoS decreasing validated report.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Identification -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Identification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Identification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Identification Function identifies and triggers diagnostic actions relevant to identify the resource trouble, depending on the resource type and rules defined by the Resource Problem Policy Management function.
It triggers the corresponding actions and analysis of their results.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Ticket Escalation Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Trouble Ticket Escalation Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Ticket Escalation Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Ticket Escalation Management Function identifies if an escalation has to be triggered and find corresponding actions when relevant.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Assignment -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Assignment">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Assignment</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Assignment Function enables booking and release of a tangible product.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Availability Check -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Stock Item Availability Check">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Availability Check</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Stock Item Availability Check Function allows one to:

	Check the availability of tangible products in warehouses
	Get the delivery duration 

For this function, the supply chain uses its own stock and delivery duration, but also the stock and delivery duration of its partners.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Updating -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work Order Updating">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Updating</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Order Updating updates the transition of the order through its various states, including in-flight changes and cancellations</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Sourcing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Network Sourcing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Sourcing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Sourcing function is responsible for identifying, securing rights to, and integrating with networks and network elements that are owned by other network operators, in order to augment a service provider's own coverage, for situations where building or buying network is impractical due to strategic, financial or timing concerns.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Information Collection -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Information Collection">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Information Collection</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Business Partner Information Collection Aggregate Function enables collecting our knowledge of the Business Partner to keep or produce an up-to-date and accurate Business Partner information view.
It will incorporate into the Business Partner Information view, all relevant information gathered through all contacts with the Business Partner and in particular his field of activity.
Business Partner Information from other sources may be gathered, which will build a better knowledge of the supplier.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Qualify Business Partner Information -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Qualify Business Partner Information">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Qualify Business Partner Information</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Collect and Qualify Business Partner Information Aggregate Function is in charge of qualifying Business Partner Information collected including legal compliance.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Product Relationship Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Product Relationship Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Product Relationship Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Business Partner Product Relationship Management Function manages relationships between Products bought from the Business Partner with the CSP's (Customer Service Provider) different level of installed base (Product, Know-How a.k.a CustomerFacingService, Technical Solution a.k.a ResourceFacingService and Resource).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Technical Onboarding -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Technical Onboarding">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Technical Onboarding</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Technical Onboarding function enables electronic interactions between a service provider's systems and external partners' systems. External partners may be customers, suppliers, or third parties.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Portal Access -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Portal Access">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Portal Access</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Portal Access function supports providing a single entry point and self-service access to Business Partners to functions and information relevant to those Parties' interactions with the CSP. Responsible for ensuring that appropriate role-based security functions are employed, and for ensuring the safe and secure capture and/or delivery of information.  The provision of the functions accessed through the portal are the responsibility of those functions, not of the portal.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Voucher Ordering -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Voucher Ordering">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Voucher Ordering</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Voucher Ordering includes the ability to generate, modify, authorize and associate a PIN with serial numbers and dispatch the order to the manufacturer.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Operational Issues Integration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Operational Issues Integration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Operational Issues Integration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Operational Issues Integration provides receiving and passing inquires and issues between the service provider and (supplier) partner per contractual arrangements.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Performance Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Performance Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Performance Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Performance Management provides collection and analyzing of the performance of the supplier/partner or service provider equipment as well as the performance of the actual partner or service provider.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Problems Receiving -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Problems Receiving">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Problems Receiving</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Problems Receiving provides receiving of problems from the partner that require service provider assistance in resolving.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Settlement Adjustment and Billed Charges Collection -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Settlement Adjustment and Billed Charges Collection">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Settlement Adjustment and Billed Charges Collection</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Settlement Adjustment and Billed Charges Collection gathers substantiating adjustment and billing data to support supplier/partner invoice reconciliation and partner settlements.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Statistics on Supplier/Partner Activities Collection -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Statistics on Supplier/Partner Activities Collection">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Statistics on Supplier/Partner Activities Collection</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Statistics on Supplier/Partner Activities Collection collects supplier/partner statistics on Supplier/Partner activities data to support supplier/partner invoice reconciliation and partner settlements.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Supplier/Partner Settlements -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Supplier/Partner Settlements">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supplier/Partner Settlements</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Settlements provides the necessary functionality to calculate a settlement with the partner, initiate the payment or bill to the partner.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Supplier/Partner Settlements Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Supplier/Partner Settlements Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supplier/Partner Settlements Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supplier/Partner Settlements Reporting provides the necessary functionality to create reports that substantiate the settlement.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Purchase Requisition Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Purchase Requisition Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Purchase Requisition Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Purchase Requisition Management function manages the purchase requests and approvals and convert purchase approvals into standard purchase orders. It also manages requisitions for Network infrastructure maintenance and investment, only used for purchase of Network infrastructure. E.g.: Technical partner needs to purchase material for a planned or emergency infrastructure work. It may then be booked as an investment or maintenance expenditure.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Order Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Order Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Order Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Order Management tracks, monitors and reports on a service provider initiated order to ensure that the interactions are in accordance with the agreed commercial arrangements between the service provider and another party.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Product Sourcing Registration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Product Sourcing Registration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Product Sourcing Registration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Product Sourcing Registration provides initiation of product instantiation into the service provider product catalog and/or store front, including product prices.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Product Certification -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Product Certification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Product Certification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Product Certification provides product certification/decertification to be an integrated part of the service provider's value proposition.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Product Onboarding Support -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Product Onboarding Support">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Product Onboarding Support</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Product Onboarding Support provides product onboarding, updating, and decommissioning.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Supplier/Partner Invoice Reconciliation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Supplier/Partner Invoice Reconciliation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supplier/Partner Invoice Reconciliation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supplier/Partner Invoice Reconciliation uses the charges (and e.g. adjustments) from the supplier/partner along with substantiating information available to the service provider to reconcile the invoice presented by the supplier/partner.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Contract Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Contract Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Contract Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Contract Management, including establishment, modification, and termination.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Potential Partner Identification -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Potential Partner Identification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Potential Partner Identification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Potential Partner Identification by managing the evaluation of potential partners, to determine partners and partner's engagements that best meet the enterprises needs</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Billing and Settlement Disputes Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Billing and Settlement Disputes Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Billing and Settlement Disputes Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Billing and Settlement Disputes Management of inter-carrier billing and settlement disputes and other supplier/partner services including content and e-commerce disputes.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Record Automated Error Correction -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Record Automated Error Correction">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Record Automated Error Correction</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Record Automated Error Correction provides automatic handling of records found in error, mass correction and re-rating of events. Including forwarding to manual handling in case automatic correction isn't possible.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Payments Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Payments Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Payments Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Payments Management handles payments in the area of Supplier/Partner billing and settlement, logging and tracking of full or partial payments.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Automated Billing/Settlement Monitoring -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Automated Billing/Settlement Monitoring">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Automated Billing/Settlement Monitoring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Automated Billing/Settlement Monitoring tools for monitoring of automated billing, settlement and payment to ease and expedite dispute management.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Invoice Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Invoice Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Invoice Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Invoice Management provides accurate, flexible bi-directional invoicing for various settlement periods.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Business Event Processing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Business Event Processing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Business Event Processing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Business Event Processing processes the events generated by the partners business activities for invoicing and payment purposes, including accounting of partners' activities.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Sourcing Reference Data Collection -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Sourcing Reference Data Collection">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sourcing Reference Data Collection</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sourcing Reference Data Collection collects definition of products and services, pricing schemes, partner entities and contracts into the system. Easy uploading of reference data from external sources such as XML files.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Workflow Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Workflow Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Workflow Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Workflow Management function provides workflow and orchestration for supplier/partner management activities.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partnership Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partnership Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partnership Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partnership Reporting provides reporting of partner related information as appropriate concerning orders, trouble tickets, campaign and sales results, product usage, billing data, inquiries on products, product feedback, as well as lead and opportunity data. This information can be made available to relevant service provider or partner staff and systems.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Procurement Order Monitoring -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Procurement Order Monitoring">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Procurement Order Monitoring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">A Procurement Order is a type of Business Partner Order requesting for materials (a.k.a. purchasing order).
Procurement Order Monitoring provides monitoring of Procurement Orders to ensure supplier order payment according to goods receipt control.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Collaboration Constraints Collection -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Collaboration Constraints Collection">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Collaboration Constraints Collection</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Collaboration Constraints Collection function collects external and internal constraints that can impact a partner collaboration. The partner strategy definition is impacted by various factors, like partners geographical location, governmental regulatory, product and services offered etc. The function also provides capability to consider security and financial risks, environmental and legal issues and existing agreements etc.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Strategy Development -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Strategy Development">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Strategy Development</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Strategy Development function creates partner strategies for different partner categories and internal organizations, defines the scope of possible collaboration and policies for the internal organizations, and ensures that the partner strategies are aligned with the enterprise business model.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Strategy Lifecycle Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Strategy Lifecycle Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Strategy Lifecycle Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Strategy Lifecycle Management function supports collection and analyzing of partner strategy observance as well as constraints and risks development to update the partner strategies accordingly.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Strategy Implementation Planning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Strategy Implementation Planning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Strategy Implementation Planning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Strategy Implementation Planning function provides planning for the introduction of a partner strategy for relevant stakeholders within the company, including deriving/creating partner proposition at organization level.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Strategy Implementation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Strategy Implementation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Strategy Implementation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Strategy Implementation provides piloting and aligning the partner strategy implementation in the different levels of the organization including gathering of feedback of the implementation.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Strategy Assessing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Strategy Assessing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Strategy Assessing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Strategy Assessing provides planning and support of follow-up of strategy assessing by collecting metrics and performing auditing etc.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Group and Hierarchy Definition -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Group and Hierarchy Definition">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Group and Hierarchy Definition</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Group and Hierarchy Definition defines and creates partner group types and hierarchy criteria in line with the partner strategy to support partner collaboration with the different organization of the enterprise.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Group and Hierarchy Assigning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Group and Hierarchy Assigning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Group and Hierarchy Assigning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Group and Hierarchy Assigning assigns partners to relevant groups and hierarchies and make the grouping available to the concerned organizations within the enterprise</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Profile Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Profile Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Profile Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Profile Management function provides the necessary functionalities to manage partner information details for internal usages. This includes management of the stored profile information including creation, updating and deletion as well as lifecycle management by supervision to keep information valid and up to date.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Preferences Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Preferences Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Preferences Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Preferences Management function provide the necessary functionalities to manage partner preferences and partner information details in collaboration with the partner. This includes management of the stored profile information including creation, updating and deletion as well as lifecycle management by supervision of validity and recency.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Profile Enquiry and Filtering -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Profile Enquiry and Filtering">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Profile Enquiry and Filtering</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Profile Enquiry and Filtering function provides the necessary functionalities to enquire stored profiles including filtering to both ensure access based on authority levels and for the convenience for the reader.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Profile Storage -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Profile Storage">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Profile Storage</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Profile Storage function secures data availability and integrity for the partner profile management.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Financial Information Collection -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Financial Information Collection">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Financial Information Collection</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Financial Information Collection function gathers financial information related to potential partners, partner groups and hierarchies. Financial information can be collected from 3rd parties/institutions and stored locally by the enterprise for future internal use to assess potential financial risks associated with partners before making any new business engagement with the partner.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Financial Risk Analyzing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Financial Risk Analyzing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Financial Risk Analyzing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Financial Risk Analyzing function supports the assessment of potential financial risks associated with partners before making any new business engagement. The analysis is done based on financial information, both collected and recent, for the relevant partner profile, group and hierarchy.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Financial Risk Scoring -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Financial Risk Scoring">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Financial Risk Scoring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Financial Risk Scoring function creates a risk score for all engaged partners.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Interaction Journalizing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Interaction Journalizing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Interaction Journalizing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Interaction Journalizing provides collection & storage of all contact events with the partner via all channels whether unassisted (self service, retail kiosk) or assisted (call center, retail store).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Agreement Creation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Agreement Creation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Agreement Creation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Agreement Creation function provides the functionality to automate the creation of an agreement based on templates or from scratch. The function allows to create and maintain predefined agreement options and templates with terms and conditions (e.g. pricing information, payment clauses, legal texts, etc.) for different purposes and services.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Agreement Storage and Searching -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Agreement Storage and Searching">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Agreement Storage and Searching</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Agreement Storage and Searching function provides the ability to view Partner's existing agreements, search for partner agreements based on meta-data and to search text strings within agreements. The data can also be mined for partner strategy, negotiation, workflow and interaction purposes.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Agreement Implementation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Agreement Implementation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Agreement Implementation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Agreement Implementation function provides support for the implementation of the agreements terms and conditions to be used by related organizations during operations.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Agreement Tracking -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Agreement Tracking">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Agreement Tracking</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Agreement Tracking function keeps the association of the partner product offerings with the agreements and tracks anomalies for single products or group of products of the partner.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Tender Development -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Tender Development">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tender Development</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tender Development function supports developing the tender from scratch or based on template. Including the definition of templates for tenders to be reused.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Tender Workflow Guiding -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Tender Workflow Guiding">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tender Workflow Guiding</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tender workflow guiding supports the tender workflow creation and guiding throughout the bidding process and tender finalization.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Tender Tracking and Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Tender Tracking and Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tender Tracking and Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tender tracking and reporting function tracks and compiles the biddings and responses and reports the tender/bidding status and responses.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Tender to Partner Qualification -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Tender to Partner Qualification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tender to Partner Qualification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tender to Partner Qualification function identifies the list of potential partner who can bid for the tender based on defined partner strategy and partner profiles.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Product Onboarding Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Product Onboarding Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Product Onboarding Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Product Onboarding Management function supports the managing of the onboarding of a Product Offering sourced from an external source e.g. a business partner.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Onboarded Product Partner Collaboration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Onboarded Product Partner Collaboration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Onboarded Product Partner Collaboration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Onboarded Product Partner Collaboration function defines the Point Of Contacts (POC) pertaining to the onboarded product offerings. The function supports the definition and management of the information about the POCs for both the sourcing partner and the receiving organization. The POCs may differ for different stages of the onboarded product e.g. onboarding, fulfillment, assurance, billing.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Onboarded Product Licensing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Onboarded Product Licensing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Onboarded Product Licensing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Onboarded Product Licensing function manages the linking of license information of the onboarded product to technical, procurement and agreement conditions.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Onboarded Product Workflows Definition -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Onboarded Product Workflows Definition">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Onboarded Product Workflows Definition</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Onboarded Product Workflows Definition function identifies appropriate workflows related to the use of the onboarded product in fulfillment, assurance and billing.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Procurement Order Payment -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Procurement Order Payment">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Procurement Order Payment</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Procurement Order Payment provides payment of supplier order.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Order Lifecycle Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Order Lifecycle Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Order Lifecycle Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Order Lifecycle Management collects Business Partner Order events and manages Business Partner Orders lifecycle.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Cost Avoidance Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Cost Avoidance Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Cost Avoidance Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Cost Avoidance Management Function measures Cost avoidance.
Cost avoidance is much more difficult to define. Suggested definitions include: 
-avoidance is a cost reduction that does not lower the cost of products/ but rather minimizes or avoids entirely the negative impact to the bottom line that a price increase would have caused

-when there is an increase in output/capacity without increasing resource expenditure, in general, the cost avoidance savings are the amount that would have been spent to handle the increased volume/output
-avoidances include process improvements that do not immediately reduce cost or assets but provide benefits through improved process efficiency, employee productivity, improved customer satisfaction, improved competitiveness, etc.; over time, cost avoidance often becomes cost savings.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Cost Reduction Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Cost Reduction Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Cost Reduction Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Cost Reduction Management Function measures Cost reductions.
Cost reductions, understood as tangible bottom line reductions, are easily defined as / characterized by: 
-year-on-year saving over the constant volume of purchased product/service
-direct reduction of expense liked to changes in processes/technology/policies that directly reduces expenses,
process improvements that result in real and measurable cost or asset reductions
-examination of existing products or services, contractual agreements, or processes to determine potential changes that reduce cost
-net reductions in prices paid for items procured when compared to prices in place for the prior 12 months or a change to lower cost alternatives.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Purchasing Needs Forecasts -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Purchasing Needs Forecasts">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Purchasing Needs Forecasts</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Purchasing Needs Forecasts Function gathers the forecasts from the users.
It permits to define external purchases volume by perimeter and country according to business strategic priorities (make or buy), budget constraints or technical constraints.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Order Storage Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Order Storage Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Order Storage Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Order Storage Management Function is in charge of tracking Business Partner Orders for each version.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Goods Receipt Check -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Goods Receipt Check">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Goods Receipt Check</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Goods Receipt Check Function manages suppliers' goods receipt checking (quantity, working).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Revenue Sharing Identification -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Revenue Sharing Identification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Revenue Sharing Identification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Revenue Sharing Identification Function identifies the relevant pricing rules (tariffs, discounts and penalties) to be applied according to Revenue Sharing Agreement.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Revenue Sharing Enforcement -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Revenue Sharing Enforcement">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Revenue Sharing Enforcement</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Revenue Sharing Enforcement Functions applies revenue sharing pricing rules to calculate what the CSP owes to the Business Partner and what is owed by the Business Partner to the CSP.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Settlement Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Business Partner Settlement Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Settlement Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Partner Settlement Management calculates settlements amounts according to what the CSP owes to the Business Partner (for Offers bought to the BP and for Revenue Sharing) and what is owed by the Business Partner to the CSP (for what has been bought by the BP to the CSP and for Revenue sharing).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Goods Return management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Goods Return management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Goods Return management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Goods Return Management Function manages suppliers' goods return when Goods received do not correspond to the quality expected.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Enterprise Security Risk Identification -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Enterprise Security Risk Identification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Enterprise Security Risk Identification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Enterprise Security Risk Identification Function is in charge of identifying security risk and security risk level on various security aspects.

Security concerns several parts: 
- CSP financial and legal security
- Personnel security (employees in their work environment, customers)
- Site security (buildings)
- Network, Service Platform and IS infrastructure security
- Information security (GDPR, confidentiality, defense secrecy)

The CSP Security Policy may be applied to these different parts, and its implementation may be carried out in operational functions of collection, control, supervision and analysis.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Security Rules Definition -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Security Rules Definition">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Security Rules Definition</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Security Rules Definition Function enables the definition of security rules and the means to verify compliance (processes, tools, organization, etc.).

Security concerns several parts: 
- CSP financial and legal security
- Personnel security (employees in their work environment, customers)
- Site security (buildings)
- Network, Service Platform and IS infrastructure security
- Information security (GDPR, confidentiality, defense secrecy)
The CSP Security Policy may be applied to these different parts.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Security Rules Implementation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Security Rules Implementation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Security Rules Implementation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Security Rules Implementation Function is in charge of the implementation of security rules and the means to verify compliance (processes, tools, organization, etc.).

Security concerns several parts: 
- CSP financial and legal security
- Personnel security (employees in their work environment, customers)
- Site security (buildings)
- Network, Service Platform and IS infrastructure security
- Information security (GDPR, confidentiality, defense secrecy)
The CSP Security Policy may be applied to these different parts, and its implementation may be carried out in operational functions of collection, control, supervision and analysis.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Security Crisis Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Security Crisis Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Security Crisis Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Security Crisis Management Function is in charge of managing major crises (technical, environmental, etc.).

Security concerns several parts: 
- CSP financial and legal security
- Personnel security (employees in their work environment, customers)
- Site security (buildings)
- Network, Service Platform and IS infrastructure security
- Information security (GDPR, confidentiality, defense secrecy)
The CSP Security Policy may be applied to these different parts, and its implementation may be carried out in operational functions of collection, control, supervision and analysis.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Security Context Monitoring -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Security Context Monitoring">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Security Context Monitoring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Security Context Monitoring Function monitors the security constraints that may appear such as new legal rules.

Security concerns several parts: 
- CSP financial and legal security
- Personnel security (employees in their work environment, customers)
- Site security (buildings)
- Network, Service Platform and IS infrastructure security
- Information security (GDPR, confidentiality, defense secrecy)
The CSP Security Policy may be applied to these different parts, and its implementation may be carried out in operational functions of collection, control, supervision and analysis.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Loan Securitization -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Loan Securitization">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Loan Securitization</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Loan Securitization function is supporting responsible for the processes of pooling loans and converting them into securities that can be sold to investors. The principal responsibilities processes include: Structuring loan pools, Assessing credit quality, Engaging rating agencies, Preparing offering documents, Complying with regulatory requirements, Coordinating with stakeholders, Managing the issuance process, Monitoring loan performance, and Implementing best practices. These responsibilities ensure a well-structured, compliant, and successful securitization process while maintaining transparency and investor confidence.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.IP Licensing and Sales -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.IP Licensing and Sales">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">IP Licensing and Sales</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">IP Licensing and Sales function supports targeting opportunities, negotiating deals and executing and managing license agreements for Intellectual Property.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work List Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Work List Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work List Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work List Management function supports organizing and prioritizing tasks for individuals or groups.  It includes:
1.	Task Identification and Prioritization: Worklist managers determine the importance of tasks and prioritize them based on urgency and impact.
2.	Task Assignment: They allocate tasks to the appropriate individuals or teams, ensuring the right people are working on the right tasks.
3.	Workflow Optimization: Worklist management streamlines processes, reducing delays and bottlenecks.
4.	Monitoring Progress: Managers track task completion and ensure adherence to deadlines.
5.	Resource Allocation: They allocate resources like time, manpower, and equipment effectively.
6.	Communication Facilitation: They foster communication among team members and stakeholders.
7.	Risk Mitigation: Managers identify and address potential risks to prevent disruptions in workflow.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Enterprise Email -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Enterprise Email">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Enterprise Email</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Enterprise Email function supports organizational communication and information management. Its key responsibilities include:
1.	Managing Email Infrastructure: Ensuring the availability, scalability, and security of email servers and systems.
2.	User Account Management: Creating, maintaining, and deactivating email accounts for employees.
3.	Email Security: Implementing robust security measures to protect against phishing, malware, and unauthorized access.
4.	Email Compliance: Enforcing email policies, archiving, and retention to meet legal and regulatory requirements.
5.	Email Encryption: Securing sensitive data through encryption for confidentiality.
6.	Spam and Virus Protection: Filtering and blocking unwanted emails and threats.
7.	Email Client Support: Assisting users with email client configuration and troubleshooting.
8.	Disaster Recovery: Creating backup and recovery plans to ensure email continuity.
9.	Training and Education: Conducting training sessions to educate users on email best practices.
10.	Performance Monitoring: Constantly monitoring email system performance and optimizing for efficiency and reliability.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Receivable General Ledger Posting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Receivable General Ledger Posting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Receivable General Ledger Posting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Recording of revenues and expenses at the General Ledger level provide necessary tools to maintain the customer account receivable. Aggregate customer accounts for general ledger: Group receivables by type of customer accounts, through grouping of individual customers A/R accounts.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Receivable Debit/Credit Matching -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Receivable Debit/Credit Matching">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Receivable Debit/Credit Matching</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Receivable Debit/Credit Matching function allocates/assigns receivables within customers account: Match credit and debit entries related to a same process. The most common example is matching payment(s) to corresponding invoices or invoice items. The matching does not affect the global balance but eases the clerical tasks.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Receivable Direct Debiting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Receivable Direct Debiting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Receivable Direct Debiting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Receivable Direct Debiting provides Direct debit by generating flows of requests for direct debits. It is based upon the billing accounts and on the banks' opening schedule.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Receivable Balance Transferring -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Receivable Balance Transferring">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Receivable Balance Transferring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Accounts Receivable (A/R) Management function of Applying adjustments and balance transfer: Adjustments to be carried out (manually or in bulk) or transfer of transactions to customers accounts after corrections.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Accounting Event Creation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Accounting Event Creation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Accounting Event Creation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Accounting Event Creation function sends information produced by rating and/or invoicing functions to the accounting functionality, including the period end (a.k.a. cut-off) accounting entries.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Payments to Accounts Crediting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Payments to Accounts Crediting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Payments to Accounts Crediting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Payments to Accounts Crediting receives customer payments from various sources and applies them to customer account balances. It also performs activities, such as Payment Allocation to balances and Transfers of funds between accounts.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Customer Account Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Customer Account Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Customer Account Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Customer Account Management supports the financial activities that relate to customer accounts. These activities includes Refunds, Disputes, Adjustments / Credits and Write-offs.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Accounts Receivable Charge Posting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Accounts Receivable Charge Posting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Accounts Receivable Charge Posting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Accounts Receivable Charge Posting posts invoice charges in Accounts Receivable based on billed charges. It can be invoked by any billing system. Invoice charges accepts information on new charges and credits billed to customers, and updates their account balance accordingly.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Customer's Account Adjustment -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Customer's Account Adjustment">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Customer's Account Adjustment</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Customer's Account Adjustment adjusts customer's account balance based on the result of a detailed assessment or dispute. Possible adjustments may include tax adjustments, account/invoice/charge level adjustment, good will adjustment as well as refund or credits. All adjustments are made based on schedule of authorization polices. The customer service representative (CSR) can also consider the history and nature of previous dispute &amp; adjustment requests made by the customer.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Billing Financial transaction creation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Billing Financial transaction creation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Billing Financial transaction creation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Create appropriate transactions regarding the current invoice for Receivables Management.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Care-center Workforce Training -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Care-center Workforce Training">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Care-center Workforce Training</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Care-center Workforce Training facilitates work center training, including integration to workforce scheduling and tracking.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Care-center Compliance Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Care-center Compliance Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Care-center Compliance Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Care-center Compliance Management manages compliance with customer service / work-center methods and procedures.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Care-center Case Queuing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Care-center Case Queuing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Care-center Case Queuing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Care-center Case Queuing addresses the work queuing and work assignment for cases received from various channels including incoming calls, email, and back-office/front-office work distribution and queuing. Work Queuing can be on-line (active customer contact) or off line (no customer "on the line").</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Care-center Workforce Administration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Care-center Workforce Administration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Care-center Workforce Administration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Care-center Workforce Administration administers the work center workforce and associated skills-based work assignments. It addresses scheduling, work distribution/assignment and planning for current and forecasted center work-loads.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Center Activity Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Center Activity Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Center Activity Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Center Activity Management includes the necessary functionality to track activities performed within a work center. These activities range from orders placed, sales closed, problems resolved, ticket closed, etc. Most work centers incorporate a detailed activity tracking mechanism with associated reporting for individual agent performance and is typically rolled up to support center-level performance as well.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Center Budget Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Center Budget Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Center Budget Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Center Budget Management includes the tracking of all center expenses including operating expenses as well as project expenses. This function is primarily used for managing project budgets where a project can have long durations, multiple parallel or sequential activities and may involve work by multiple support resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Center Quality Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Center Quality Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Center Quality Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Center Quality Management supports the tracking of all quality components of a support (ordering, outage, provisioning, etc) project for completeness, accuracy, and customer satisfaction.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Center Time Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Center Time Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Center Time Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Center Time Management supports all of the time management of a service provider Agent/CSR/LCM etc. including tracking of hours worked, hours spent in training and other activities. It includes all time attributes used in the scheduling of resources to meet center SLAs. This function would also track time associated with a specific activity whether it be a short (single contact) or long running, multiple contact and team related activity. This aspect of time may span center resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Off-Line Contact Channel Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Off-Line Contact Channel Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Off-Line Contact Channel Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Off-Line Contact Channel Management provides the means to capture and manage activities that cannot or were not completed via an online channel contact. It also provides the means to place an activity on the off line queue that originated from an off-line channel such as email, postal mail, fax, etc.
Note: An activity can be completed on a different channel from which the request originated.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Journal Entry Accumulation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Journal Entry Accumulation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Journal Entry Accumulation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Journal Entry Accumulation accumulates journal entries and maps them to the GL transaction based on criteria such as appropriate geographical accounting principles for sending downstream to the corporate general ledger.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Financial Code Assigning -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Financial Code Assigning">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Financial Code Assigning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Financial Code Assigning assigns financial codes to transactions received from billing, online adjustment, payment, refund, and collection processes.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Journal Record Creation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Journal Record Creation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Journal Record Creation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Analyzes and translates financial activities into journal records, ready for accumulation or sending downstream to the corporate general ledger.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Account Receivables and Collection Access -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Partner Account Receivables and Collection Access">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Account Receivables and Collection Access</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Partner Account Receivables and Collection Access provides an online access function to make partners self sufficient for Receivables and Collection activities. Including the use of VNO/Dealer data fencing.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Change Project Collaboration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Change Project Collaboration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Change Project Collaboration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Change Project Collaboration provides interfaces to Workforce Management, supports collaborative project management across business boundaries and supports links to vendors ERP- via B2B portals and to internal network engineering duties for in-station and street activities.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Change Expenditure Authorization and Control -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Resource Change Expenditure Authorization and Control">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Change Expenditure Authorization and Control</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Change Expenditure Authorization and Control provides an interface to financial control in order to authorize the expenditure required to purchase the required resources.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Management function coordinate the availability and deployment of workforce resources to their in-service locations for e.g. preventative maintenance and change management.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Appointment Schedule Configuration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Appointment Schedule Configuration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Appointment Schedule Configuration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Appointment Schedule Configuration provides configuration of rules and routines for the workforce appointment schedule.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workload Forecasting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workload Forecasting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workload Forecasting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workload Forecasting provides forecasting of the workload and respective assignable staffing requirements on a daily, weekly, and longer period basis.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Availability Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Availability Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Availability Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Availability Management provides management of staff availability, including vacation time.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Training Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Training Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Training Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Training Management provides management of workforce training and/or coordination and interface with HR systems regarding the training.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Dispatchability Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Dispatchability Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Dispatchability Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Dispatchability Management provides management of the dispatchable technicians, including skill sets.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Geographical Work Areas Configuration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Geographical Work Areas Configuration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Geographical Work Areas Configuration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Geographical Work Areas Configuration provides management of the various geographical working areas (turfs).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Management Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Management Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Management Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Management Reporting functions provide the necessary functionality to report on the status of open work orders as well as technician information such as availability, utilization, and overall performance.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Scheduling -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Workforce Scheduling">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Scheduling</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Workforce Schedule Management function provide the necessary functionality to manage the work schedule, appointment schedule and resource schedule of the dispatchable workforce.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Proof and Balance Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Proof and Balance Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Proof and Balance Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Proof and Balance Reporting provides a Financial Reporting function to provide data presenting summaries of the financial activities of customer accounts. It includes a set of debt aging reports and proof &amp; balance reports.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Tax Information Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Tax Information Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tax Information Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Tax Information Reporting provides a function for Financial Reporting of tax information to Corporate Tax in support of tax compliance.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Data to Business Intelligence Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Account Data to Business Intelligence Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Data to Business Intelligence Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Data to Business Intelligence Reporting prepares account revenue details to be gathered into Business Intelligence data warehouse to facilitate decision support.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Control Configuration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Control Configuration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Control Configuration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Control Configuration function establishes the policies and rules to be applied to the Revenue Assurance process. It includes baselining acceptable limits and values from which actions will be taken.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Control -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Control">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Control</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Control function assures that the RA process is executing according to specified rules and controls.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Problem Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Problem Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Problem Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Problem Management function provides necessary functionality to assure that Revenue Assurance problems are assigned, coordinated, and corrected efficiently, escalating as needed per established business rules.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Problem Tracking -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Problem Tracking">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Problem Tracking</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Problem Tracking function provides necessary functionality to assure that Revenue Assurance problems are tracked from inception to resolution.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Problem Resolution Verification -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Problem Resolution Verification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Problem Resolution Verification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Problem Resolution Verification function provides necessary functionality to assure that Revenue Assurance problems resolution is verified.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Data Collection -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Data Collection">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Data Collection</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Data Collection function provide the necessary functionality to collect data from product, service, and resource (network) layers within fulfillment, assurance, and billing, as well as information from supplier/partner transactions.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Anomaly Monitoring -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Anomaly Monitoring">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Anomaly Monitoring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Anomaly Monitoring function analyzes processes (both interprocess and intraprocess) for RA anomalies, and looks for situations that are outside of the established baselines and triggers alerts when those situations are detected for further analysis. RA Monitoring looks for both "immediate" anomalies as well as predicts anomalies via trend analysis.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Anomaly Analyzing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Anomaly Analyzing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Anomaly Analyzing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Anomaly Analyzing function provides necessary functionality to diagnose detected revenue assurance related problems.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Correction Initiation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Correction Initiation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Correction Initiation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Correction Initiation provides the necessary functionality to initiate correction of the revenue assurance anomalies. Given that Revenue Assurance will detect issues originating in ordering, provisioning, billing, and usage, it is likely the correction or recovery will also need to be performed in those domains.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Recovery Initiation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Recovery Initiation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Recovery Initiation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Recovery Initiation provides the necessary functionality to initiate recovery of the lost revenue.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Revenue Assurance Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Revenue Assurance Reporting provides the functionality to report on the status of Revenue Assurance activities, including the status of issues currently being monitored, analyzed, and remedied. RA Reporting also reports on data derived from the fulfillment, assurance, and billing data collected for monitoring.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Payroll Wage Calculation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Payroll Wage Calculation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Payroll Wage Calculation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Payroll Wage Calculation calculates wages based on hourly rate plus any applicable adjustments such as overtime earned.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Payroll Salary Calculation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Payroll Salary Calculation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Payroll Salary Calculation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Payroll Salary Calculation calculates salary for current period.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Payroll Withholdings and Deductions Calculation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Payroll Withholdings and Deductions Calculation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Payroll Withholdings and Deductions Calculation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Payroll Withholdings and Deductions Calculation calculates Payroll Taxes and outputs to applicable agencies. Calculates Withholdings such as Federal Income Tax, and calculates deductions such as medical insurance, union dues and charitable contributions.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Paycheck Generation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Paycheck Generation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Paycheck Generation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Paycheck Generation generates Paycheck/Paystub deliverable in Paper and/or Electronic form.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Payroll Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Payroll Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Payroll Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Payroll Reporting reports payroll results to Financial Accounting and other applicable reporting and analytics.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Personnel Performance Goal Setting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Personnel Performance Goal Setting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Personnel Performance Goal Setting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Personnel Performance Goal Setting function supports setting of Short and Long Term goals for personnel, individuals or in a group.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Personnel Performance Goal Analyzing -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Personnel Performance Goal Analyzing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Personnel Performance Goal Analyzing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Personnel Performance Goal Analyzing function does performance appraisal relative to (set) Goals and Gap analysis for personnel, individual or in group.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Personnel Performance Feedback Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Personnel Performance Feedback Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Personnel Performance Feedback Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Personnel Performance Feedback Management provides KPI feedback calculation and presentation, as well as Identification and evaluation of competencies for personnel, individual or in group.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Governmental & Regulatory Tracking -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Governmental & Regulatory Tracking">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Governmental & Regulatory Tracking</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Governmental & Regulatory Tracking provides the necessary functionality to track the implementation of governmental & regulatory rules or requirements.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Governmental & Regulatory Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Governmental & Regulatory Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Governmental & Regulatory Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Governmental & Regulatory Reporting provides the necessary functionality to report as required to various Legal and Regulatory bodies.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Time Attendance Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Time Attendance Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Time Attendance Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Time Attendance Management provides the following functionality: 

	Time capture
	Time tracking
	Time calculations
	Time allocation
	Attendance and Absence tracking.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Time & Attendance Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Time & Attendance Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Time & Attendance Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Time &amp; Attendance Reporting provides the following functionality:

	Attendance and Absence reporting and analytics.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Staff Recruiting Support -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Staff Recruiting Support">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Staff Recruiting Support</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Staff Recruiting Support provides the following functionality: 

	Job Descriptions/Job Briefs
	Sourcing of candidates through job boards, job fairs, advertisements, referrals, company job site.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Staff Onboarding -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Staff Onboarding">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Staff Onboarding</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Staff Onboarding provides the following functionality: 

	Tracking of candidate through process
	Interviewing candidates by recruiter
	Ranking of candidates for hiring manager interview
	Background checks
	Organizational Management.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Recruitment and Staffing Reporting -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Recruitment and Staffing Reporting">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Recruitment and Staffing Reporting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Recruitment and Staffing Reporting provides the following functionality: 

	Legal and Regulatory reporting
	Analytics such as attrition rate.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Ethics & Compliance Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Ethics & Compliance Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ethics & Compliance Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Ethics &amp; Compliance Management provides the following functionality:

	Provides a program to ensure Labor is properly trained on ethics and compliance requirements
	Provides a program to enable safe reporting of ethical and compliance violations
	Ensures company is meeting ethical and compliance standards
	Institutes and manages programs such as EEO case management to track violations.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Employee Records Administration -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Employee Records Administration">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Employee Records Administration</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Employee Records Administration provides the following functionality: 

	Manages long term storage of employee records
	Defines what employee records are to be retained
	Defines record retention/destruction guidelines.
</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Employee Records Search and Retrieval -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Employee Records Search and Retrieval">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Employee Records Search and Retrieval</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Employee Records Search and Retrieval provides required records on request.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Awards & Recognition Guideline Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Awards & Recognition Guideline Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Awards & Recognition Guideline Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Awards &amp; Recognition Guideline Management provides the following functionality: 

	Provides guidelines for appropriate employee recognition
	Provides guidelines for appropriate employee awards.
</rdfs:comment>
</owl:Class>

