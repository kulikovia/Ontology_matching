<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Shared Allowances Charging links a charge record to shared allowance if it exists.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Billing Accounts Creation -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Billing Accounts Creation">
