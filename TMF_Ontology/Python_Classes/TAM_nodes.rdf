</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Building Portfolios Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Building Portfolios Management">
