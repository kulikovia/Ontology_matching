<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Lease Management plans, tracks, manage and maintain all aspects of leased real estates.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Real Estate Facility Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#F.Real Estate Facility Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#Function"/>
