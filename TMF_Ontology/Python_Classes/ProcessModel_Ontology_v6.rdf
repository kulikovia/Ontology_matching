<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Handle Interaction -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Handle Interaction">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Handle Interaction</rdf:label>
<rdfs:comment>Receive the interaction requests and authenticate the party contact. Either enable its originator to automatically fulfill it, or identify and activate the opportune process to accomplish the request.</rdfs:comment>
</owl:Class>

