<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Cancel Customer Bill Inquiry -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Cancel Customer Bill Inquiry">
