<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Update Customer Data -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Update Customer Data">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Update Customer Data</rdf:label>
<rdfs:comment>The purpose of this process is to update the customer data in the customer inventory. This can happen as a result of direct notification from the customer, as a result of information gathered as part of other processes (such as selling and order handling) or as a result of back office processes (such as customer data cleansing).</rdfs:comment>
</owl:Class>

