<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#De-duplicate Customer Identity -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#De-duplicate Customer Identity">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>De-duplicate Customer Identity</rdf:label>
<rdfs:comment>The purpose of this process is to check that the customer does not already have an Identity with the Enterprise. This process is also used to clean-up duplicates of customer identifying information that may exist within the organization.</rdfs:comment>
</owl:Class>

