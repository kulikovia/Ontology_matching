<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Monitor Interaction Status -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Monitor Interaction Status">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Monitor Interaction Status</rdf:label>
<rdfs:comment>The purpose of this process is to  monitor the status of a Party interaction. These processes analyze and assess the Party interaction status changes to initiate notifications or reports.</rdfs:comment>
</owl:Class>

