</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Manage Business Partner Orders -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Manage Business Partner Orders">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Manage Business Partner Orders</rdf:label>
<rdfs:comment>Manage Business Partner Orders processes manages orders to ensure they are being processed and delivered efficiently and effectively. These processes also manage notifications or requests from parties regarding forced or requested changes to the order or delivery schedule. These change requests may be caused by the Business Partner or may be outside their control. Change requests are provided to the originating  process(es) where a resolution is agreed.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Monitor Jeopardy Status -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Monitor Jeopardy Status">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
