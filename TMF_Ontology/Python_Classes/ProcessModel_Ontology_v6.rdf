<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Link consumption profiles and available product families">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Link consumption profiles and available product families</rdf:label>
<rdfs:comment>Link Market segments andamp; available product families processes analyze the basic consumption profiles of market segments and associate these with the product families available.</rdfs:comment>
</owl:Class>

