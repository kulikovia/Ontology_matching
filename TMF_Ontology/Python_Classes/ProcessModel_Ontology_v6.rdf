<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Monitor Customer Problem">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Monitor Customer Problem</rdf:label>
<rdfs:comment>Not used for this process element</rdfs:comment>
</owl:Class>

