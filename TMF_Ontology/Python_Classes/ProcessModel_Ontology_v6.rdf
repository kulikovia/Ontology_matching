<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Administer Commercial Arrangement for Third Party Supplier -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Administer Commercial Arrangement for Third Party Supplier">
