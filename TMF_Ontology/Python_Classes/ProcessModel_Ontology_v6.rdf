<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Log Customer Interaction -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Log Customer Interaction">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Log Customer Interaction</rdf:label>
<rdfs:comment>The purpose of this process is to record and maintain all information about the customer interaction. This information can be used in future interaction or as input for data analysis processes.</rdfs:comment>
</owl:Class>

