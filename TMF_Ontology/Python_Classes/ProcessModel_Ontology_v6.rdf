<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Create Customer Record -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Create Customer Record">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Create Customer Record</rdf:label>
<rdfs:comment>The purpose of this process is to create a new customer record in the customer inventory. This process follows the processes in Establish Customer Relationship that make sure that a single record is created for each customer, and it persists the customer data in the customer inventory.</rdfs:comment>
</owl:Class>

