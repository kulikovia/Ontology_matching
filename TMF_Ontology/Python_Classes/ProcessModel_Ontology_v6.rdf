<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Modify Business Partner Order">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Modify Business Partner Order</rdf:label>
<rdfs:comment>Not used for this process element</rdfs:comment>
</owl:Class>

