<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Update Customer Interaction -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Update Customer Interaction">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Update Customer Interaction</rdf:label>
<rdfs:comment>The purpose of this process is to update the customer interaction, typically when additional action is carried out during long-lived interactions. When the customer should be notified about the update, this process triggers the Notify Customer process to perform the notification.</rdfs:comment>
</owl:Class>

