<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Create Business Partner Interaction Log -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Create Business Partner Interaction Log">
