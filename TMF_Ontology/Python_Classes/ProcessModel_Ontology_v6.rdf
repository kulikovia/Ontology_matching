<!-- http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Close Interaction -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Close Interaction">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/ProcessModel_v1#Process"/>
<rdf:label>Close Interaction</rdf:label>
<rdfs:comment>The purpose of this process is to close the Party interaction when both parties agree that the interaction is closed, or according to party interaction policies when an interaction is regarded as timed out.</rdfs:comment>
</owl:Class>

