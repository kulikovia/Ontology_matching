<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Customer Fulfillment Access Management Aggregate Function provides access to information available through functions concerning Customer in Fulfillment vertical.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/v1#AF.Resource Fullfilment Access Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF.Resource Fullfilment Access Management">
