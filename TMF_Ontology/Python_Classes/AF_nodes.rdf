<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">TBA</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/v1#AF.Customer Fulfillment Access Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF.Customer Fulfillment Access Management">
