</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/v1#AF.API Implementation Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF.API Implementation Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF"/>
<rdf:label>API Implementation Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">API Implementation Management aggregate function groups function that support the development, production operation, lifecycle management and information management of API Implementations (aka software services, or service-oriented architecture services).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/v1#AF.API Implementation Information Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF.API Implementation Information Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF"/>
<rdf:label>API Implementation Information Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">API Implementation Information Management aggregate function groups functions that manage metadata, history, service plans and metrics and inventory of API Implementations (aka Software Service Implementations).</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/v1#AF.Business Requirements, Process & Rules Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF.Business Requirements, Process & Rules Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF"/>
<rdf:label>Business Requirements, Process & Rules Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Requirements, Process & Rules Management Aggregate Function groups functions that capture, organize, communicate, and validate business requirements, business process defijnitions, and business rules, and may also execute business processes (as workflows) and/or business rules.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/v1#AF.Business Rules Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF.Business Rules Management">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF"/>
<rdf:label>Business Rules Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Rules Management aggregate function groups functions that provide an ecosystem to  create, modify and execute business rules that guide people & systems behavior.</rdfs:comment>
</owl:Class>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/v1#AF.Fulfillment Integration Management -->

<owl:Class rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/FunctionModel_v1#AF.Fulfillment Integration Management">
