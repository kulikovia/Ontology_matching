<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>totalAssets</rdf:label>
<rdfs:comment>Total number of assets provided to the Community.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_totalResourcesAffected -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_totalResourcesAffected">
