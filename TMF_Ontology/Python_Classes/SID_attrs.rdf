<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_description -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_description">
<InformationModel_v1:hasOrigin>TroubleTicket</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>JSON::JSON_Attribute</InformationModel_v1:hasStereotype>
<rdf:label>description</rdf:label>
<rdfs:comment>Description of the trouble or issue</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_name -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_name">
<InformationModel_v1:hasOrigin>TroubleTicket</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>JSON::JSON_Attribute</InformationModel_v1:hasStereotype>
<rdf:label>name</rdf:label>
<rdfs:comment>Name of the trouble ticket, typically a short description provided by the user that create the ticket</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_(un)applicableCode -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_(un)applicableCode">
<InformationModel_v1:hasOrigin>PerformanceApplicability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>(un)applicableCode</rdf:label>
<rdfs:comment>Indicator that specifies whether an instance represents applicability or un-applicability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_(un)applicableDays -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_(un)applicableDays">
<InformationModel_v1:hasOrigin>PerformanceApplicability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>(un)applicableDays</rdf:label>
<rdfs:comment>A day or days representing applicability or un-applicability.  For example 2, 3 represent Monday and Tuesday.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_(un)applicableDuring -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_(un)applicableDuring">
<InformationModel_v1:hasOrigin>PerformanceApplicability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>(un)applicableDuring</rdf:label>
<rdfs:comment>A period of time representing applicability or un-applicability. For example, from 8AM to 12PM.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_amount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_amount">
<InformationModel_v1:hasOrigin>EmployeePay</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>amount</rdf:label>
<rdfs:comment>The amount corresponds to the sum of each EmployeePayComponent amount (calculated if it's a rate) for the EmployeePay period.  It specifies the unit (any currency) and the value such as $10.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_amoutPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_amoutPeriod">
<InformationModel_v1:hasOrigin>EmployeePay</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>amoutPeriod</rdf:label>
<rdfs:comment>amountPeriod specifies the duration covered by the amount. For example, the amount may correspond to a complete Year.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_abbreviation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_abbreviation">
<InformationModel_v1:hasOrigin>TimeZoneRule</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>abbreviation</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_acceptableEquipmentList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_acceptableEquipmentList">
<InformationModel_v1:hasOrigin>EquipmentHolder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>acceptableEquipmentList</rdf:label>
<rdfs:comment>This is an array of strings, based on M.3100, that identifies the types of equipment objects that can be supported by this object. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_acceptableEquipmentTypeList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_acceptableEquipmentTypeList">
<InformationModel_v1:hasOrigin>EquipmentHolder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>acceptableEquipmentTypeList</rdf:label>
<rdfs:comment>This attribute identifies the types of equipment that can be supported by the Equipment Holder.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_acceptedAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_acceptedAmount">
<InformationModel_v1:hasOrigin>DAAAccepted</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>acceptedAmount</rdf:label>
<rdfs:comment>The amount which the enterprise agreed to refund the Customer as a result of this DisputedAmount. This amount is less or equal the disputedAmount (in DAACreated entity), pending of the DisputedAmount was partially or completely accepted respectively.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_accessClassification -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_accessClassification">
<InformationModel_v1:hasOrigin>CalendarEntry</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>accessClassification</rdf:label>
<rdfs:comment>The access intended for this entry Permitted Values: PUBLIC, PRIVATE or CONFIDENTIAL</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_accessDecision -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_accessDecision">
<InformationModel_v1:hasOrigin>NACSecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>accessDecision</rdf:label>
<rdfs:comment>Final decision by the NAC to permit or deny access to the network (Permit/Deny).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_accessLevel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_accessLevel">
<InformationModel_v1:hasOrigin>SecurityIncidentImpact</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>accessLevel</rdf:label>
<rdfs:comment>Level of access obtained by the intruder, such as Root or User access.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_accountNameInThirdParty -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_accountNameInThirdParty">
<InformationModel_v1:hasOrigin>ThirdPartyCollectionPM</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>accountNameInThirdParty</rdf:label>
<rdfs:comment>The account, which is used in the third party, used to pay. If bank transfer is used here,  paymentAccountinThirdParty is BankAccount. If paymet tool (such as PayPal) is used here, paymentAccountInThirdPart is the payment tool (such as PayPal) account.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_accuracy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_accuracy">
<InformationModel_v1:hasOrigin>MetricDefMeasure</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>accuracy</rdf:label>
<rdfs:comment>The number of digits of accuracy captured for Metrics associated with a MetricDefMeasure.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_acFrequencyHigh -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_acFrequencyHigh">
<InformationModel_v1:hasOrigin>PowerSupply</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>acFrequencyHigh</rdf:label>
<rdfs:comment>This defines the high value of the AC Frequency range in Hertz. If this is a DC PowerSupply, this value is not applicable and should be set to NULL.  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_acFrequencyLow -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_acFrequencyLow">
<InformationModel_v1:hasOrigin>PowerSupply</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>acFrequencyLow</rdf:label>
<rdfs:comment>This defines the low value of the AC Frequency range in Hertz. If this is a DC PowerSupply, this value is not applicable and should be set to NULL.  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_achievedBudget -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_achievedBudget">
<InformationModel_v1:hasOrigin>Budget</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>achievedBudget</rdf:label>
<rdfs:comment>The amount achieved.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ackState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ackState">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>ackState</rdf:label>
<rdfs:comment>Provides the Acknowledgement State of the alarm.   Note that the automatic AVC notification generation is disabled for this attribute as a specific notification is generated for acknowledgement state change.    If the acknowledgeResourceAlarms is supported, then this attribute shall also be supported.   This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ackStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ackStatus">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>ackStatus</rdf:label>
<rdfs:comment>Acknowledgement status</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ackSystemId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ackSystemId">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>ackSystemId</rdf:label>
<rdfs:comment>Provides the name of the system that last changed the ackState of an alarm, i.e. acknowledged or unacknowledged the alarm.  Note that the automatic AVC notification generation is disabled for this attribute as a specific notification is generated for acknowledgement state change.    If the acknowledgeResourceAlarms is supported, then this attribute is optional.   This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ackTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ackTime">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>ackTime</rdf:label>
<rdfs:comment>Provides the time when the alarm has been last acknowledged or unacknowledged.  Note that the automatic AVC notification generation is disabled for this attribute as a specific notification is generated for acknowledgement state change.    If the acknowledgeResourceAlarms is supported, then this attribute shall also be supported.   This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ackUserId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ackUserId">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>ackUserId</rdf:label>
<rdfs:comment>Provides the id of the user who has last changed the ack state of the alarm,  i.e. acknowledged or unacknowledged the alarm.  Note that the automatic AVC notification generation is disabled for this attribute as a specific notification is generated for acknowledgement state change.    If the acknowledgeResourceAlarms is supported, then this attribute shall also be supported.   This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_action -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_action">
<InformationModel_v1:hasOrigin>BusinessInteractionItem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>action</rdf:label>
<rdfs:comment>The action to take for an InteractionItem, such as add, change, remove.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionData -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionData">
<InformationModel_v1:hasOrigin>PolicyActionVendor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>actionData</rdf:label>
<rdfs:comment>This attribute provides a general extension mechanism for representing policy actions that have not been modeled with the specific properties contained in this model. The format of this attribute is determined by the OID value stored in the ActionEncoding attribute. A policy decision point can readily determine whether it supports the values stored in an instance of ActionData by checking the OID value from ActionEncoding against the set of OIDs it recognizes. The action for the policy decision point to take in case it does not recognize the format of this data could itself be modeled as a PolicyRule, governing the behavior of the policy decision point. Notes: Not present in the ITU specs. The CIM defines a similar attribute called ActionData.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionEncoding -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionEncoding">
<InformationModel_v1:hasOrigin>PolicyActionVendor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>actionEncoding</rdf:label>
<rdfs:comment>This is a string attribute. It is used to represent an OID that in turn identifies the encoding and semantics of the ActionData attribute value array in this instance. The value of this property is a single string, representing a single OID. Notes: Not present in the ITU specs. The CIM defines a similar attribute called ActionEncoding.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionExecutionStrategy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionExecutionStrategy">
<InformationModel_v1:hasOrigin>PolicyActionComposite</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>actionExecutionStrategy</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the execution strategy to be used upon the sequenced actions aggregated by this PolicyActionComposite object. Defined execution strategies include: 0: Unknown 1: Do Until Success 2: Do All 3: Do Until Failure 4: Do All Without Failure or Do Nothing "Do Until Success" means that actions should be executed according to their predefined order, until successful execution of a single action. At that point, the process should stop (even if there are additional actions that could be executed). "Do All" means that all actions should be executed that are part of the set, according to their predefined order. This should continue, even if one or more of the actions fails. "Do Until Failure" means that actions should be executed according to their predefined order until an action fails to execute. At that point, the entire sequence should be stopped. Finally, "Do All Without Failure or Do Nothing" means that ALL actions specified should be performed. However, if a failure occurs, then NONE of the actions should be performed. This implies EITHER the ability to look-ahead and ensure that the actions will be able to be performed successfully, or the ability to perform a rollback of that action and all previous actions when an error is encountered.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionItem -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionItem">
<InformationModel_v1:hasOrigin>CalendarToDo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>actionItem</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionRequested -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionRequested">
<InformationModel_v1:hasOrigin>StockItemShipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>actionRequested</rdf:label>
<rdfs:comment>Realize or Cancel</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionResponse -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionResponse">
<InformationModel_v1:hasOrigin>PolicyActionVendor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>actionResponse</rdf:label>
<rdfs:comment>This is a Boolean attribute that is used to allow a 'standard' definition of a TRUE/FALSE response to be made by an external system attached to the model at this point. This will allow integration with a generalized policy processing engine. notes: Not defined in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionsCNF -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionsCNF">
<InformationModel_v1:hasOrigin>PolicyActionComposite</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>actionsCNF</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionSequence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionSequence">
<InformationModel_v1:hasOrigin>PolicyActionComposite</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>actionSequence</rdf:label>
<rdfs:comment>This attribute is a non-negative integer and represents the particular sequence in which this element is executed as part of the overall policy structure.   For example if a composite is part of another composite policy structure. Notes: default is 1</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionSequenceNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionSequenceNumber">
<InformationModel_v1:hasOrigin>PolicyActionAtomic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>actionSequenceNumber</rdf:label>
<rdfs:comment>This attribute is a non-negative integer and represents the particular sequence in which this element is executed as part of the overall policy structure. This will allow a policy engine to reference externally supplied arguments to this object as it is executed.  Notes: Not present in the ITU specs;  CIM 2.7 has a subset of these values.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionTaken -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actionTaken">
<InformationModel_v1:hasOrigin>PartyRevShareReconDiscrepancy</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>actionTaken</rdf:label>
<rdfs:comment>Text that describes what action was taken, such as the creation of a PartyRevenueShareAdjustment, an AppliedPartyBillingRate, an adjustment to a PartyPayment, or a PartyPaymentItem.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_activationMode -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_activationMode">
<InformationModel_v1:hasOrigin>ServiceDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>activationMode</rdf:label>
<rdfs:comment>Indicates whether the designed service is activated through provisioning, or is signaled.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_activityDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_activityDate">
<InformationModel_v1:hasOrigin>DisputedAmountActivity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>activityDate</rdf:label>
<rdfs:comment>The date in which this activity was performed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_activityNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_activityNr">
<InformationModel_v1:hasOrigin>Activity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>activityNr</rdf:label>
<rdfs:comment>A unique identifier for the Activity</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_activityStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_activityStatus">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>activityStatus</rdf:label>
<rdfs:comment>Activity status, indicates if the problem is historical or active</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actualCompletionDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actualCompletionDate">
<InformationModel_v1:hasOrigin>CalendarToDo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>actualCompletionDate</rdf:label>
<rdfs:comment>The date the toDo was actually completed Notes: COMPLETED [iCalendar]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actualCost -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actualCost">
<InformationModel_v1:hasOrigin>WorkforceResourceAssignment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>actualCost</rdf:label>
<rdfs:comment>Actual Cost of the assignment of the resource (tools) to the work.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actualDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actualDuration">
<InformationModel_v1:hasOrigin>ProjectElement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>actualDuration</rdf:label>
<rdfs:comment>The duration that actually occurred</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actualParticipationStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_actualParticipationStatus">
<InformationModel_v1:hasOrigin>CalendarEntryAttendance</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>actualParticipationStatus</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ACWP -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ACWP">
<InformationModel_v1:hasOrigin>ProjectElement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>ACWP</rdf:label>
<rdfs:comment>Actual Cost of Work Scheduled</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_additionalInfo -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_additionalInfo">
<InformationModel_v1:hasOrigin>CommonObjectInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>likelyToBeDeprecated</InformationModel_v1:hasStereotype>
<rdf:label>additionalInfo</rdf:label>
<rdfs:comment>This attribute is a vendor specific attribute that contains additional specific information about the object. This list can be empty.  The attribute, when present, can be used to convey information from the target OS to the requesting OS, and vice versa, of additional information that isn't explicitly modelled, except that some parameter names and values may be predefined.  Any information encoded in the additionalInfo is optional: target OS need not fill out this information and the requesting OS need not interpret this information.  See R_TMF518_FMW_I_0001.This is a vendor specific attribute that contains additional specific information about the object. This list can be empty.  The attribute, when present, can be used to convey information from the target OS to the requesting OS, and vice versa, of additional information that isn't explicitly modelled, except that some parameter names and values may be predefined.  Any information encoded in the additionalInfo is optional: the target OS need not fill out this information and the requesting OS need not interpret this information.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_additionalObjectInfoList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_additionalObjectInfoList">
<InformationModel_v1:hasOrigin>TransmissionDescriptor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>additionalObjectInfoList</rdf:label>
<rdfs:comment>This attribute contains additional parameters which can be set and/or retrieved on an object having this Transmission Descriptor (TMD) assigned as (egress or ingress) TMD.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_additionalText -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_additionalText">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>additionalText</rdf:label>
<rdfs:comment>Contains further information on the alarm. Vendors should avoid using this field to put additional information identifying the alarmed object or the specific problem. The corresponding fields should be use for better alarm quality.   This attribute is optional in all 3 profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_addressValueList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_addressValueList">
<InformationModel_v1:hasOrigin>IPAddressValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>addressValueList</rdf:label>
<rdfs:comment>This is an array of string values. Each string value contains a particular value to filter on. Note that all values must have the format specified in the Format attribute of this class.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_adjustmentReason -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_adjustmentReason">
<InformationModel_v1:hasOrigin>PartyRevenueShareAdjustment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>adjustmentReason</rdf:label>
<rdfs:comment>The reason the adjustment was determined.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_administrativeState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_administrativeState">
<InformationModel_v1:hasOrigin>ManagedHardware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>administrativeState</rdf:label>
<rdfs:comment>This attribute is an enumerated integer that describes the current physical state of the ManagedHardware. Values include:  0: Unknown  1: Unlocked  2: Locked  3: Shutting Down  4: Starting Up  5: Testing  6: Maintenance  7: Not Applicable  8: Not able to inform  This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_adminState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_adminState">
<InformationModel_v1:hasOrigin>Test</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>adminState</rdf:label>
<rdfs:comment>The administrative state of the test may be "LOCKED", "UNLOCKED"</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_affectedServiceNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_affectedServiceNumber">
<InformationModel_v1:hasOrigin>ServiceProblem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>affectedServiceNumber</rdf:label>
<rdfs:comment>Number of affected services (mandatory, but value can be zero).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_afterSalesServiceProvidedBy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_afterSalesServiceProvidedBy">
<InformationModel_v1:hasOrigin>PartyRoleProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>afterSalesServiceProvidedBy</rdf:label>
<rdfs:comment>An indicator that specifies that a party provides assurance related customer service after a sale is made.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aggregateSharedRevenue -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aggregateSharedRevenue">
<InformationModel_v1:hasOrigin>PartyRevShareTermOrCondition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>aggregateSharedRevenue</rdf:label>
<rdfs:comment>Aggregate revenue shared for a product offering if true. Provide details about each acquisition of an offering if false.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aggregation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aggregation">
<InformationModel_v1:hasOrigin>AssociationRoleSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>aggregation</rdf:label>
<rdfs:comment>Indicates whether an association role is a shared or composite aggregation.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aggregationDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aggregationDuration">
<InformationModel_v1:hasOrigin>TariffUsageProdOfferPriceCharge</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>aggregationDuration</rdf:label>
<rdfs:comment>The aggregationDuration specifies the duration during which ProductUsages have to be aggregated before applying the TarifUsageProdOfferPriceCharge globally on the ProductUsages aggregated volume.  The type of this attribute is String as it might be more complex than a simple duration, such as "all ProductUsages between 8AM-8PM during one month".</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmAction -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmAction">
<InformationModel_v1:hasOrigin>CalendarAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>alarmAction</rdf:label>
<rdfs:comment>The action to be invoked when an alarm is triggered [iCalendar] Notes ACTION [iCalendar]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmChangedTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmChangedTime">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>alarmChangedTime</rdf:label>
<rdfs:comment>Indicates the last date and time when the alarm is changed on the alarm-owning system. Any change to the alarm whether coming from the alarmed resource, or triggered by a change from the client is changing this time.   This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmClearedTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmClearedTime">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>alarmClearedTime</rdf:label>
<rdfs:comment>Indicates the time (as a date + time) at which  the alarm is cleared.  Note that the automatic AVC notification generation is disabled for this attribute as a specific notification is generated for alarm clearance.    It is not filled on an alarm for which the clearance has not been received, but it is mandatory for a cleared alarm.  This attribute is mandatory in all 3 profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmDateTime">
<InformationModel_v1:hasOrigin>AbsoluteCalendarAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>alarmDateTime</rdf:label>
<rdfs:comment>An absolute date/ time for the alarm to activate</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmEscalation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmEscalation">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>alarmEscalation</rdf:label>
<rdfs:comment>Indicates if this alarm has been escalated or not. Possible values are 0 to 10. A value of zero means no escalation.  The meanings of values 1-10 are to be determined by the user of the interface, but they show increasing levels of escalation.  This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmId">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>alarmId</rdf:label>
<rdfs:comment>Local identifier of the Alarm. Note that this identifier is local to the server side of the interface, i.e. the alarm-owning system.   Only EntityIdentifier can be considered as global.  This attribute is mandatory in all 3 profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmRaisedTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmRaisedTime">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>alarmRaisedTime</rdf:label>
<rdfs:comment>Indicates the time (as a date + time) at which the alarm occurred.  This attribute is mandatory in all 3 profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmReportingTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmReportingTime">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>alarmReportingTime</rdf:label>
<rdfs:comment>Indicates the time (as a date + time) at which the alarm was reported by the owning system.   It might be different from the alarmRaisedTime. For instance, if the alarm list is maintained by an EMS, the alarmRaisedtime would be the time the alarm was detected by the NE, while the alarmReportingTime would be the time this alarm was stored in the alarm list of the EMS.  This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmSeverityAssignmentList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmSeverityAssignmentList">
<InformationModel_v1:hasOrigin>AlarmSeverityAssignmentProfile</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>alarmSeverityAssignmentList</rdf:label>
<rdfs:comment>This attribute identifies a list of Alarm Severity Assignments (ASA). Each record of this sequence specifies the probable cause (plus optionally the probableCauseQualifier and / or the nativeProbableCause) and the severities to be assigned.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmTrigger -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmTrigger">
<InformationModel_v1:hasOrigin>RelativeCalendarAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>alarmTrigger</rdf:label>
<rdfs:comment>Specifies if the alarm trigger durationOffset relates to the start or the end of the Entry</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alarmType">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>alarmType</rdf:label>
<rdfs:comment>Categorizes the alarm.  This attribute is mandatory in all 3 profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aliasNameList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aliasNameList">
<InformationModel_v1:hasOrigin>CommonObjectInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>likelyToBeDeprecated</InformationModel_v1:hasStereotype>
<rdf:label>aliasNameList</rdf:label>
<rdfs:comment>This attribute contains a list of aliases for the network entity.  See R_TMF518_FMW_I_0001.This attribute contains a list of aliases for the entity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aliveDuring -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aliveDuring">
<InformationModel_v1:hasOrigin>Individual</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>aliveDuring</rdf:label>
<rdfs:comment>Birth date and death date.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_allocatedBudget -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_allocatedBudget">
<InformationModel_v1:hasOrigin>Budget</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>allocatedBudget</rdf:label>
<rdfs:comment>The amount allocated.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_allocationDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_allocationDate">
<InformationModel_v1:hasOrigin>ProjectResourceAllocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>allocationDate</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_allowedApiEntities -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_allowedApiEntities">
<InformationModel_v1:hasOrigin>APISpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>allowedApiEntities</rdf:label>
<rdfs:comment>A comma separated list of authorised entities for this API.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_allowedOperations -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_allowedOperations">
<InformationModel_v1:hasOrigin>APISpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>allowedOperations</rdf:label>
<rdfs:comment>A comma separated list of authorised operations like POST, PATCH for this API.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_allowedValueTypes -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_allowedValueTypes">
<InformationModel_v1:hasOrigin>VariableStandard</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>allowedValueTypes</rdf:label>
<rdfs:comment>This is an array of string attributes that define the set of class names (which correspond to a set of datatypes) that are allowed to be used in conjunction with this PolicyVariable. Each string provides a class name, which corresponds to a particular subclass of PolicyValue. Each allowed subclass defines an object with a compatible datatype and semantics. Notes: Not present in the ITU or CIM specs. The IETF RFCs only define MATCH.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alphabetName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alphabetName">
<InformationModel_v1:hasOrigin>Language</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>alphabetName</rdf:label>
<rdfs:comment>The alphabet name use for the language Note: ISO standard ?</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alternativeDifferences -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_alternativeDifferences">
<InformationModel_v1:hasOrigin>SoftwareSpecAlternativeRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>alternativeDifferences</rdf:label>
<rdfs:comment>A textual description of the differences between the alternates.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_amountLimited -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_amountLimited">
<InformationModel_v1:hasOrigin>ChargeAmountThreshold</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>amountLimited</rdf:label>
<rdfs:comment>Limited amount could be affordable by certain BillingAccount.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_amountPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_amountPeriod">
<InformationModel_v1:hasOrigin>PayComponentSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>amountPeriod</rdf:label>
<rdfs:comment>amountPeriod specifies the duration covered by the amount. For example, the amount may correspond to a complete Year, in this case if the pay is executed monthly, the amount will be devided by 12 to find the amount for one pay.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_amountRangeInterval -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_amountRangeInterval">
<InformationModel_v1:hasOrigin>RevShareModelSpecNegotiableRange</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>amountRangeInterval</rdf:label>
<rdfs:comment>An indicator that specifies the inclusion or exclusion of the lower range and upper range amount attributes. Possible values are "open", "closed", "closedBottom" and "closedTop".</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_apiProtocolType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_apiProtocolType">
<InformationModel_v1:hasOrigin>APISpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>apiProtocolType</rdf:label>
<rdfs:comment>API protocol type like REST, SOAP and so on.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicabilityLabel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicabilityLabel">
<InformationModel_v1:hasOrigin>AnomalyApplicability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>applicabilityLabel</rdf:label>
<rdfs:comment>Label that is used as a guidance to decide applicability / inapplicability</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicableCode -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicableCode">
<InformationModel_v1:hasOrigin>MetricDefMeasureApplicability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>applicableCode</rdf:label>
<rdfs:comment>Indicator that specifies whether an instance represents applicability or un-applicability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicableDays -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicableDays">
<InformationModel_v1:hasOrigin>AnomalyApplicability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>applicableDays</rdf:label>
<rdfs:comment>A day or days representing applicability or inapplicability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicableDuring -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicableDuring">
<InformationModel_v1:hasOrigin>AnomalyApplicability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>applicableDuring</rdf:label>
<rdfs:comment>Time period during which the applicability or inapplicability needs to be considered</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicableStateValues -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicableStateValues">
<InformationModel_v1:hasOrigin>SapSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>applicableStateValues</rdf:label>
<rdfs:comment>A list of possible states that a ServiceAccessPoint may take on.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicationDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_applicationDuration">
<InformationModel_v1:hasOrigin>ProdOfferPriceAlteration</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>applicationDuration</rdf:label>
<rdfs:comment>Specifies for a ProductOfferingPriceAlteration that impacts recurring ProductOfferingPrice the duration of application. For example, the ProductOfferingPriceAlteration may apply 10% discount only during 6 months.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_appliedAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_appliedAmount">
<InformationModel_v1:hasOrigin>CustomerPaymentItem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>appliedAmount</rdf:label>
<rdfs:comment>The amount of money that has been applied to specific entity, such as CustomerBill.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_appliedDemandAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_appliedDemandAmount">
<InformationModel_v1:hasOrigin>AppliedCapacityDemand</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>appliedDemandAmount</rdf:label>
<rdfs:comment>An amount of demand applied to a CapacityAmount. Note that this is a composite attribute defined by CapacityAmount.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aristocraticTitle -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_aristocraticTitle">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>aristocraticTitle</rdf:label>
<rdfs:comment>A name that describes someone's aristocratic position, such as Baron, Graf, Earl, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_asapRef -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_asapRef">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>asapRef</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_assignedPriority -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_assignedPriority">
<InformationModel_v1:hasOrigin>ProductOrder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>assignedPriority</rdf:label>
<rdfs:comment>The order's assigned priority after review.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_assignedResponsibilityDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_assignedResponsibilityDate">
<InformationModel_v1:hasOrigin>ProductOrder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>assignedResponsibilityDate</rdf:label>
<rdfs:comment>The target response date assigned after review.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_assignmentPurpose -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_assignmentPurpose">
<InformationModel_v1:hasOrigin>CustomerBillingAccountAssignment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>assignmentPurpose</rdf:label>
<rdfs:comment>This attribute indicates why the BillingAccount is related to the FinancialAccount. For example, for taxes, revenue associated with an invoice, bill, or credit memo, payment, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_associationType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_associationType">
<InformationModel_v1:hasOrigin>PartyRoleAssociation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>associationType</rdf:label>
<rdfs:comment>A categorization of the association, such as organizational, household, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_assumptions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_assumptions">
<InformationModel_v1:hasOrigin>Project</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>assumptions</rdf:label>
<rdfs:comment>Assumptions made when defining the Project (especially assumptions for success)</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_attachedOnDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_attachedOnDateTime">
<InformationModel_v1:hasOrigin>Attachment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>attachedOnDateTime</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_attackVector -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_attackVector">
<InformationModel_v1:hasOrigin>SecurityIncidentAttackMethod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>attackVector</rdf:label>
<rdfs:comment>Attack method chosen from the following enumerated list:  Exploited New Vulnerability Exploited Known Vulnerability Self Propagating Malicious Logic Insider Purposeful Insider Accidental Distributed Network Activity Non Distributed Network Activity Network Scan System Scan Compromise Through Another System Reconnaissance Unknown/NA Other (See Comment)</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_attribute1 -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_attribute1">
<InformationModel_v1:hasOrigin>CharacteristicSpecValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>attribute1</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_audibleAlarm -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_audibleAlarm">
<InformationModel_v1:hasOrigin>SecureHolder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>audibleAlarm</rdf:label>
<rdfs:comment>This is a boolean attribute that, if TRUE, indicates that this SecureHolder is equipped with an audible alarm. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_audibleAlarmDescription -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_audibleAlarmDescription">
<InformationModel_v1:hasOrigin>SecureHolder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>audibleAlarmDescription</rdf:label>
<rdfs:comment>This is a free-form string that provides supplementary information for the AudibleAlarm attribute. It should only be filled in when the value of the AudibleAlarm attribute is TRUE. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_authenticationLevel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_authenticationLevel">
<InformationModel_v1:hasOrigin>CommunicationInteractionRole</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>authenticationLevel</rdf:label>
<rdfs:comment>A CommunicationInteractionRole's authenticationLevel specifies the level of authentication of the PartyRole or ResourceRole. It may impact what the interactor has the right to ask for.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_authenticationType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_authenticationType">
<InformationModel_v1:hasOrigin>APISpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>authenticationType</rdf:label>
<rdfs:comment>The authentication type like OAUTH, SSL used for this API</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_availability -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_availability">
<InformationModel_v1:hasOrigin>SecurityIncidentImpactLevel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>availability</rdf:label>
<rdfs:comment>A loss of availability is the disruption of access to or use of information or an information system.  Enumerated value indicating the impact to availability due to the Security Incident:   Low - The loss of confidentiality, integrity, or availability could be expected to have a limited adverse effect on organizational operations, organizational assets, or individuals.  A limited adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a degradation in mission capability to an extent and duration that the organization is able to perform its primary functions, but the effectiveness of the functions is noticeably reduced; (ii) result in minor damage to organizational assets; (iii) result in minor financial loss; or (iv) result in minor harm to individuals   Moderate - The loss of confidentiality, integrity, or availability could be expected to have a serious adverse effect on organizational operations, organizational assets, or individuals.  A serious adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a significant degradation in mission capability to an extent and duration that the organization is able to perform its primary functions, but the effectiveness of the functions is significantly reduced; (ii) result in significant damage to organizational assets; (iii) result in significant financial loss; or (iv) result in significant harm to individuals that does not involve loss of life or serious life threatening injuries.   High - The loss of confidentiality, integrity, or availability could be expected to have a severe or catastrophic adverse effect on organizational operations, organizational assets, or individuals.  A severe or catastrophic adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a severe degradation in or loss of mission capability to an extent and duration that the organization is not able to perform one or more of its primary functions; (ii) result in major damage to organizational assets; (iii) result in major financial loss; or (iv) result in severe or catastrophic harm to individuals involving loss of life or serious life threatening injuries.   Source:  FIPS 199.  http://csrc.nist.gov/publications/fips/fips199/FIPS-PUB-199-final.pdf</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_averagePay -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_averagePay">
<InformationModel_v1:hasOrigin>PayRange</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>averagePay</rdf:label>
<rdfs:comment>Mid point for this Pay Range. This will be defined at global alignment. This field will define the middle point of an amount an employee can get paid that sit in a particular pay range. </rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_backedUpStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_backedUpStatus">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>backedUpStatus</rdf:label>
<rdfs:comment>Indicates if the Managed Object (related to this alarm) has a back up or has been backed up.   This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_backgroundColor -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_backgroundColor">
<InformationModel_v1:hasOrigin>SurfaceSymbology</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>backgroundColor</rdf:label>
<rdfs:comment>A quality such as red, blue, green, yellow, and so forth, for the background of the surface.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_backlogItemNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_backlogItemNr">
<InformationModel_v1:hasOrigin>SCRUM_BacklogItem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>backlogItemNr</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_backplaneIndependent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_backplaneIndependent">
<InformationModel_v1:hasOrigin>PhysicalDevice</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>backplaneIndependent</rdf:label>
<rdfs:comment>This is a boolean attribute that, if TRUE, indicates that this ManagedDevice has independent backplanes that can be managed separately. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_backplaneNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_backplaneNumber">
<InformationModel_v1:hasOrigin>PhysicalDevice</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>backplaneNumber</rdf:label>
<rdfs:comment>This is an integer that defines the number of backplanes that this device has. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_balanceClass -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_balanceClass">
<InformationModel_v1:hasOrigin>AccountBalanceType</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>balanceClass</rdf:label>
<rdfs:comment>Class of the BillingAccountBalance, such as prepayment, deposit, bonus.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bankAccountNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bankAccountNumber">
<InformationModel_v1:hasOrigin>BankAccount</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>bankAccountNumber</rdf:label>
<rdfs:comment>The bank account according to the accountType.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bankCardType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bankCardType">
<InformationModel_v1:hasOrigin>BankCardPM</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>bankCardType</rdf:label>
<rdfs:comment>The type of the BankCard, such as VISA, MasterCard, UnionPay.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bankCode -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bankCode">
<InformationModel_v1:hasOrigin>Bank</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>bankCode</rdf:label>
<rdfs:comment>The bank code according to the bankCodeType.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bankCodeType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bankCodeType">
<InformationModel_v1:hasOrigin>Bank</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>bankCodeType</rdf:label>
<rdfs:comment>The type of bank code, for example BIC(Bank Identifier Code).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bankName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bankName">
<InformationModel_v1:hasOrigin>Bank</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>bankName</rdf:label>
<rdfs:comment>The name of the bank.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_baseDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_baseDuration">
<InformationModel_v1:hasOrigin>ScheduledDuration</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>baseDuration</rdf:label>
<rdfs:comment>The expected duration of a job (amount and units).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_BCWP -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_BCWP">
<InformationModel_v1:hasOrigin>ProjectElement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>BCWP</rdf:label>
<rdfs:comment>Budgeted Cost of Work Performed</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_BCWS -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_BCWS">
<InformationModel_v1:hasOrigin>ProjectElement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>BCWS</rdf:label>
<rdfs:comment>Budgeted Cost of Work Scheduled</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billDate">
<InformationModel_v1:hasOrigin>OffCyclePartyBill</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>billDate</rdf:label>
<rdfs:comment>The official date of the bill</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billedBy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billedBy">
<InformationModel_v1:hasOrigin>PartyRoleProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>billedBy</rdf:label>
<rdfs:comment>An indicator that specifies that the associated PartyRole submits a bill for the ProductOffering.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billingDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billingDate">
<InformationModel_v1:hasOrigin>PartyBillingCycle</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>billingDate</rdf:label>
<rdfs:comment>Official date at which the PartyBills have been produced.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billingDateShift -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billingDateShift">
<InformationModel_v1:hasOrigin>PartyBillingCycleSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>billingDateShift</rdf:label>
<rdfs:comment>An offset of a billing date. The offset is expressed as number of days with regard to the start of the BillingPeriod.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billingID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billingID">
<InformationModel_v1:hasOrigin>BillingCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>billingID</rdf:label>
<rdfs:comment>The billing instance identifier for this capability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billingTemplateID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billingTemplateID">
<InformationModel_v1:hasOrigin>BillingCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>billingTemplateID</rdf:label>
<rdfs:comment>The unique identifier of the billing template to be used for billing an offer.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billingType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billingType">
<InformationModel_v1:hasOrigin>BillingCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>billingType</rdf:label>
<rdfs:comment>The billing type determines how a billing capability recognize revenue for a given offer</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billNo -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_billNo">
<InformationModel_v1:hasOrigin>PartyBill</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>billNo</rdf:label>
<rdfs:comment>A user friendly identification number of a bill.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bookedQuantity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bookedQuantity">
<InformationModel_v1:hasOrigin>StockItemStockLevel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>bookedQuantity</rdf:label>
<rdfs:comment>/bookedQuantity corresponds to the result of a calculation. It is calculated adding all quantity booked through related StockItemRequests still valid.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_border -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_border">
<InformationModel_v1:hasOrigin>SurfaceSymbology</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>border</rdf:label>
<rdfs:comment>The edge or boundary of a surface.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_boxNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_boxNr">
<InformationModel_v1:hasOrigin>PoBoxAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>boxNr</rdf:label>
<rdfs:comment>A number or text that represents a post office box number.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_boxType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_boxType">
<InformationModel_v1:hasOrigin>PoBoxAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>boxType</rdf:label>
<rdfs:comment>The kind of box number.  For example one at a post office or other location authorized to maintain postal boxes.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_brand -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_brand">
<InformationModel_v1:hasOrigin>ProductSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>brand</rdf:label>
<rdfs:comment>The manufacturer or trademark of the specification.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_brokerCommMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_brokerCommMethod">
<InformationModel_v1:hasOrigin>BrokerCoordinationDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>brokerCommMethod</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the communication method used between the PolicyBroker and the PolicyServers that it coordinates the actions of. Values include: 0: Not yet established 1: Telnet 2: COPS 3: Proprietary Protocol</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_brokerCoordinationTimePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_brokerCoordinationTimePeriod">
<InformationModel_v1:hasOrigin>BrokerCoordinationDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>brokerCoordinationTimePeriod</rdf:label>
<rdfs:comment>This attribute defines the start and end times (in the form of time stamps) in which this PolicyBroker has the authority to coordinate the actions of this PolicyServer.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_budget -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_budget">
<InformationModel_v1:hasOrigin>WorksProgram</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>budget</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_buildingName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_buildingName">
<InformationModel_v1:hasOrigin>UrbanPropertySubAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>buildingName</rdf:label>
<rdfs:comment>A well known name for a building. Notes: e.g. Telstra house, Parliament house</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_buildNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_buildNumber">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>buildNumber</rdf:label>
<rdfs:comment>This is a string attribute that defines the internal identifier for the compilation of this unit of a SoftwareResourceSpecification.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bundleSpecValidFor -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_bundleSpecValidFor">
<InformationModel_v1:hasOrigin>ServicePackageBundleDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>bundleSpecValidFor</rdf:label>
<rdfs:comment>This attribute defines a time period in which the use of this particular ServiceBundleSpec is allowed for implementing the associated ServicePackageSpec. The TimePeriod attribute is a complex data type consisting of a TimeStamp to mark the beginning of the TimePeriod and a TimeStamp to mark the end of the TimePeriod.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessDriverImpact -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessDriverImpact">
<InformationModel_v1:hasOrigin>MetDefBusinessValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>businessDriverImpact</rdf:label>
<rdfs:comment>A textual description of the impact to the business if the metric lags.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessDriverPriority -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessDriverPriority">
<InformationModel_v1:hasOrigin>MetDefBusinessValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>businessDriverPriority</rdf:label>
<rdfs:comment>A textual description of how important this metric is to the business.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessDriverValue -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessDriverValue">
<InformationModel_v1:hasOrigin>MetDefBusinessValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>businessDriverValue</rdf:label>
<rdfs:comment>A textual description of business drivers, such as revenue benefit, cost benefit, efficiency, customer experience, time to market, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessInteractionRevisionDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessInteractionRevisionDate">
<InformationModel_v1:hasOrigin>BusinessInteractionVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>businessInteractionRevisionDate</rdf:label>
<rdfs:comment>The date of the revision.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessInteractionRevisionDescription -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessInteractionRevisionDescription">
<InformationModel_v1:hasOrigin>BusinessInteractionVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>businessInteractionRevisionDescription</rdf:label>
<rdfs:comment>Text that explains the revision, including why the revision was made.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessInteractionRevisionNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessInteractionRevisionNumber">
<InformationModel_v1:hasOrigin>BusinessInteractionVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>businessInteractionRevisionNumber</rdf:label>
<rdfs:comment>A unique number that identifies the revision.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessInteractionRevisionType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_businessInteractionRevisionType">
<InformationModel_v1:hasOrigin>BusinessInteractionVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>businessInteractionRevisionType</rdf:label>
<rdfs:comment>The significance of the revision, such as major or minor. Permitted Values: Major, Minor</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cableManagementStrategy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cableManagementStrategy">
<InformationModel_v1:hasOrigin>HolderComposite</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>cableManagementStrategy</rdf:label>
<rdfs:comment>This is a free-form string that contains information on how the various cables contained in the Chassis, Rack, or other type of HolderComposite object are connected and bundled. This property contains information to aid in the assembly and service of the cables contained in a SecureHolder object. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cableType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cableType">
<InformationModel_v1:hasOrigin>PhysicalConnector</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>cableType</rdf:label>
<rdfs:comment>This is an enumerated integer, and defines the particular type of cable that is attached to this connector. Values include:  0: Unknown  1: RS-232  2: RS-422  3: RS-423  4: RS-449  5: RS-485  6: RS-530  7: V.35  8: X.21  9: 9 um single-mode  10: 62.5/125 um multi-mode  11: USB  to be continued, not done!  This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_calculationFrequency -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_calculationFrequency">
<InformationModel_v1:hasOrigin>RevenueAssuranceParameter</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>calculationFrequency</rdf:label>
<rdfs:comment>The rate of occurrence that a value for a parameter is determined. For example, hourly, daily, weekly.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_calendricalSystem -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_calendricalSystem">
<InformationModel_v1:hasOrigin>Calendar</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>calendricalSystem</rdf:label>
<rdfs:comment>The default calendrical system for the Calendar  Note:  CALSCALE [iCalendar]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_callDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_callDuration">
<InformationModel_v1:hasOrigin>VoiceCallUsage</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>callDuration</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_callType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_callType">
<InformationModel_v1:hasOrigin>VoiceCallUsage</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>callType</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_canBeOverridden -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_canBeOverridden">
<InformationModel_v1:hasOrigin>EntitySpecCharUse</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>canBeOverridden</rdf:label>
<rdfs:comment>An indicator that specifies that the CharacteristicSpecValues associated with the CharacteristicSpec cannot be changed when instantiating a CharacteristicValue. For example, a bandwidth of 64 MB cannot be changed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_canMixPower -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_canMixPower">
<InformationModel_v1:hasOrigin>PhysicalDevice</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>canMixPower</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, means that AC and/or DC power supplies can be used in this device. If it is false, then only one or the other can be used.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capabilityType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capabilityType">
<InformationModel_v1:hasOrigin>ExternalSystemCapability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>capabilityType</rdf:label>
<rdfs:comment>Capability type like policy, charging and so on.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityAmount">
<InformationModel_v1:hasOrigin>CapacityAmount</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>capacityAmount</rdf:label>
<rdfs:comment>A value and units that define the CapacityAmount, such as 10000 ea, 10B Mb. Instance values are mutually exclusive with From and To capacityAmounts and range interval.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityAmountFrom -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityAmountFrom">
<InformationModel_v1:hasOrigin>CapacityAmount</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>capacityAmountFrom</rdf:label>
<rdfs:comment>The low range value that a CapacityAmount can take on.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityAmountTo -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityAmountTo">
<InformationModel_v1:hasOrigin>CapacityAmount</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>capacityAmountTo</rdf:label>
<rdfs:comment>The upper range value that a CapacityAmount can take on.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityDemandAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityDemandAmount">
<InformationModel_v1:hasOrigin>CapacityDemand</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>capacityDemandAmount</rdf:label>
<rdfs:comment>A value and units that define the CapacityDemand, such as 10000 ea, 10B Mb.  Instance values are mutually exclusive with From and To capacityDemandAmounts and range interval.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityDemandAmountFrom -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityDemandAmountFrom">
<InformationModel_v1:hasOrigin>CapacityDemand</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>capacityDemandAmountFrom</rdf:label>
<rdfs:comment>The low range value that a CapacityDemand can take on.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityDemandAmountTo -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityDemandAmountTo">
<InformationModel_v1:hasOrigin>CapacityDemand</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>capacityDemandAmountTo</rdf:label>
<rdfs:comment>The upper range value that a CapacityDemand can take on.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityDemandType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capacityDemandType">
<InformationModel_v1:hasOrigin>CapacityDemand</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>capacityDemandType</rdf:label>
<rdfs:comment>An indicator that specifies whether the capacity demand is planned, actual or required by.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capDemandRelType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capDemandRelType">
<InformationModel_v1:hasOrigin>CapacityDemandRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>capDemandRelType</rdf:label>
<rdfs:comment>A categorization of the relationship, such as aggregation, used to calculate.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capitalCostRate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capitalCostRate">
<InformationModel_v1:hasOrigin>Cost</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>capitalCostRate</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capRelType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capRelType">
<InformationModel_v1:hasOrigin>CapacityRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>capRelType</rdf:label>
<rdfs:comment>A categorization of the relationship, such as aggregation, used to calculate.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_captureFrequency -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_captureFrequency">
<InformationModel_v1:hasOrigin>MetricDefMeasure</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>captureFrequency</rdf:label>
<rdfs:comment>The frequency of capture for the MetricDefMeasure.  Note:  This may be replaced by a set of entities similar to the Performance Monitoring ABEs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_captureMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_captureMethod">
<InformationModel_v1:hasOrigin>MetricDefMeasure</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>captureMethod</rdf:label>
<rdfs:comment>The method used to capture the Metrics associated with a MetricDefMeasure.    Note:  This may be replaced by a set of entities similar to the Performance Monitoring ABEs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capturePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_capturePeriod">
<InformationModel_v1:hasOrigin>MetricDefMeasure</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>capturePeriod</rdf:label>
<rdfs:comment>The period during which Metrics associated with a MetricDefMeasure are captured.    Note:  This may be replaced by a set of entities similar to the Performance Monitoring ABEs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cardCompatibilityResults -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cardCompatibilityResults">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>cardCompatibilityResults</rdf:label>
<rdfs:comment>This is an attribute that is used to store the result of the negotiation process between a Card and its EquipmentHolder to see if they are compatible. This is the result of the isCompatible() method, with the Card being the source and the EquipmentHolder being the target, translated into a textual description.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cardNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cardNr">
<InformationModel_v1:hasOrigin>NationalIdentityCardIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>cardNr</rdf:label>
<rdfs:comment>A number assigned to a NationalIdentityCard used to identify it.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cardNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cardNumber">
<InformationModel_v1:hasOrigin>BankCardPM</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>cardNumber</rdf:label>
<rdfs:comment>The identification number of a bank card.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_carrierShipmentID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_carrierShipmentID">
<InformationModel_v1:hasOrigin>ShipmentTracking</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>carrierShipmentID</rdf:label>
<rdfs:comment>Identifier used to communicate with the Carrier in charge of the corresponding StockItemShipment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_carrierTrackingUrl -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_carrierTrackingUrl">
<InformationModel_v1:hasOrigin>ShipmentTracking</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>carrierTrackingUrl</rdf:label>
<rdfs:comment>Url given by the Carrier in charge of the corresponding StockItemShipment to follow the shipment</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cashierInfo -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cashierInfo">
<InformationModel_v1:hasOrigin>CashPM</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>cashierInfo</rdf:label>
<rdfs:comment>A description of the employee who received the cash for payment</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_category -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_category">
<InformationModel_v1:hasOrigin>MarketSegment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>category</rdf:label>
<rdfs:comment>A classification of MarketSegments because they share common characteristics. For example a vertical or horizontal MarketSegment. Vertical MarketSegments put a PartyRole in a single segment, while a PartyRole can exist in multiple horizontal MarketSegments</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cceName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cceName">
<InformationModel_v1:hasOrigin>SecurityVulnerability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>cceName</rdf:label>
<rdfs:comment>Unique identifier to system configuration issues in order to facilitate fast and accurate correlation of configuration data across multiple information sources and tools.  The cceName represents a configuration that makes a resource vulnerable.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_certificateNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_certificateNr">
<InformationModel_v1:hasOrigin>BirthCertificateIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>certificateNr</rdf:label>
<rdfs:comment>A number assigned birth certificate used to identify it.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chargeableQuantity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chargeableQuantity">
<InformationModel_v1:hasOrigin>PublicWANAccessUsageEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>chargeableQuantity</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chargeableUnit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chargeableUnit">
<InformationModel_v1:hasOrigin>PublicWANAccessUsageEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>chargeableUnit</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chargeDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chargeDate">
<InformationModel_v1:hasOrigin>OffCyclePartyBill</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>chargeDate</rdf:label>
<rdfs:comment>A date through which charges previously received by the billing system appear on the bill.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chargeDateOffset -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chargeDateOffset">
<InformationModel_v1:hasOrigin>PartyBillingCycleSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>chargeDateOffset</rdf:label>
<rdfs:comment>An offset of a date through which charges previously received by the billing system will appear on the bill. The offset is expressed as number of days with regard to the start of the BillingPeriod.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chargeType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chargeType">
<InformationModel_v1:hasOrigin>ChargingCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>chargeType</rdf:label>
<rdfs:comment>The type of charge like OneTime, Usage, Recurring applied to an offer</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_charIsAnExplicitAttribute -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_charIsAnExplicitAttribute">
<InformationModel_v1:hasOrigin>ConfigSpecCharUse</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>charIsAnExplicitAttribute</rdf:label>
<rdfs:comment>An indicator that specifies the use of a CharacteristicSpecification is used to assign a value to an explicitly modeled attribute of an entity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_charRelationshipType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_charRelationshipType">
<InformationModel_v1:hasOrigin>EntitySpecCharUseRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>charRelationshipType</rdf:label>
<rdfs:comment>A categorization of the relationship, such as aggregation, migration, substitution, dependency, exclusivity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_charSpecSeq -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_charSpecSeq">
<InformationModel_v1:hasOrigin>EntitySpecCharUseRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>charSpecSeq</rdf:label>
<rdfs:comment>The order in which a CharacteristicSpecification appears within another CharacteristicSpecification that defines a grouping of CharacteristicSpecifications. For example, a grouping may represent the name of an individual. The given name is first, the middle name is second, and the last name is third. The order in which a CharacteristicSpecification appears within another CharacteristicSpecification that defines a grouping of CharacteristicSpecifications.  For example, a grouping may represent the name of an individual. The given name is first, the middle name is second, and the last name is third.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_charValueRelationshipType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_charValueRelationshipType">
<InformationModel_v1:hasOrigin>EntitySpecCharValueUseRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>charValueRelationshipType</rdf:label>
<rdfs:comment>A categorization of the relationship between values, such as aggregation, migration, substitution, dependency, exclusivity.A categorization of the relationship, such as aggregation, migration, substitution, dependency, exclusivity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chassisType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_chassisType">
<InformationModel_v1:hasOrigin>Chassis</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>chassisType</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the type of Chassis that this object is. Values include: 0: Unknown 1: Desktop 2: Low Profile Desktop 3: Pizza Box 4: Mini Tower 5: Tower 6: Portable 7: LapTop 8: Notebook 9: Sub-Notebook 10: Hand Held 11: Docking Station 12: Main System Chassis 13: Expansion Chassis 14: Bus Expansion Chassis 15: Peripheral Chassis 16: Storage Chassis 17: Rack Mount Chassis  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_checkID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_checkID">
<InformationModel_v1:hasOrigin>CheckPM</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>checkID</rdf:label>
<rdfs:comment>The external identification number of a check specified by the Bank.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ciSource -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ciSource">
<InformationModel_v1:hasOrigin>CompetitorIntelligencePartyRole</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>ciSource</rdf:label>
<rdfs:comment>The origin of the CompetitorIntelligence, such as a financial report, press release, or product brochure, gathered by a PartyRole.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_classification -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_classification">
<InformationModel_v1:hasOrigin>MarketStatistic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>classification</rdf:label>
<rdfs:comment>A specification of what the MarketStatistic represents, for example a ProductProgram, ProductPromotion, ProductOffering, Branch, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_className -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_className">
<InformationModel_v1:hasOrigin>PublicWANAccessUsageEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>className</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_clearStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_clearStatus">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>clearStatus</rdf:label>
<rdfs:comment>Clear status of the problem.  Clearance of the resource RC alarm or of the underlying alarms or problems does not imply clearance of the problem.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_clearSystemId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_clearSystemId">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>clearSystemId</rdf:label>
<rdfs:comment>Provides the id of the system where the user who invoked the clearResourceAlarm operation is located. This might be different from the alarm-owning system.   Note that the automatic AVC notification generation is disabled for this attribute as a specific notification is generated for alarm clearance.    This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_clearUserId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_clearUserId">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>clearUserId</rdf:label>
<rdfs:comment>Provides the id of the user who invoked the clearResourceAlarm operation.  Note that the automatic AVC notification generation is disabled for this attribute as a specific notification is generated for alarm clearance.    This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_clientMACAddress -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_clientMACAddress">
<InformationModel_v1:hasOrigin>DHCPSecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>clientMACAddress</rdf:label>
<rdfs:comment>The Media Access Control (MAC) address that was assigned an IP address during this DHCP event.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_closeDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_closeDate">
<InformationModel_v1:hasOrigin>CloseCustomerProblemSummary</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>closeDate</rdf:label>
<rdfs:comment>The date in which the CustomerProblem was closed</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_code -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_code">
<InformationModel_v1:hasOrigin>Currency</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>code</rdf:label>
<rdfs:comment>Represents the code of the currency in the usage for convenience. Generally it is made up of three capital English letters, the first two of which represent the country and the last of which represents the name of the currency. For example, USD represents United State of America Dollar. Usually ISO 4217 is used.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_codeModel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_codeModel">
<InformationModel_v1:hasOrigin>StockItem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>codeModel</rdf:label>
<rdfs:comment>The codeModel specifies the type of codification used for the stockItemCode.  Two main types exist: EAN (European Article Numbering) or GTIN (Global Trade Item Numbering). A GTIN consists of a GS1 Company Prefix, an Item Reference Number and a Check Digit.   Each of them is further defined by the length of the number such as EAN 13, GTIN-12 (USA / Canada for individual products), GTIN-13 (Rest of World for Individual products), GTIN-14 (Worldwide for Product groupings).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_collectionPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_collectionPeriod">
<InformationModel_v1:hasOrigin>AdhocCollection</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>collectionPeriod</rdf:label>
<rdfs:comment>The time range of the requested Performance Indicators.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_collectionType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_collectionType">
<InformationModel_v1:hasOrigin>MetricDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>collectionType</rdf:label>
<rdfs:comment>The type of the collection such as: gauge, commulative, status inspection. Indicators can be produced using these methods.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_color -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_color">
<InformationModel_v1:hasOrigin>Symbology</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>color</rdf:label>
<rdfs:comment>A quality such as red, blue, green, yellow, and so forth, that is seen when looking at something.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_comment -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_comment">
<InformationModel_v1:hasOrigin>CalendarEntry</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>comment</rdf:label>
<rdfs:comment>Comment text about the entry Note: COMMENT [iCalendar]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_comments -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_comments">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>comments</rdf:label>
<rdfs:comment>Comments on problem, as a list of comments.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_completionEvent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_completionEvent">
<InformationModel_v1:hasOrigin>ClosedLoopActivitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>completionEvent</rdf:label>
<rdfs:comment>A happening that trigger to completion of the activity. </rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_compositionType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_compositionType">
<InformationModel_v1:hasOrigin>CompositeCriterionCondition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>compositionType</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conditionIsCNF -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conditionIsCNF">
<InformationModel_v1:hasOrigin>PolicyConditionComposite</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>conditionIsCNF</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, defines the condition clause of this PolicyConditionComposite object to be represented in Conjunctive Normal Form (e.g., an And of Ors). If the value of this attribute is FALSE, then the condition clause will be represented in Disjunctive Normal Form. This attribute controls the setting of how multiple condition clauses (as represented by individual PolicyConditionAtomic objects) are treated in the PolicyConditionComposite object. As such, it is different from the attribute PolicyRule.IsCNF, which controls how multiple PolicyConditionComposite objects are treated in a PolicyRule object. Notes: Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conditionResponse -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conditionResponse">
<InformationModel_v1:hasOrigin>PolicyConditionVendor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>conditionResponse</rdf:label>
<rdfs:comment>This is a Boolean attribute that is used to allow a 'standard' definition of a TRUE/FALSE response to be made by an external system attached to the model at this point. This will allow integration with a generalized policy processing engine. Notes: Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conditionSequenceNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conditionSequenceNumber">
<InformationModel_v1:hasOrigin>PolicyConditionAtomic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>conditionSequenceNumber</rdf:label>
<rdfs:comment>This attribute is a non-negative integer and represents the particular sequence in which this element is parsed as part of the overall policy structure. This will allow a policy engine to reference externally supplied arguments to this object as it is evaluated.  Notes: Not present in the ITU specs. CIM 2.7 has a subset of these values</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conditionType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conditionType">
<InformationModel_v1:hasOrigin>PolicyConditionVendor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>conditionType</rdf:label>
<rdfs:comment>This is a free-form string that can be used to define the type of condition that this instance is checking. Notes: Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_confidentiality -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_confidentiality">
<InformationModel_v1:hasOrigin>SecurityIncidentImpactLevel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>confidentiality</rdf:label>
<rdfs:comment>A loss of confidentiality is the unauthorized disclosure of information.  Enumerated value indicating the impact to confidentiality due to the Security Incident:   Low - The loss of confidentiality, integrity, or availability could be expected to have a limited adverse effect on organizational operations, organizational assets, or individuals.  A limited adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a degradation in mission capability to an extent and duration that the organization is able to perform its primary functions, but the effectiveness of the functions is noticeably reduced; (ii) result in minor damage to organizational assets; (iii) result in minor financial loss; or (iv) result in minor harm to individuals   Moderate - The loss of confidentiality, integrity, or availability could be expected to have a serious adverse effect on organizational operations, organizational assets, or individuals.  A serious adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a significant degradation in mission capability to an extent and duration that the organization is able to perform its primary functions, but the effectiveness of the functions is significantly reduced; (ii) result in significant damage to organizational assets; (iii) result in significant financial loss; or (iv) result in significant harm to individuals that does not involve loss of life or serious life threatening injuries.   High - The loss of confidentiality, integrity, or availability could be expected to have a severe or catastrophic adverse effect on organizational operations, organizational assets, or individuals.  A severe or catastrophic adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a severe degradation in or loss of mission capability to an extent and duration that the organization is not able to perform one or more of its primary functions; (ii) result in major damage to organizational assets; (iii) result in major financial loss; or (iv) result in severe or catastrophic harm to individuals involving loss of life or serious life threatening injuries.   Source:  FIPS 199.  http://csrc.nist.gov/publications/fips/fips199/FIPS-PUB-199-final.pdf</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configAction -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configAction">
<InformationModel_v1:hasOrigin>CompAtomicConfigSpecRel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>configAction</rdf:label>
<rdfs:comment>A prescribed action that is taken for a ConfigurationSpecification that is part of a group (composite).  For example, "assign" a connection termination point to a connection.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configId">
<InformationModel_v1:hasOrigin>IPDRSPData</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>configId</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configQuantity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configQuantity">
<InformationModel_v1:hasOrigin>CompAtomicConfigSpecRel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>configQuantity</rdf:label>
<rdfs:comment>A number that represents how many of a related ConfigurationSpecification in a group (composite) are to be configured.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configSequence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configSequence">
<InformationModel_v1:hasOrigin>CompAtomicConfigSpecRel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>configSequence</rdf:label>
<rdfs:comment>The order in which a related ConfigurationSpecification that is part of a group (composite) is to be configured.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configSpecRelationshipType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configSpecRelationshipType">
<InformationModel_v1:hasOrigin>ConfigSpecRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>configSpecRelationshipType</rdf:label>
<rdfs:comment>A categorization of the relationship between two ConfigurationSpecifications, such as aggregation, migration, substitution, dependency, exclusivity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configurationOrder -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_configurationOrder">
<InformationModel_v1:hasOrigin>PhysicalDevice</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>configurationOrder</rdf:label>
<rdfs:comment>This is a free-form string that provides any order-specific instructions for configuring the set of components that together constitute this PhysicalDevice. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceComparator -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceComparator">
<InformationModel_v1:hasOrigin>ServiceLevelObjective</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>conformanceComparator</rdf:label>
<rdfs:comment>An operator that specifies whether a ServiceLevelObjective is violated above or below the conformanceTarget.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceComparatorLower -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceComparatorLower">
<InformationModel_v1:hasOrigin>AnomalyThresholdRule</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>conformanceComparatorLower</rdf:label>
<rdfs:comment>An operator that when applied on a value specifies whether a threshold is crossed or ceased to be crossed. This operator is used to compare with the conformanceTargetLower.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceComparatorUpper -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceComparatorUpper">
<InformationModel_v1:hasOrigin>AnomalyThresholdRule</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>conformanceComparatorUpper</rdf:label>
<rdfs:comment>An operator that when applied on a value specifies whether a threshold is crossed or ceased to be crossed. This operator is used to compare with the conformanceTargetUpper.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformancePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformancePeriod">
<InformationModel_v1:hasOrigin>ServiceLevelObjective</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>conformancePeriod</rdf:label>
<rdfs:comment>An interval of time during which the conformanceTarget must be measured.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceTarget -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceTarget">
<InformationModel_v1:hasOrigin>ServiceLevelObjective</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>conformanceTarget</rdf:label>
<rdfs:comment>A value used to determine if ServiceLevelObjective is met.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceTargetLower -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceTargetLower">
<InformationModel_v1:hasOrigin>AnomalyThresholdRule</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>conformanceTargetLower</rdf:label>
<rdfs:comment>A value used to determine if the threshold is crossed or ceases to be crossed. It represents the Lower limit. The value should be less than the conformanceTargetUpper. The conformance comparators should also be logically defined so as to not lead to a logically impossible condition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceTargetUpper -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conformanceTargetUpper">
<InformationModel_v1:hasOrigin>AnomalyThresholdRule</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>conformanceTargetUpper</rdf:label>
<rdfs:comment>A value used to determine if the threshold is crossed or ceases to be crossed. It represents the Upper limit. The value should be greater than the conformanceTargetLower. The conformance comparators should also be logically defined so as to not lead to a logically impossible condition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_connectionSetupType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_connectionSetupType">
<InformationModel_v1:hasOrigin>FreControlPlane</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>connectionSetupType</rdf:label>
<rdfs:comment>This attribute identifies the setup type of the FRE. It indicates whether the FRE has been established by UNI signalling (SC) or NMS operation (SPC, PC).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_connectorName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_connectorName">
<InformationModel_v1:hasOrigin>CardOnCardDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>connectorName</rdf:label>
<rdfs:comment>This attribute is an object reference to the PhysicalConnector of the hosting Card that this DaughterCard plugs into. This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_constraintData -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_constraintData">
<InformationModel_v1:hasOrigin>PolicyConditionVendor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>constraintData</rdf:label>
<rdfs:comment>The constraintData attribute is a string that provides a general extension mechanism for representing PolicyConditions that have not been modeled with specific attributes (as specified in this model). The format of this attribute is determined by the OID value stored in the constraintEncoding attribute of this class. The constraintEncoding attribute provides a convenient and simple mechanism by which a Policy Server can determine whether it supports the values stored in an instance of constraintData. If it doesn't recognize any of the OID values in the constraintEncoding attribute, then it will not know how to interpret the data in the corresponding constraintData attributes. The action for the policy decision point to take in case it does not recognize the format of this data could itself be modeled as a PolicyRule, governing the behavior of the Policy Server. Notes: Not present in the ITU specs. The CIM defines a similar attribute called Constraint.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_constraintEncoding -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_constraintEncoding">
<InformationModel_v1:hasOrigin>PolicyConditionVendor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>constraintEncoding</rdf:label>
<rdfs:comment>The constraintEncoding attribute is a string that is used to represent an OID that in turn identifies the encoding and semantics of the constraintData attribute in this instance. Notes: Not present in the ITU specs. The CIM defines a similar attribute called ConstraintEncoding.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_constraints -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_constraints">
<InformationModel_v1:hasOrigin>Project</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>constraints</rdf:label>
<rdfs:comment>Constraints that may affect Project success</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_constraintValue -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_constraintValue">
<InformationModel_v1:hasOrigin>BusinessRuleConstraints</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>constraintValue</rdf:label>
<rdfs:comment>Value that is constraining the business rule</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_consumingApplicationId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_consumingApplicationId">
<InformationModel_v1:hasOrigin>MeasurementJob</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>consumingApplicationId</rdf:label>
<rdfs:comment>The identifier of the application that produces performance  indicators.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_consumptionCapacity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_consumptionCapacity">
<InformationModel_v1:hasOrigin>WorkSpecFulfillmentRate</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>consumptionCapacity</rdf:label>
<rdfs:comment>Workforce capacity that is required by the work to be done for the location, and that the organization can supply. Unit of the value can be man hour, man day, etc</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_consumptionPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_consumptionPeriod">
<InformationModel_v1:hasOrigin>ConsumptionSummary</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>consumptionPeriod</rdf:label>
<rdfs:comment>The consumptionPeriod corresponds to the period where UsageVolumeBalanceCredits and / or UsageVolumeBalanceDebits and / or AppliedCustomerBillingProductUsageRates have been aggregated.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_contactType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_contactType">
<InformationModel_v1:hasOrigin>AccountContact</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>contactType</rdf:label>
<rdfs:comment>Identifies the relationship of the contact to the account, such as primary, secondary, and emergency contact.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_containedActionOrder -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_containedActionOrder">
<InformationModel_v1:hasOrigin>ContainedPolicyActionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>containedActionOrder</rdf:label>
<rdfs:comment>This is an unsigned integer attribute that defines the relative position of this action in relation to the overall sequence of actions that are associated with a given PolicyAction. Smaller integers indicate earlier positions in the sequence. The value "0" has the special semantics of "don't care". This value is not unique. Thus, if two or more attributes have the same value, they may be performed in any order, but they must all be performed at the appropriate place in the overall sequence.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_containedConditionGroupNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_containedConditionGroupNumber">
<InformationModel_v1:hasOrigin>ContainedPolicyConditionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>containedConditionGroupNumber</rdf:label>
<rdfs:comment>This attribute is used to define the group to which the condition is a part of. It corresponds logical to the position of parentheses used to group condition terms together.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_containedConditionIsNegated -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_containedConditionIsNegated">
<InformationModel_v1:hasOrigin>ContainedPolicyConditionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>containedConditionIsNegated</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that this condition term is negated. The default value for this attribute is FALSE.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_content -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_content">
<InformationModel_v1:hasOrigin>Attachment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>content</rdf:label>
<rdfs:comment>The content is the document that is attached.  "link" and "content" attributes are mutually exclusive.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_contractorNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_contractorNr">
<InformationModel_v1:hasOrigin>ContractorIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>contractorNr</rdf:label>
<rdfs:comment>A number assigned to a contractor used to identify it.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conversionFactor -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_conversionFactor">
<InformationModel_v1:hasOrigin>PerformanceSpecIntervalConversion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>conversionFactor</rdf:label>
<rdfs:comment>A value used to convert one time interval to another time interval. For example a value of 12 converts a five minute interval into an hour interval.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_coolingRequirements -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_coolingRequirements">
<InformationModel_v1:hasOrigin>ManagedHardware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>coolingRequirements</rdf:label>
<rdfs:comment>This is a free-form string that specifies the cooling requirements for this ManagedComponents. Specific cooling information is defined by the Cooling association. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cost -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cost">
<InformationModel_v1:hasOrigin>PartyResource</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>cost</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_costToBusiness -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_costToBusiness">
<InformationModel_v1:hasOrigin>ProductSpecificationCost</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>costToBusiness</rdf:label>
<rdfs:comment>The monetary amount that represents the cost.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_count -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_count">
<InformationModel_v1:hasOrigin>IPDRDocEnd</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>count</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_country -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_country">
<InformationModel_v1:hasOrigin>Rack</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>country</rdf:label>
<rdfs:comment>This is the designation of the country for which the Rack is designed. Country code strings are as defined by ISO/IEC 3166. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cpeName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cpeName">
<InformationModel_v1:hasOrigin>CommonPlatformEnumeration</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>cpeName</rdf:label>
<rdfs:comment>A CPE Name is represented by a Well Formed Name (WFN) that is bound to a URI, which provides backward compatability with CPE 2.2,  and a formatted string. For further details on CPE refer to NIST IRs 7695-7698.  Notes: "For example, the following represents a CPE WFN definition of Microsoft Internet Explorer 8.0.6001 Beta:  wfn:[part=""a"",vendor=""microsoft"",product=""internet_explorer"", version=""8\.0\.6001"",update=""beta""].   An example of the formatted string binding is:  cpe:2.3:a:microsoft:internet_explorer:8.0.6001:beta:*:*:*:*:*:* and URI binding is: cpe:/a:microsoft:internet_explorer:8.0.6001:beta."</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creationDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creationDate">
<InformationModel_v1:hasOrigin>CustomerProblemTask</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>creationDate</rdf:label>
<rdfs:comment>The date and time in which the CustomerProblemTask was created</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creationTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creationTime">
<InformationModel_v1:hasOrigin>IPDetailRecord</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>creationTime</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creditDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creditDate">
<InformationModel_v1:hasOrigin>OffCyclePartyBill</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>creditDate</rdf:label>
<rdfs:comment>A date through which credits previously received by the billing system appear on the bill</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creditDateOffset -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creditDateOffset">
<InformationModel_v1:hasOrigin>PartyBillingCycleSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>creditDateOffset</rdf:label>
<rdfs:comment>An offset of a date through which credits previously received by the billing system will appear on the bill. The offset is expressed as number of days with regard to the start of the BillingPeriod.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creditLimit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creditLimit">
<InformationModel_v1:hasOrigin>CustomerBillingAccount</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>creditLimit</rdf:label>
<rdfs:comment>The maximum amount of money that may be charged on an account.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creditRiskRating -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creditRiskRating">
<InformationModel_v1:hasOrigin>PartyCreditProfile</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>creditRiskRating</rdf:label>
<rdfs:comment>This is an integer whose value is used to rate the risk of this Party paying late or defaulting versus paying on time.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creditScore -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_creditScore">
<InformationModel_v1:hasOrigin>PartyCreditProfile</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>creditScore</rdf:label>
<rdfs:comment>A measure of a person?s or organization?s creditworthiness calculated on the basis of a combination of factors such as their income and credit history.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_criticalityLevel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_criticalityLevel">
<InformationModel_v1:hasOrigin>PartyPrivacyProfileTypeCharacteristic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>criticalityLevel</rdf:label>
<rdfs:comment>The criticityLevel specifies a level of criticality for the set of Personal Identifiable Information (PII) defined by RootEntityTypeCharUse.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currencyAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currencyAmount">
<InformationModel_v1:hasOrigin>MarketStatistic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>currencyAmount</rdf:label>
<rdfs:comment>A current amount used to value the MarketStatistic. Mutually exclusive with the amount attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentDuration">
<InformationModel_v1:hasOrigin>ProjectElement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>currentDuration</rdf:label>
<rdfs:comment>The latest expected duration before the actual occurrence</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentLength -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentLength">
<InformationModel_v1:hasOrigin>PhysicalLink</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>currentLength</rdf:label>
<rdfs:comment>This is a string attribute that defines the current length of the PhysicalLink in feet. For some connections, such as wireless connections, this property may not be applicable and should be assigned the special value of NULL. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentNumberLicenses -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentNumberLicenses">
<InformationModel_v1:hasOrigin>PartyRoleSoftwareLicenseDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>currentNumberLicenses</rdf:label>
<rdfs:comment>This attribute defines the current number of licenses that have been allotted for this particular OperatingSystem instance.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentNumberProcesses -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentNumberProcesses">
<InformationModel_v1:hasOrigin>PartyRoleUsesProcessesDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>currentNumberProcesses</rdf:label>
<rdfs:comment>This attribute defines the current number of processes that can be used by this particular PartyRole.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentPortNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentPortNumber">
<InformationModel_v1:hasOrigin>Protocol</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>currentPortNumber</rdf:label>
<rdfs:comment>This is a non-negative integer that defines the port number used by this protocol.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentSalary -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentSalary">
<InformationModel_v1:hasOrigin>ServiceProviderEmployee</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>currentSalary</rdf:label>
<rdfs:comment>The current fixed regular payment, typically paid on a monthly or biweekly basis but often expressed as an annual sum, made by an employer to an employee.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentSpeed -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_currentSpeed">
<InformationModel_v1:hasOrigin>Fan</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>currentSpeed</rdf:label>
<rdfs:comment>This is the current speed of the Fan in revolutions per minute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_customerRank -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_customerRank">
<InformationModel_v1:hasOrigin>Customer</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>customerRank</rdf:label>
<rdfs:comment>The relative importance of this Customer compared to other Customers.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cveName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cveName">
<InformationModel_v1:hasOrigin>SecurityVulnerability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>cveName</rdf:label>
<rdfs:comment>CVE Identifiers (also called "CVE names," "CVE numbers," "CVE-IDs," and "CVEs") are unique, common identifiers for publicly known information security vulnerabilities. CVE identifiers have "entry" or "candidate" status. Entry status indicates that the CVE Identifier has been accepted to the CVE List while candidate status (also called "candidates," "candidate numbers," or "CANs") indicates that the identifier is under review for inclusion in the list.   source:  http://cve.mitre.org</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_CVV -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_CVV">
<InformationModel_v1:hasOrigin>BankCardPM</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>CVV</rdf:label>
<rdfs:comment>The CVV (Card Verification Value) of the bank card.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cweName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cweName">
<InformationModel_v1:hasOrigin>CommonWeaknessEnumeration</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>cweName</rdf:label>
<rdfs:comment>This attribute is for weaknesses realted to the vulnerability.  Comon Weakness Enumerations (CWE).   CWE provides a unified, measurable set of software weaknesses that is enabling more effective discussion, description, selection, and use of software security tools and services that can find these weaknesses in source code and operational systems as well as better understanding and management of software weaknesses related to architecture and design.   Source:  http://cwe.mitre.org/</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cweUsed -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_cweUsed">
<InformationModel_v1:hasOrigin>SecurityThreatTechnique</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>cweUsed</rdf:label>
<rdfs:comment>The weakness used by the technique defined as a Common Weakness Enumeration (CWE).  Http://cwe.mitre.org</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dataFlowDirection -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dataFlowDirection">
<InformationModel_v1:hasOrigin>SignatureSecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>dataFlowDirection</rdf:label>
<rdfs:comment>This indicates the overall flow of data for the connection - inbound implies that more data (bytes) was received by the destination than by the source.  Enumeration values:    inbound   outbound</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dataRecord -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dataRecord">
<InformationModel_v1:hasOrigin>IPDRSPData</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dataRecord</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_datatype -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_datatype">
<InformationModel_v1:hasOrigin>SecVulnerabilityScoringMetricDefn</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>datatype</rdf:label>
<rdfs:comment>A kind of value that the associated SecVulnerabilityScoringMetricValueDefn can take on, such as numeric, text, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dataType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dataType">
<InformationModel_v1:hasOrigin>ComponentEntityIdentificationSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>dataType</rdf:label>
<rdfs:comment>A kind of value that the ComponentEntityIdentificationSpec can take on, such as numeric, text, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_date -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_date">
<InformationModel_v1:hasOrigin>AppliedCustomerBillingRate</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>date</rdf:label>
<rdfs:comment>A date of creation.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateAcquired -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateAcquired">
<InformationModel_v1:hasOrigin>CompetitorIntelligencePartyRole</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dateAcquired</rdf:label>
<rdfs:comment>The date on which the CompetitorIntelligence was gathered by a Party playing a PartyRole.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateComplete -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateComplete">
<InformationModel_v1:hasOrigin>RevenueAssuranceAssessment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dateComplete</rdf:label>
<rdfs:comment>The date on which the RevenueAssuranceAssessment was completed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateCreated -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateCreated">
<InformationModel_v1:hasOrigin>PartyProfile</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dateCreated</rdf:label>
<rdfs:comment>The date that the PartyProfile was created.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateDetermined -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateDetermined">
<InformationModel_v1:hasOrigin>PartyRevenueShare</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>dateDetermined</rdf:label>
<rdfs:comment>The date the revenue share was determined.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateIdentified -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateIdentified">
<InformationModel_v1:hasOrigin>PartyRevShareReconDiscrepancy</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>dateIdentified</rdf:label>
<rdfs:comment>The date the PartyRevShareReconDiscrepancy was identified.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateJoined -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateJoined">
<InformationModel_v1:hasOrigin>CommunityMember</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>dateJoined</rdf:label>
<rdfs:comment>The initial date of committing to the community</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateResolved -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateResolved">
<InformationModel_v1:hasOrigin>PartyRevShareReconDiscrepancy</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>dateResolved</rdf:label>
<rdfs:comment>The date that a PartyRevShareReconDiscrepancy is resolved.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateStarted -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateStarted">
<InformationModel_v1:hasOrigin>RevenueAssuranceAssessment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dateStarted</rdf:label>
<rdfs:comment>The date on which the RevenueAssuranceAssessement was started.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateTime">
<InformationModel_v1:hasOrigin>SecurityIncidentHistory</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>dateTime</rdf:label>
<rdfs:comment>The dateTime a history record was created</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_datum -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_datum">
<InformationModel_v1:hasOrigin>ExchangeLocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>datum</rdf:label>
<rdfs:comment>A single piece of information, such as a fact, statistic, or code, for a ExchangeLocation.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daughterCardInstallStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daughterCardInstallStatus">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>daughterCardInstallStatus</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the current installation status of this Card's daughter Cards. Note that this defines the status of daughter Cards as viewed by the hosting Card. Status values of individual daughter Cards are defined by attributes in the daughter card itself. Values include:  0: Not Applicable (doesn't have any DaughterCards)  1: All Daughter Cards are installed  2: Some Daughter Cards are installed  3: No Daughter Cards are installed</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daughterCardOperatingStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daughterCardOperatingStatus">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>daughterCardOperatingStatus</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the current operating status of this Card's daughter Cards. Note that this defines the operating status of daughter Cards as viewed by the hosting Card. Status values of individual daughter Cards are defined by attributes in the daughter card itself.   This attribute only defines the physical operating characteristics of the daughter card. It does not say whether the daughter Card is functioning correctly, as that is a logical attribute.  Values include:  0: Not Applicable (doesn't have any DaughterCards)  1: All Daughter Cards are operating correctly  2: Some Daughter Cards are operating incorrectly  3: No Daughter Cards are operating correctly</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daughterCardRequirements -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daughterCardRequirements">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>daughterCardRequirements</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the relationship between this Card and all DaughterCards. Values include:  1: No DaughterCard can be attached  2: Requires 1 or more DaughterCards to function correctly  3: Can optionally use 1 or more DaughterCards</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dayOfMonthMask -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dayOfMonthMask">
<InformationModel_v1:hasOrigin>PolicyConditionTimePeriod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dayOfMonthMask</rdf:label>
<rdfs:comment>This is a string attribute that refines the definition of the valid time period that is defined by the timePeriod attribute. This is done by explicitly specifying the days of the month when the policy is valid. These attributes work together, with the timePeriod attribute used to specify the overall time period during which the PolicyRule might be valid, and the dayOfMonthMask attribute used to pick out the specific days of the month within that time period when the PolicyRule is valid. This property is formatted as a fixed string of 64 bits. The first 31 bits correspond to the days of the month counting from the beginning, followed by 31 more bits identifying the days of the month counting from the end, followed by 2 bits that are always set to '0'. For each day, the value '1' indicates that the policy is valid for that day, and the value '0' indicates that it is not valid. The value X'80 00 00 01 00 00 00 00', for example, indicates that a PolicyRule is valid on the first and last days of the month. For months with fewer than 31 days, the digits corresponding to days that the months do not have (counting in both directions) are ignored. The encoding of the 62 significant bits in the octet string matches that used for the schedDay object in the DISMAN-SCHEDULE-MIB. If this attribute is not specified, then the PolicyRule is treated as valid for all days in the months specified by the timePeriod attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dayOfWeek -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dayOfWeek">
<InformationModel_v1:hasOrigin>StandardWorkPeriod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dayOfWeek</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dayOfWeekMask -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dayOfWeekMask">
<InformationModel_v1:hasOrigin>PolicyConditionTimePeriod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>dayOfWeekMask</rdf:label>
<rdfs:comment>This is a string attribute that refines the definition of the valid time period that is defined by the timePeriod attribute. This is done by explicitly specifying the days of the week when the PolicyRule is valid. These attributes work together, with the timePeriod attribute used to specify the overall time period when the policy might be valid, and the DayOfWeekMask used to pick out the specific days of the week in that time period when the PolicyRule is valid. This property is formatted as a fixed length string of 8 bits. The first 7 bits identify the 7 days of the week, beginning with Sunday and ending with Saturday, followed by 1 bit that is always set to '0'. For each day of the week, the value '1' indicates that the PolicyRule is valid for that day, and the value '0' indicates that it is not valid. If this attribute is not specified, then the PolicyRule is treated as valid for all 7 days in the weeks specified by the timePeriod attribute. Notes: Not present in the ITU specs. The CIM defines a similar attribute called DayOfWeekMask.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daysOfMonthRecurrence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daysOfMonthRecurrence">
<InformationModel_v1:hasOrigin>MonthlyScheduleDayOfMonthDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>daysOfMonthRecurrence</rdf:label>
<rdfs:comment>The list of days of month when the monthly schedule definition is active on, e.g. 10th , 15th , 20th.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daysOfWeek -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daysOfWeek">
<InformationModel_v1:hasOrigin>ApplicableTimePeriod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>daysOfWeek</rdf:label>
<rdfs:comment>A day or days representing when the schedule is applicable.  For example 2, 3 represent Monday and Tuesday.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daysOfWeekRecurrence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_daysOfWeekRecurrence">
<InformationModel_v1:hasOrigin>WeeklyScheduleDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>daysOfWeekRecurrence</rdf:label>
<rdfs:comment>The list of days of week when the weekly schedule definition is active on: e.g. Monday, Tuesday, Wednesday.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dcOutputPower -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dcOutputPower">
<InformationModel_v1:hasOrigin>PowerSupply</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dcOutputPower</rdf:label>
<rdfs:comment>This is the maximum value of the output power of the DC PowerSupply. If this is an AC PowerSupply, then this attribute must be set to NULL.  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_decisionStrategy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_decisionStrategy">
<InformationModel_v1:hasOrigin>PolicySetSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>decisionStrategy</rdf:label>
<rdfs:comment>This is an enumerated integer that specifies the particular decision strategy to be used in this PolicySet.  Permitted Values: 0: Unknown 1: MatchFirst 2: MatchAll MatchFirst enforces the actions of the first rule that evaluates to TRUE; policy evaluation then STOPS, meaning that all subsequent rules are no longer evaluated. MatchAll enforces the actions of all rules that evaluate to TRUE. This is equivalent to performing two passes through the rule set. The first pass gathers all PolicyRules that evaluate to true and places them in a group. The second pass then executes only those rules that evaluated to true. Execution of these rules is controlled through the Priority property (on the aggregation PolicySetComponent), which defines the order in which the PolicyRules execute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_defaultNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_defaultNumber">
<InformationModel_v1:hasOrigin>RootEntityRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>defaultNumber</rdf:label>
<rdfs:comment>Default number of instances of RootEntity according to the type of RootEntityRelationship.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_defaultRelOfferNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_defaultRelOfferNumber">
<InformationModel_v1:hasOrigin>BundledProdOfferOption</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>defaultRelOfferNumber</rdf:label>
<rdfs:comment>The default of related ProductOfferings that is used to initialise the number of ProductOffering in an order as part of the BundledProductOffering.  The default number must be consistant with the lower and upper limit. It isn't mandatory to specify it and in this case it is considered a default number 0.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_definesExemption -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_definesExemption">
<InformationModel_v1:hasOrigin>TaxDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>definesExemption</rdf:label>
<rdfs:comment>If TRUE, the TaxDefinition corresponds to a tax exemption that replaces a standard tax if a corresponding TaxExemptionCertificate grants it.  For example, a voluntary organization may be granted a complete exemption from value-added tax, to pay 0% of the standard tax.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_definition -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_definition">
<InformationModel_v1:hasOrigin>SecurityVulnerabilityTool</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>definition</rdf:label>
<rdfs:comment>Defines required signature or policy definition that must be installed on the tool.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_degreeOfCorrelation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_degreeOfCorrelation">
<InformationModel_v1:hasOrigin>CompetitorProductCorrelation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>degreeOfCorrelation</rdf:label>
<rdfs:comment>A percentage that measures how closely an enterprise's ProductOffering compares to a CompetitorProductOffering.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_delimiter -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_delimiter">
<InformationModel_v1:hasOrigin>SecVulnerabilityGeneralMbr</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>delimiter</rdf:label>
<rdfs:comment>A character used to specify the boundary between separate members.  Notes:  For example, ";", ",", ":"</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_delimiterSequence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_delimiterSequence">
<InformationModel_v1:hasOrigin>RootEntityGroupMemberExpression</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>delimiterSequence</rdf:label>
<rdfs:comment>The order in which a delimiter appears in this part of an expression.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dependencyLag -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dependencyLag">
<InformationModel_v1:hasOrigin>ProjectElementRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dependencyLag</rdf:label>
<rdfs:comment>The time lag to be applied to the dependency.  Only applicable if type is Dependency. Notes: May be zero</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dependencyLead -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dependencyLead">
<InformationModel_v1:hasOrigin>ProjectElementRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dependencyLead</rdf:label>
<rdfs:comment>The time lead to be applied to the dependency. Only applicable if type is Dependency. Notes: May be zero</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_deploymentActivityState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_deploymentActivityState">
<InformationModel_v1:hasOrigin>ForwardingRelationshipEncapsulation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>deploymentActivityState</rdf:label>
<rdfs:comment>This attribute represents the activity state of the current deployment request (e.g. activate, modify, and deactivate). If there is no in-progress deployment request, then the activity state is INACTIVE.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_deploymentState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_deploymentState">
<InformationModel_v1:hasOrigin>ForwardingRelationshipEncapsulation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>deploymentState</rdf:label>
<rdfs:comment>This attribute represents the state of provisioning of the forwarding relationship between the set of end points.  PARTIAL: Indicates that only part of the FRE has been activated in the network.  PENDING: Indicates that none of the FRE resources have been deployed.  COMPLETE: Indicates the FRE has been successfully deployed in all Network Elements and no further intervention is required.  Note that a COMPLETE FRE is not necessarily enabled to carry traffic or carrying traffic.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_depth -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_depth">
<InformationModel_v1:hasOrigin>Hardware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>depth</rdf:label>
<rdfs:comment>This attribute defines the depth of the ManagedComponent using the units specified in the MeasurementUnits attribute. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_derivationAlgorithm -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_derivationAlgorithm">
<InformationModel_v1:hasOrigin>ProdOfferPricePolicyVariable</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>derivationAlgorithm</rdf:label>
<rdfs:comment>A reference to a logical sequence of steps for determining the value of the ProdOfferPricePolicyVariable.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_derivationFormula -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_derivationFormula">
<InformationModel_v1:hasOrigin>MarketSegmentCharacteristic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>derivationFormula</rdf:label>
<rdfs:comment>A rule or principle represented in symbols, numbers, or letters, often in the form of an equation used to derive the value of a characteristic value.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_derivationMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_derivationMethod">
<InformationModel_v1:hasOrigin>AnomalyIndicatorSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>derivationMethod</rdf:label>
<rdfs:comment>he method used to calculate the value of a AnomalyIndicator, such as average, minimum, maximum, sum, and so forth</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_descriptionExtension -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_descriptionExtension">
<InformationModel_v1:hasOrigin>MetDefDescExtension</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>descriptionExtension</rdf:label>
<rdfs:comment>Text that represents the extension to the description of MetricDefinition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_desiredSpeed -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_desiredSpeed">
<InformationModel_v1:hasOrigin>Fan</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>desiredSpeed</rdf:label>
<rdfs:comment>This is an integer attribute that defines the currently requested fan speed, defined in revolutions per minute.  For non-variable speed Fans, this attribute has the same semantics as turning the Fan on or off. For variable-speed Fans, this attribute represents the desired speed of the Fan.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_destinationAddress -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_destinationAddress">
<InformationModel_v1:hasOrigin>VoiceCallUsage</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>destinationAddress</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_detectionMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_detectionMethod">
<InformationModel_v1:hasOrigin>SecurityIncident</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>detectionMethod</rdf:label>
<rdfs:comment>Method used for detection (e.g. user report, detected by sensor, network flow analysis)</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_deviceGroupID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_deviceGroupID">
<InformationModel_v1:hasOrigin>PhysicalDevice</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>deviceGroupID</rdf:label>
<rdfs:comment>This is a string, and is used to uniquely identify this device as a member of a group of devices. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dialectNames -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dialectNames">
<InformationModel_v1:hasOrigin>Language</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dialectNames</rdf:label>
<rdfs:comment>A list of the dialects of the language Note: ISO standard ?</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dialedNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dialedNumber">
<InformationModel_v1:hasOrigin>ResourceNumber</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dialedNumber</rdf:label>
<rdfs:comment>This attribute called dialedNumber exist to specify the number, for any of those types: mobile like MDN, fixed, and IP type of numbers.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_directCost -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_directCost">
<InformationModel_v1:hasOrigin>Cost</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>directCost</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_directCostRate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_directCostRate">
<InformationModel_v1:hasOrigin>Cost</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>directCostRate</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_direction -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_direction">
<InformationModel_v1:hasOrigin>PartyPayment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>direction</rdf:label>
<rdfs:comment>The direction of the payment seen by the company. It can be inbound (payment made to the company) or outbound (payment made by the company).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_disabilities -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_disabilities">
<InformationModel_v1:hasOrigin>Individual</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>disabilities</rdf:label>
<rdfs:comment>Notes:  Used for legal requirements (special billing, special products, special contact media, such as Braille). This should be modeled as a separate entity but is shown as an attribute for brevity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_disclosureDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_disclosureDateTime">
<InformationModel_v1:hasOrigin>SecurityVulnerability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>disclosureDateTime</rdf:label>
<rdfs:comment>The date and time the vulnerability was publicly disclosed</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_discoveredDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_discoveredDateTime">
<InformationModel_v1:hasOrigin>SecurityVulnerability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>discoveredDateTime</rdf:label>
<rdfs:comment>The date and time the vulnerability was discovered.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_discoveredName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_discoveredName">
<InformationModel_v1:hasOrigin>CommonObjectInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>likelyToChange</InformationModel_v1:hasStereotype>
<rdf:label>discoveredName</rdf:label>
<rdfs:comment>This attribute contains the name of the object when its existence is first published on the CCV.  See R_TMF518_FMW_I_0001 and R_TMF518_FMW_I_0003.This attribute contains the name of the object when its existence is first published on the CCV but only in the case where the OS that publishes the object on the CCV is not the naming OS.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_disputedAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_disputedAmount">
<InformationModel_v1:hasOrigin>DAACreated</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>disputedAmount</rdf:label>
<rdfs:comment>The amount which the customer wants a refund for.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_docId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_docId">
<InformationModel_v1:hasOrigin>IPDRDoc</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>docId</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_documentID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_documentID">
<InformationModel_v1:hasOrigin>IPDetailRecord</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>documentID</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_documentNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_documentNumber">
<InformationModel_v1:hasOrigin>Agreement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>documentNumber</rdf:label>
<rdfs:comment>A reference number assigned to an Agreement that follows a prescribed numbering system.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dueDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dueDate">
<InformationModel_v1:hasOrigin>ProductOrder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dueDate</rdf:label>
<rdfs:comment>The date upon which the ProductOrder is due for completion.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_duplexMode -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_duplexMode">
<InformationModel_v1:hasOrigin>PhysicalPort</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>duplexMode</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the duplex mode of this port. Values are:  0: Unknown  1: Full Duplex  2: Half Duplex  This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_duration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_duration">
<InformationModel_v1:hasOrigin>WorksProgram</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>duration</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_durationOffset -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_durationOffset">
<InformationModel_v1:hasOrigin>RelativeCalendarAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>durationOffset</rdf:label>
<rdfs:comment>Specifies the alarm offset. e.g. -5 mins is 5 minutes before and 10hr is 10 hours after</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dX -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dX">
<InformationModel_v1:hasOrigin>RelativeLocalLocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>dX</rdf:label>
<rdfs:comment>The x Cartesian coordinate relative to the referenceLocation.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dY -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dY">
<InformationModel_v1:hasOrigin>RelativeLocalLocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>dY</rdf:label>
<rdfs:comment>The y Cartesian coordinate relative to the referenceLocation.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dynamicAttrAssoc -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dynamicAttrAssoc">
<InformationModel_v1:hasOrigin>RootEntityType</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dynamicAttrAssoc</rdf:label>
<rdfs:comment>An indicator that specifies whether dynamic attributes or associations or both have been added for the RootEntityType.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dZ -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dZ">
<InformationModel_v1:hasOrigin>RelativeLocalLocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>dZ</rdf:label>
<rdfs:comment>The z Cartesian coordinate relative to the referenceLocation. Notes: required for 3D representations</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_effectiveDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_effectiveDate">
<InformationModel_v1:hasOrigin>ConsumptionSummary</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>effectiveDate</rdf:label>
<rdfs:comment>The effectiveDate corresponds to the date where the ConsumptionSummary have been produced.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_effectiveness -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_effectiveness">
<InformationModel_v1:hasOrigin>SecurityVulnerabilityFixAction</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>effectiveness</rdf:label>
<rdfs:comment>States whether the fix action fully avoids the risk associated with the vulnerability or reduces risk to some extent.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_elevation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_elevation">
<InformationModel_v1:hasOrigin>Property</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>elevation</rdf:label>
<rdfs:comment>The height above sea level, in the indicated units</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_eMailAddress -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_eMailAddress">
<InformationModel_v1:hasOrigin>EmailContact</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>eMailAddress</rdf:label>
<rdfs:comment>A full e-mail address in standard format. Notes: e.g. fred.bloggs@thing.com</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_emitConstraint -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_emitConstraint">
<InformationModel_v1:hasOrigin>EventEmitDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>emitConstraint</rdf:label>
<rdfs:comment>This attribute is a string that contains the specific OCL expression to constrain how a particular Event is emitted by a particular Resource. Defining this as an attribute enables external applications to populate this constraint.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_employeeNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_employeeNr">
<InformationModel_v1:hasOrigin>ServiceProviderEmployee</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>employeeNr</rdf:label>
<rdfs:comment>A unique identification number for an employee.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_enabled -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_enabled">
<InformationModel_v1:hasOrigin>ContainedPolicySetsDetail</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>enabled</rdf:label>
<rdfs:comment>This is an enumerated integer. If its value is 1 (which means enabled), then this signifies that this object is enabled for evaluation. If its value is 3 (which means that it is enabled for debugging), then this rule can be used in test or debug scenarios. If its value is 2, then this object is disabled and cannot be used or evaluated. Note that this object still might end up being disabled, even if this attribute is TRUE. For example, an associated PolicyTimePeriodCondition might evaluate to FALSE, effectively disabling this object. That's why the phrasing said "enabled for evaluation" instead of "enabled for use". Values include: 0: Unknown 1: Enabled for evaluation 2: Disabled for use 3: Enabled for debugging</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_encompassingFinancialImpact -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_encompassingFinancialImpact">
<InformationModel_v1:hasOrigin>SecurityIncidentImpact</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>encompassingFinancialImpact</rdf:label>
<rdfs:comment>Financial impact due to Incident</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endActiity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endActiity">
<InformationModel_v1:hasOrigin>WorkflowSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>endActiity</rdf:label>
<rdfs:comment>Represents the action that trips the workflow. Linked to Activity ABE.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endDate">
<InformationModel_v1:hasOrigin>BusinessInteraction</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>endDate</rdf:label>
<rdfs:comment>The date on which an interaction is closed or completed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endEvent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endEvent">
<InformationModel_v1:hasOrigin>WorkflowSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>endEvent</rdf:label>
<rdfs:comment>Identifies the event signaling end of the workflow.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endpointRole -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endpointRole">
<InformationModel_v1:hasOrigin>SecurityEventEndpoint</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>endpointRole</rdf:label>
<rdfs:comment>Defines the role of the endpoint in the Security Event.  Possible enumeration values:  Source, InternalSource, TranslatedSource, or Destination.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endTime">
<InformationModel_v1:hasOrigin>IPDRDocEnd</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>endTime</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_entryDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_entryDate">
<InformationModel_v1:hasOrigin>MetricDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>entryDate</rdf:label>
<rdfs:comment>The date when MetricDefintion was defined or added.  It is meant to provide an indication of how old the MetricDefinition is.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_entryRole -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_entryRole">
<InformationModel_v1:hasOrigin>CalendarEntryAttendance</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>entryRole</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_epic -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_epic">
<InformationModel_v1:hasOrigin>SCRUM_BacklogItem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>epic</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_errorEvent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_errorEvent">
<InformationModel_v1:hasOrigin>ClosedLoopSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>errorEvent</rdf:label>
<rdfs:comment>Identifies events that signal occurrence of an error.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_estimatedDeliveryDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_estimatedDeliveryDate">
<InformationModel_v1:hasOrigin>ShipmentTracking</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>estimatedDeliveryDate</rdf:label>
<rdfs:comment>Date on which the StockItemShipment should be delivered at the final place.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_eventSequenceNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_eventSequenceNumber">
<InformationModel_v1:hasOrigin>PolicyEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>eventSequenceNumber</rdf:label>
<rdfs:comment>This attribute is a non-negative integer and represents the particular sequence in which this event is parsed as part of the overall event clause. This will allow a policy engine to reference externally supplied arguments to this object as it is evaluated. Notes: Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exceptionAction -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exceptionAction">
<InformationModel_v1:hasOrigin>MetricDefinitionDeterminationMethod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>exceptionAction</rdf:label>
<rdfs:comment>Action to take when one or more of the related MetricDefinitionMethodArgument cause indeterminate results, such as a denominator of 0 in a ratio or a missing value for a  MetricDefinitionMethodArgument.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exceptionEvent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exceptionEvent">
<InformationModel_v1:hasOrigin>WorkflowSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>exceptionEvent</rdf:label>
<rdfs:comment>Identifies events to signal abnormalities of the workflow.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_excludedDates -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_excludedDates">
<InformationModel_v1:hasOrigin>ScheduleDefinitionExcludedDates</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>excludedDates</rdf:label>
<rdfs:comment>Dates that should be excluded from the Schedule definition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exclusions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exclusions">
<InformationModel_v1:hasOrigin>Project</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>exclusions</rdf:label>
<rdfs:comment>Specific exclusions that may have been reasonably expected to be included in the Project</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_excutionPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_excutionPeriod">
<InformationModel_v1:hasOrigin>MarketingCampaign</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>excutionPeriod</rdf:label>
<rdfs:comment>Start date and End date representing the period during which the MarketingCampaign is executed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionConstraints -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionConstraints">
<InformationModel_v1:hasOrigin>PolicyGroupExecutionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>executionConstraints</rdf:label>
<rdfs:comment>This attribute is a string that contains the specific OCL expression to constrain how a given set of PolicyEvents are distributed to a particular PolicyGroup. Defining this as an attribute enables external applications to populate this constraint.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionEndTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionEndTime">
<InformationModel_v1:hasOrigin>PolicyGroupExecutionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>executionEndTime</rdf:label>
<rdfs:comment>This defines an end time by which the PolicyEventSet should be executed. If it isn't executed by this time, then the action specified in the ExecutionFailure event of this object should be executed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionFilter -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionFilter">
<InformationModel_v1:hasOrigin>PolicyGroupExecutionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>executionFilter</rdf:label>
<rdfs:comment>The ExecutionFilter attribute contains an OCL expression that defines which components in the PolicyGroup this PolicyEventSet will be passed to, so it can be evaluated. It is expected that this attribute is populated by an external application that knows what policy elements are contained in a particular PolicyGroup.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionStartTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionStartTime">
<InformationModel_v1:hasOrigin>PolicyGroupExecutionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>executionStartTime</rdf:label>
<rdfs:comment>This defines when the PolicyEventSet should be executed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionState">
<InformationModel_v1:hasOrigin>ManagementJob</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>executionState</rdf:label>
<rdfs:comment>The execution state of the management job. It is used to indicate a failure in the execution of the job.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionStrategy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_executionStrategy">
<InformationModel_v1:hasOrigin>PolicyRuleSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>executionStrategy</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the strategy to be used when executing the sequenced actions aggregated by this PolicyRule. Defined execution strategies include: 0: Unknown 1: Do Until Success 2: Do All 3: Do Until Failure 4: Do All Without Failure or Do Nothing "Do Until Success" means that actions should be executed according to their predefined order, until successful execution of a single action. At that point, the process should stop (even if there are additional actions that could be executed). "Do All" means that all actions should be executed that are part of the set, according to their predefined order. This should continue, even if one or more of the actions fails. "Do Until Failure" means that all actions should be executed according to their predefined order until an action fails to execute. At that point, the entire sequence should be stopped. Finally, "Do All Without Failure or Do Nothing" means that all actions specified should be performed. However, if a failure occurs, then NONE of the actions should be performed. This implies EITHER the ability to look-ahead and ensure that the actions will be able to be performed successfully, or the ability to perform a rollback of that action and all previous actions when an error is encountered.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exerciseDescription -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exerciseDescription">
<InformationModel_v1:hasOrigin>SecurityIncident</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>exerciseDescription</rdf:label>
<rdfs:comment>If the incident is part of an exercise, this attribute describes that exercise.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exitCondition -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exitCondition">
<InformationModel_v1:hasOrigin>WorkflowSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>exitCondition</rdf:label>
<rdfs:comment>Identifies the condition to exit from the workflow.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedCompletionDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedCompletionDate">
<InformationModel_v1:hasOrigin>ProductOrder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>expectedCompletionDate</rdf:label>
<rdfs:comment>Expected delivery date amended by the provider.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedDate">
<InformationModel_v1:hasOrigin>ShipmentCheckPoint</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>expectedDate</rdf:label>
<rdfs:comment>Date on which the shipment should arrive at this ShipmentCheckPoint.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedDuration">
<InformationModel_v1:hasOrigin>ProjectElementSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>expectedDuration</rdf:label>
<rdfs:comment>The normal duration of this standard element</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedEquipmentObjectType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedEquipmentObjectType">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>expectedEquipmentObjectType</rdf:label>
<rdfs:comment>This attribute identifies the type of the expected resource. For example, "Fan" or "STM16" for the Equipment class and "Line Shelf" for the Equipment Holder class.) This is an empty string if there is no expected equipment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedEquipmentType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedEquipmentType">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>expectedEquipmentType</rdf:label>
<rdfs:comment>This attribute identifies the type of the expected resource. For example, "Fan" or "STM16" for the Equipment class and "Line Shelf" for the Equipment Holder class. This is an empty string if there is no expected equipment. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedOrInstalledEquipmentRef -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expectedOrInstalledEquipmentRef">
<InformationModel_v1:hasOrigin>EquipmentHolder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>expectedOrInstalledEquipmentRef</rdf:label>
<rdfs:comment>This attribute identifies the equipment object expected or installed in the equipment holder, if any. Null if the equipment holder is empty or if it only contains other equipment holders.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expirationDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expirationDate">
<InformationModel_v1:hasOrigin>BankCardPM</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>expirationDate</rdf:label>
<rdfs:comment>The date of card expiration.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exploitPublishedDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exploitPublishedDateTime">
<InformationModel_v1:hasOrigin>SecurityVulnerability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>exploitPublishedDateTime</rdf:label>
<rdfs:comment>The date and time the exploit for the vulnerability was published.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exploitType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_exploitType">
<InformationModel_v1:hasOrigin>SecurityThreatExploit</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>exploitType</rdf:label>
<rdfs:comment>An enumerated list of threa exploit types, such as:   Software Flaw  Weak Security Control  Cross-scripting Exploit  User-interaction Dependent Tool</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expression -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expression">
<InformationModel_v1:hasOrigin>Intent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>expression</rdf:label>
<rdfs:comment>An Intent contains a set of expectations expressed  (expression) in statements using a particular espressionLanguage. This attribute captures the intent expressed by the TM Forum Intent Ontology (TIO) as is stored as  a string. The expression is the formal statement of the intent and contains all the information that describes the complete intent.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expressionLanguage -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_expressionLanguage">
<InformationModel_v1:hasOrigin>Intent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>expressionLanguage</rdf:label>
<rdfs:comment>Determines the language used to express intent. E.g JSON-LD, Turtle.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_extensible -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_extensible">
<InformationModel_v1:hasOrigin>MarketSegmentCharacteristic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>extensible</rdf:label>
<rdfs:comment>An indicator that specifies that the values for the characteristic can be extended by adding new values when instantiating a characteristic for an Entity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_extensionDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_extensionDuration">
<InformationModel_v1:hasOrigin>ScheduledDuration</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>extensionDuration</rdf:label>
<rdfs:comment>The duration of the expected extensions.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_externalRepresentationReference -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_externalRepresentationReference">
<InformationModel_v1:hasOrigin>TransmissionDescriptor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>externalRepresentationReference</rdf:label>
<rdfs:comment>This attribute provides a means to store at the target OS a reference to the external representation of the Transmission Descriptor.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_externalSchema -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_externalSchema">
<InformationModel_v1:hasOrigin>APISpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>externalSchema</rdf:label>
<rdfs:comment>The external API schema of the (external) url offered to the client of this API.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_externalUrl -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_externalUrl">
<InformationModel_v1:hasOrigin>APISpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>externalUrl</rdf:label>
<rdfs:comment>The url of an API offered to the user. this is seen as external url for an API brokerage.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_familyGeneration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_familyGeneration">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>familyGeneration</rdf:label>
<rdfs:comment>An abbreviation or word that pertains to the generation in a family, such Sr, Jr.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_familyNamePrefix -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_familyNamePrefix">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>familyNamePrefix</rdf:label>
<rdfs:comment>Notes: e.g. Van den, Von etc.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_familyNames -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_familyNames">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>familyNames</rdf:label>
<rdfs:comment>Contains the non-chosen or inherited name. Also known as a person's last name in the Western context. Notes: Also known as surname  Multiple fields may be entered with a delimiter in-between</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fieldId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fieldId">
<InformationModel_v1:hasOrigin>FieldDescriptor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>fieldId</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fieldName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fieldName">
<InformationModel_v1:hasOrigin>FieldDescriptor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>fieldName</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_financialInstitutionAccountType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_financialInstitutionAccountType">
<InformationModel_v1:hasOrigin>PartyCreditProfileReference</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>financialInstitutionAccountType</rdf:label>
<rdfs:comment>The type of financial institution account.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_financialInstitutionAccoutNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_financialInstitutionAccoutNumber">
<InformationModel_v1:hasOrigin>PartyCreditProfileReference</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>financialInstitutionAccoutNumber</rdf:label>
<rdfs:comment>The financial institution account number that identifies the party account at the financial institution.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_financialInstitutionName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_financialInstitutionName">
<InformationModel_v1:hasOrigin>PartyCreditProfileReference</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>financialInstitutionName</rdf:label>
<rdfs:comment>The name of the financial institution that holds the referenced account.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_firstAlert -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_firstAlert">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>firstAlert</rdf:label>
<rdfs:comment>Text that indicates what first alerted the system to the problem. It is not the root cause of the Service Problem.  Examples:  Threshold crossing alert: Service component causing the problem  Customer report: customer name (or TT id) reporting the problem</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fixActionType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fixActionType">
<InformationModel_v1:hasOrigin>SecurityVulnerabilityFixAction</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>fixActionType</rdf:label>
<rdfs:comment>An enumeration of to describe the type of fix action. Enumeration values:   Mitigation - mitigates the potential impact from an exploit of the vulnerability   Remediation - removes the vulnerability from the affected resource.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fixedScheduleStartTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fixedScheduleStartTime">
<InformationModel_v1:hasOrigin>FixedScheduleItem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>fixedScheduleStartTime</rdf:label>
<rdfs:comment>The date and time to start a job/activity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_flags -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_flags">
<InformationModel_v1:hasOrigin>NetFlowSecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>flags</rdf:label>
<rdfs:comment>Flags set in packet headers</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_flowIdentifier -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_flowIdentifier">
<InformationModel_v1:hasOrigin>FreConnectionless</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>flowIdentifier</rdf:label>
<rdfs:comment>This parameter contains the internal identifier of the flow through TPEs and decomposed FREs.  An example of a flow identifier is the IVID which defines the value to be used for VID in S-TAGs pushed onto the frames at entry to the FD.  When the value of flowIdentifier on an FRE is not null", the value of the  corresponding flowIdentifier for all of the TPEs attached to this FRE and to any supporting FREs have the same value as the as the flowIdentifier on the FRE.  If the FRE is performing flowIdentifier swapping inside (as opposed to only at the edges), the flowIdentifier on the FRE is not meaningful (and set to null).  Note:  Since the flowIdentifier a TPE of the FRE has the same value as the flowIdentifer of the FRE (when the flowIdentifier of the FRE is not null) any attempt to set a different value for the flowIdentifier of the TPE will be rejected.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_flowIDHeaderNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_flowIDHeaderNumber">
<InformationModel_v1:hasOrigin>IPv6FlowIDVariable</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>flowIDHeaderNumber</rdf:label>
<rdfs:comment>This attribute is an enumerated integer that defines the particular packet header that contains the IPv6 flow ID information. Specifying the packet header is necessary in case the address is tunneled. In this case, it is mandatory that the correct address be chosen for comparison. Values are: 0: outermost header 1: next innermost header 2: second innermost header etc.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_followedBy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_followedBy">
<InformationModel_v1:hasOrigin>EntityIdentificationSpecFormat</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>followedBy</rdf:label>
<rdfs:comment>One or more characters that follow the EntityIdentification value. For example, the format of a phone number contains dashes, such as 972-477-8401.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_forecastBudget -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_forecastBudget">
<InformationModel_v1:hasOrigin>Budget</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>forecastBudget</rdf:label>
<rdfs:comment>The amount forecasted.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_format -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_format">
<InformationModel_v1:hasOrigin>ServiceSpecVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>format</rdf:label>
<rdfs:comment>This attribute defines the specific revision format used in this version. Each field of the revision is separated by a period. For example, if the desired format is .>, then the value of this string could be: major-number.minor-number The semantics of the format should be described in the revisionSemantics attribute of this class.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_formattedName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_formattedName">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>formattedName</rdf:label>
<rdfs:comment>Contains, in one string, a fully formatted name with all of its pieces in their proper place. This includes all of the necessary punctuation. This de-normalized form of the name cannot be easily parsed. Note: if NULL, then derive from the other fields using name policy</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_formFactor -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_formFactor">
<InformationModel_v1:hasOrigin>Chip</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>formFactor</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the form factor of this PhysicalComponent. Values include: 0: Unknown 1: Other 2: Custom 3: SIP 4: DIP 5: ZIP 6: SOJ 7: SIMM 8: DIMM 9: PGA 10: RIMM 11: SRIMM 12: SODIMM 13: SOIC 14: LCC 15: PLCC  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_formOfAddress -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_formOfAddress">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>formOfAddress</rdf:label>
<rdfs:comment>Contains the Salutation,e.g. Mr., Mrs., Hon., Dr.,Major, etc Note: Also known as person title Also includes. Miss, Ms,</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_formula -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_formula">
<InformationModel_v1:hasOrigin>SalesCommissionSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>formula</rdf:label>
<rdfs:comment>A rule or principle represented in symbols, numbers, or letters, often in the form of an equation used to derive the value of SalesCommission.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_freeBusyType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_freeBusyType">
<InformationModel_v1:hasOrigin>CalendarEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>freeBusyType</rdf:label>
<rdfs:comment>Determines the event resource reservation on the Calendar Notes: TRANSP, FREEBUSY, FBTYPE [iCalendar] Permitted Values: FREE, BUSY, BUSY-UNAVAILABLE, BUSY-TENTATIVE</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_frequency -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_frequency">
<InformationModel_v1:hasOrigin>SalesOpportunity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>frequency</rdf:label>
<rdfs:comment>Frequency of Revenue</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_freType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_freType">
<InformationModel_v1:hasOrigin>ForwardingRelationshipEncapsulation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>freType</rdf:label>
<rdfs:comment>This attribute provides the name of the type of the FRE.  The type is an expression of the traffic flow and potential for flow (accounting for protection switching constructs etc) through the FRE between the EndPoints of the FRE.  This attribute essentially provides the name of the spec for the FRE. The FRE may have further specification details provided via other specification mechanisms.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_from -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_from">
<InformationModel_v1:hasOrigin>GoalDirection</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>from</rdf:label>
<rdfs:comment>Source of goal achievement. </rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fromToDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fromToDateTime">
<InformationModel_v1:hasOrigin>ApplicableTimePeriod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>fromToDateTime</rdf:label>
<rdfs:comment>The period of time for which Capacity or CapacityDemand applies.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fromValue -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fromValue">
<InformationModel_v1:hasOrigin>MarketSegmentCharacteristicValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>fromValue</rdf:label>
<rdfs:comment>The low range value that a characteristic can take on.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fulfilmentID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fulfilmentID">
<InformationModel_v1:hasOrigin>FulfilmentCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>fulfilmentID</rdf:label>
<rdfs:comment>The unique identifier of a fulfilment capability offered by a fulfillment system.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fulfilmentType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fulfilmentType">
<InformationModel_v1:hasOrigin>FulfilmentCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>fulfilmentType</rdf:label>
<rdfs:comment>The type of a fulfilment capability offered by a fulfillment system.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fulfilmentVersion -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fulfilmentVersion">
<InformationModel_v1:hasOrigin>FulfilmentCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>fulfilmentVersion</rdf:label>
<rdfs:comment>The version of a fulfilment capability offered by a fulfillment system.This may include subfileds like major and minor which are separated by a period delimiter.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fullAddress -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_fullAddress">
<InformationModel_v1:hasOrigin>LocalAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>fullAddress</rdf:label>
<rdfs:comment>A denormalised string showing the type and position numbers up the hierarchy with separator characters. Notes: provide if required for performance purposes. e.g. SUITE 5 /  RACK 7B / SUBRACK 2 / CARD 3</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_functionalArea -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_functionalArea">
<InformationModel_v1:hasOrigin>SCRUM_Impediment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>functionalArea</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_functionalPurpose -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_functionalPurpose">
<InformationModel_v1:hasOrigin>ASIC</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>functionalPurpose</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the functional purpose of this ASIC. Values include:  0: Unknown  1: Routing Traffic  2: Forwarding Traffic  3: Encrypting Traffic  4: Firewalling  5: Encoding  6: General Computational Functions</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_gender -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_gender">
<InformationModel_v1:hasOrigin>PhysicalConnector</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>gender</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the gender type of the connector. Values are:  0: Unknown  1: Not Applicable  2: Male  3: Female  This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_generation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_generation">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>generation</rdf:label>
<rdfs:comment>An abbreviation or word that pertains to the generation in a family history, such as Sr., Jr., III (the third), and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_geometry -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_geometry">
<InformationModel_v1:hasOrigin>GeographicLocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>geometry</rdf:label>
<rdfs:comment>The two dimensional graphical representation of the Location allowing it to be displayed on a map and to be used for spatial calculations. Notes: Since Geometry is abstract, the attribute will actually be one of the concrete subclasses</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_givenNames -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_givenNames">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>givenNames</rdf:label>
<rdfs:comment>Note: Also known as Christian name, chosen name, first name  Multiple fields may be entered with a delimiter in-between or stored in a collection</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_GMTSessionEndDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_GMTSessionEndDateTime">
<InformationModel_v1:hasOrigin>PublicWANAccessUsageEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>GMTSessionEndDateTime</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_GMTSessionStartDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_GMTSessionStartDateTime">
<InformationModel_v1:hasOrigin>PublicWANAccessUsageEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>GMTSessionStartDateTime</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_gracePeriods -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_gracePeriods">
<InformationModel_v1:hasOrigin>ServiceLevelObjective</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>gracePeriods</rdf:label>
<rdfs:comment>The number of times an objective can remain un-updated without a violation of a ServiceLevelAgreement in reference to a measurement period and/or ServiceLevelAgreement reporting period.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_granularity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_granularity">
<InformationModel_v1:hasOrigin>CrossedThreshold</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>granularity</rdf:label>
<rdfs:comment>Indicates the granularity at which the indicator is evaluated for threshold crossing.  If the threshold applies to a single indicator, then this attribute is mandatory. It can only be omitted for complex threshold involving multiple indicators.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_gridX -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_gridX">
<InformationModel_v1:hasOrigin>GridLocalLocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>gridX</rdf:label>
<rdfs:comment>The grid x coordinate.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_gridY -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_gridY">
<InformationModel_v1:hasOrigin>GridLocalLocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>gridY</rdf:label>
<rdfs:comment>The grid y coordinate.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_gridZ -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_gridZ">
<InformationModel_v1:hasOrigin>GridLocalLocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>gridZ</rdf:label>
<rdfs:comment>The grid z coordinate. Notes: not normally used</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_groupNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_groupNumber">
<InformationModel_v1:hasOrigin>PolicyConditionRuleDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>groupNumber</rdf:label>
<rdfs:comment>This attribute is used to define the group to which the condition is a part of. It corresponds logical to the position of parentheses used to group condition terms together.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_handlingState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_handlingState">
<InformationModel_v1:hasOrigin>Intent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>handlingState</rdf:label>
<rdfs:comment>A enumerated list of states, including StateIntentReceived, StateCompliant, StateDegraded, StateFinalizing</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_handOfActivity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_handOfActivity">
<InformationModel_v1:hasOrigin>WorkflowSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>handOfActivity</rdf:label>
<rdfs:comment>Represents the point of interface outbound from the workflow. Linked to Activity ABE.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hardwarePurpose -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hardwarePurpose">
<InformationModel_v1:hasOrigin>ManagedHardware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>hardwarePurpose</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the purpose of the ManagedHardware. Values include:  1: Required  2: Optional  3: Redundant  4: Fail-Over  5: Other  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hardwareVersion -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hardwareVersion">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>hardwareVersion</rdf:label>
<rdfs:comment>This is a string attribute that contains the hardware version number of this Card.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasActiveCooling -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasActiveCooling">
<InformationModel_v1:hasOrigin>CoolingDevice</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>hasActiveCooling</rdf:label>
<rdfs:comment>This is a Boolean that, if TRUE, means that this CoolingDevice provides active cooling. If it is false, then cooling is provided by a passive means.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasAdapter -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasAdapter">
<InformationModel_v1:hasOrigin>Slot</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>hasAdapter</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, indicates that this slot has an adapter installed that enables it to accept other types of cards (e.g., fitting an adapter on two Slots enable them to accept a Card that otherwise could not be accommodated). If its value is FALSE, then no adapter is present. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasEvaluated -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasEvaluated">
<InformationModel_v1:hasOrigin>PolicyConditionAtomic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>hasEvaluated</rdf:label>
<rdfs:comment>This is an enumerated integer that is set by a policy application to define the state of evaluation of this PolicyCondition.   Permitted Values: 0: not yet evaluated 1: evaluated as TRUE 2: evaluated as FALSE Notes: Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasEventEvaluated -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasEventEvaluated">
<InformationModel_v1:hasOrigin>PolicyEventBase</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>hasEventEvaluated</rdf:label>
<rdfs:comment>This is an enumerated integer that is set by a policy application to define the state of evaluation of this event. Values include: 0: not yet evaluated 1: evaluated as TRUE 2: evaluated as FALSE</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasExecuted -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasExecuted">
<InformationModel_v1:hasOrigin>PolicyActionAtomic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>hasExecuted</rdf:label>
<rdfs:comment>This is an enumerated integer that is set by a policy application to define the state of execution of this policyAction.   Permited Values: 0: not yet executed 1: executed with no errors 2: executed with errors but successfully rolled back 3: executed with errors and did not roll back 4: did not complete execution but successfully rolled back 5: did not complete execution and did not roll back  Notes: Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasMultipleQoSTypes -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasMultipleQoSTypes">
<InformationModel_v1:hasOrigin>ServiceBundle</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>hasMultipleQoSTypes</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, defines this ServiceBundle as containing more than a single type of QoSService (e.g., DiffServ and 802.1P as an example).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasStarted -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasStarted">
<InformationModel_v1:hasOrigin>Service</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>hasStarted</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that this Service has already been started. If the value of this attribute is FALSE, then this signifies that this Service has NOT been Started.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasSubActions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasSubActions">
<InformationModel_v1:hasOrigin>PolicyActionAtomic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>hasSubActions</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that this PolicyAction has one or more sub-actions. Sub-actions are used to enforce a hierarchical nesting of actions, so that parent actions may control the evaluation and other semantics of the sub-actions that they contain.  Notes: Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasSubPolicyActions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasSubPolicyActions">
<InformationModel_v1:hasOrigin>PolicyActionComposite</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>hasSubPolicyActions</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that this PolicyAction has one or more sub-actions. Sub-actions are used to enforce a hierarchical nesting of actions, so that parent actions may control the evaluation and other semantics of sub-actions that they contain. Notes: Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasSubRules -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasSubRules">
<InformationModel_v1:hasOrigin>PolicyRuleBase</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>hasSubRules</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that this PolicyRule has one or more sub-rules. Sub-rules are used to enforce a hierarchical nesting of rules, so that parent rules may control the execution and other semantics of sub-rules that they contain.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_header -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_header">
<InformationModel_v1:hasOrigin>IPDRSPData</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>header</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_heatGeneration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_heatGeneration">
<InformationModel_v1:hasOrigin>Chassis</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>heatGeneration</rdf:label>
<rdfs:comment>This is an integer that defines the amount of heat generated by the Chassis in BTU/hour. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_height -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_height">
<InformationModel_v1:hasOrigin>Hardware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>height</rdf:label>
<rdfs:comment>This attribute defines the height of the ManagedComponent using the units specified in the MeasurementUnits attribute. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_heightInUs -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_heightInUs">
<InformationModel_v1:hasOrigin>Rack</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>heightInUs</rdf:label>
<rdfs:comment>This is the height of the Rack in 'U's. A 'U' is a standard unit of measure for the height of a Rack or rack-mountable components. It is equal to 1.75 inches or 4.445 cm. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_holderStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_holderStatus">
<InformationModel_v1:hasOrigin>EquipmentHolder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>holderStatus</rdf:label>
<rdfs:comment>This attribute, based on M.3100, indicates the status of the EquipmentHolder. Values include:  0: Unknown  1: Installed And Acceptable  2: Installed And Not Acceptable  3: Not Installed  4: Mismatch Of Installed and Acceptable  5: Unavailable  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hostNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hostNumber">
<InformationModel_v1:hasOrigin>IPAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>hostNumber</rdf:label>
<rdfs:comment>This contains the host number portion of the IP Address.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hotSwappable -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hotSwappable">
<InformationModel_v1:hasOrigin>PhysicalContainer</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>hotSwappable</rdf:label>
<rdfs:comment>This is a Boolean attribute that defines whether it is possible to replace this object instance with a physically different, but equivalent, object instance while the containing Equipment has power applied to it. TRUE means that it is HotSwappable, and FALSE means that it is not.  All HotSwappable PhysicalComponents are inherently Removable and Replaceable.  This is a required attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ID">
<InformationModel_v1:hasOrigin>RootEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>ID</rdf:label>
<rdfs:comment>Unambiguously distinguishes different object instances.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ifType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ifType">
<InformationModel_v1:hasOrigin>PhysicalPort</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>ifType</rdf:label>
<rdfs:comment>This is an enumerated integer, and specifies the particular media type of the link. This attribute provides additional detail beyond that provided in the ifType of an ifEntry of a MIB (e.g., distinguishing between 10Base and 100Base ethernet). Values include:  0: Unknown 1: 10BaseT 2: 100BaseT 3: 10-100BaseT 4: 1000BaseT 5: 10000BaseT 6: DS-0 7: DS-1 8: DS-3 9: OC-3 10: OC-12 11: OC-48 12: OC-192  This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_impactImportanceFactor -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_impactImportanceFactor">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>impactImportanceFactor</rdf:label>
<rdfs:comment>Impact Importance is characterized by an Impact Importance Factor: overall importance of the impact of all the affected services, e.g. 0 (zero impact) to 100 (worst impact). The Impact Importance is a calculated field which is set by the OSS determining the impact.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_impactPattterns -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_impactPattterns">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>impactPattterns</rdf:label>
<rdfs:comment>Define the patterns of impact (optional)  - e.g. other service characteristics  - Used when defining impact through another pattern than the pre-defined attributes above  This field is extendable.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_incidentCause -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_incidentCause">
<InformationModel_v1:hasOrigin>SecurityIncidentAssessment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>incidentCause</rdf:label>
<rdfs:comment>Free text description of the cause of an intrusion</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_includesResourcesUseByAnotherFre -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_includesResourcesUseByAnotherFre">
<InformationModel_v1:hasOrigin>MultiRouteManagement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>includesResourcesUseByAnotherFre</rdf:label>
<rdfs:comment>This attribute indicates whether one (or more) of the component FREs of the route or TPEs  associated directly with an component FRE of the route is carrying traffic of another FRE, i.e. is involved in another route that is active, (True) or not (False).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inclusions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inclusions">
<InformationModel_v1:hasOrigin>Project</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>inclusions</rdf:label>
<rdfs:comment>Items that the Project covers that are not obvious</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indicatorCategory -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indicatorCategory">
<InformationModel_v1:hasOrigin>PerformanceIndicatorSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>indicatorCategory</rdf:label>
<rdfs:comment>A grouping or set of PerformanceIndicatorSpecifications that are classified together because of common characteristics, such as technology specific, service specific, or technology/service independent.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indicatorName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indicatorName">
<InformationModel_v1:hasOrigin>CrossedThreshold</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>indicatorName</rdf:label>
<rdfs:comment>Indicates the  name of performance indicator, KPI, gauge or counter which crossed the threshold.   If the threshold applies to a single indicator, then this attribute is mandatory. It can only be omitted for complex threshold involving multiple indicators.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indicatorType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indicatorType">
<InformationModel_v1:hasOrigin>AnomalyIndicatorSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>indicatorType</rdf:label>
<rdfs:comment>A kind of value that the AnomalyIndicator can take on, such as numeric, text, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indicatorUnit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indicatorUnit">
<InformationModel_v1:hasOrigin>CrossedThreshold</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>indicatorUnit</rdf:label>
<rdfs:comment>This attribute identifies the unit of the measurement of the indicator corresponding to the threshold that has been crossed in a free format string.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indirectCost -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indirectCost">
<InformationModel_v1:hasOrigin>Cost</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>indirectCost</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indirectCostRate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_indirectCostRate">
<InformationModel_v1:hasOrigin>Cost</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>indirectCostRate</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_initialDetectionDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_initialDetectionDateTime">
<InformationModel_v1:hasOrigin>SecurityIncident</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>initialDetectionDateTime</rdf:label>
<rdfs:comment>Date/time initial detection of activity occurred associated with this incident.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputCurrentMax -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputCurrentMax">
<InformationModel_v1:hasOrigin>PowerSupply</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>inputCurrentMax</rdf:label>
<rdfs:comment>This is a string that defines the input current rating in amperes for a fully populated chassis. For a DC PowerSupply, this is the maximum current drawn when operating at the lowest permissible value of its input voltage range. For an AC PowerSupply, the value of this attribute is the same as the value of the InputCurrentMin attribute.  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputCurrentMin -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputCurrentMin">
<InformationModel_v1:hasOrigin>PowerSupply</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>inputCurrentMin</rdf:label>
<rdfs:comment>This is a string that defines the input current rating in amperes for a fully populated chassis. For a DC PowerSupply, this is the minimum current drawn when operating at the lowest permissible value of its input voltage range. For an AC PowerSupply, the value of this attribute is the same as the value of the InputCurrentMax attribute.  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputOctets -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputOctets">
<InformationModel_v1:hasOrigin>PublicWANAccessUsageEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>inputOctets</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputSource -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputSource">
<InformationModel_v1:hasOrigin>WorkflowSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>inputSource</rdf:label>
<rdfs:comment>Identifies source of input to the workflow.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputVoltageHigh -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputVoltageHigh">
<InformationModel_v1:hasOrigin>PowerSupply</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>inputVoltageHigh</rdf:label>
<rdfs:comment>This is a string that defines the high value for the Input Voltage Range for this PowerSupply.  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputVoltageLow -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inputVoltageLow">
<InformationModel_v1:hasOrigin>PowerSupply</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>inputVoltageLow</rdf:label>
<rdfs:comment>This is a string that defines the low value for the Input Voltage Range for this PowerSupply.  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installationOrder -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installationOrder">
<InformationModel_v1:hasOrigin>Chassis</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>installationOrder</rdf:label>
<rdfs:comment>This is a free-form string that defines the order of installation of components into the Chassis. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedEquipmentObjectType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedEquipmentObjectType">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>installedEquipmentObjectType</rdf:label>
<rdfs:comment>This attribute identifies the type of the installed resource. For example, "Fan" or "STM16" for the Equipment class and "Line Shelf" for the Equipment Holder class.) The installed equipment type is invariant for the lifetime of the hardware. This is an empty string if there is no expected equipment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedEquipmentType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedEquipmentType">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>installedEquipmentType</rdf:label>
<rdfs:comment>This attribute identifies the type of the installed resource. For example, "Fan" or "STM16" for the Equipment class and "Line Shelf" for the Equipment Holder class. The installed equipment type is invariant for the lifetime of the hardware. This is an empty string if there is no installed equipment. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedPartNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedPartNumber">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>installedPartNumber</rdf:label>
<rdfs:comment>This attribute identifies the vendor's resource Part Number (PN) of the installed equipment. If PN is not available empty string shall be used. If the part and serial number are both non-null then the part+serial number together shall be unique.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedSerialNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedSerialNumber">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>installedSerialNumber</rdf:label>
<rdfs:comment>This attribute contains the vendor's serial number of the installed equipment. Unique, if no default is provided. At least one serial number has to be provided.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedTimeStamp -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedTimeStamp">
<InformationModel_v1:hasOrigin>ServicePlaceDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>installedTimeStamp</rdf:label>
<rdfs:comment>The date and time a Service has been installed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedVersion -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installedVersion">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>installedVersion</rdf:label>
<rdfs:comment>This attribute identifies the vendor's resource version of the installed equipment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installSize -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installSize">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>installSize</rdf:label>
<rdfs:comment>The amount and units, such as 800 MB, required to install the SoftwareResource.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_installStatus">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>installStatus</rdf:label>
<rdfs:comment>This is an m.3100 attribute that represents the availability of the type of Equipment that this object represents. Its semantics are as follows.  The attribute availability status is used to indicate whether the correct physical piece of equipment (in m.3100, it is called a "circuit pack") is isntalled or not. This is a set valued attribute and includes the values notInstalled and empty. If the type of the inserted physical circuit pack matches the value of the circuitPackType attribute (relating to the circuitPack instance) then the value of the availabilityStatus is an empty set. Otherwise, the value of the availabilityStatus attribute is notInstalled even if it is one of the acceptable circuit pack type  This is implemented as an enumerated integer. The values will include at least the following:  0: Unknown  1: Operational (installed and matches expected type)  2: Installed (buit does not match expected type)  3: Not Installed  4: In Maintenance  5: Failed  6: Not operational  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_integrity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_integrity">
<InformationModel_v1:hasOrigin>SecurityIncidentImpactLevel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>integrity</rdf:label>
<rdfs:comment>A loss of integrity is the unauthorized modification or destruction of information.  Enumerated value indicating the impact to integrity due to the Security Incident:   Low - The loss of confidentiality, integrity, or availability could be expected to have a limited adverse effect on organizational operations, organizational assets, or individuals.  A limited adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a degradation in mission capability to an extent and duration that the organization is able to perform its primary functions, but the effectiveness of the functions is noticeably reduced; (ii) result in minor damage to organizational assets; (iii) result in minor financial loss; or (iv) result in minor harm to individuals   Moderate - The loss of confidentiality, integrity, or availability could be expected to have a serious adverse effect on organizational operations, organizational assets, or individuals.  A serious adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a significant degradation in mission capability to an extent and duration that the organization is able to perform its primary functions, but the effectiveness of the functions is significantly reduced; (ii) result in significant damage to organizational assets; (iii) result in significant financial loss; or (iv) result in significant harm to individuals that does not involve loss of life or serious life threatening injuries.   High - The loss of confidentiality, integrity, or availability could be expected to have a severe or catastrophic adverse effect on organizational operations, organizational assets, or individuals.  A severe or catastrophic adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a severe degradation in or loss of mission capability to an extent and duration that the organization is not able to perform one or more of its primary functions; (ii) result in major damage to organizational assets; (iii) result in major financial loss; or (iv) result in severe or catastrophic harm to individuals involving loss of life or serious life threatening injuries.   Source:  FIPS 199.  http://csrc.nist.gov/publications/fips/fips199/FIPS-PUB-199-final.pdf</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_interactionType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_interactionType">
<InformationModel_v1:hasOrigin>GeographicLocationRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>interactionType</rdf:label>
<rdfs:comment>The type of relationship between the locations. This could be a binary topological relationship type (touches, crosses, overlaps, equals, contains, within) if a spatial engine is not available and the spatial relationships are being modeled directly, or some more general relationships.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_internalSchema -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_internalSchema">
<InformationModel_v1:hasOrigin>APISpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>internalSchema</rdf:label>
<rdfs:comment>The internal API schema of the (internal) url which an API broker uses.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_internalUrl -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_internalUrl">
<InformationModel_v1:hasOrigin>APISpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>internalUrl</rdf:label>
<rdfs:comment>The url of an API offered to an API brokerage.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_interval -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_interval">
<InformationModel_v1:hasOrigin>PerformanceSpecificationInterval</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>interval</rdf:label>
<rdfs:comment>A value that represents the period of time over which the PerformanceSpecificaion is collected.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_intervalTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_intervalTime">
<InformationModel_v1:hasOrigin>Performance</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>intervalTime</rdf:label>
<rdfs:comment>The increment of time (including date) for which the associated PerformanceIndicators were calculated/determined.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_intiallyReportedDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_intiallyReportedDateTime">
<InformationModel_v1:hasOrigin>SecurityIncident</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>intiallyReportedDateTime</rdf:label>
<rdfs:comment>Date and time initially reported.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inUse -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inUse">
<InformationModel_v1:hasOrigin>PhysicalConnector</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>inUse</rdf:label>
<rdfs:comment>This is a boolean attribute that, if TRUE, indicates that this PhysicalConnector is in use by some other component of the system. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inventoryDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_inventoryDate">
<InformationModel_v1:hasOrigin>StockItemStockLevel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>inventoryDate</rdf:label>
<rdfs:comment>Date of the last inventory of the StockItemStockLevel</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_involvementType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_involvementType">
<InformationModel_v1:hasOrigin>PartyRevenueSharingModelInvolvement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>involvementType</rdf:label>
<rdfs:comment>The specification of whether revenue is retained by an enterprise and whether a party participates in revenue sharing. For example, an enterprise may charge a listing fee for a party's offering or offerings as part of an agreement between a party and an enterprise, and an enterprise passes all revenue on to the party for sales of the party's offering. The party is invoiced separately for the listing fee. For a template revenue sharing model only an enterprise's involvement is specified. When a party enters into a revenue sharing agreement and a template is used their involvement is specified.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isAC -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isAC">
<InformationModel_v1:hasOrigin>PowerSupply</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isAC</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies this to be an AC PowerSupply. If FALSE, then it is a DC PowerSupply.  This is a required attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isAlarmReporting -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isAlarmReporting">
<InformationModel_v1:hasOrigin>ForwardingRelationshipEncapsulation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isAlarmReporting</rdf:label>
<rdfs:comment>This attribute identifies whether alarm reporting for this FRE is administratively enabled or disabled.   True = alarm reporting is enabled; False = alarm reporting is disabled.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isAppointmentRequired -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isAppointmentRequired">
<InformationModel_v1:hasOrigin>WorkSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isAppointmentRequired</rdf:label>
<rdfs:comment>Specifies if this kind of work requires an appointment with the customer/owner to be performed at their location</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isCNF -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isCNF">
<InformationModel_v1:hasOrigin>PolicyRuleBase</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isCNF</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, defines the condition clause of this rule to be represented in Conjunctive Normal Form (e.g., an AND of ORs). If the value of this attribute is FALSE, then the condition clause will be represented in Disjunctive Normal Form (e.g., an OR of ANDs).  This attribute controls the setting of how multiple condition clauses (as represented by multiple PolicyConditionComposite objects) are treated in the PolicyRule. As such, it is different from the attribute PolicyConditionComposite.IsCNF, which controls how multiple PolicyConditionAtomic objects are treated in a (single) PolicyConditionComposite object.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isComposite -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isComposite">
<InformationModel_v1:hasOrigin>PhysicalDevice</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isComposite</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, means that this physical device is in reality made up of a set of physical devices, each of which can be individually managed. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isConfigurable -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isConfigurable">
<InformationModel_v1:hasOrigin>PhysicalComponent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isConfigurable</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, means that this PhysicalComponent is configurable by the end-user. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isConfigurablePhysically -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isConfigurablePhysically">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isConfigurablePhysically</rdf:label>
<rdfs:comment>This is a boolean attribute that, if TRUE, indicates that this Card has one or more options that can be physically configured. Each of these options has a distinct physical manifestation (e.g., additional memory, or faster CPU) that usually (but not always) results in occupying more room in the Card.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isConsumable -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isConsumable">
<InformationModel_v1:hasOrigin>ProjectResourceSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isConsumable</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isDefault -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isDefault">
<InformationModel_v1:hasOrigin>MarketSegmentCharacteristicValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isDefault</rdf:label>
<rdfs:comment>Indicates if the value is the default value for a characteristic.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isDistributable -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isDistributable">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isDistributable</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, designates the SoftwareResource as being able to be distributed across multiple physically distinct Resources.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isDistributedCurrent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isDistributedCurrent">
<InformationModel_v1:hasOrigin>SoftwareResource</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isDistributedCurrent</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, defines this SoftwareResource as being currently distributed across several Resource nodes.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEdgeFlowIdentifierPreserved -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEdgeFlowIdentifierPreserved">
<InformationModel_v1:hasOrigin>FreConnectionless</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isEdgeFlowIdentifierPreserved</rdf:label>
<rdfs:comment>If True, the relevant flow identifier of particular information egressing the FRE at the boundary of the FRE is the same as the flowIdentifier used for that particular traffic at the ingress to the FRE. If flowIdentifier stacking or translation is applied within the FRE, the stacking/translation tables on all endpoints of the FRE will be set such that the above condition is satisfied for any flow.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEdgePriorityPreserved -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEdgePriorityPreserved">
<InformationModel_v1:hasOrigin>FreConnectionless</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isEdgePriorityPreserved</rdf:label>
<rdfs:comment>This attribute shall indicate whether the egress Priority in the frame header must be the same as the ingress Priority</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEdgeResourcePort -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEdgeResourcePort">
<InformationModel_v1:hasOrigin>ResourcePort</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isEdgeResourcePort</rdf:label>
<rdfs:comment>This is a Boolean attribute. If the value of this attribute is TRUE, then this ResourcePort is located at the edge of a Network or SubNetwork.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEnabled -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEnabled">
<InformationModel_v1:hasOrigin>FieldDescriptor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isEnabled</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEphemeral -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEphemeral">
<InformationModel_v1:hasOrigin>Protocol</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isEphemeral</rdf:label>
<rdfs:comment>This is a Boolean attribute. If its value is TRUE, then this protocol can use ephemeral port numbers. If its value is FALSE, then this protocol will only use well-defined port numbers.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEquipmentProtected -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isEquipmentProtected">
<InformationModel_v1:hasOrigin>TerminationPointEncapsulation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isEquipmentProtected</rdf:label>
<rdfs:comment>This attribute indicates whether or not the TPE is supported by a protected Equipment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isExactAlternative -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isExactAlternative">
<InformationModel_v1:hasOrigin>SoftwareSpecAlternativeRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isExactAlternative</rdf:label>
<rdfs:comment>An indicator that specifies if the alternate is an exact alternate.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isExercise -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isExercise">
<InformationModel_v1:hasOrigin>SecurityIncident</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isExercise</rdf:label>
<rdfs:comment>Indicates whether this incident is real or part of an exercise (i.e. part of a test of an organization's security posture).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isExperimental -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isExperimental">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isExperimental</rdf:label>
<rdfs:comment>This is a Boolean attribute. If the value of this attribute is TRUE, then this represents a special build (perhaps as a trial to suit specific customer needs).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isFalsePositive -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isFalsePositive">
<InformationModel_v1:hasOrigin>SecurityIncident</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isFalsePositive</rdf:label>
<rdfs:comment>Boolean for the evaluation whether this incident is a false positive or not.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isFixed -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isFixed">
<InformationModel_v1:hasOrigin>ForwardingRelationshipEncapsulation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isFixed</rdf:label>
<rdfs:comment>This attribute identifies whether the FRE can be deleted via the interface (isFixed = FALSE) or cannot be deleted (isFixed = TRUE).   Where isFixed = TRUE attempts to delete the FRE by the OS will be rejected.  Where an FRE has a route (i.e. is known to traverse multiple NEs) all NFREs of the FRE must be fxed for the FRE to be fixed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isIntendedRoute -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isIntendedRoute">
<InformationModel_v1:hasOrigin>MultiRouteManagement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isIntendedRoute</rdf:label>
<rdfs:comment>This attribute indicates whether this route is the intended (prefered) route of the FRE (True) or not (False).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isLegalEntity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isLegalEntity">
<InformationModel_v1:hasOrigin>Organization</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isLegalEntity</rdf:label>
<rdfs:comment>Permitted Values: TRUE or FALSE</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isLocalTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isLocalTime">
<InformationModel_v1:hasOrigin>PolicyConditionTimePeriod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isLocalTime</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that the times represented in the timePeriod attribute and in the various Mask attributes represent local times. If the value of this attribute is FALSE, then this means that the times represented in the timePeriod attribute and in the various Mask attributes represent UTC times. There is no provision for mixing of local times and UTC times: the value of this attribute applies to all of the other time-related attributes. Notes: Not present in the ITU specs. The CIM defines a similar attribute called LocalOrUtcTime.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isLocatedAt -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isLocatedAt">
<InformationModel_v1:hasOrigin>ServicePlaceDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isLocatedAt</rdf:label>
<rdfs:comment>A indicator that specifies if a Service has been installed at the Location.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMandatory -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMandatory">
<InformationModel_v1:hasOrigin>Service</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isMandatory</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that this Service is mandatory (i.e., this Service must be running when the managed environment is in a non-failed state). If the value of this attribute is FALSE, then this means that this Service is not required to run.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMandatoryASIC -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMandatoryASIC">
<InformationModel_v1:hasOrigin>ASIC</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isMandatoryASIC</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that this ASIC is mandatory for the correct operation of the PhysicalResource that contains it.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMandatoryEvaluation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMandatoryEvaluation">
<InformationModel_v1:hasOrigin>PolicySet</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isMandatoryEvaluation</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that evaluation (and possibly action execution) of this entity is mandatory and must be attempted. If the Mandatory property value of this entity is FALSE, then the evaluation of this entity is considered to be "best effort" and may be ignored.  Notes:  Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMinUnit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMinUnit">
<InformationModel_v1:hasOrigin>CurrencyUnit</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isMinUnit</rdf:label>
<rdfs:comment>A flag to indicate if it is minimum unit of a currency.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMotherBoard -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMotherBoard">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isMotherBoard</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, defines this Card as either a motherboard or another type of hosting board. When FALSE, it isn't.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isNegated -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isNegated">
<InformationModel_v1:hasOrigin>PolicyConditionRuleDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isNegated</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that this condition is negated. The default value for this attribute is FALSE.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_iso2Code -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_iso2Code">
<InformationModel_v1:hasOrigin>Country</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>iso2Code</rdf:label>
<rdfs:comment>ISO 2 letter country abbreviation. Notes: refer ISO-3166</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_iso3Code -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_iso3Code">
<InformationModel_v1:hasOrigin>Country</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>iso3Code</rdf:label>
<rdfs:comment>ISO 3 letter country abbreviation Notes: refer ISO-3166</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isOnCriticalPath -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isOnCriticalPath">
<InformationModel_v1:hasOrigin>SimpleActivity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isOnCriticalPath</rdf:label>
<rdfs:comment>Indicates if the Activity is on the Project critical path</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isOperational -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isOperational">
<InformationModel_v1:hasOrigin>LogicalResource</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isOperational</rdf:label>
<rdfs:comment>This attribute is used to define the operational status of the object, and is implemented as a Boolean: TRUE means that the object is currently operational, and FALSE means that the object is not currently operational.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isPackage -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isPackage">
<InformationModel_v1:hasOrigin>EntitySpecCharUse</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isPackage</rdf:label>
<rdfs:comment>An indicator that specifies that the associated CharacteristicSpecification is a composite.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isPhysicalEvent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isPhysicalEvent">
<InformationModel_v1:hasOrigin>EventEmitDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isPhysicalEvent</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, identifies this event as being emitted from a PhysicalResource. If it is FALSE, then this event has been emitted from a LogicalResource.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isPluggable -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isPluggable">
<InformationModel_v1:hasOrigin>CardOnCardDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isPluggable</rdf:label>
<rdfs:comment>This attribute is a Boolean that, if TRUE, means that this DaughterCard can "plug into" its hosting Card without any external cabling. FALSE means that this DaughterCard requires an external cable to attach it to its hosting Card. This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isPromotion -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isPromotion">
<InformationModel_v1:hasOrigin>ProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isPromotion</rdf:label>
<rdfs:comment>isPromotion specifies if the ProductOffering is a promotion to encourage Parties to buy, rent, or in some other way procure the offering.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isRedundant -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isRedundant">
<InformationModel_v1:hasOrigin>PowerSupply</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isRedundant</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies this PowerSupply as a redundant PowerSupply.  This is a required attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isReportingAlarms -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isReportingAlarms">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isReportingAlarms</rdf:label>
<rdfs:comment>This attribute provides an indication of whether alarm reporting for this Equipment is enabled (true) or disabled (false).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isReservable -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isReservable">
<InformationModel_v1:hasOrigin>ProjectResourceSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isReservable</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isRSVPEnabled -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isRSVPEnabled">
<InformationModel_v1:hasOrigin>RSVP</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isRSVPEnabled</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that this RSVPService instance is enabled.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isRVSPRequested -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isRVSPRequested">
<InformationModel_v1:hasOrigin>CalendarEntry</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isRVSPRequested</rdf:label>
<rdfs:comment>If an RSVP is expected Notes: RVSP [iCalendar] Permitted Values: True, False</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSellableStandAlone -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSellableStandAlone">
<InformationModel_v1:hasOrigin>ProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isSellableStandAlone</rdf:label>
<rdfs:comment>If TRUE indicates that the ProductOffering, which is part of a BundledProductOffering, can also be offered for sale stand-alone, if FALSE means that the ProductOffering can only be sold within a BundledProductOffering. NOTE: This attribute only applies to offerings that are part of a BundledProductOffering.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isServiceEnabled -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isServiceEnabled">
<InformationModel_v1:hasOrigin>Service</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isServiceEnabled</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, signifies that this Service has been enabled for use. If the value of this attribute is FALSE, then this means that this particular Service has NOT been enabled for use.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isShared -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isShared">
<InformationModel_v1:hasOrigin>UsageVolumeProductSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isShared</rdf:label>
<rdfs:comment>True if the UsageVolumeProductSpec can be shared by several NetworkProducts.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSolitary -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSolitary">
<InformationModel_v1:hasOrigin>PhysicalCapacityDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isSolitary</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, defines this ManagedComponent as containing only one PhysicalCapacity. If this is FALSE, then this ManagedComponent contains multiple PhysicalCapacities (all different, of course). This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSolitaryHolder -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSolitaryHolder">
<InformationModel_v1:hasOrigin>EquipmentHolder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isSolitaryHolder</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, defines this EquipmentHolder as containing only one ManagedComponent. If this is FALSE, then this EquipmentHolder contains nested ManagedComponents. This is a REQUIRED attrinbute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isStateful -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isStateful">
<InformationModel_v1:hasOrigin>Service</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isStateful</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, means that this Service can be changed without affecting any other services.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isStdUnit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isStdUnit">
<InformationModel_v1:hasOrigin>CurrencyUnit</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isStdUnit</rdf:label>
<rdfs:comment>A flag to indicate if it is standard unit of a currency.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_issueDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_issueDate">
<InformationModel_v1:hasOrigin>PartyIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>issueDate</rdf:label>
<rdfs:comment>The date that the identification was produced / printed</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_issuingCountry -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_issuingCountry">
<InformationModel_v1:hasOrigin>PassportIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>issuingCountry</rdf:label>
<rdfs:comment>The country issuing the passport.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSwitching -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSwitching">
<InformationModel_v1:hasOrigin>PowerSupply</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isSwitching</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, indicates that this PowerSupply is a switching (vs linear) PowerSupply.  This is a required attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSymmetricalAlternative -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSymmetricalAlternative">
<InformationModel_v1:hasOrigin>SoftwareSpecAlternativeRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isSymmetricalAlternative</rdf:label>
<rdfs:comment>An indicator that specifies whether one SoftwareResourceSpecification is an alternate for the other involved in the relationshp and the other is an alternate for the SoftwareResourceSpecfication, or the SoftwareResourceSpecification is an alternate for the other only.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSymmetricConstraint -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isSymmetricConstraint">
<InformationModel_v1:hasOrigin>SoftwareSpecConstraintRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>isSymmetricConstraint</rdf:label>
<rdfs:comment>An indicator that specifies if the relationship is from  the perspective of just one specification or from both.  For example, A constrains B, and B constrains A.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isUniquePhysical -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isUniquePhysical">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isUniquePhysical</rdf:label>
<rdfs:comment>This is a boolean attribute that, if TRUE, defines this Card to be physically different from other Cards of the same type and therefore requires a special slot. The unique aspects of this Card are described in the UniqueRequirementsPhysical attribute. An example might be a different form factor than other Cards of its type, or the ability to set jumpers on the Card to control its functionality (e.g., clocking).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isUsageMonitoring -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isUsageMonitoring">
<InformationModel_v1:hasOrigin>NetworkProductSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isUsageMonitoring</rdf:label>
<rdfs:comment>A NetworkProductSpec might be monitored or not. The wording monitored means that the user can\'t realise a type of usage if he hasn\'t any FixedVolumePackageProd for this type of usage (i.e. without an empty balance). In this case, the attribute isUsageMonitoring is TRUE.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isUsingHomeRoute -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isUsingHomeRoute">
<InformationModel_v1:hasOrigin>FreControlPlane</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isUsingHomeRoute</rdf:label>
<rdfs:comment>This attribute indicates whether the Connection is currently using the home route or not.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isUTCTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isUTCTime">
<InformationModel_v1:hasOrigin>InstalledSoftware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isUTCTime</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, means that this Software uses absolute (or UTC) time. If FALSE, then it uses LOCAL time.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isVariableSpeed -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isVariableSpeed">
<InformationModel_v1:hasOrigin>Fan</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isVariableSpeed</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, means that this fan supports variable cooling speeds. If it is FALSE, then this fan only provides a single cooling speed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isVirtualizable -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isVirtualizable">
<InformationModel_v1:hasOrigin>HostingPlatformRequirementSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isVirtualizable</rdf:label>
<rdfs:comment>The attribute isVirtualizable specifies if the Capacity required can be virtualized or not.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isWfSupplierEmployeePool -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isWfSupplierEmployeePool">
<InformationModel_v1:hasOrigin>WorkforceEmployeePool</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isWfSupplierEmployeePool</rdf:label>
<rdfs:comment>Indicates whether this pool is managed by the workforce provider company, or by a 3rd-party contractor</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isWfSupplierResourcePool -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isWfSupplierResourcePool">
<InformationModel_v1:hasOrigin>WorkforceResourcePool</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isWfSupplierResourcePool</rdf:label>
<rdfs:comment>Indicates whether this pool is managed by the workforce provider company, or by a 3rd-party contractor</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isWireless -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isWireless">
<InformationModel_v1:hasOrigin>PhysicalLink</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isWireless</rdf:label>
<rdfs:comment>This is a Boolean attribute that defines whether this link is a wireless connection or not. TRUE means that this is a wireless connection, and FALSE means that the connection uses one or more cables and connectors to communicate. This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isWorkingPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isWorkingPeriod">
<InformationModel_v1:hasOrigin>SpecialWorkPeriod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>isWorkingPeriod</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ituArcStateAndStatusList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ituArcStateAndStatusList">
<InformationModel_v1:hasOrigin>ForwardingRelationshipEncapsulation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>ituArcStateAndStatusList</rdf:label>
<rdfs:comment>See R_TMF518_NRB_I_0001 and R_TMF518_NRB_I_0004.   See supporting document SD1-8_encodingX731M3100...\..\Framework\SD\SD1-8_encodingX731M3100.pdf</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ituStateAndStatusList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ituStateAndStatusList">
<InformationModel_v1:hasOrigin>CommonResourceInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>ituStateAndStatusList</rdf:label>
<rdfs:comment>See R_TMF518_NRB_I_0001 and R_TMF518_NRB_I_0004.   See supporting document SD1-8_encodingX731M3100...\..\Framework\SD\SD1-8_encodingX731M3100.pdf</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_jobId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_jobId">
<InformationModel_v1:hasOrigin>ManagementJob</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>jobId</rdf:label>
<rdfs:comment>The ID of the management job.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_jobPriority -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_jobPriority">
<InformationModel_v1:hasOrigin>ManagementJob</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>jobPriority</rdf:label>
<rdfs:comment>The priority of the management job. The way the management application will use the JobPriority to schedule job execution is application specific and outside of the scope.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_keywords -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_keywords">
<InformationModel_v1:hasOrigin>Policy</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>keywords</rdf:label>
<rdfs:comment>This is a string attribute that defines a set of one or more keywords that a policy administrator may use to assist in characterizing or categorizing a policy object to facilitate search operations. The following keywords are pre-defined:  Permitted Values:   Unknown InstallPermissions  ConfigChange InstallMethod  Default Error  Usage InternalError  Security ExternalError  Authentication Notification  Authorization Publish  Accounting Subscribe  Auditing Publish-Subscribe  Service Exception  CustomerFacingService   ResourceFacingService  Notes: Not present in the ITU specs; the CIM defines a PolicyKeyword attribute, but its semantics are very different.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_keyWords -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_keyWords">
<InformationModel_v1:hasOrigin>ResourceFunctionSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>keyWords</rdf:label>
<rdfs:comment>A list of key words that may help in searches to find an RF spec with desired capabilities</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_landCover -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_landCover">
<InformationModel_v1:hasOrigin>Property</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>landCover</rdf:label>
<rdfs:comment>The vegetation (natural or planted) or man made constructions (buildings, etc.) which occur on the earth surface. Water, ice, bare rock, sand and similar surfaces also count as land cover. [Land Use Database]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_landUse -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_landUse">
<InformationModel_v1:hasOrigin>Property</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>landUse</rdf:label>
<rdfs:comment>A series of operations on land, carried out by humans, with the intention to obtain products and/or benefits through using land resources. [Land Use Database]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastModifiedDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastModifiedDate">
<InformationModel_v1:hasOrigin>CalendarEntry</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>lastModifiedDate</rdf:label>
<rdfs:comment>The DateTime (in UTC time) that the entry was lastModifier Note: LAST-MODIFIED [iCalendar]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastModifiedDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastModifiedDateTime">
<InformationModel_v1:hasOrigin>SecurityVulnerability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lastModifiedDateTime</rdf:label>
<rdfs:comment>The last date and time the vulnerability was updated</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastModifiedTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastModifiedTime">
<InformationModel_v1:hasOrigin>ManagementJob</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>lastModifiedTime</rdf:label>
<rdfs:comment>Defines the time when the management job was last modified.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastStartTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastStartTime">
<InformationModel_v1:hasOrigin>InstalledSoftware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lastStartTime</rdf:label>
<rdfs:comment>This is a TimeStamp that defines the last time that this Sofware was started.  A TimeStamp is a complex attribute that contains a Date and a Time.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastUpdateDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastUpdateDateTime">
<InformationModel_v1:hasOrigin>SecurityIncident</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lastUpdateDateTime</rdf:label>
<rdfs:comment>Last date/time the incident was updated.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastUsed -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lastUsed">
<InformationModel_v1:hasOrigin>MetricDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lastUsed</rdf:label>
<rdfs:comment>The date when the MetricDefinition was last used (in a report, study, and so forth).  This attribute provides a quick reference as to how useful the metric is over time.  If the lastUsed data is many years old, then the suggestion is that the MetricDefinition may not be as useful as it once was.  No value means no use of this MetricDefinition has been made thus far, thus making it more of a hypothetical MetricDefintion whose utility has not been demonstrated.  This is derived based on its use as described above.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_layerProtocolName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_layerProtocolName">
<InformationModel_v1:hasOrigin>ForwardingRelationshipEncapsulation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>layerProtocolName</rdf:label>
<rdfs:comment>Provides the name and potentially additional information such as version number for the protocol/layer that the FRE supports. Syntax and semantic to be specified.  Note: allowed value examples: X2, LR Optical Channel.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_layerProtocolNameList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_layerProtocolNameList">
<InformationModel_v1:hasOrigin>NetworkForwardingDomain</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>layerProtocolNameList</rdf:label>
<rdfs:comment>Each entry provides the name and potentially additional information such as version number for (one of) the protocol(s)/layer(s) that the NFD supports. Syntax and semantic to be specified.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_leaseDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_leaseDuration">
<InformationModel_v1:hasOrigin>DHCPSecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>leaseDuration</rdf:label>
<rdfs:comment>The time duration that the IP address has been assigned to the MAC address for.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_legalName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_legalName">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>legalName</rdf:label>
<rdfs:comment>Contains, in one string, a fully formatted name with all of its pieces in their proper place. This includes all of the necessary punctuation Note: if NULL, then derive from the other fields using name policy</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_legalPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_legalPeriod">
<InformationModel_v1:hasOrigin>Organization</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>legalPeriod</rdf:label>
<rdfs:comment>Incorporation date to disincorporation date.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_length -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_length">
<InformationModel_v1:hasOrigin>ComponentEntityIdentificationSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>length</rdf:label>
<rdfs:comment>The value that represents unit of measure for the ComponentEntityIdentificaitonSpec.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_level -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_level">
<InformationModel_v1:hasOrigin>MarketStatistic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>level</rdf:label>
<rdfs:comment>Describes the place the MarketStatistic holds in a hierarchy of MarketStatistics. For example, director, executive, external, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_levelNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_levelNr">
<InformationModel_v1:hasOrigin>UrbanPropertySubAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>levelNr</rdf:label>
<rdfs:comment>A number used where a level type may be repeated e.g. BASEMENT 1, BASEMENT 2. Notes: some level Types do not require a level Nr e.g.  BASEMENT, LOWER GROUND, MEZZANINE, UPPER GROUND</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_levelType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_levelType">
<InformationModel_v1:hasOrigin>UrbanPropertySubAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>levelType</rdf:label>
<rdfs:comment>The level types within a building. Notes: e.g. BASEMENT, FLOOR, LOWER GROUND, LEVEL, MEZZANINE, UPPER GROUND</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_licenseNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_licenseNr">
<InformationModel_v1:hasOrigin>DriversLicenseIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>licenseNr</rdf:label>
<rdfs:comment>A number assigned to a driver's license used to identify it.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_licenseValidityTimePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_licenseValidityTimePeriod">
<InformationModel_v1:hasOrigin>PartyRoleSoftwareLicenseDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>licenseValidityTimePeriod</rdf:label>
<rdfs:comment>This attribute defines a time period for which this license for this particular OperatingSystem is valid.  A TimePeriod is a complex attribute, consisting of a Date and a TimeStamp for the starting period of the license and a Date and a TimeStamp for the ending period of the license.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lifeCycleStage -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lifeCycleStage">
<InformationModel_v1:hasOrigin>CompetitorProductCorrelation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lifeCycleStage</rdf:label>
<rdfs:comment>The stage in the life cycle of the ProductOfferings being correlated. Examples are acquisition, retention, win back, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lifecycleStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lifecycleStatus">
<InformationModel_v1:hasOrigin>Catalog</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lifecycleStatus</rdf:label>
<rdfs:comment>The condition of the catalog, such as active,testing, published</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lineStyle -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lineStyle">
<InformationModel_v1:hasOrigin>LineSymbology</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>lineStyle</rdf:label>
<rdfs:comment>The appearance of the line, such as dashed or dotted.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lineWidth -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lineWidth">
<InformationModel_v1:hasOrigin>LineSymbology</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lineWidth</rdf:label>
<rdfs:comment>The width of a line.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_link -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_link">
<InformationModel_v1:hasOrigin>Attachment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>link</rdf:label>
<rdfs:comment>A kind of unique resource identifier like a file path or url that points to location of the attachment.  "link" and "content" attributes are mutually exclusive.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_linkageReference -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_linkageReference">
<InformationModel_v1:hasOrigin>MetricDefinitionCategory</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>linkageReference</rdf:label>
<rdfs:comment>A reference to other forms of categorization such as Frameworx domains or Business Architecture domains.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_listeningProficiency -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_listeningProficiency">
<InformationModel_v1:hasOrigin>LanguageAbility</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>listeningProficiency</rdf:label>
<rdfs:comment>Degree of mastery in listening to a language.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_locality -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_locality">
<InformationModel_v1:hasOrigin>UrbanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>locality</rdf:label>
<rdfs:comment>"An area of defined or undefined boundaries within a local authority or other legislatively defined area, usually rural or semi rural in nature." [ANZLIC-STREET], or a suburb "a bounded locality within a city, town or shire principally of urban character " [ANZLIC-STREET]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_localOrientation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_localOrientation">
<InformationModel_v1:hasOrigin>LocalCoordinateSystem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>localOrientation</rdf:label>
<rdfs:comment>The orientation of the LocalCoordinateSystem, such as directional (north, south) or facing (front, back,side), angle of rotation from the axes of the LocalCoordinateSystem.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_locationInChassis -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_locationInChassis">
<InformationModel_v1:hasOrigin>ChassisPosition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>locationInChassis</rdf:label>
<rdfs:comment>Some Racks have movable "shelves" that Chassis can fit into. In order to identify the position that the Chassis occupies, a pair of measurements - number of Us from the top of the Rack and number of Us from the left side of the Rack - are provided as a comma-delimited string. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_locationRole -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_locationRole">
<InformationModel_v1:hasOrigin>BusinessInteractionLocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>locationRole</rdf:label>
<rdfs:comment>The locationRole specifies the role of the location (i.e. related Place) for the BusinessInteraction or BusinessInteractionItem. For example, it can be "installation" when related to a PartyOrderItem.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lockPresent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lockPresent">
<InformationModel_v1:hasOrigin>SecureHolder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lockPresent</rdf:label>
<rdfs:comment>This is a boolean attribute that, if TRUE, indicates that this SecureHolder is protected by some type of lock. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_logData -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_logData">
<InformationModel_v1:hasOrigin>AnomalySecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>logData</rdf:label>
<rdfs:comment>Text from logs that captured information relevant to the event.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_logo -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_logo">
<InformationModel_v1:hasOrigin>Logo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>logo</rdf:label>
<rdfs:comment>Logo of Organization.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lotNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lotNr">
<InformationModel_v1:hasOrigin>Property</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lotNr</rdf:label>
<rdfs:comment>A number assigned to a Property lot that is used to identify it.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lowerSize -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lowerSize">
<InformationModel_v1:hasOrigin>SegmentSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lowerSize</rdf:label>
<rdfs:comment>The lowerSize specifies the targeted minimum size of the calculated Segment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lrStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_lrStatus">
<InformationModel_v1:hasOrigin>LogicalResource</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>lrStatus</rdf:label>
<rdfs:comment>This is an enumerated integer whose value indicates the current status of the object. The following values are defined:  0: Unknown  1: OK  2: Initializing  3: Starting  4: Paused  5: Stopping  6: Stopped  7: Degraded  8: Stressed   9: Predicted Failure  10: Error - General  11: Error - Non Recoverable  12: Not Installed or Not Present  13: In Maintenance  14: Unable To Contact  15: Lost Communications  Stopped indicates that the LogicalResource is known to still exist, but it is no longer operational. However, it has not failed.  Stressed indicates that the LogicalResource is functioning, but needs attention (e.g., it may be overheating, or overloaded in some way). This is similar to Predicted Failure, which indicates that this LogicalResource is functioning properly, but is predicting a failure in the near future.  In Maintenance indicates that this LogicalResource is being configured, maintained, or otherwise administered and is NOT available for service.  Unable To Contact indicates that the monitoring system has knowledge of this LogicalResource but has never been able to establish communications with it. In contrast, Lost Commmunications indicates that the LogicalResource has been contacted successfully in the past and is known to still exist; however, it is currently unreachable.  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_macAddress -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_macAddress">
<InformationModel_v1:hasOrigin>NACSecurityEventSubject</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>macAddress</rdf:label>
<rdfs:comment>Media Access Control address of the device considered for network access</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_macAddressList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_macAddressList">
<InformationModel_v1:hasOrigin>MACVariable</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>macAddressList</rdf:label>
<rdfs:comment>This attribute is an unordered list of strings, each specifying a MAC address or a range of MAC addresses. The 802 MAC address canonical format is used: MACaddress = 1*4HEXDIG ":" 1*4HEXDIG ":" 1*4HEXDIG MACmaskedaddress = MACaddress","MACaddress Each string entry is either: 1. A single MAC address. Example: 0000:00A5:0000 2. A MACmaskedaddress address range defined specified by an address and mask. The mask specifies the relevant bits in the address. Example: 0000:00A5:0000, FFFF:FFFF:0000  defines a range of MAC addresses in which the first 4 8-bit  bytes are equal to 0000:00A5</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_macDirection -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_macDirection">
<InformationModel_v1:hasOrigin>MACVariable</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>macDirection</rdf:label>
<rdfs:comment>This is an enumerated integer that defines if this variable is used to represent source addresses, destination addresses, or both.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_macFormat -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_macFormat">
<InformationModel_v1:hasOrigin>MACAddressValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>macFormat</rdf:label>
<rdfs:comment>This is an enumerated integer that defines how the MAC Address is represented. Values are: 0: a single address (e.g., 0000:00A5:0000) 1: an address with mask (e.g., 0000:00A5:0000, FFFF:FFFF:0000)</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_macValueList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_macValueList">
<InformationModel_v1:hasOrigin>MACAddressValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>macValueList</rdf:label>
<rdfs:comment>This is an array of strings, each of which contains a MAC Address. Each string must be of the same format, which is specified in the macFormat attribute of this object.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mailingDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mailingDate">
<InformationModel_v1:hasOrigin>OffCyclePartyBill</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>mailingDate</rdf:label>
<rdfs:comment>A party bill mailing date.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mailingDateOffset -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mailingDateOffset">
<InformationModel_v1:hasOrigin>PartyBillingCycleSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>mailingDateOffset</rdf:label>
<rdfs:comment>An offset of a party bill mailing date. The offset is expressed as number of days with regard to the start of the BillingPeriod.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maintenanceVersion -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maintenanceVersion">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>maintenanceVersion</rdf:label>
<rdfs:comment>This a string attribute that defines the maintenance number component of the version of SoftwareResourceSpecification. For example, if the version is 3.1.10, the maintenance version is 10.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_majorVersion -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_majorVersion">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>majorVersion</rdf:label>
<rdfs:comment>This a string attribute that defines the major number component of the version of the SoftwareResourceSpecification. For example, if the version is 3.1.10, the major version is 3.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_managedObjectClass -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_managedObjectClass">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>managedObjectClass</rdf:label>
<rdfs:comment>Identifies, in terms of object class, the resource that is in alarm.  This attribute is mandatory in all 3 profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_managementMethodCurrent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_managementMethodCurrent">
<InformationModel_v1:hasOrigin>ManagedEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>managementMethodCurrent</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the particular type of management method that is currently being used.  Permitted Values: 0: Unknown 1: None 2: CLI 3: SNMP 4: TL1 5: CMIP 6: Proprietary Notes:No analog in M.3100 or the DMTF CIM.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_managementMethodSupported -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_managementMethodSupported">
<InformationModel_v1:hasOrigin>ManagedEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>managementMethodSupported</rdf:label>
<rdfs:comment>This is an array of integers that define the different management methods that are supported by this object.  Permitted Values: 0: Unknown 1: None 2: CLI 3: SNMP 4: TL1 5: CMIP 6: Proprietary Notes: No analog in M.3100 or the DMTF CIM.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mandatory -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mandatory">
<InformationModel_v1:hasOrigin>MetricDefinitionDimensionUse</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>mandatory</rdf:label>
<rdfs:comment>Indicates whether this dimension is mandatory for this use.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_manner -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_manner">
<InformationModel_v1:hasOrigin>GoalStrategy</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>manner</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_manufactureDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_manufactureDate">
<InformationModel_v1:hasOrigin>PhysicalResource</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>manufactureDate</rdf:label>
<rdfs:comment>This is a string attribute that defines the date of manufacture of this item in the fixed format "dd/mm/yyyy". This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_manufacturer -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_manufacturer">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>manufacturer</rdf:label>
<rdfs:comment>This attribute identifies the equipment manufacturer name. It is defined as a non-empty free format string with no semantics.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maritalStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maritalStatus">
<InformationModel_v1:hasOrigin>Individual</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>maritalStatus</rdf:label>
<rdfs:comment>Permitted Values: married, never married, divorced, widowed</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_marketedBy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_marketedBy">
<InformationModel_v1:hasOrigin>PartyRoleProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>marketedBy</rdf:label>
<rdfs:comment>An indicator that specifies if the PartyRoleProductOffering is marketed by the related PartyRole.  For example a Competitor PartyRole may only have this attribute set to true and the other boolean attributes set to false.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxAmount">
<InformationModel_v1:hasOrigin>PaymentPlan</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maxAmount</rdf:label>
<rdfs:comment>The maximum amount of the Payment when at least one PaymentMethod is declared so that the company generates each Payment. For example, with a due debt of $250, and a maxPaymentAmount of $100, 2 payments of $100 will be generated and the last one will be $50.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxCardinality -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxCardinality">
<InformationModel_v1:hasOrigin>MarketSegmentCharacteristic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maxCardinality</rdf:label>
<rdfs:comment>The maximum number of instances a CharacteristicValue can take on. For example, zero to five phone numbers in a group calling plan, where five is the value for the maxCardinality.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxDataWidth -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxDataWidth">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maxDataWidth</rdf:label>
<rdfs:comment>This is an integer that defines the maximum bus width of this Card. Values include:  0: Unknown  1: Special  8: 8 bit data bus  16: 16 bit data bus  24: 24 bit data bus  32: 32 bit data bus  64: 64 bit data bus  128: 128 bit data bus  The value "1" can be used for any non-standard data bus width.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxExtensions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxExtensions">
<InformationModel_v1:hasOrigin>ScheduledDuration</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>maxExtensions</rdf:label>
<rdfs:comment>The maximal number of expected extensions.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maximum -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maximum">
<InformationModel_v1:hasOrigin>PhysicalMemoryCapacity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maximum</rdf:label>
<rdfs:comment>This defines the maximum amount of memory, in Kbytes, that can be supported by this ManagedHardware instance. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maximumCost -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maximumCost">
<InformationModel_v1:hasOrigin>FreControlPlane</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maximumCost</rdf:label>
<rdfs:comment>This attribute defines a number that indicates the maximum cost allowed for an FRE. The cost of an FRE is calculated based on the cost of the supporting links. This link cost represents a vector of one or more metrics, each of which indicates the relative desirability of a particular link over another during path selection.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maximumLength -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maximumLength">
<InformationModel_v1:hasOrigin>PhysicalLink</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maximumLength</rdf:label>
<rdfs:comment>This is a string attribute that defines the maximum allowable length of the PhysicalLink in feet. For some connections, such as wireless connections, this property may not be applicable and should be assigned the special value of NULL. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maximumNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maximumNumber">
<InformationModel_v1:hasOrigin>RootEntityRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maximumNumber</rdf:label>
<rdfs:comment>Mzximum number of instances of RootEntity according to the type of RootEntityRelationship.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maximumPay -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maximumPay">
<InformationModel_v1:hasOrigin>PayRange</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maximumPay</rdf:label>
<rdfs:comment>Maximum pay for this Pay Range. This will be defined at global alignment. This field will define the maximum amount an employee can get paid that sit in a particular pay range. </rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxNumberLicenses -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxNumberLicenses">
<InformationModel_v1:hasOrigin>PartyRoleSoftwareLicenseDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maxNumberLicenses</rdf:label>
<rdfs:comment>This attribute defines the maximum number of licenses that be allotted for this particular OperatingSystem instance.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxNumberProcesses -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxNumberProcesses">
<InformationModel_v1:hasOrigin>PartyRoleUsesProcessesDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maxNumberProcesses</rdf:label>
<rdfs:comment>This attribute defines the maximum number of processes that can be allocated to a particular PartyRole.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxPowerSupplies -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxPowerSupplies">
<InformationModel_v1:hasOrigin>PowerCapacity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maxPowerSupplies</rdf:label>
<rdfs:comment>This is an integer that defines the maximum number of power supplies that can be installed in the Equipment. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxTrialTimes -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_maxTrialTimes">
<InformationModel_v1:hasOrigin>PaymentPlan</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>maxTrialTimes</rdf:label>
<rdfs:comment>Maximum number of trial to submit a payment if it has been rejected.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mcType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mcType">
<InformationModel_v1:hasOrigin>MarketingCampaign</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>mcType</rdf:label>
<rdfs:comment>A categorization of a MarketingCampaign, such as new or re-launch.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_meanExtensions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_meanExtensions">
<InformationModel_v1:hasOrigin>ScheduledDuration</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>meanExtensions</rdf:label>
<rdfs:comment>The mean number of expected extensions.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_measureDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_measureDateTime">
<InformationModel_v1:hasOrigin>MetricMeasureGroup</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>measureDateTime</rdf:label>
<rdfs:comment>Specifies the date and time of the MetricMeasureGroup.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_measurementUnits -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_measurementUnits">
<InformationModel_v1:hasOrigin>Hardware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>measurementUnits</rdf:label>
<rdfs:comment>This attribute defines the MeasurementUnits for the Depth, Height, and Width attributes of this object. Values include:  0: Unknown (or not measured)  1: inches  2: feet  3: millimeters  4: centimeters  5: meters  This is an optional attribute. However, if any of the Depth, Height, or Width attributes are defined, then this attribute is REQUIRED.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mediaType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mediaType">
<InformationModel_v1:hasOrigin>PhysicalLink</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>mediaType</rdf:label>
<rdfs:comment>This is an enumerated integer, and is used to define the particular type of media that is used to carry communication. Values include:  0: Unknown  1: Wireless  2: Cat1  3: Cat2  4: Cat3  5: Cat4  6: Cat5  7: 50-ohm Coaxial  8: 75-ohm Coaxial  9: 100-ohm Coaxial  10: Fiber-optic  11: UTP  12: STP  13: Ribbon Cable  14: Twinaxial  15: Optical 9um  16: Optical 50um  17: Optical 62.5um  This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_memberSequence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_memberSequence">
<InformationModel_v1:hasOrigin>RootEntityGroupMemberExpression</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>memberSequence</rdf:label>
<rdfs:comment>The order in which a RootEntityGroupMember appears in this part of an expression.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_memorySize -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_memorySize">
<InformationModel_v1:hasOrigin>FlashDisk</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>memorySize</rdf:label>
<rdfs:comment>This is the size of the Flash disk in MBytes.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_memoryType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_memoryType">
<InformationModel_v1:hasOrigin>PhysicalMemoryCapacity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>memoryType</rdf:label>
<rdfs:comment>This is an enumerated integer, and defines the type of memory that this ManagedHardware object instance can have. Values include:  O: Unknown  1: DRAM  2: Synchronous DRAM  3: Cache DRAM  4: RAM  5: SRAM  6: VRAM  7: EDRAM  8: EDO  9: ROM  10: PROM  11: EPROM  12: EEPROM  13: FEPROM  14: CDRAM  15: 3DRAM  16: SDRAM  17: SGRAM  18: RDRAM  19: Flash  20: DDR  This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_message -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_message">
<InformationModel_v1:hasOrigin>ShipmentCheckPoint</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>message</rdf:label>
<rdfs:comment>Message to be communicated to the contact</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_metDefType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_metDefType">
<InformationModel_v1:hasOrigin>MetDefDescExtension</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>metDefType</rdf:label>
<rdfs:comment>Type of description extension, such as comments, MetricDefinition owner notes, references, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_metricDefMeasureApplicability -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_metricDefMeasureApplicability">
<InformationModel_v1:hasOrigin>MetricDefMeasureExpression</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>metricDefMeasureApplicability</rdf:label>
<rdfs:comment>An indicator that is set to true if a MetricDefMeasureApplicability is part of the MetricDefMeasureExpresssion.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_metricDefMeasureConsequence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_metricDefMeasureConsequence">
<InformationModel_v1:hasOrigin>MetricDefMeasureExpression</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>metricDefMeasureConsequence</rdf:label>
<rdfs:comment>An indicator that is set to true if a MetricDefMeasureConsequence is part of the MetricDefMeasureExpresssion.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_metricDefMeasureThresholdRule -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_metricDefMeasureThresholdRule">
<InformationModel_v1:hasOrigin>MetricDefMeasureExpression</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>metricDefMeasureThresholdRule</rdf:label>
<rdfs:comment>An indicator that is set to true if a MetricDefMeasureThresholdRule is part of the MetricDefMeasureExpresssion.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_metricLevel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_metricLevel">
<InformationModel_v1:hasOrigin>MetricDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>metricLevel</rdf:label>
<rdfs:comment>A number assigned to a MetricDefnition based on the importance enterprise-wide.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mgmtInfoValidFor -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mgmtInfoValidFor">
<InformationModel_v1:hasOrigin>ManagementInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>mgmtInfoValidFor</rdf:label>
<rdfs:comment>This attribute defines the time period that this management information is valid for. A TimePeriod is a complex datatype, that has a starting time and an ending time.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_middleNames -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_middleNames">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>middleNames</rdf:label>
<rdfs:comment>Middle name(s) or initial(s) Note: Multiple fields may be entered with a delimiter in-between or stored in a collection</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mimeType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mimeType">
<InformationModel_v1:hasOrigin>Attachment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>mimeType</rdf:label>
<rdfs:comment>A technical characterization of the attachment content format using IETF Mime Types such as mp4 for audio, bmp, gif jpeg for image.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minCardinality -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minCardinality">
<InformationModel_v1:hasOrigin>MarketSegmentCharacteristic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>minCardinality</rdf:label>
<rdfs:comment>The minimum number of instances a CharacteristicValue can take on. For example, zero to five phone numbers in a group calling plan, where zero is the value for the minCardinality.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minimum -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minimum">
<InformationModel_v1:hasOrigin>PhysicalMemoryCapacity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>minimum</rdf:label>
<rdfs:comment>This defines the minimum amount of memory, in Kbytes, that can be supported by this ManagedHardware instance. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minimumNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minimumNumber">
<InformationModel_v1:hasOrigin>RootEntityRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>minimumNumber</rdf:label>
<rdfs:comment>Minimum number of instances of RootEntity according to the type of RootEntityRelationship.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minimumPay -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minimumPay">
<InformationModel_v1:hasOrigin>PayRange</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>minimumPay</rdf:label>
<rdfs:comment>Minimum pay for this Pay Range. This will be defined at global alignment. This field will define the minimum amount an employee can get paid that sit in a particular pay range. </rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minorVersion -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minorVersion">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>minorVersion</rdf:label>
<rdfs:comment>This a string attribute that defines the minor number component of the version of SoftwareResourceSpecification. For example, if the version is 3.1.10, the minor version is 1.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minVersionForUse -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_minVersionForUse">
<InformationModel_v1:hasOrigin>CFSSpecVersionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>minVersionForUse</rdf:label>
<rdfs:comment>This attribute defines the minimal version of this CustomerFacingServiceSpecification to use.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mode -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mode">
<InformationModel_v1:hasOrigin>Test</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>mode</rdf:label>
<rdfs:comment>An indication of whether the test is running in "PROACTIVE" or "ONDEMAND" mode</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_modelNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_modelNumber">
<InformationModel_v1:hasOrigin>PhysicalResourceSpecAttributes</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>modelNumber</rdf:label>
<rdfs:comment>This is a string that represents a manufacturer-allocated number used to identify the general type and/or category of the hardware item. This, in combination with the PartNumber and the VendorName, identify different types of hardware items. The SerialNumber can then be used to differentiate between different instances of the same type of hardware item. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_modifier -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_modifier">
<InformationModel_v1:hasOrigin>PlacePhysicalResourceAssoc</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>modifier</rdf:label>
<rdfs:comment>A limitation or qualification of the association.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_monitoredObjectClass -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_monitoredObjectClass">
<InformationModel_v1:hasOrigin>MonitoredClassCriteria</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>monitoredObjectClass</rdf:label>
<rdfs:comment>A  monitored object class for specifying the set of instances that are referenced by a PM query.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_monitoredObjectInstances -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_monitoredObjectInstances">
<InformationModel_v1:hasOrigin>MonitoredInstancesCriteria</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>monitoredObjectInstances</rdf:label>
<rdfs:comment>A list of object identifiers for specifying what monitored objects need to be referenced by a PM query.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_monthlyDaysOfWeekInstance -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_monthlyDaysOfWeekInstance">
<InformationModel_v1:hasOrigin>MonthlyScheduleDayOfWeekDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>monthlyDaysOfWeekInstance</rdf:label>
<rdfs:comment>The instance of a selected day in the monthly schedule definition, 1-5 or "last" instance. For example: the 2nd Monday in a month.This works in conjunction with the daysOfWeek attribute Permitted Values: 1-4, last</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_monthOfYearMask -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_monthOfYearMask">
<InformationModel_v1:hasOrigin>PolicyConditionTimePeriod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>monthOfYearMask</rdf:label>
<rdfs:comment>The monthOfYearMask attribute is a string that refines the definition of the valid time period that is defined by the timePeriod attribute. This is done by explicitly specifying the months when the policy is valid. Thus, the timePeriod attribute is used to specify the overall time period during which the policy might be valid, and the monthOfYearMask attribute is used to pick out the specific months within that time period when the PolicyRule is valid. This attribute consists of a fixed string of 16 bits. The first 12 bits correspond to the 12 months of the year, beginning with January and ending with December. The last 4 bits are always set to "0". For each month, the value "1" indicates that the policy is valid for that month, and the value "0" indicates that it is not valid. If this attribute is not specified, then the PolicyRule is treated as valid for all twelve months. Notes: Not present in the ITU specs. The CIM defines a similar attribute called MonthOfYearMask.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_motive -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_motive">
<InformationModel_v1:hasOrigin>SecurityThreatActor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>motive</rdf:label>
<rdfs:comment>A description of the motives ascribed to a given threat.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mountingOptions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mountingOptions">
<InformationModel_v1:hasOrigin>HolderComposite</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>mountingOptions</rdf:label>
<rdfs:comment>This is an enumerated 16-bit unsigned integer that defines how Equipment in this entity is mounted. Values include:  0: Unknown  1: Stand-alone  2: Rack-mounted, free access  3: Rack-mounted, restricted access  4: Enclosed in another chassis  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mtosiSpecificAlarmAttributes -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_mtosiSpecificAlarmAttributes">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>mtosiSpecificAlarmAttributes</rdf:label>
<rdfs:comment>This attribute groups wireline specific alarm attributes coming from MTOSI.  It is present to ease migration from MTOSI RTM implementation and can be considered as conditional for MTOSI.   This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_multiplicity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_multiplicity">
<InformationModel_v1:hasOrigin>AssociationRoleSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>multiplicity</rdf:label>
<rdfs:comment>A number that specifies how many instances of RootEntityType can be involved in an association role.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nameOnCard -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nameOnCard">
<InformationModel_v1:hasOrigin>BankCardPM</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nameOnCard</rdf:label>
<rdfs:comment>The name of the person who owns the card.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nameType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nameType">
<InformationModel_v1:hasOrigin>OrganizationName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nameType</rdf:label>
<rdfs:comment>Co., Inc., Ltd., Pty Ltd. , Plc., Gmbh</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_namingOsRef -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_namingOsRef">
<InformationModel_v1:hasOrigin>CommonObjectInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>likelyToChange</InformationModel_v1:hasStereotype>
<rdf:label>namingOsRef</rdf:label>
<rdfs:comment>This attribute represents an identifier for the steward of the object.  See R_TMF518_FMW_I_0001.This attribute represents an identifier for the steward of the object, intended as the OS that sets the name of the object. The namingOS attribute is set by the OS that is responsible for setting the "name" of the object.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nationality -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nationality">
<InformationModel_v1:hasOrigin>Individual</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>nationality</rdf:label>
<rdfs:comment>Note: Pointer to a country object</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nativeEmsName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nativeEmsName">
<InformationModel_v1:hasOrigin>CommonObjectInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>likelyToChange</InformationModel_v1:hasStereotype>
<rdf:label>nativeEmsName</rdf:label>
<rdfs:comment>This attribute contains the native EMS Name of the object. It represents how an EMS user addresses an object on the EMS GUI. Its aim is to provide a "nomenclature bridge" for relating information presented on NMS displays and EMS displays (via GUI cut through).  The EMS may or may not support changing this value.This attribute contains a list of aliases for the entity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_navigable -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_navigable">
<InformationModel_v1:hasOrigin>AssociationRoleSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>navigable</rdf:label>
<rdfs:comment>An indicator that indicates if navigation can be made to a RootEntityType involved in an association.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nbrConsumedAssets -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nbrConsumedAssets">
<InformationModel_v1:hasOrigin>CommunityMember</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nbrConsumedAssets</rdf:label>
<rdfs:comment>Number of assets consumed from the Community</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nbrContributions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nbrContributions">
<InformationModel_v1:hasOrigin>CommunityMember</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nbrContributions</rdf:label>
<rdfs:comment>Number of assets provided to the Community</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nbrOfMembers -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nbrOfMembers">
<InformationModel_v1:hasOrigin>Community</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nbrOfMembers</rdf:label>
<rdfs:comment>The number of members committed to the community</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nbrRelatedMembers -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nbrRelatedMembers">
<InformationModel_v1:hasOrigin>CommunityMember</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nbrRelatedMembers</rdf:label>
<rdfs:comment>Number of associated CommunityMembers</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_needsLoyaltyAccount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_needsLoyaltyAccount">
<InformationModel_v1:hasOrigin>LoyaltyProgramProdSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>needsLoyaltyAccount</rdf:label>
<rdfs:comment>If TRUE, a LoyaltyAccount is needed for each LoyaltyProgramProduct created according to the LoyaltyProgramProdSpec.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_negotiableRangeLowerAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_negotiableRangeLowerAmount">
<InformationModel_v1:hasOrigin>RevShareModelSpecNegotiableRange</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>negotiableRangeLowerAmount</rdf:label>
<rdfs:comment>The lower negotiable limiit for an amount.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_negotiableRangeLowerQuantity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_negotiableRangeLowerQuantity">
<InformationModel_v1:hasOrigin>RevShareModelSpecNegotiableRange</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>negotiableRangeLowerQuantity</rdf:label>
<rdfs:comment>The lower negotiable limiit for a quantity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_negotiableRangeUpperAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_negotiableRangeUpperAmount">
<InformationModel_v1:hasOrigin>RevShareModelSpecNegotiableRange</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>negotiableRangeUpperAmount</rdf:label>
<rdfs:comment>The upper negotiable limit for an amount.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_negotialbleRangeUpperQuantity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_negotialbleRangeUpperQuantity">
<InformationModel_v1:hasOrigin>RevShareModelSpecNegotiableRange</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>negotialbleRangeUpperQuantity</rdf:label>
<rdfs:comment>The upper negotiable limiit for a quantity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_networkAccessDomain -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_networkAccessDomain">
<InformationModel_v1:hasOrigin>CommonResourceInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>likelyToChange</InformationModel_v1:hasStereotype>
<rdf:label>networkAccessDomain</rdf:label>
<rdfs:comment>This attribute contains a free-format string used to associate the resource to a Network Access Domain.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_networkInd -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_networkInd">
<InformationModel_v1:hasOrigin>PerformancePointCode</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>networkInd</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_networkNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_networkNumber">
<InformationModel_v1:hasOrigin>IPAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>networkNumber</rdf:label>
<rdfs:comment>This contains the network number portion of the IP Address.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nfdLevel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nfdLevel">
<InformationModel_v1:hasOrigin>NetworkForwardingDomain</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nfdLevel</rdf:label>
<rdfs:comment>This attribute expresses the level  of the NFD in the hierarchy of NFDs</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nfdRole -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nfdRole">
<InformationModel_v1:hasOrigin>NetworkForwardingDomain</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nfdRole</rdf:label>
<rdfs:comment>This attribute identifies purpose for the grouping provided by the NFD.  The NFD could be:  - ROUTING_AREA  - FORWARDING_AREA  - ADMINISTRATIVE_AREA</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nfdType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nfdType">
<InformationModel_v1:hasOrigin>NetworkForwardingDomain</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nfdType</rdf:label>
<rdfs:comment>This attribute  provides the name of the type of the NFD. The type is an expression of the contained topology.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nickName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nickName">
<InformationModel_v1:hasOrigin>Avatar</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nickName</rdf:label>
<rdfs:comment>Nick name used to welcome when connecting.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_normalDays -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_normalDays">
<InformationModel_v1:hasOrigin>AnomalyIndicatorSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>normalDays</rdf:label>
<rdfs:comment>Normal values of the AnomalyIndicator used for training the AI/Model</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_normalDaysDataSource -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_normalDaysDataSource">
<InformationModel_v1:hasOrigin>AnomalyIndicatorSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>normalDaysDataSource</rdf:label>
<rdfs:comment>Data source URL where the normal values of the AnomalyIndicator used for training the AI/Model is stored</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_notes -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_notes">
<InformationModel_v1:hasOrigin>SecurityVulnerabilityFixAction</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>notes</rdf:label>
<rdfs:comment>General notes on the SecurityVulnerabilityFixAction</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nrDecimals -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nrDecimals">
<InformationModel_v1:hasOrigin>ComponentEntityIdentificationSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nrDecimals</rdf:label>
<rdfs:comment>A value that represents the number of digits in the ComponentEntityIndentificationSpec.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nrDigits -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_nrDigits">
<InformationModel_v1:hasOrigin>ComponentEntityIdentificationSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>nrDigits</rdf:label>
<rdfs:comment>A value that represents the number of digits in the ComponentEntityIndentificationSpec.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_number -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_number">
<InformationModel_v1:hasOrigin>ProductSpecificationVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>number</rdf:label>
<rdfs:comment>A number that represents the occurrence of the version in the sequence of versions.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfAllowedCrossing -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfAllowedCrossing">
<InformationModel_v1:hasOrigin>AnomalyThresholdRule</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numberOfAllowedCrossing</rdf:label>
<rdfs:comment>The number of allowed crossing occurrences in reference to the tolerancePeriod without a consequence being initiated.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfBytes -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfBytes">
<InformationModel_v1:hasOrigin>NetFlowSecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numberOfBytes</rdf:label>
<rdfs:comment>Total number of bytes captured in a network flow</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfChassisSlots -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfChassisSlots">
<InformationModel_v1:hasOrigin>Chassis</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numberOfChassisSlots</rdf:label>
<rdfs:comment>This defines the number of Slots that are in the Chassis. This does NOT account for any SlotAdapters used - these are described by the CardInSlot association. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfDevicesCurrent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfDevicesCurrent">
<InformationModel_v1:hasOrigin>PhysicalDeviceComposite</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numberOfDevicesCurrent</rdf:label>
<rdfs:comment>This attribute defines the current number of PhysicalDevices aggregated by this PhysicalDeviceComposite object that are active and manageable.  Note that this aggregation is for that particular level of aggregation. Thus, if a PhysicalDeviceComposite, called A, contains another PhysicalDeviceComposite, called B, then B's instance of this attribute will define how many PhysicalDevices are aggregated by B, whereas A's instance of this attribute will defined how many PhysicalDevices are aggregated by A (which includes those aggregated by B).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfDevicesTotal -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfDevicesTotal">
<InformationModel_v1:hasOrigin>PhysicalDeviceComposite</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numberOfDevicesTotal</rdf:label>
<rdfs:comment>This attribute defines the total number of PhysicalDevices aggregated by this PhysicalDeviceComposite object. Note that this aggregation is for that particular level of aggregation. Thus, if a PhysicalDeviceComposite, called A, contains another PhysicalDeviceComposite, called B, then B's instance of this attribute will define how many PhysicalDevices are aggregated by B, whereas A's instance of this attribute will defined how many PhysicalDevices are aggregated by A (which includes those aggregated by B).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfPackets -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberOfPackets">
<InformationModel_v1:hasOrigin>NetFlowSecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numberOfPackets</rdf:label>
<rdfs:comment>Total number of packets in the network flow</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberProcessActiveTotal -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberProcessActiveTotal">
<InformationModel_v1:hasOrigin>SoftwareSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numberProcessActiveTotal</rdf:label>
<rdfs:comment>This is an integer attribute that defines the maximum number of total processes that a SoftwareSpecifciation can support at any given time.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberProcessesActiveCurrent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberProcessesActiveCurrent">
<InformationModel_v1:hasOrigin>InstalledSoftware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numberProcessesActiveCurrent</rdf:label>
<rdfs:comment>This is an integer attribute that defines the current number of total processes that the Software can support at any given time.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberRelCatLowerLimit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberRelCatLowerLimit">
<InformationModel_v1:hasOrigin>PerformanceCatSpecRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numberRelCatLowerLimit</rdf:label>
<rdfs:comment>The lower limit of the number of PerformanceCategories that can related. Values can range from 0 to unbounded.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberRelCatUpperLimit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberRelCatUpperLimit">
<InformationModel_v1:hasOrigin>PerformanceCatSpecRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numberRelCatUpperLimit</rdf:label>
<rdfs:comment>The upper limit of the number of PerformanceCategories that can related. Values can range from 0 to unbounded.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberRelOfferLowerLimit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberRelOfferLowerLimit">
<InformationModel_v1:hasOrigin>BundledProdOfferOption</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>numberRelOfferLowerLimit</rdf:label>
<rdfs:comment>The lower limit of related ProductOfferings that can be procured as part of the BundledProductOffering.  Values can range from 0 to unbounded.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberRelOfferUpperLimit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numberRelOfferUpperLimit">
<InformationModel_v1:hasOrigin>BundledProdOfferOption</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>numberRelOfferUpperLimit</rdf:label>
<rdfs:comment>The upper limit of related ProductOfferings that can be procured as part of the BundledProductOffering.  Values can range from 0 to unbounded.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numOfIPs -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numOfIPs">
<InformationModel_v1:hasOrigin>PerformanceIPAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numOfIPs</rdf:label>
<rdfs:comment>A number that represents the number of IP addresses specified by a range of IP Addresses in the ipAddress attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numUsersCurrent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numUsersCurrent">
<InformationModel_v1:hasOrigin>InstalledSoftware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numUsersCurrent</rdf:label>
<rdfs:comment>This is a non-negative integer that defines the current number of users of the Sofware.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numUsersMax -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_numUsersMax">
<InformationModel_v1:hasOrigin>SoftwareSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>numUsersMax</rdf:label>
<rdfs:comment>This is a non-negative integer that defines the maximum number of users for a SoftwareSpecifciation.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_objectInstanceFilter -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_objectInstanceFilter">
<InformationModel_v1:hasOrigin>MonitoredClassCriteria</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>objectInstanceFilter</rdf:label>
<rdfs:comment>A filter that can be used in conjunction with the  monitored object class for specifying the set of instancesthat are referenced by a PM query.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_observationPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_observationPeriod">
<InformationModel_v1:hasOrigin>MetricMeasurementObservation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>observationPeriod</rdf:label>
<rdfs:comment>Period during wich the observation (measurements) are done.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_observedValue -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_observedValue">
<InformationModel_v1:hasOrigin>CrossedThreshold</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>observedValue</rdf:label>
<rdfs:comment>Indicates the observed value: the value of the indicator which crossed the threshold.  This may be different from the threshold value if, for example, the indicator is a gauge and this gauge only takes on discrete values.  If the threshold applies to a single indicator, then this attribute is mandatory. It can only be omitted for complex threshold involving multiple indicators.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_offCycleProductionReason -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_offCycleProductionReason">
<InformationModel_v1:hasOrigin>OffCyclePartyBill</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>offCycleProductionReason</rdf:label>
<rdfs:comment>The reason for this off cycle run reason, values may be CUSTOMER_REQUEST, ACCOUNT_CLOSE or others</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_offerID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_offerID">
<InformationModel_v1:hasOrigin>ChargingCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>offerID</rdf:label>
<rdfs:comment>The identifier of an offer like a mobile service for which this charging capability applied.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_offerLowerLimit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_offerLowerLimit">
<InformationModel_v1:hasOrigin>BundledProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>offerLowerLimit</rdf:label>
<rdfs:comment>The attribute offerUpperLimit specifies the maximum number of ProductOfferings that can be ordered in the BundledProductOffering.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_offerUpperLimit -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_offerUpperLimit">
<InformationModel_v1:hasOrigin>BundledProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>offerUpperLimit</rdf:label>
<rdfs:comment>The attribute offerLowerLimit specifies the minimum number of ProductOfferings that must be ordered in the BundledProductOffering.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operationalState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operationalState">
<InformationModel_v1:hasOrigin>ServiceAccessPoint</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>operationalState</rdf:label>
<rdfs:comment>Indicates whether the set of resources supporting the service are installed and working.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operator -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operator">
<InformationModel_v1:hasOrigin>SecVulnerabilityGeneralMbr</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>operator</rdf:label>
<rdfs:comment>A mathematical symbol, term, or other entity that describes an operation.  Notes:  For example, case of, *, /.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operatorAccess -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operatorAccess">
<InformationModel_v1:hasOrigin>PolicyAppliesToDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>operatorAccess</rdf:label>
<rdfs:comment>This attribute defines the access privileges that a user (human or otherwise) has when performing various operations on a ManagedEntity residing in a specific PolicyDomain.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operatorConstraint -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operatorConstraint">
<InformationModel_v1:hasOrigin>OperatorConstraintDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>operatorConstraint</rdf:label>
<rdfs:comment>This attribute is a string that contains the specific OCL expression to define which PolicyOperators are allowed to be used in this particular PolicyStatement. Defining this as an attribute enables external applications to populate this constraint.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operatorSequence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operatorSequence">
<InformationModel_v1:hasOrigin>RootEntityGroupMemberExpression</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>operatorSequence</rdf:label>
<rdfs:comment>The order in which an operator appears in this part of an expression.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_operState">
<InformationModel_v1:hasOrigin>AnomalyReport</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>operState</rdf:label>
<rdfs:comment>Operational state of associated Anomaly </rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_opType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_opType">
<InformationModel_v1:hasOrigin>PolicyOperator</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>opType</rdf:label>
<rdfs:comment>This is an enumerated integer that specifies the various types of operators that are allowed for this PolicyStatement.  Permitted Values: 1: Match 2: Greater than 3: Greater than or equals 4: Less than 5: Less than or equals 6: Equals 7: Not equals 8: IN 9: NOT IN 10: SET 11: CLEAR Notes:  Not present in the ITU or CIM specs. The IETF RFCs only define MATCH.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_order -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_order">
<InformationModel_v1:hasOrigin>PolicyActionRuleDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>order</rdf:label>
<rdfs:comment>This is an unsigned integer attribute that defines the relative position of this action in relation to the overall sequence of actions that are associated with a given PolicyRule. Smaller integers indicate earlier positions in the sequence. The value "0" has the special semantics of "don't care". This value is not unique. Thus, if two or more attributes have the same value, they may be performed in any order, but they must all be performed at the appropriate place in the overall sequence.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_orderItemAction -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_orderItemAction">
<InformationModel_v1:hasOrigin>EntitySpecificationAction</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>orderItemAction</rdf:label>
<rdfs:comment>The corresponding order item action like Add, Modify, Disconnect if this item is orderable.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_orderMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_orderMethod">
<InformationModel_v1:hasOrigin>Collection</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>orderMethod</rdf:label>
<rdfs:comment>This is an enumerated integer, and is used to define the method by which elements in an OrderedSet or Sequence are collated. If the Collection type is Set or Bag, then this attribute MUST have the value 1 ("Not Applicable"). Values include:  1: Not Applicable  2: Ascending  3: Descending</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_orderTakenBy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_orderTakenBy">
<InformationModel_v1:hasOrigin>PartyRoleProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>orderTakenBy</rdf:label>
<rdfs:comment>An indicator that specifies that the associated PartyRole takes an order for the ProductOffering.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_organizationRoleName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_organizationRoleName">
<InformationModel_v1:hasOrigin>WorkforceOrganizationRole</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>organizationRoleName</rdf:label>
<rdfs:comment>Name of the OrganizationRole</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_orientation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_orientation">
<InformationModel_v1:hasOrigin>LocalLocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>orientation</rdf:label>
<rdfs:comment>The angle of rotation from the axes of the local coordinate system.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_originatingSytem -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_originatingSytem">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>originatingSytem</rdf:label>
<rdfs:comment>Indicates where the problem was generated.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_originationAddress -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_originationAddress">
<InformationModel_v1:hasOrigin>VoiceCallUsage</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>originationAddress</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_otherDesignator -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_otherDesignator">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>otherDesignator</rdf:label>
<rdfs:comment>This is a string attribute, and enables the manufacturer to label this software as having some set of special restrictions (e.g., early or limited deployment, end of life, or targeted at a specific type of market.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_otherIdentifier -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_otherIdentifier">
<InformationModel_v1:hasOrigin>PhysicalResource</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>otherIdentifier</rdf:label>
<rdfs:comment>This is a string that is used to contain other important identifying data, such as a bar code, of the hardware item. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_outbreakDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_outbreakDate">
<InformationModel_v1:hasOrigin>DunningCaseRule</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>outbreakDate</rdf:label>
<rdfs:comment>The outbreakDate represents the date at which the condition of the DunningRule has been verified, triggering the outbreak of the DunningCaseRule.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_outputDestination -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_outputDestination">
<InformationModel_v1:hasOrigin>WorkflowSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>outputDestination</rdf:label>
<rdfs:comment>identifies a destination for the output of a workflow.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_outputFormat -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_outputFormat">
<InformationModel_v1:hasOrigin>AdhocCollection</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>outputFormat</rdf:label>
<rdfs:comment>The file format that is used for transferring the performance data between applications.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_outputOctets -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_outputOctets">
<InformationModel_v1:hasOrigin>PublicWANAccessUsageEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>outputOctets</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_overall -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_overall">
<InformationModel_v1:hasOrigin>SecurityIncidentImpactLevel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>overall</rdf:label>
<rdfs:comment>An enumerated value indicating the overall impact to confidentiality, integrity, and availability due to the Security Incident:   Low - The loss of confidentiality, integrity, or availability could be expected to have a limited adverse effect on organizational operations, organizational assets, or individuals.  A limited adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a degradation in mission capability to an extent and duration that the organization is able to perform its primary functions, but the effectiveness of the functions is noticeably reduced; (ii) result in minor damage to organizational assets; (iii) result in minor financial loss; or (iv) result in minor harm to individuals   Moderate - The loss of confidentiality, integrity, or availability could be expected to have a serious adverse effect on organizational operations, organizational assets, or individuals.  A serious adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a significant degradation in mission capability to an extent and duration that the organization is able to perform its primary functions, but the effectiveness of the functions is significantly reduced; (ii) result in significant damage to organizational assets; (iii) result in significant financial loss; or (iv) result in significant harm to individuals that does not involve loss of life or serious life threatening injuries.   High - The loss of confidentiality, integrity, or availability could be expected to have a severe or catastrophic adverse effect on organizational operations, organizational assets, or individuals.  A severe or catastrophic adverse effect means that, for example, the loss of confidentiality, integrity, or availability might: (i) cause a severe degradation in or loss of mission capability to an extent and duration that the organization is not able to perform one or more of its primary functions; (ii) result in major damage to organizational assets; (iii) result in major financial loss; or (iv) result in severe or catastrophic harm to individuals involving loss of life or serious life threatening injuries.   Source:  FIPS 199.  http://csrc.nist.gov/publications/fips/fips199/FIPS-PUB-199-final.pdf</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_overHeadCost -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_overHeadCost">
<InformationModel_v1:hasOrigin>Cost</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>overHeadCost</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_overheadCostRate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_overheadCostRate">
<InformationModel_v1:hasOrigin>Cost</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>overheadCostRate</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_owner -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_owner">
<InformationModel_v1:hasOrigin>CommonObjectInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>likelyToChange</InformationModel_v1:hasStereotype>
<rdf:label>owner</rdf:label>
<rdfs:comment>This attribute represents an identifier for the owner of the object.  Used and controlled (write-access) by the requesting OS only.  See R_TMF518_FMW_I_0001.This attribute represents an identifier for the owner of the object.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_packetCaptureData -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_packetCaptureData">
<InformationModel_v1:hasOrigin>SignatureSecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>packetCaptureData</rdf:label>
<rdfs:comment>Text field to capture PCAP (packet capture) data (i.e. full packets involved in the SecurityEvent)</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pagingFileSizeCurrent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pagingFileSizeCurrent">
<InformationModel_v1:hasOrigin>InstalledSoftware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pagingFileSizeCurrent</rdf:label>
<rdfs:comment>This defines the current size in amount and units that are stored in the paging files for the Software. If this instance doesn't support paging files, then the value of this attribute should be 0.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_parentCapacity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_parentCapacity">
<InformationModel_v1:hasOrigin>PhysicalCapacityDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>parentCapacity</rdf:label>
<rdfs:comment>This is a unique name that can be used to identify the PhysicalCapacity that is associated with this ManagedComponent. If this ManagedComponent doesn't contain any other PhysicalCapacities, then the value of this attribute MUST be NULL. This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_participationType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_participationType">
<InformationModel_v1:hasOrigin>CalendarEntryParticipation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>participationType</rdf:label>
<rdfs:comment>The role that the participant is playing for the associated entry Note: ATTENDEE, ORGANIZER [iCalendar] Permitted Values: ATTENDEE, ORGANIZER, DELEGATED-ATTENDEE, DELEGATED-ORGANIZER</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partNumber">
<InformationModel_v1:hasOrigin>PhysicalResourceSpecAttributes</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>partNumber</rdf:label>
<rdfs:comment>This is a string that defines a manufacturer-allocated part number assigned by the organization that manufactures the hardware item. This, in combination with the ModelNumber and the VendorName, identify different types of hardware items. The SerialNumber can then be used to differentiate between different instances of the same type of hardware item. This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyDemographicSource -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyDemographicSource">
<InformationModel_v1:hasOrigin>PartyDemographic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>partyDemographicSource</rdf:label>
<rdfs:comment>The origin of the PartyDemographic.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyRank -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyRank">
<InformationModel_v1:hasOrigin>AdditionalPartyAttributes</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>partyRank</rdf:label>
<rdfs:comment>Degree of importance relative to other partys.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyRoleProdOfferStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyRoleProdOfferStatus">
<InformationModel_v1:hasOrigin>PartyRoleProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>partyRoleProdOfferStatus</rdf:label>
<rdfs:comment>The current condition of an PartyRoleProductOffering, such as planned, on-boarded, off-boarded, inactive.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyRoleProdOffRelType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyRoleProdOffRelType">
<InformationModel_v1:hasOrigin>PartyRoleProdOffRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>partyRoleProdOffRelType</rdf:label>
<rdfs:comment>A categorization of the relationship, such as purchase for resell, broker as-is for resale.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyRoleProdSpecRelType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyRoleProdSpecRelType">
<InformationModel_v1:hasOrigin>PartyRoleProdSpecRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>partyRoleProdSpecRelType</rdf:label>
<rdfs:comment>A categorization of the relationship, such as purchase for resell, broker as-is for resale.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partySettlementRoleType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partySettlementRoleType">
<InformationModel_v1:hasOrigin>PartySettlementRole</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>partySettlementRoleType</rdf:label>
<rdfs:comment>An indicator that specifies the involment such as payment responsible and parties/unit responsible for calculating settlements.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_partyStatus">
<InformationModel_v1:hasOrigin>AdditionalPartyAttributes</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>partyStatus</rdf:label>
<rdfs:comment>The current condition of a party, such as active, inactive, prospective.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_passportNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_passportNr">
<InformationModel_v1:hasOrigin>PassportIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>passportNr</rdf:label>
<rdfs:comment>The unique identifier per passport issuer</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_passportType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_passportType">
<InformationModel_v1:hasOrigin>PassportIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>passportType</rdf:label>
<rdfs:comment>The type of Passport. e.g. Personal, Consular</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pattern -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pattern">
<InformationModel_v1:hasOrigin>SurfaceSymbology</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pattern</rdf:label>
<rdfs:comment>A repeated form or design for a surface.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentAcceptedBy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentAcceptedBy">
<InformationModel_v1:hasOrigin>PartyRoleProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>paymentAcceptedBy</rdf:label>
<rdfs:comment>An indicator that specifies that the associated PartyRole accepts payment for the ProductOffering.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentDay -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentDay">
<InformationModel_v1:hasOrigin>PaymentPlan</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>paymentDay</rdf:label>
<rdfs:comment>The day chosen by the party for generating the payments</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentDueDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentDueDate">
<InformationModel_v1:hasOrigin>OffCyclePartyBill</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>paymentDueDate</rdf:label>
<rdfs:comment>A party bill payment due date.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentDueDateOffset -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentDueDateOffset">
<InformationModel_v1:hasOrigin>PartyBillingCycleSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>paymentDueDateOffset</rdf:label>
<rdfs:comment>An offset of a payment due date. The offset is expressed as number of days with regard to the start of the BillingPeriod.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentFrequency -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentFrequency">
<InformationModel_v1:hasOrigin>PayComponentSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>paymentFrequency</rdf:label>
<rdfs:comment>paymentFrequency corresponds to the frequency at which the PayComponentSpecification is applied. For example, it might be applied Monthly for basic pay or Yearly for a Bonus pay component.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentMadeTo -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentMadeTo">
<InformationModel_v1:hasOrigin>PartyRoleProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>paymentMadeTo</rdf:label>
<rdfs:comment>An indicator that specifies that payment is made to the associated PartyRole for the ProductOffering.  For example, an entrprise may accept payment on behalf of PartyRole and then send the payment to the PartyRole.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentPeriod">
<InformationModel_v1:hasOrigin>PaymentPlan</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>paymentPeriod</rdf:label>
<rdfs:comment>The period of time between two payments.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paymentType">
<InformationModel_v1:hasOrigin>PublicWANAccessUsageEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>paymentType</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paySaleType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_paySaleType">
<InformationModel_v1:hasOrigin>PayGrade</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>paySaleType</rdf:label>
<rdfs:comment>The type associated with the Pay grade scale information based on organisation's pay structure.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pdpCommMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pdpCommMethod">
<InformationModel_v1:hasOrigin>DecisionRequestedDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pdpCommMethod</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the communication method used between this ManagedEntity and this PolicyDecisionPoint. Values include: 0: Not yet established 1: Telnet 2: COPS 3: Proprietary Protocol</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pdpRequestTimePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pdpRequestTimePeriod">
<InformationModel_v1:hasOrigin>DecisionRequestedDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pdpRequestTimePeriod</rdf:label>
<rdfs:comment>This attribute defines the start and end times (in the form of time stamps) in which this ManagedEntity can request decisions of this PolicyDecisionPoint.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pepCommMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pepCommMethod">
<InformationModel_v1:hasOrigin>PEPDirectionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pepCommMethod</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the communication method used between this PolicyDecisionPoint and this PolicyEnforcementPoint. Values include: 0: Not yet established 1: Telnet 2: COPS 3: Proprietary Protocol</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pepRequestTimePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pepRequestTimePeriod">
<InformationModel_v1:hasOrigin>PEPDirectionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pepRequestTimePeriod</rdf:label>
<rdfs:comment>This attribute defines the start and end times (in the form of time stamps) in which this PolicyDecisionPoint is allowed to manage this set of PolicyEnforcementPoints.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perceivedSeverity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perceivedSeverity">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>perceivedSeverity</rdf:label>
<rdfs:comment>Lists the possible severities that can be allocated to an Alarm. The values are consistent with ITU-T Recommendation X.733.  Once an alarm has been cleared, its perceived severity is set to Cleared and can no longer be set.   This attribute is mandatory in all 3 profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_percentage -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_percentage">
<InformationModel_v1:hasOrigin>ProdOfferPriceAlteration</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>percentage</rdf:label>
<rdfs:comment>percentage specifies the amount of alteration that is applied when it corresponds to a percentage discount, else the price from ComponentProdOfferPrice is used.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_percentComplete -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_percentComplete">
<InformationModel_v1:hasOrigin>SimpleActivity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>percentComplete</rdf:label>
<rdfs:comment>Indicates how much work has been completed for the Activity Permitted Values: 0-100</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlamSpecSeverity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlamSpecSeverity">
<InformationModel_v1:hasOrigin>PerformanceAlarmSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>perfAlamSpecSeverity</rdf:label>
<rdfs:comment>A value for the PerceivedSeverity attribute as part of a threshold crossing alarm definition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlarmSpecAdditionalText -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlarmSpecAdditionalText">
<InformationModel_v1:hasOrigin>PerformanceAlarmSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>perfAlarmSpecAdditionalText</rdf:label>
<rdfs:comment>A value for the AdditionalText attribute as part of a threshold crossing alarm definition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlarmSpecAlarmType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlarmSpecAlarmType">
<InformationModel_v1:hasOrigin>PerformanceAlarmSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>perfAlarmSpecAlarmType</rdf:label>
<rdfs:comment>A value for the AlarmType attribute as part of a threshold crossing alarm definition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlarmSpecProbableCause -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlarmSpecProbableCause">
<InformationModel_v1:hasOrigin>PerformanceAlarmSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>perfAlarmSpecProbableCause</rdf:label>
<rdfs:comment>A value for the ProbableCause attribute as part of a threshold crossing alarm definition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlarmSpecSpecificProblem -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlarmSpecSpecificProblem">
<InformationModel_v1:hasOrigin>PerformanceAlarmSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>perfAlarmSpecSpecificProblem</rdf:label>
<rdfs:comment>A value for the  SpecificProblem attribute as part of a threshold crossing alarm definition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlarmThresholdCrossingDescription -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perfAlarmThresholdCrossingDescription">
<InformationModel_v1:hasOrigin>PerformanceAlarmSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>perfAlarmThresholdCrossingDescription</rdf:label>
<rdfs:comment>A specific description of the threshold crossing (intended to be populated e under the alarm under CrossedThreshold structure).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_period -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_period">
<InformationModel_v1:hasOrigin>CommunicationInteractionItem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>period</rdf:label>
<rdfs:comment>A CommunicationInteractionItem's period specifies when it happened (starting date and end date).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_periodCoverage -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_periodCoverage">
<InformationModel_v1:hasOrigin>AppliedCustomerBillingProductRecurringCharge</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>periodCoverage</rdf:label>
<rdfs:comment>The periodCoverage represents the period of time for which this RecurringCharge is being incurred. This period may not be the same as the period covered by the Bill document, for instance due to proration.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perspective -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perspective">
<InformationModel_v1:hasOrigin>CompetitiveTier</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>perspective</rdf:label>
<rdfs:comment>How the CompetitiveTier is viewed, such as vertical or horizontal.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perspectiveCharacteristic -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_perspectiveCharacteristic">
<InformationModel_v1:hasOrigin>CompetitiveTier</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>perspectiveCharacteristic</rdf:label>
<rdfs:comment>A feature or quality that further describes the perspective recognizable, such as consumer, business, carrier, size, usage, customer, and so forth. For example, a consumer vertical market perspective.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_photo -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_photo">
<InformationModel_v1:hasOrigin>EmployeeIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>photo</rdf:label>
<rdfs:comment>A picture or likeness obtained by photography.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_physicalAlarmReportingEnabled -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_physicalAlarmReportingEnabled">
<InformationModel_v1:hasOrigin>ManagedHardware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>physicalAlarmReportingEnabled</rdf:label>
<rdfs:comment>This is a Boolean attribute, and defines whether alarm reporting for this object instance is enabled or not. TRUE means that reporting is allowed, and FALSE means that reporting is inhibited.  Note that some physical entities are not capable of reporting physical alarms, while some are. For those that are not capable of reporting physical alarms, this value MUST be set to FALSE.  Remember that this is for physical alarm reporting. In most cases, there are corresponding logical alarms. The ManagementEntity class hierarchy describes and correlates these.  This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_physicalAlarmStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_physicalAlarmStatus">
<InformationModel_v1:hasOrigin>ManagedHardware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>physicalAlarmStatus</rdf:label>
<rdfs:comment>This is an enumerated integer that indicates the occurrence of an abnormal physical condition relating to an object. This attribute may also function as a summary indicator of alarm conditions associated with a specific resource. It is used to indicate the existence of an alarm condition, a pending alarm condition such as threshold situations, or (when used as a summary indicator) the highest severity of active alarm conditions.  This attribute expands on the standard ITU semantics and updates them to include eTOM concepts. Values include: 0: unknown 1: activeReportable-Critical 2: activeReportable-Major 3: activeReportable-Minor 4: activeReportable-Indeterminate 5: activeReportable-Warning 6: activePendingDecision 7: active-underRepair 8: active-beingReplaced 9: cleared  This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_physicalCapacityStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_physicalCapacityStatus">
<InformationModel_v1:hasOrigin>PhysicalCapacity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>physicalCapacityStatus</rdf:label>
<rdfs:comment>This is an enumerated integer whose value indicates the current status of this category of capacity object. The category is the name of the subclass. For example, the PhysicalMemoryCapacity subclass inherits the Status attribute, so the status applies to this instance of PhysicalMemory. The following values are defined:  0: Unknown 1: OK 2: Initializing 3: Starting 4: Paused 5: Stopping 6: Stopped 7: Degraded 8: Stressed 9: Critical 10: Predicted Failure 11: Error - General 12: Error - Non Recoverable 13: Not Installed or Not Present 14: In Maintenance 15: Unable To Contact 16: Lost Communications  Stopped indicates that the object is known still exist, but it is no longer operational. However, it has not failed. Stressed indicates that the object is functioning, but needs attention (e.g., it may be overheating, or overloaded in some way). Predicted Failure indicates that this object is functioning properly but predicting a failure in the near future.  In Maintenance describes an object that is being configured, maintained, or otherwise administered and is NOT available for service. Unable To Contact indicates that the monitoring system has knowledge of this object but has never been able to establish communications with it. Lost Commmunications indicates that the object has been contacted successfully in the past and is known to still exist; however, it is currently unreachable.  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_physicalDescription -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_physicalDescription">
<InformationModel_v1:hasOrigin>HolderAtomic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>physicalDescription</rdf:label>
<rdfs:comment>This is a free-form string that defines the physically unique characteristics of this holder. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pi -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pi">
<InformationModel_v1:hasOrigin>AbsoluteLocalOrientation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>pi</rdf:label>
<rdfs:comment>The angle between the x axis and the N axis.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pin -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pin">
<InformationModel_v1:hasOrigin>CustomerBillingAccount</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pin</rdf:label>
<rdfs:comment>A multidigit personal identification number that is used by a Customer to gain access to a BillingAccount at an ATM, a computer, or a telephone system, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pinDescription -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pinDescription">
<InformationModel_v1:hasOrigin>PhysicalConnector</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>pinDescription</rdf:label>
<rdfs:comment>This is a free-form string describing the pin configuration and signal usage of a PhysicalConnector.  This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_placeOfBirth -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_placeOfBirth">
<InformationModel_v1:hasOrigin>Individual</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>placeOfBirth</rdf:label>
<rdfs:comment>Note: Pointer to a Location object City, town name etc.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_placeRole -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_placeRole">
<InformationModel_v1:hasOrigin>ProductPlaceRole</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>placeRole</rdf:label>
<rdfs:comment>Role type of the Place in the context of a Product.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedDuration">
<InformationModel_v1:hasOrigin>ProjectElement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>plannedDuration</rdf:label>
<rdfs:comment>The duration expected during the planning process</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedEnd -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedEnd">
<InformationModel_v1:hasOrigin>ClosedLoopActivity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>plannedEnd</rdf:label>
<rdfs:comment>Scheduled end of the activity</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedEntryDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedEntryDate">
<InformationModel_v1:hasOrigin>CompetitorIntelligenceMarketSegment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>plannedEntryDate</rdf:label>
<rdfs:comment>The date on which the Competitor intends to begin making ProductOfferings available to a MarketSegment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedMarketCoverage -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedMarketCoverage">
<InformationModel_v1:hasOrigin>CompetitorIntelligenceMarketSegment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>plannedMarketCoverage</rdf:label>
<rdfs:comment>A percent or description that describes the degree to which a Competitor will/does/has extend into a MarketSegment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedMarketEntryDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedMarketEntryDate">
<InformationModel_v1:hasOrigin>CompetitorMarketSegment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>plannedMarketEntryDate</rdf:label>
<rdfs:comment>The date on which a Competitor plans to offer ProductOfferings in a MarketSegment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedOrActualCapacity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedOrActualCapacity">
<InformationModel_v1:hasOrigin>Capacity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>plannedOrActualCapacity</rdf:label>
<rdfs:comment>An indicator that specifies whether the capacity is planned or actual.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedOutageIndication -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedOutageIndication">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>plannedOutageIndication</rdf:label>
<rdfs:comment>Indicates that the Managed Object (related to this alarm) is in planned outage (in planned maintenance, or out-of-service). This might also be used when an equipment is being commissioned to avoid the alarms propagating to other systems.  This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedQty -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedQty">
<InformationModel_v1:hasOrigin>ProjectResourceReservationAllocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>plannedQty</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedSpending -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedSpending">
<InformationModel_v1:hasOrigin>CompetitorIntelligenceMarketSegment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>plannedSpending</rdf:label>
<rdfs:comment>The amount of money that a Competitor intends on spending make ProductOfferings available in a MarketSegment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedStart -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_plannedStart">
<InformationModel_v1:hasOrigin>ClosedLoopActivity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>plannedStart</rdf:label>
<rdfs:comment>Scheduled start of the activity</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyActionSelectCriteria -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyActionSelectCriteria">
<InformationModel_v1:hasOrigin>PolicyRuleSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>policyActionSelectCriteria</rdf:label>
<rdfs:comment>This is an attribute that contains an OCL expression to prescribe any limitations on the types of PolicyActions that can be used with any PolicyRules that are derived from this particular PolicyRuleSpec. This enables a PolicyRuleSpec to be built that defines what types of PolicyActions can be used to build PolicyRules. This in turn ensures that a given set of PolicyRules carry standard functionality. Notes: Not present in the ITU or CIM specs</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyConditionSelectCriteria -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyConditionSelectCriteria">
<InformationModel_v1:hasOrigin>PolicyRuleSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>policyConditionSelectCriteria</rdf:label>
<rdfs:comment>This is an attribute that contains an OCL expression to prescribe any limitations on the types of PolicyConditions that can be used with any PolicyRules that are derived from this particular PolicyRuleSpec. This enables a PolicyRuleSpec to be built that defines what types of PolicyConditions can be used to build PolicyRules. This in turn ensures that a given set of PolicyRules carry standard functionality. Notes: Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyDomainID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyDomainID">
<InformationModel_v1:hasOrigin>PolicyCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>policyDomainID</rdf:label>
<rdfs:comment>The Policy Domain identifier for this capability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyEventSelectCriteria -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyEventSelectCriteria">
<InformationModel_v1:hasOrigin>PolicyRuleSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>policyEventSelectCriteria</rdf:label>
<rdfs:comment>This is an attribute that contains an OCL expression to prescribe any limitations on the types of PolicyEvents that can be used with any PolicyRules that are derived from this particular PolicyRuleSpec. This enables a PolicyRuleSpec to be built that defines what types of PolicyEvents can be used to trigger the evaluation of PolicyRules. This in turn ensures that a given set of PolicyRules carry standard functionality. Notes: Not present in the ITU or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyGroupID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyGroupID">
<InformationModel_v1:hasOrigin>PolicyCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>policyGroupID</rdf:label>
<rdfs:comment>The policy group identifier for this capability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policyName">
<InformationModel_v1:hasOrigin>Policy</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>policyName</rdf:label>
<rdfs:comment>This is a generic naming attribute that can be used to identify different policy entities. This enables commonName to be used to enforce enterprise or service provider generic naming and this attribute to be used to fine tune the naming of policy entities. Thus, commonName is public in scope and policyName is private to policy.  Notes:   Not present in the ITU specs or CIM specs.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policySetID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_policySetID">
<InformationModel_v1:hasOrigin>PolicyCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>policySetID</rdf:label>
<rdfs:comment>This is the identifier of associated polictSet for this capability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_poolAssignmentRestriction -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_poolAssignmentRestriction">
<InformationModel_v1:hasOrigin>WorkforcePoolAssignment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>poolAssignmentRestriction</rdf:label>
<rdfs:comment>Represents any limitation of the assignment other than time period. For example, this employee\'s assignment to the pool has the highest priority compared to other assignments.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_port -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_port">
<InformationModel_v1:hasOrigin>SecurityEventEndpoint</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>port</rdf:label>
<rdfs:comment>The IP port associated with the IP address in the translation</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_portabilityStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_portabilityStatus">
<InformationModel_v1:hasOrigin>NumberPortabilityRole</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>portabilityStatus</rdf:label>
<rdfs:comment>All the number portability requests have a behavior with an affinity and dependency to the different parties created and added. (NP Clearinghouse, External System, Customer). This relation affects directly to the tracking for the portability through a status. This status is mapped through this attribute called portabilityStatus.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_portDirection -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_portDirection">
<InformationModel_v1:hasOrigin>PortVariable</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>portDirection</rdf:label>
<rdfs:comment>This is an enumerated integer that defines if this variable is used to represent source addresses, destination addresses, or both.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_portNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_portNumber">
<InformationModel_v1:hasOrigin>PhysicalPort</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>portNumber</rdf:label>
<rdfs:comment>This is a non-zero integer that uniquely identifies this PhysicalPort instance from all other instances. This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_portRangeEnd -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_portRangeEnd">
<InformationModel_v1:hasOrigin>Protocol</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>portRangeEnd</rdf:label>
<rdfs:comment>This non-negative integer defines the upper range of allowable port numbers to use.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_portRangeStart -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_portRangeStart">
<InformationModel_v1:hasOrigin>Protocol</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>portRangeStart</rdf:label>
<rdfs:comment>This non-negative integer defines the lower range of allowable port numbers to use.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_positionInChassis -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_positionInChassis">
<InformationModel_v1:hasOrigin>ChassisPosition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>positionInChassis</rdf:label>
<rdfs:comment>This is the "slot number" of the Rack that the Chassis is placed in. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_positionNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_positionNr">
<InformationModel_v1:hasOrigin>LocalAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>positionNr</rdf:label>
<rdfs:comment>The position within the type. Notes: often a number with a suffix, e.g. 5B</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_possibleDeliveryDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_possibleDeliveryDate">
<InformationModel_v1:hasOrigin>WorkOrder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>possibleDeliveryDate</rdf:label>
<rdfs:comment>The date upon which the WorkOrder may be completed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_postcode -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_postcode">
<InformationModel_v1:hasOrigin>UrbanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>postcode</rdf:label>
<rdfs:comment>A descriptor for a postal delivery area, used to speed and simplify the delivery of mail. Notes: also known as ZIP code</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_postOrderFulfilledBy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_postOrderFulfilledBy">
<InformationModel_v1:hasOrigin>PartyRoleProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>postOrderFulfilledBy</rdf:label>
<rdfs:comment>An indicator the specifies if the party completes fulfillment of an order after it has been taken.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_potentialRootCauseIndication -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_potentialRootCauseIndication">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>potentialRootCauseIndication</rdf:label>
<rdfs:comment>Indicates whether an alarm is a raw (uncorrelated) alarm (when false) or a potential root cause alarm indication (when true).  A fault has typically one root cause, but identifying the true root cause of a fault might be difficult. However, with the scope of an alarm-owning system, it might possible to identify a potential root cause indication that might be useful for client systems.  This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_powerCordNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_powerCordNumber">
<InformationModel_v1:hasOrigin>Chassis</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>powerCordNumber</rdf:label>
<rdfs:comment>This is an integer that defines the number of power cords which must be connected to the Chassis in order for all of its contained ManagedEntities to operate correctly. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_powerState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_powerState">
<InformationModel_v1:hasOrigin>PhysicalResource</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>powerState</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the current power status of the hardware item. Values include:  0: Unknown  1: Not Applicable  2: No Power Applied  3: Full Power Applied  4: Power Save - Normal  5: Power Save - Degraded  6: Power Save - Standby  7: Power Save - Critical  8: Power Save - Low Power Mode  9: Power Save - Unknown  10: Power Cycle  11: Power Warning  12: Power Off  Value 1 means that the hardware item doesn't require the direct application of power (e.g., a but or bolt). If the value for this item is 3, then the PowerCapability class will describe the particular power requirements of this item through the HasPower association.  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preceededBy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preceededBy">
<InformationModel_v1:hasOrigin>EntityIdentificationSpecFormat</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>preceededBy</rdf:label>
<rdfs:comment>One or more characters that precede the EntityIdentification value. For example, the format of a phone number contains dashes, such as 972-477-8401.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_precision -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_precision">
<InformationModel_v1:hasOrigin>PartyRoleCurrency</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>precision</rdf:label>
<rdfs:comment>Precision of a currency.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preferredBundleSpec -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preferredBundleSpec">
<InformationModel_v1:hasOrigin>ServicePackageBundleDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>preferredBundleSpec</rdf:label>
<rdfs:comment>This attribute contains the name of the ServiceBundleSpec that is preferred to be used to implement this particular ServicePackageSpec.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preferredConfigMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preferredConfigMethod">
<InformationModel_v1:hasOrigin>SupportedMgmtMethodDetail</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>preferredConfigMethod</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the name of a class that identifies the name of the preferred ManagementMethod for performing configuration operations on the associated ManagedEntity. Values include:  0: Unknown  1: None  2: CLI  3: SNMP  4: TL1  5: CMIP  6: Proprietary  None could mean that this ManagedEntity performs a set function and is not configurable, as well as mean that this ManagedEntity is not configurable except by the factory.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preferredGivenName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preferredGivenName">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>preferredGivenName</rdf:label>
<rdfs:comment>Contains the chosen name by which the person prefers to be addressed. Note: This name may be a name other than a given name, such as a nickname</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preferredMonitorMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preferredMonitorMethod">
<InformationModel_v1:hasOrigin>SupportedMgmtMethodDetail</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>preferredMonitorMethod</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the name of a class that identifies the name of the preferred ManagementMethod for performing monitoring operations on the associated ManagedEntity. Values include:  0: Unknown  1: None  2: CLI  3: SNMP  4: RMON  5: CMIP  6: TL1  7: Proprietary  None could mean that this ManagedEntity is not able to be monitored.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preferredVersionToUse -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_preferredVersionToUse">
<InformationModel_v1:hasOrigin>CFSSpecVersionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>preferredVersionToUse</rdf:label>
<rdfs:comment>This attribute defines the preferred Version of this CustomerFacingServiceSpecification to use.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_prescribedAction -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_prescribedAction">
<InformationModel_v1:hasOrigin>ServiceLevelSpecConsequence</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>prescribedAction</rdf:label>
<rdfs:comment>Recommended remedy for a violated ServiceLevelObjective. A placeholder that indicates an extension may be made to the SID model here to further define remedies.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_presizedSIze -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_presizedSIze">
<InformationModel_v1:hasOrigin>SCRUM_BacklogItem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>presizedSIze</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_price -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_price">
<InformationModel_v1:hasOrigin>ComponentProdPrice</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>price</rdf:label>
<rdfs:comment>The amount of money that characterizes the price.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_priceRuleConditionType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_priceRuleConditionType">
<InformationModel_v1:hasOrigin>ProdOfferPriceCondition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>priceRuleConditionType</rdf:label>
<rdfs:comment>A character string that specifies how to interpret the condition. A value of "Buy" means that the condition specifies how many of an entity must be procured to satisfy the rule. A value of "Price" means that the condition specifies that there is a relationship between prices of two entities that must exist for the condition to be satisfied. The value ObtainedWithin specifies dates within which a Product Offering must be procured to satisfy the Policy Condition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_priceType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_priceType">
<InformationModel_v1:hasOrigin>ComponentProdPrice</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>priceType</rdf:label>
<rdfs:comment>A category that describes the price, such as recurring, discount, allowance, penalty, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_principalLocation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_principalLocation">
<InformationModel_v1:hasOrigin>TimeZone</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>principalLocation</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_priority -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_priority">
<InformationModel_v1:hasOrigin>ProjectElement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>priority</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_privacyType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_privacyType">
<InformationModel_v1:hasOrigin>PartyPrivacyProfileTypeCharacteristic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>privacyType</rdf:label>
<rdfs:comment>A privacyType specifies the type of Privacy rule specified for an information such as    - Internal Purpose : usage of the information by the company that collects the information for a purpose,    - External Purpose: usage of the information by the company that received the information from another company for a purpose,    - Internal Retention: rights to keep the information for the company that collects the information,    - External Retention: rights to keep the information for the company that  that received the information from another company.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_privateStreetName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_privateStreetName">
<InformationModel_v1:hasOrigin>UrbanPropertySubAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>privateStreetName</rdf:label>
<rdfs:comment>Private streets internal to a property (e.g. a university) may have internal names that are not recorded by the land title office.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_probableCause -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_probableCause">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>probableCause</rdf:label>
<rdfs:comment>Further qualifies the alarm in complement of the alarmType. This specification does not use an enumeration, but a string with qualified text. Recommended values are specified in TMF063 Probable Causes Technical Specification.  This attribute is mandatory in all 3 profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_problemEscalation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_problemEscalation">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>problemEscalation</rdf:label>
<rdfs:comment>Indicates if this service problem has been escalated or not. Possible values are 0 to 10. A value of zero means no escalation.  The meanings of values 1-10 are to be determined by the user of the interface, but they show increasing levels of escalation.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_problemId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_problemId">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>problemId</rdf:label>
<rdfs:comment>Identifier of the problem. Note that this identifier is local to the server side of the interface.  Only EntityIdentifier can be considered as global.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_processesPerUserMax -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_processesPerUserMax">
<InformationModel_v1:hasOrigin>PartyRoleUsesProcessesDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>processesPerUserMax</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_processMemorySizeCurrent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_processMemorySizeCurrent">
<InformationModel_v1:hasOrigin>InstalledSoftware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>processMemorySizeCurrent</rdf:label>
<rdfs:comment>This defines the amount and units of memory that have been allocated to a Process.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_processType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_processType">
<InformationModel_v1:hasOrigin>ProcessType</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>processType</rdf:label>
<rdfs:comment>The type of process. E.g. ClosedLoop, Workflow, Activity</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_producingApplicationId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_producingApplicationId">
<InformationModel_v1:hasOrigin>MeasurementJob</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>producingApplicationId</rdf:label>
<rdfs:comment>The identifier of the application that consumes performance indicators.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_productionReason -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_productionReason">
<InformationModel_v1:hasOrigin>PartyBillingCycle</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>productionReason</rdf:label>
<rdfs:comment>The reason for this cycle run. Values may be SCHEDULE_RUN, PROVEIDER_REQUEST or others</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_programDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_programDate">
<InformationModel_v1:hasOrigin>NumberPortabilityRequest</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>programDate</rdf:label>
<rdfs:comment>This attribute called programDate is used to program the date to port (hence the name) for Port In and Port Out of the portability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_projectNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_projectNr">
<InformationModel_v1:hasOrigin>Project</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>projectNr</rdf:label>
<rdfs:comment>A unique identifier for the Project</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_proposedRepairActions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_proposedRepairActions">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>proposedRepairActions</rdf:label>
<rdfs:comment>Indicates proposed repair actions, if known to the system emitting the alarm.  This attribute is optional in all 3 profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_proseFormula -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_proseFormula">
<InformationModel_v1:hasOrigin>MetricDefinitionDeterminationMethod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>proseFormula</rdf:label>
<rdfs:comment>A prose expression of formula, may not be as precise as the XLS formula or some XLS-like formula.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_protectionRole -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_protectionRole">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>protectionRole</rdf:label>
<rdfs:comment>This attribute defines the protection role that this equipment plays. In case the equipment is not protected, the value "NOT_APPLICABLE" shall be used.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_protectionSchemeState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_protectionSchemeState">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>protectionSchemeState</rdf:label>
<rdfs:comment>This attribute identifies the individual lock of this equipment. In case the equipment is not protected, the value "UNKNOWN" shall also be used.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_protocol -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_protocol">
<InformationModel_v1:hasOrigin>NetFlowSecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>protocol</rdf:label>
<rdfs:comment>Integer number of the protocol used in the network flow.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_protocolDirection -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_protocolDirection">
<InformationModel_v1:hasOrigin>Protocol</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>protocolDirection</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the direction of this protocol. Values are:  0: input  1: output  2: bi-directional</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_provessValue -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_provessValue">
<InformationModel_v1:hasOrigin>BusinessRule</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>provessValue</rdf:label>
<rdfs:comment>Identifies the value to be assigned to the process.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_psi -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_psi">
<InformationModel_v1:hasOrigin>AbsoluteLocalOrientation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>psi</rdf:label>
<rdfs:comment>The angle between the N axis and the X axis.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_publishedDateTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_publishedDateTime">
<InformationModel_v1:hasOrigin>SecurityVulnerability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>publishedDateTime</rdf:label>
<rdfs:comment>The date and time the vulnerability was published to the public.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_purchaseOrderNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_purchaseOrderNumber">
<InformationModel_v1:hasOrigin>ProductOrder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>purchaseOrderNumber</rdf:label>
<rdfs:comment>A number that uniquely identifies a ProductOrder within the ordering Party's enterprise.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_purpose -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_purpose">
<InformationModel_v1:hasOrigin>PartyRoleProductOffering</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>purpose</rdf:label>
<rdfs:comment>The reason for the PartyRoleProductOffering, such as sell on behalf of, purchase, offer.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_purposeDescription -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_purposeDescription">
<InformationModel_v1:hasOrigin>Slot</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>purposeDescription</rdf:label>
<rdfs:comment>This is a free-form string that defines the physically unique characteristics of this Slot. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpActionCommMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpActionCommMethod">
<InformationModel_v1:hasOrigin>PolicyActionPerformedDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pxpActionCommMethod</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the communication method used between this ManagedEntity and this PolicyExecutionPoint. Values include: 0: Not yet established 1: Telnet 2: COPS 3: Proprietary Protocol</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpAllowedActionTimePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpAllowedActionTimePeriod">
<InformationModel_v1:hasOrigin>PolicyActionPerformedDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pxpAllowedActionTimePeriod</rdf:label>
<rdfs:comment>This attribute defines the start and end times (in the form of time stamps) in which this PolicyExecutionPoint can perform actions on this ManagedEntity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpCommMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpCommMethod">
<InformationModel_v1:hasOrigin>PXPDirectionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pxpCommMethod</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the communication method used between this PolicyDecisionPoint and this PolicyExecutionPoint. Values include: 0: Not yet established 1: Telnet 2: COPS 3: Proprietary Protocol</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpEnforcementCommMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpEnforcementCommMethod">
<InformationModel_v1:hasOrigin>PXPEnforcementDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pxpEnforcementCommMethod</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the communication method used between this PolicyExecutionPoint and this PolicyEnforcementPoint. Values include: 0: Not yet established 1: Telnet 2: COPS 3: Proprietary Protocol</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpEnforcementRequestTimePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpEnforcementRequestTimePeriod">
<InformationModel_v1:hasOrigin>PXPEnforcementDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pxpEnforcementRequestTimePeriod</rdf:label>
<rdfs:comment>This attribute defines the start and end times (in the form of time stamps) in which this PolicyEnforcementPoint must enforce the actions taken by this PolicyExecutionPoint.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpRequestTimePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_pxpRequestTimePeriod">
<InformationModel_v1:hasOrigin>PXPDirectionDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>pxpRequestTimePeriod</rdf:label>
<rdfs:comment>This attribute defines the start and end times (in the form of time stamps) in which this PolicyDecisionPoint is allowed to manage this set of PolicyExecutionPoints.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_qty -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_qty">
<InformationModel_v1:hasOrigin>ProductSpecActivitySpecAllocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>qty</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_qualifications -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_qualifications">
<InformationModel_v1:hasOrigin>IndividualName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>qualifications</rdf:label>
<rdfs:comment>Contains the letters used to describe academic or other type qualifications held by a person and/or the distinctions conferred upon them. e.g. PhD, MD, CPA, MCSD, etc Note: also known as orders, decorations, honors, awards and distinctions</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_quantity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_quantity">
<InformationModel_v1:hasOrigin>AppliedCustomerBillingRate</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>quantity</rdf:label>
<rdfs:comment>A unit (for example, US Dollars) and number of the applied rate.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_quantityRangeInterval -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_quantityRangeInterval">
<InformationModel_v1:hasOrigin>RevShareModelSpecNegotiableRange</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>quantityRangeInterval</rdf:label>
<rdfs:comment>An indicator that specifies the inclusion or exclusion of the lower range and upper range quantity attributes. Possible values are "open", "closed", "closedBottom" and "closedTop".</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_raAssessmentType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_raAssessmentType">
<InformationModel_v1:hasOrigin>RevenueAssuranceAssessment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>raAssessmentType</rdf:label>
<rdfs:comment>A category that groups assessments that have strongly marked and readily defined similarities. For example, effectiveness, trend analysis, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rangeInterval -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rangeInterval">
<InformationModel_v1:hasOrigin>MarketSegmentCharacteristicValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>rangeInterval</rdf:label>
<rdfs:comment>An indicator that specifies the inclusion or exclusion of the valueFrom and valueTo attributes.  Possible values are "open", "closed", "closedBottom" and "closedTop".</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rangeStep -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rangeStep">
<InformationModel_v1:hasOrigin>CharacteristicSpecValue</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>rangeStep</rdf:label>
<rdfs:comment>The specification that a range of values increases in steps, such as a range from 0 to 100 in steps of 5 with the resulting permitted values being 0, 5, 10, 15,...100. This complements the valueFrom, valueTo, and rangeInterval attributes. Previously there was no way to do so, and individual CharacteristicSpecValues had to be created.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rank -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rank">
<InformationModel_v1:hasOrigin>CompetitorMarketSegment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>rank</rdf:label>
<rdfs:comment>The degree of importance or excellence of a Competitor in a MarketSegment relative to other Competitors in the MarketSegment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rate">
<InformationModel_v1:hasOrigin>SimpleRateTaxDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>rate</rdf:label>
<rdfs:comment>The percentage rate for calculating the tax. For example, 17% for value added tax.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_readingProficiency -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_readingProficiency">
<InformationModel_v1:hasOrigin>LanguageAbility</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>readingProficiency</rdf:label>
<rdfs:comment>Degree of mastery in reading a language.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reason -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reason">
<InformationModel_v1:hasOrigin>ServiceSpecVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>reason</rdf:label>
<rdfs:comment>This is a string that describes the reason for creating this version.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reconciliationDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reconciliationDate">
<InformationModel_v1:hasOrigin>PartyRevenueShareReconciliation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>reconciliationDate</rdf:label>
<rdfs:comment>The date that a PartyRevenueShare was reconciled.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reconciliationDateComplete -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reconciliationDateComplete">
<InformationModel_v1:hasOrigin>PartyRevenueShareReconciliation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>reconciliationDateComplete</rdf:label>
<rdfs:comment>The date that a PartyRevenueShareReconciliation is completed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_recorderInfo -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_recorderInfo">
<InformationModel_v1:hasOrigin>IPDRDoc</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>recorderInfo</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_recurringFrequency -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_recurringFrequency">
<InformationModel_v1:hasOrigin>RecurringScheduleDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>recurringFrequency</rdf:label>
<rdfs:comment>A recurring frequency to run a job within day that is included in schedule definition, for example: every 5 minutes, 15 minuute, 30 minutes, 1 hour.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_redundancy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_redundancy">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>redundancy</rdf:label>
<rdfs:comment>This is an enumerated integer that describes the redundancy capabilities of this particular Equipment. Values include:  0: Unknown  1: Primary (supported by a Redundant Equipment)  2: Redundant (supports a Primary Equipment)  3: Stand-alone (no Redundancy possible)  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reference -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reference">
<InformationModel_v1:hasOrigin>SecurityThreatActor</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>reference</rdf:label>
<rdfs:comment>A reference to additional information about a threat.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relatedEntity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relatedEntity">
<InformationModel_v1:hasOrigin>Anomaly</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>relatedEntity</rdf:label>
<rdfs:comment>related entity identifier where this anomaly is applicable</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relationshipReason -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relationshipReason">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>relationshipReason</rdf:label>
<rdfs:comment>Text that explains the reason for the association between the SoftwareResourceSpecifications.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relationshipType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relationshipType">
<InformationModel_v1:hasOrigin>ProductFinancialAccountRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>relationshipType</rdf:label>
<rdfs:comment>A categorization of the relationship, such as aggregation, substitution, dependency, exclusivity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relationshipTypeCode -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relationshipTypeCode">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>relationshipTypeCode</rdf:label>
<rdfs:comment>An enumeration of the values for a particular type of SoftwareSpecificationRelationship that is dependent on the relationshipType attribute.  For example, for a Refinement type of relationship the value may represent a substitution, division, or fusion.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relativeElevation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relativeElevation">
<InformationModel_v1:hasOrigin>NetworkRouteSection</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>relativeElevation</rdf:label>
<rdfs:comment>The relative height to which something is elevated above a point of reference such as the ground.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relativeModifier -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relativeModifier">
<InformationModel_v1:hasOrigin>PlacePartyRoleAssoc</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>relativeModifier</rdf:label>
<rdfs:comment>If the association is relative to the location (not at it) then use a modifier NEAR-TO or OUTSIDE or ACROSS-ROAD-FROM ?.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_releaseStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_releaseStatus">
<InformationModel_v1:hasOrigin>SoftwareResourceSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>releaseStatus</rdf:label>
<rdfs:comment>This attribute is an enumerated integer that defines the particualr release status of this SoftwareResourceSpecification. Values include: 0: alpha 1. beta 2: FCS (First Customer Shipment) 3. GD (General Deployment) 4: SV (Special Version for 1 or more customers) 5: EOE (end of engineering) 6: EOS (end of sale) 7: EOL (end of life) FCS marks the beginning of the limited deployment phase. In this phase, the SoftwareResourceSpecification is usually certified on a few platforms but not all platforms. GD marks the certification of stable SoftwareResourceSpecification on all major platforms. SV is a special build for a particular customer that needs special fixes or features. EOE means that no new engineering fixes will be applied, but the SoftwareResourceSpecification can still be ordered. EOS means that the SoftwareResourceSpecificatino can no longer be ordered, but will still be supported. EOL means that the SofwareResourceSpecification can no longer be supported, and cannot be ordered.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_relType">
<InformationModel_v1:hasOrigin>PartySettlementRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>relType</rdf:label>
<rdfs:comment>Specifies the relationship type of two PartySettlements suh as migration, substitution, dependency, exclusivity.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_remainingAmount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_remainingAmount">
<InformationModel_v1:hasOrigin>AccountBalance</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>remainingAmount</rdf:label>
<rdfs:comment>Remained or owed account balance amount. Here Quantity type represents both non-monetary balance and monetary balance. Non-monetary balance is applied to the service usage volume and monetary balance is applied to the monetary amount.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_remainingValue -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_remainingValue">
<InformationModel_v1:hasOrigin>UsageVolumeBalance</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>remainingValue</rdf:label>
<rdfs:comment>The remainingValue is a calculated value based on UsageVolumeBalanceCredits and UsageVolumeBalanceDebits.  When the remainingValue is 0, no more UsageVolumeBalanceDebit can be decremented from the Balance.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_removable -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_removable">
<InformationModel_v1:hasOrigin>PhysicalContainer</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>removable</rdf:label>
<rdfs:comment>This is a Boolean that defines whether it is possible to insert and remove this object instance from the Equipment in which it is installed, without impairing the function or packaging of the Equipment. TRUE means that it is removable, and FALSE means that it is not.  A Package can still be Removable if power must be 'off' in order to perform the removal. If power can be 'on' and this object instance can still be removed, then this object instance is both Removable and HotSwappable.  This is a required attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reorderLevel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reorderLevel">
<InformationModel_v1:hasOrigin>StockItemStockLevel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>reorderLevel</rdf:label>
<rdfs:comment>Quantity under wich StockItem must be reordered (only for type = Available for Sale or Use).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reorderQuantity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reorderQuantity">
<InformationModel_v1:hasOrigin>StockItemStockLevel</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>reorderQuantity</rdf:label>
<rdfs:comment>Quantity of StockItem that must be reordered when quantity is under reorderLevel (only for type = Available for Sale or Use)</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_repeatAction -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_repeatAction">
<InformationModel_v1:hasOrigin>AnomalyConsequence</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>repeatAction</rdf:label>
<rdfs:comment>Recommended repeatAction when a qualifying condition is met</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_repeatCount -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_repeatCount">
<InformationModel_v1:hasOrigin>CalendarAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>repeatCount</rdf:label>
<rdfs:comment>The number of times the alarm should be repeated, after the initial trigger [iCalendar] Notes: REPEAT [iCalendar]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_replaceable -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_replaceable">
<InformationModel_v1:hasOrigin>PhysicalContainer</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>replaceable</rdf:label>
<rdfs:comment>This is a Boolean that defines whether it is possible to replace this object instance with a physically different instance of the same type. For example, some types of device allow various Chips to be upgraded. TRUE means that it is replaceable, and FALSE means that it is not.  All Removable packages are inherently Replaceable.  This is a required attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_replacementDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_replacementDate">
<InformationModel_v1:hasOrigin>ProjectElementRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>replacementDate</rdf:label>
<rdfs:comment>The date that the substitution, division or fusion takes effect.  Only applicable if type is Replacement.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reportingPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reportingPeriod">
<InformationModel_v1:hasOrigin>MeasurementCollectionJob</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>reportingPeriod</rdf:label>
<rdfs:comment>The rate of collecting Performance Indicators reports.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reportSequenceNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reportSequenceNumber">
<InformationModel_v1:hasOrigin>IntentReport</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>reportSequenceNumber</rdf:label>
<rdfs:comment>Specifies the sequence number of intent reports sent to owner.  Individual intents may have a sequence of reports directly related to this intent.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reportTimeStamp -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reportTimeStamp">
<InformationModel_v1:hasOrigin>AnomalyReport</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>reportTimeStamp</rdf:label>
<rdfs:comment>Date and time from when the information is  captured in the AnomalyReport </rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reportTimestamp -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reportTimestamp">
<InformationModel_v1:hasOrigin>IntentReport</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>reportTimestamp</rdf:label>
<rdfs:comment>The timestamp of when the intent handler created the intent report.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestedCompletionDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestedCompletionDate">
<InformationModel_v1:hasOrigin>ProductOrder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>requestedCompletionDate</rdf:label>
<rdfs:comment>Requested delivery date from the requestor perspective.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestedDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestedDate">
<InformationModel_v1:hasOrigin>StockItemShipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>requestedDate</rdf:label>
<rdfs:comment>Date on which the StockItemShipment should be completed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestedDeliveryDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestedDeliveryDate">
<InformationModel_v1:hasOrigin>WorkOrder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>requestedDeliveryDate</rdf:label>
<rdfs:comment>The date upon which the WorkOrder is desired to be completed.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestedParticipation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestedParticipation">
<InformationModel_v1:hasOrigin>CalendarEntryParticipation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>requestedParticipation</rdf:label>
<rdfs:comment>The requested participation status Note: ROLE [iCalendar] Permitted Values: REQ-PARTICIPANT, OPT-PARTICIPANT, NON-PARTICIPANT</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestedStartDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestedStartDate">
<InformationModel_v1:hasOrigin>ProductOrder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>requestedStartDate</rdf:label>
<rdfs:comment>Order fulfillment start date wished by the requestor. This is used when, for any reason, requestor cannot allow seller to begin to operationally begin the fulfillment before a date. It can happen for example in the context of a move.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestStatus">
<InformationModel_v1:hasOrigin>CalendarEntryParticipation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>requestStatus</rdf:label>
<rdfs:comment>Indicates if the request has been delivered to the participant and if it has been read (but not actioned) Permitted Value: DELIVERED-UNREAD, READ, UNDELIVERED</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requestType">
<InformationModel_v1:hasOrigin>StockItemRequest</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>requestType</rdf:label>
<rdfs:comment>The requestType might be Booking request: a booking request might come from a CustomerOrder in progress or simply from a salesperson that plan to place a huge quantity to a Customer. It carries a valid period to avoid freezing the stock. Replenishment: a replenishment request is triggered when the quantity is under the reorderLevel.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requirements -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requirements">
<InformationModel_v1:hasOrigin>PowerCapacity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>requirements</rdf:label>
<rdfs:comment>This is a free-form string that defines the recommend power supply configuration required as a function of how populated the Equipment is. Often in networking devices, higher-capacity power supplies must be used in place of lower-capacity ones when the type and/or number of installed Cards exceeds a certain number. In addition, in order to have fully-redundant power, higher-capacity power supplies must sometimes be used, again depending on the type and number of Cards installed. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requisiteSkillSet -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_requisiteSkillSet">
<InformationModel_v1:hasOrigin>ResourceRolePartyRoleDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>requisiteSkillSet</rdf:label>
<rdfs:comment>This attribute is an array of integers, and is used to define a set of skills that are required for this PartyRole to possess in order to manage this Resource. The values appear as a comma separated list.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reservedFor -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_reservedFor">
<InformationModel_v1:hasOrigin>ProjectResourceAllocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>reservedFor</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resolutionTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resolutionTime">
<InformationModel_v1:hasOrigin>SCRUM_Impediment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>resolutionTime</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourceAccess -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourceAccess">
<InformationModel_v1:hasOrigin>PolicyAppliesToDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>resourceAccess</rdf:label>
<rdfs:comment>This attribute defines the access privileges that the resource has. This may restrict the performance of operations that a user (human or otherwise) has access to when performing various operations on a ManagedEntity residing in a specific PolicyDomain.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourceFulfillmentState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourceFulfillmentState">
<InformationModel_v1:hasOrigin>Equipment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>resourceFulfillmentState</rdf:label>
<rdfs:comment>This attribute supports basic administration of plug-ins.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourcePolicyValidFor -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourcePolicyValidFor">
<InformationModel_v1:hasOrigin>ResourceManagementPolicy</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>resourcePolicyValidFor</rdf:label>
<rdfs:comment>This attribute defines a period of time that this particular ResourcePolicy is valid for. A TimePeriod is a complex datatype that contains both a starting and ending time.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourceRate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourceRate">
<InformationModel_v1:hasOrigin>ProjectResourceSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>resourceRate</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resources -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resources">
<InformationModel_v1:hasOrigin>CalendarActionEntry</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>resources</rdf:label>
<rdfs:comment>The equipment or resource requirements Note: RESOURCES [iCalendar]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourceState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourceState">
<InformationModel_v1:hasOrigin>CommonResourceInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>resourceState</rdf:label>
<rdfs:comment>See R_TMF518_NRB_I_0001.   See SD2-17_EnhancedResourceStates supporting document...\SD\SD2-17_EnhancedResourceStates.pdf</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourceUse -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_resourceUse">
<InformationModel_v1:hasOrigin>RunningSoftwareStatistic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>resourceUse</rdf:label>
<rdfs:comment>The quantity (amount, units) of a Resource being used by Software.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_respectsThreshold -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_respectsThreshold">
<InformationModel_v1:hasOrigin>Segment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>respectsThreshold</rdf:label>
<rdfs:comment>The attribute respectsThreshold specifies if the Segment respects the lower and upper size defined by the SegmentSpecification.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_respondedParticipation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_respondedParticipation">
<InformationModel_v1:hasOrigin>CalendarEntryParticipation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>respondedParticipation</rdf:label>
<rdfs:comment>The responded participation status Note PARTSTAT [iCalendar] Permitted Values: refer [iCalendar]</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_responseTypeFormat -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_responseTypeFormat">
<InformationModel_v1:hasOrigin>APISpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>responseTypeFormat</rdf:label>
<rdfs:comment>Response type format of this API like Text and Json.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_responsibleParty -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_responsibleParty">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>responsibleParty</rdf:label>
<rdfs:comment>Person or organization responsible for handling this problem. This is text or structured text and not an association to a party object. The Who category from the ATIS Service Outage document can be used for this attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_retrievalMethodCurrent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_retrievalMethodCurrent">
<InformationModel_v1:hasOrigin>ManagementInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>retrievalMethodCurrent</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the particular type of method that is currently being used to retrieve the management information. Values include:  0: Unknown  1: None  2: CLI  3: SNMP  4: TL1  5: CMIP  6: RMON  7: Proprietary  None could mean that this ManagedEntity performs a set function and is not configurable, as well as mean that this ManagedEntity is not configurable except by the factory.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_retrievalMethodsSupported -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_retrievalMethodsSupported">
<InformationModel_v1:hasOrigin>ManagementInfo</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>retrievalMethodsSupported</rdf:label>
<rdfs:comment>This is an array of integers that define the different means of retrieving management methods that are supported by this object. Values include:  0: Unknown  1: None  2: CLI  3: SNMP  4: TL1  5: CMIP  6: RMON  7: Proprietary  None could mean that this ManagedEntity performs a set function and is not configurable, as well as mean that this ManagedEntity is not configurable except by the factory.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_retryNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_retryNumber">
<InformationModel_v1:hasOrigin>EventTriggerDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>retryNumber</rdf:label>
<rdfs:comment>This specifies the number of times that this PolicyEvent should be resent to the specified PolicyRule. If the triggerEndTime elapses, then this PolicyEvent will not be resent anymore, even if the retryNumber indicates that additional retries should be attempted. Instead, the hasEventEvaluated attribute of this PolicyEvent must be set to 2 (failed to be evaluated).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_retryPolicy -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_retryPolicy">
<InformationModel_v1:hasOrigin>EventTriggerDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>retryPolicy</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the policy for retrying triggers. An enumeration enables the policy application to choose among a set of pre-defined policies for determining how many times to retry sending this PolicyEvent to its associated PolicyRule. Values include: 0 - do NOT retry 1 - always retry (until successful acknowledgment) 2 - retry the number of times specified in the retryNumber attribute</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revenueCode -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revenueCode">
<InformationModel_v1:hasOrigin>AppliedCustomerBillingRateSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>revenueCode</rdf:label>
<rdfs:comment>The revenue type represented by this AppliedCustomerBillingRateSpec. This attribute has at least 3 valid values:  RC - (for recurring charge)  UC - (for usage charge)  OC - (for one-time charge)</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revenueShareProvidedUsing -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revenueShareProvidedUsing">
<InformationModel_v1:hasOrigin>PartyRevShareTermOrCondition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>revenueShareProvidedUsing</rdf:label>
<rdfs:comment>Specifies how the revenue sharing information is provided. For example, on a revenue sharing notice, bill/invoice, or payment.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revenueShareTimePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revenueShareTimePeriod">
<InformationModel_v1:hasOrigin>PartyRevShareTermOrCondition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>revenueShareTimePeriod</rdf:label>
<rdfs:comment>The time period for which revenue shares should be determined. For example, weekly, monthly, quarterly.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revisionDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revisionDate">
<InformationModel_v1:hasOrigin>PartySettlementSpecVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>revisionDate</rdf:label>
<rdfs:comment>The date the version was created.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revisionNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revisionNumber">
<InformationModel_v1:hasOrigin>PartySettlementSpecVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>revisionNumber</rdf:label>
<rdfs:comment>A number that represents the occurrence of the version in the sequence of versions.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revisionType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_revisionType">
<InformationModel_v1:hasOrigin>PartySettlementSpecVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>revisionType</rdf:label>
<rdfs:comment>The significance of the revision.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rfsStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rfsStatus">
<InformationModel_v1:hasOrigin>ResourceFacingService</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>rfsStatus</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the status of this particular ResourceFacingService. Values include: 0: Operational and supporting CFS 1: Degraded but supporting CFS 2: In Violation and not supporting CFS 3: Operational but not yet supporting a CFS 4: Being Tested 5: Being Deployed 6: Failed Value 0 means that this ResourceFacingService is acting per specification, and is also currently supporting one or more CustomerFacingServices. Value 1 means that this ResourceFacingService is operational, but is currently in a degraded state. This degraded state indicates congestion or some other problem, but has not yet comprimised the operation of its associated CustomerFacingServices. Value 2 means that this ResourceFacingService is operational, but is currently in violation of its associated specification(s). This in turn means that its associated CustomerFacingServices are violating their contractual specification(s) unless automatic fail-over has been enabled. Value 3 means that this ResourceFacingService is acting per specification, but is not yet currently supporting one or more CustomerFacingServices. Value 4 means that this ResourceFacingService is currently being tested, and is not yet ready to support a CustomerFacingService. Value 5 means that this ResourceFacingService is currently being deployed, and is not yet ready to support a CustomerFacingService. Value 6 means that this ResourceFacingService has currently failed. The set of actions that should be taken, as well as whether this service can still be billed or not, are determined by its associated Policy for handling service violations.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_role -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_role">
<InformationModel_v1:hasOrigin>SecurityIncidentRelatedParty</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>role</rdf:label>
<rdfs:comment>Enumeration of the roles the Security Party plays in the incident, such as Notifying, Affected, Tracking.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_roleCombination -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_roleCombination">
<InformationModel_v1:hasOrigin>Role</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>roleCombination</rdf:label>
<rdfs:comment>A roleCombination is an array of string attributes that are used to identify and potentially select one or more policies for a set of managed entities from among a much larger set of available policies. Values of this attribute should be entered in comma separated value format; white space should be ignored.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_roleName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_roleName">
<InformationModel_v1:hasOrigin>AssociationRoleSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>roleName</rdf:label>
<rdfs:comment>Text that provides the name of the role a RootEntityType plays in an association.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_roleNbr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_roleNbr">
<InformationModel_v1:hasOrigin>AssociationRoleSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>roleNbr</rdf:label>
<rdfs:comment>A number assigned to a RootEntityType's involvement in an association. Valid values are 1 or 2, because this model only supports binary associations.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_roleSelectionMethod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_roleSelectionMethod">
<InformationModel_v1:hasOrigin>Role</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>roleSelectionMethod</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the precise means used to select one or more entities which map to one or more roles contained in the roleCombination attribute of this object. Values include: 0: retrieve all 1: retrieve intersection For exampe, assume that there is an external query engine that is looking for the roles edge or ethernet. The result of this query will look at the roleCombination and roleSelectionMethod attributes of each managed object that it is querying. If the value of this attribute is 0, then all managed objects that have their roleCombination set to either {edge}, {ethernet}, or {edge, ethernet} will be retrieved. In contrast, if the value of this attribute is 1, then only those managed objects whose roleCombination attribute is set to {edge, ethernet} will be retrieved.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_roleType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_roleType">
<InformationModel_v1:hasOrigin>ResourceSpecificationPerfRole</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>roleType</rdf:label>
<rdfs:comment>A function that a ResourceSpecification plays in defining a PerformanceSpecification, such as source, destination, related, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rootCause -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_rootCause">
<InformationModel_v1:hasOrigin>SecurityIncidentAttackMethod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>rootCause</rdf:label>
<rdfs:comment>Description of the root cause of the attack</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_routeGroupLabel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_routeGroupLabel">
<InformationModel_v1:hasOrigin>FreControlPlane</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>routeGroupLabel</rdf:label>
<rdfs:comment>This attribute represents the Route Group the FRE is associated to. When a target OS creates a Call with diverse Route Groups, it assigns a Route Group label (which may be a number) to each FRE. FREs in the same Route Group will be assigned the same value for routeGroupLabel. FREs in different Route Groups will be assigned different values for routeGroupLabel.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_routingConstraintEffort -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_routingConstraintEffort">
<InformationModel_v1:hasOrigin>FreControlPlane</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>routingConstraintEffort</rdf:label>
<rdfs:comment>This attribute indicates the requested level of effort to meet the routing constraint when creating and when rerouting the FRE.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scalarValue -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scalarValue">
<InformationModel_v1:hasOrigin>MetricDefinitionMethodArgument</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>scalarValue</rdf:label>
<rdfs:comment>A quantity that can assume any of a set of values.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scan -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scan">
<InformationModel_v1:hasOrigin>PartyIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>scan</rdf:label>
<rdfs:comment>A scan of the identification paper Note: May be used to get a copy of the photo to help in identification</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduledDates -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduledDates">
<InformationModel_v1:hasOrigin>DateScheduleDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>scheduledDates</rdf:label>
<rdfs:comment>The list of dates  when the date schedule definition is active on, e.g.November 1st 2022.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduledDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduledDuration">
<InformationModel_v1:hasOrigin>ProjectElement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>scheduledDuration</rdf:label>
<rdfs:comment>The duration expected during the detailed scheduling process</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduleDefinitionEndTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduleDefinitionEndTime">
<InformationModel_v1:hasOrigin>RecurringScheduleDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>scheduleDefinitionEndTime</rdf:label>
<rdfs:comment>The Endtime of the Schedule Definition. If the attribute is empty the Schedule run forever, not having a time constraint.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduleDefinitionHoursRange -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduleDefinitionHoursRange">
<InformationModel_v1:hasOrigin>RecurringScheduleDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>scheduleDefinitionHoursRange</rdf:label>
<rdfs:comment>A list of time ranges within a specific day that the schedule will be active on, for example 08:00-12:00, 16:00-19:00.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduleDefinitionStartTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduleDefinitionStartTime">
<InformationModel_v1:hasOrigin>RecurringScheduleDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>scheduleDefinitionStartTime</rdf:label>
<rdfs:comment>The Start time of the Schedule Definition. If the attribute is empty the Schedule will be active immediately.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduledQty -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduledQty">
<InformationModel_v1:hasOrigin>ProjectResourceReservationAllocation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>scheduledQty</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduleStartOffset -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scheduleStartOffset">
<InformationModel_v1:hasOrigin>RecurringScheduleDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>scheduleStartOffset</rdf:label>
<rdfs:comment>This is an offeset relating  to the recurring interval. For example, if the recurring interval is 1 hour and the offset is 10 minutes, a job will be executed at 1:10, 2:10, 3:10, etc.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_schemaName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_schemaName">
<InformationModel_v1:hasOrigin>TemplateBlock</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>schemaName</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scoringSequence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_scoringSequence">
<InformationModel_v1:hasOrigin>SecVulnerabilityScoringMetricDefn</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>scoringSequence</rdf:label>
<rdfs:comment>The order in which the score for the metric is calculated.  This ensures that a metric's score upon which another is dependent is calculated first.   Notes:  For example, the Base Exploitability Score is calculated after the Access Vector, Authentication, and Access Complexity scores are calculated.  Also, the Base Score has to be calculated from the Base Metrics before scoring the Temporal and/or Environmental Metrics.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sdStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sdStatus">
<InformationModel_v1:hasOrigin>ServiceDefinition</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>sdStatus</rdf:label>
<rdfs:comment>The state of the Service Definition; it may take on one of the following values: Draft, Standard, or Proprietary.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_securityBreach -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_securityBreach">
<InformationModel_v1:hasOrigin>SecureHolder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>securityBreach</rdf:label>
<rdfs:comment>This is an enumerated 16-bit unsigned integer attribute indicating whether a breach of the Rack was attempted. Values include:  0: Unknown  1: Other  2: No Breach  3: Unsuccessful Breach (but attempted)  4: Successful Breach  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_securityBreachDescription -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_securityBreachDescription">
<InformationModel_v1:hasOrigin>SecureHolder</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>securityBreachDescription</rdf:label>
<rdfs:comment>This is a free-form string attribute that provides supplementary information for the SecurityBreach attribute. It should only be filled in when the value of SecurityBreach is 1 ("Other").  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_semantics -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_semantics">
<InformationModel_v1:hasOrigin>ServiceSpecVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>semantics</rdf:label>
<rdfs:comment>This is a string that is used to define the particular semantics of this version. This string should include as a minimum a description of the format of the revisionNumber.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_seqNum -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_seqNum">
<InformationModel_v1:hasOrigin>MatrixCharValueIndex</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>seqNum</rdf:label>
<rdfs:comment>Holds the sequentialnumber of the dimension that this index applies to</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequence">
<InformationModel_v1:hasOrigin>CommunicationInteractionItem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>sequence</rdf:label>
<rdfs:comment>The CommunicationInteractionItem\'s sequence specifies the order in which they follow one another.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequencedActions -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequencedActions">
<InformationModel_v1:hasOrigin>PolicyRuleSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>sequencedActions</rdf:label>
<rdfs:comment>This is an enumerated integer defines how the ordering of the PolicyActions associated with this PolicyRule is to be interpreted.  Notes: Not present in the ITU or CIM specs (the CIM defined a subset of these values as an attribute in the PolicyRule).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequenceNum -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequenceNum">
<InformationModel_v1:hasOrigin>Anomaly</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>sequenceNum</rdf:label>
<rdfs:comment>A unique sequence of Anomaly used to identify the Anomaly management session</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequenceNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequenceNumber">
<InformationModel_v1:hasOrigin>PayGrade</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>sequenceNumber</rdf:label>
<rdfs:comment>The sequence maintained at the pay scale type for the same pay grade to maintain the differences in the payment amount in the payroll system.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequenceOfApplication -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequenceOfApplication">
<InformationModel_v1:hasOrigin>MetricDefMeasureThresholdConsequence</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>sequenceOfApplication</rdf:label>
<rdfs:comment>A number that represents the sequence in which a MetricDefMeasureConsequence should be applied for a MetricDefMeasureThresholdRule.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serialNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serialNumber">
<InformationModel_v1:hasOrigin>InstalledSoftware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>serialNumber</rdf:label>
<rdfs:comment>A set of identifying characters and/or numbers assigned to, and usually marked on, each of a series of identical Software instances.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceAffecting -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceAffecting">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>serviceAffecting</rdf:label>
<rdfs:comment>Provides the alarm-owning system determination of whether or not the alarm affects service.    This attribute is not supported in the Simple Alarm Reporting profile and optional in the Standard and Enhanced profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceApproach -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceApproach">
<InformationModel_v1:hasOrigin>HolderComposite</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>serviceApproach</rdf:label>
<rdfs:comment>This is an enumerated, integer-valued array that defines how this entity is serviced (e.g., from the top or front), whether it has sliding trays or removable sides, and/or whether the Frame is moveable (e.g., it has rollers). Values include:  0: Unknown  1: Custom  2: Service From Top  3: Service From Front  4: Service From Back  5: Service From Side  6: Sliding Trays  7: Removable Sides  8: Moveable  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceLevelObjective -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceLevelObjective">
<InformationModel_v1:hasOrigin>ServiceLevelSpecExpression</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>serviceLevelObjective</rdf:label>
<rdfs:comment>An indicator that is set to true if a ServiceLevelSpecObjective is part of the expresssion.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceLevelSpecApplicability -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceLevelSpecApplicability">
<InformationModel_v1:hasOrigin>ServiceLevelSpecExpression</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>serviceLevelSpecApplicability</rdf:label>
<rdfs:comment>An indicator that is set to true if a ServiceLevelSpecApplicability is part of the expresssion.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceLevelSpecConsequence -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceLevelSpecConsequence">
<InformationModel_v1:hasOrigin>ServiceLevelSpecExpression</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>serviceLevelSpecConsequence</rdf:label>
<rdfs:comment>An indicator that is set to true if a ServiceLevelSpecConsequence is part of the expresssion.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceLevelSpecParameter -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceLevelSpecParameter">
<InformationModel_v1:hasOrigin>ServiceLevelSpecExpression</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>serviceLevelSpecParameter</rdf:label>
<rdfs:comment>An indicator that is set to true if a ServiceLevelSpecParameter is part of the expresssion.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceLocation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceLocation">
<InformationModel_v1:hasOrigin>ServiceTemplate</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>serviceLocation</rdf:label>
<rdfs:comment>Gives the URL of where the service component activation OS is actually located.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_servicePolicyValidFor -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_servicePolicyValidFor">
<InformationModel_v1:hasOrigin>ServiceManagementPolicy</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>servicePolicyValidFor</rdf:label>
<rdfs:comment>This attribute defines a period of time that this particular ServicePolicy is valid for. A TimePeriod is a complex datatype that contains both a starting and ending time.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceRestoredDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceRestoredDate">
<InformationModel_v1:hasOrigin>TroubleTicket</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>serviceRestoredDate</rdf:label>
<rdfs:comment>The date on which the service was brought back to its original condition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceState -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_serviceState">
<InformationModel_v1:hasOrigin>ServiceAccessPoint</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>serviceState</rdf:label>
<rdfs:comment>Indicates the ability of an entity to provide service.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sessionID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sessionID">
<InformationModel_v1:hasOrigin>PublicWANAccessUsageEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>sessionID</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sessionTerminationCause -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sessionTerminationCause">
<InformationModel_v1:hasOrigin>PublicWANAccessUsageEntity</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>sessionTerminationCause</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_settlementDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_settlementDate">
<InformationModel_v1:hasOrigin>PartySettlement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>settlementDate</rdf:label>
<rdfs:comment>Issue date of a PartySettlement.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_settlementNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_settlementNumber">
<InformationModel_v1:hasOrigin>PartySettlement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>settlementNumber</rdf:label>
<rdfs:comment>A unique identifier that enables different instances of a PartySettlement to be distinguished from each other.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_severity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_severity">
<InformationModel_v1:hasOrigin>CustomerProblem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>severity</rdf:label>
<rdfs:comment>The severity of the CustomerProblem (in the eyes of the CSP).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sharedRiskGroupList -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sharedRiskGroupList">
<InformationModel_v1:hasOrigin>RoutingParameters</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>sharedRiskGroupList</rdf:label>
<rdfs:comment>This attribute specifies the shared risk that in general is considered against the physical environment. It is defined as a sequence of {risk type, and sequence of shared risk references (strings)}.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sharedSlots -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sharedSlots">
<InformationModel_v1:hasOrigin>AdjacentSlotDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>sharedSlots</rdf:label>
<rdfs:comment>This is a Boolean attribute that, if TRUE, means that if this Slot (i.e., Slot n) is populated by an adapter Card, then the next Slot (i.e., Slot n+1) must be left empty. This is because Slots can often be located in close proximity, such that if one of these Slots is occupied, there is no room to access the next Slot. This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_signatureRepresentation -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_signatureRepresentation">
<InformationModel_v1:hasOrigin>AgreementAuthorization</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>signatureRepresentation</rdf:label>
<rdfs:comment>Indication that represents whether the signature is a physical paper signature or a digital signature.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_size -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_size">
<InformationModel_v1:hasOrigin>CompetitiveTier</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>size</rdf:label>
<rdfs:comment>How big the Competitor is, such as small, medium, large, compared to other Competitors.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_skillLevel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_skillLevel">
<InformationModel_v1:hasOrigin>WorkforceEmployeeRole</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>skillLevel</rdf:label>
<rdfs:comment>Indicates the qualification level of the technician: for example, intern, entry level, senior/highly qualified</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_skills -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_skills">
<InformationModel_v1:hasOrigin>PartyResource</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>skills</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_skuNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_skuNumber">
<InformationModel_v1:hasOrigin>PhysicalResourceSpecAttributes</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>skuNumber</rdf:label>
<rdfs:comment>This is a string that defines the manufacturer-allocated Stock Keeping Unit (SKU) number of the hardware item. This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slaName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slaName">
<InformationModel_v1:hasOrigin>AssuranceCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>slaName</rdf:label>
<rdfs:comment>The name of corresponding Service Level Agreement for this capability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotLayout -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotLayout">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>slotLayout</rdf:label>
<rdfs:comment>This is a free-form string that describes the positioning, spacing, typical usage, restrictions, and any other pertinent information that defines how the Card is to be positioned into the Slot.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotNumber -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotNumber">
<InformationModel_v1:hasOrigin>CardOnCardDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>slotNumber</rdf:label>
<rdfs:comment>This attribute is a number defining the SlotNumber of the hosting Card that this DaughterCard plugs into. If there is no such SlotNumber, then this value should be set to 0. This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotPurpose -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotPurpose">
<InformationModel_v1:hasOrigin>Slot</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>slotPurpose</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the purpose of this Slot. A specific value below, such as System, means that the Slot is intended only to accept System cards. Values include:  0: Unknown  1: System  2: Networking  3: Port Adapter  4: Memory  5: Hardware Assist  6: Video  7: General Computing  8: General Purpose  Hardware assist is a generic category for specialty boards that provide hardware functionality to assist in the processing of one or more functions. Examples are special cards for processing IPsec-based encryption.  General computing boards represent cards that have additional and/or auxiliary computing power that can be used for a variety of tasks (not just video rendering or encryption).  General purpose boards represent cards that have a variety of features (e.g., memory and computing).  This is an optional attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotSpacingMax -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotSpacingMax">
<InformationModel_v1:hasOrigin>AdjacentSlotDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>slotSpacingMax</rdf:label>
<rdfs:comment>This is a 16-bit unsigned integer attribute that indicates the maximum spacing between slots in inches. This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotSpacingMin -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotSpacingMin">
<InformationModel_v1:hasOrigin>AdjacentSlotDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>slotSpacingMin</rdf:label>
<rdfs:comment>This is a 16-bit unsigned integer attribute that indicates the minimum spacing between slots in inches. This is a REQUIRED attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotsRequired -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slotsRequired">
<InformationModel_v1:hasOrigin>Card</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>slotsRequired</rdf:label>
<rdfs:comment>This is an integer that defines the number of slots required to hold this Card. Since this is usually 1, that value is assigned as its default value.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slsID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_slsID">
<InformationModel_v1:hasOrigin>AssuranceCapabilitySpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>slsID</rdf:label>
<rdfs:comment>The identifier of corresponding Service Level specification which determines assurance parameters for this capability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_socialSecurityNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_socialSecurityNr">
<InformationModel_v1:hasOrigin>SocialSecurityNrIdentification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>socialSecurityNr</rdf:label>
<rdfs:comment>A nine-digit number issued to U.S. citizens, permanent residents, and temporary (working) residents.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_softwareVersionMinReq -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_softwareVersionMinReq">
<InformationModel_v1:hasOrigin>ResourceSpecRunsSoftwareSpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>softwareVersionMinReq</rdf:label>
<rdfs:comment>This attribute defines the minimum version of the Software that is required for this ResourceSpecification to act properly.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_source -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_source">
<InformationModel_v1:hasOrigin>ServiceTemplate</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>source</rdf:label>
<rdfs:comment>Determines whether the source of the OS providing the Service Template is external or internal to a given organization.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sourcedAssets -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sourcedAssets">
<InformationModel_v1:hasOrigin>Community</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>sourcedAssets</rdf:label>
<rdfs:comment>Number of assets sourced from the Community</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_speakingProficiency -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_speakingProficiency">
<InformationModel_v1:hasOrigin>LanguageAbility</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>speakingProficiency</rdf:label>
<rdfs:comment>Degree of mastery in speaking a language.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_specificProblem -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_specificProblem">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>specificProblem</rdf:label>
<rdfs:comment>Further qualifies the alarm in addition to the probableCause. This attribute is defined as a string. Values are defined by vendors.   This attribute is optional in all 3 profiles.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_specType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_specType">
<InformationModel_v1:hasOrigin>PartySettlementSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>specType</rdf:label>
<rdfs:comment>A classification that groups PartySettlemenSpecifications that share common characteristics.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_specVersionNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_specVersionNr">
<InformationModel_v1:hasOrigin>ActivitySpec</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>specVersionNr</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_staffHoursLost -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_staffHoursLost">
<InformationModel_v1:hasOrigin>SecurityIncidentImpact</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>staffHoursLost</rdf:label>
<rdfs:comment>Estimate of staff hours lost due to the incident</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_standardCapacityRequired -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_standardCapacityRequired">
<InformationModel_v1:hasOrigin>WorkSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>standardCapacityRequired</rdf:label>
<rdfs:comment>Standard workforce capacity (man hour, man day) under normal condition and assumptions that the work requires to be completed</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_standardDrivingTime -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_standardDrivingTime">
<InformationModel_v1:hasOrigin>WorkSpecFulfillmentRate</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>standardDrivingTime</rdf:label>
<rdfs:comment>Standard driving time for the organization\'s technicians to drive to and between work places in the serving area</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_standardDuration -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_standardDuration">
<InformationModel_v1:hasOrigin>WorkSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>standardDuration</rdf:label>
<rdfs:comment>Standard duration of time, under normal condition and assumptions, that the work can take to be completed</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_startActivty -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_startActivty">
<InformationModel_v1:hasOrigin>WorkflowSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>startActivty</rdf:label>
<rdfs:comment>Represents the action that triggers the workflow. Linked to Activity ABE. </rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_startDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_startDate">
<InformationModel_v1:hasOrigin>BusinessInteraction</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>startDate</rdf:label>
<rdfs:comment>Date interaction initiated.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_startEvent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_startEvent">
<InformationModel_v1:hasOrigin>WorkflowSpecification</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>startEvent</rdf:label>
<rdfs:comment>Identifies the event signaling start of the workflow.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_startingDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_startingDate">
<InformationModel_v1:hasOrigin>DunningCase</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>startingDate</rdf:label>
<rdfs:comment>As soon as an event triggering a DunningRule occurs on a BillingAccount, a DunningCase is created according to the DunningScenario assigned to the BillingAccount. This date corresponds to the startingDate</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_startMode -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_startMode">
<InformationModel_v1:hasOrigin>Service</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>startMode</rdf:label>
<rdfs:comment>This attribute is an enumerated integer that indicates how the Service is started. Values include: 0: Unknown 1: Automatically by the managed environment 2: Automatically by the owning device 3: Manually by the Provider of the Service 4: Manually by a Customer of the Provider 5: Any of the above</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_state -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_state">
<InformationModel_v1:hasOrigin>Test</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>state</rdf:label>
<rdfs:comment>The actual state the test is in</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_statementOfIntent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_statementOfIntent">
<InformationModel_v1:hasOrigin>Agreement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>statementOfIntent</rdf:label>
<rdfs:comment>An overview and goals of the Agreement.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_stateOrProvince -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_stateOrProvince">
<InformationModel_v1:hasOrigin>GeographicAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>stateOrProvince</rdf:label>
<rdfs:comment>The state or province that the address is in. Synonyms / Aliases: province, territory</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_statisticForPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_statisticForPeriod">
<InformationModel_v1:hasOrigin>CustomerBillingStatistic</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>statisticForPeriod</rdf:label>
<rdfs:comment>The period for which the statistic is calculated.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_status -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_status">
<InformationModel_v1:hasOrigin>PartyRole</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>status</rdf:label>
<rdfs:comment>Used to track the lifecycle status, e.g. existing, prospective or former customers.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_statusEffectiveDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_statusEffectiveDate">
<InformationModel_v1:hasOrigin>AgreementAuthorization</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>statusEffectiveDate</rdf:label>
<rdfs:comment>The date associated with the status.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetName">
<InformationModel_v1:hasOrigin>UrbanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetName</rdf:label>
<rdfs:comment>The name of the street or other street type.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNamePrefix -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNamePrefix">
<InformationModel_v1:hasOrigin>AmericanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetNamePrefix</rdf:label>
<rdfs:comment>A word, letter, or number placed before the street name.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNameSuffix -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNameSuffix">
<InformationModel_v1:hasOrigin>AmericanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetNameSuffix</rdf:label>
<rdfs:comment>A word, letter, or number placed after the street name.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrFirst -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrFirst">
<InformationModel_v1:hasOrigin>UrbanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetNrFirst</rdf:label>
<rdfs:comment>A number identifying a specific property on a public street. It may be combined with streetNrLast for ranged addresses. Notes: A ranged address could be 26-28 XXX Street</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrFirstPrefix -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrFirstPrefix">
<InformationModel_v1:hasOrigin>AmericanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetNrFirstPrefix</rdf:label>
<rdfs:comment>A word, letter, or number placed before the street number.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrFirstSuffix -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrFirstSuffix">
<InformationModel_v1:hasOrigin>UrbanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetNrFirstSuffix</rdf:label>
<rdfs:comment>The first street number suffix. Notes: e.g. A for address 101A</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrLast -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrLast">
<InformationModel_v1:hasOrigin>UrbanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetNrLast</rdf:label>
<rdfs:comment>The last number in a range of street numbers allocated to a property. Notes: only entered for ranged addresses, otherwise left blank</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrLastPrefix -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrLastPrefix">
<InformationModel_v1:hasOrigin>AmericanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetNrLastPrefix</rdf:label>
<rdfs:comment>A word, letter, or number placed before last number in a range of street numbers allocated to a property.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrLastSuffix -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetNrLastSuffix">
<InformationModel_v1:hasOrigin>UrbanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetNrLastSuffix</rdf:label>
<rdfs:comment>The last street number suffix for a ranged address.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetSuffix -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetSuffix">
<InformationModel_v1:hasOrigin>UrbanPropertyAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetSuffix</rdf:label>
<rdfs:comment>A modifier denoting a relative direction Notes: e.g. CENTRAL, EAST, LOWER, NORTH, NORTH EAST, NORTH WEST, SOUTH, SOUTH EAST, SOUTH WEST, UPPER, WEST</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_streetType">
<InformationModel_v1:hasOrigin>StreetName</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>streetType</rdf:label>
<rdfs:comment>The kind of street, such as alley, avenue, boulevard, brae, crescent, drive, highway, lane, terrace, parade, place, tarn, way, wharf. Notes: may need to store a set of abbreviations as well</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_stStatus -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_stStatus">
<InformationModel_v1:hasOrigin>ServiceTemplate</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>stStatus</rdf:label>
<rdfs:comment>The state of the Service Template; it may take on one of the following values: Draft, Pilot, Commercial, Retired.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subCategory -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subCategory">
<InformationModel_v1:hasOrigin>MarketSegment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>subCategory</rdf:label>
<rdfs:comment>A further classification of MarketSegments because they share common characteristics. For example, a vertical category MarketSegment may be further categorized as consumer, business, or carrier.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subnetMask -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subnetMask">
<InformationModel_v1:hasOrigin>IPAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>subnetMask</rdf:label>
<rdfs:comment>This is a string attribute that defines the subnet mask for the IP Address of this instance. The IP Address is constructed by concatenating the networkNumber and the hostNumber, forming a dotted decimal IP Address. The subnetMask is formatted according to the appropriate convention as defined in the addressFormat attribute of this object.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subType">
<InformationModel_v1:hasOrigin>WorkflowType</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>subType</rdf:label>
<rdfs:comment>Represents additional information that identify the secondary workflow types associated to a primary type.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subtype -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subtype">
<InformationModel_v1:hasOrigin>ClosedLoopExitBy</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>subtype</rdf:label>
<rdfs:comment>A sub-category of an end trigger. </rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subUnitNr -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subUnitNr">
<InformationModel_v1:hasOrigin>UrbanPropertySubAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>subUnitNr</rdf:label>
<rdfs:comment>The discriminator used for the subunit. Notes: often just a sumple number e.g. FLAT 5, may also be a range</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subUnitType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_subUnitType">
<InformationModel_v1:hasOrigin>UrbanPropertySubAddress</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>subUnitType</rdf:label>
<rdfs:comment>The type of subunit. Notes: e.g.BERTH, FLAT, PIER, SUITE, SHOP, TOWER, UNIT, WHARF</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_suburb -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_suburb">
<InformationModel_v1:hasOrigin>StreetSegment</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>suburb</rdf:label>
<rdfs:comment>An outlying district of a city, especially a residential one.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_summary -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_summary">
<InformationModel_v1:hasOrigin>CalendarEntry</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>summary</rdf:label>
<rdfs:comment>A summarized description or subject of the entry</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_supportedMgmtMethods -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_supportedMgmtMethods">
<InformationModel_v1:hasOrigin>SupportedMgmtMethodDetail</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>supportedMgmtMethods</rdf:label>
<rdfs:comment>This is an array of strings. Each string contains the name of a class that identifies the name of a supported ManagementMethod for this class.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_swapSpaceUsedCurrent -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_swapSpaceUsedCurrent">
<InformationModel_v1:hasOrigin>InstalledSoftware</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>swapSpaceUsedCurrent</rdf:label>
<rdfs:comment>This defines the current swap space in amount and units that is being used. If the Software doesn't distinguish swap space from space used for paging files, then the value of this attribute should be 0.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_swotType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_swotType">
<InformationModel_v1:hasOrigin>SWOT</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>swotType</rdf:label>
<rdfs:comment>A category of organizational analysis, such as strength (S), weakness (W), opportunity (O), threat (T).</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_symbol -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_symbol">
<InformationModel_v1:hasOrigin>Currency</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>symbol</rdf:label>
<rdfs:comment>Symbol of a currency, such as $.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_symbolName -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_symbolName">
<InformationModel_v1:hasOrigin>PointSymbology</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>symbolName</rdf:label>
<rdfs:comment>A word, term, or phrase by which a PointSymbology is known and distinguished from other PointSymbologys.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_symbolSize -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_symbolSize">
<InformationModel_v1:hasOrigin>PointSymbology</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>symbolSize</rdf:label>
<rdfs:comment>How big the PointSymbology is.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_synopsis -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_synopsis">
<InformationModel_v1:hasOrigin>SecurityIncident</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>synopsis</rdf:label>
<rdfs:comment>Free text synopsis for analyst notes</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_systemDN -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_systemDN">
<InformationModel_v1:hasOrigin>ResourceAlarm</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>systemDN</rdf:label>
<rdfs:comment>Identifies the alarm-owning system, i.e. the one owning the alarm list.   This attribute is not supported in the Simple Alarm Reporting profile, optional in the Standard profile and mandatory in the Enhanced profile.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_systemID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_systemID">
<InformationModel_v1:hasOrigin>ExternalSystemCapability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>systemID</rdf:label>
<rdfs:comment>Unique system identifier providing the capability.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_targetNetwork -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_targetNetwork">
<InformationModel_v1:hasOrigin>NACSecurityEvent</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>targetNetwork</rdf:label>
<rdfs:comment>URI-based name of the network the subject attempted to gain access to.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_targetPlatform -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_targetPlatform">
<InformationModel_v1:hasOrigin>SoftwareResource</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>targetPlatform</rdf:label>
<rdfs:comment>This is an enumerated integer that defines the target platform that the SoftwareResource will be deployed on. Values include:  0: Independent of Platform  1: Other  2: Network Device (specified in subclasses)  3: Server  4: Desktop Computer  5: Laptop Computer  6: PDA  7: Phone  8: Other Mobile Device</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_targetUsedAs -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_targetUsedAs">
<InformationModel_v1:hasOrigin>SecurityIncident</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>targetUsedAs</rdf:label>
<rdfs:comment>Description of the how the compromised resource was used by the attacker.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_taskFunctionalArea -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_taskFunctionalArea">
<InformationModel_v1:hasOrigin>SCRUM_Task</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>taskFunctionalArea</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_technicalDescription -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_technicalDescription">
<InformationModel_v1:hasOrigin>SecurityVulnerability</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>technicalDescription</rdf:label>
<rdfs:comment>Details on the technical characteristics of the vulnerability</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_telephonyType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_telephonyType">
<InformationModel_v1:hasOrigin>NumberPortabilityRequest</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>telephonyType</rdf:label>
<rdfs:comment>It considers the type of telephony for numbers for the portability, like mobile, fixed and IP numbers related to the request.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_templateId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_templateId">
<InformationModel_v1:hasOrigin>IPDRSPData</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>templateId</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_texture -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_texture">
<InformationModel_v1:hasOrigin>SurfaceSymbology</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>texture</rdf:label>
<rdfs:comment>The feel, appearance, or consistency of a surface.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_theta -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_theta">
<InformationModel_v1:hasOrigin>AbsoluteLocalOrientation</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>theta</rdf:label>
<rdfs:comment>The angle between the z axis and the Z axis</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thirdPartyType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thirdPartyType">
<InformationModel_v1:hasOrigin>ThirdPartyCollectionPM</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>thirdPartyType</rdf:label>
<rdfs:comment>A classification of  the third party which collects the money for service provider, such as bank transfer, payment tool.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdCrossingDescription -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdCrossingDescription">
<InformationModel_v1:hasOrigin>CrossedThreshold</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>thresholdCrossingDescription</rdf:label>
<rdfs:comment>Contains further information on the threshold crossing alarm. Vendors should avoid using this field to put additional information identifying the indicator or the threshold id. The corresponding fields should be use for better alarm quality.  For complex thresholds involving multiple indicators, this field is required to provide a textual description of the threshold crossing condition.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdId -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdId">
<InformationModel_v1:hasOrigin>CrossedThreshold</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>thresholdId</rdf:label>
<rdfs:comment>Indicates the identifier of the threshold that caused the alarm.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdParams -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdParams">
<InformationModel_v1:hasOrigin>PerformanceThresholdRulePreDefinedParam</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>thresholdParams</rdf:label>
<rdfs:comment>A name-value pair representing a predefined threshold parameters.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdQualifier -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdQualifier">
<InformationModel_v1:hasOrigin>CrossedThreshold</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>thresholdQualifier</rdf:label>
<rdfs:comment>This attribute contains a set of name/ value pairs used to qualify the crossed threshold.   When migrating from MTOSI, this attribute can contain the pmLocation and the thresholdType.   For pmLocation, the name would be pmLocation and the values would be Contra_Near_End_Rx, Contra_Far_End_Rx, Near_End_Rx, Near_End_Tx, Far_End_Rx, Far_End_Tx, Bidirectional.  For thresholdType, the name is thresholdType and the possible values are Low, Lowest, Highest and High.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdRelationshipType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdRelationshipType">
<InformationModel_v1:hasOrigin>MetricDefMeasureThresholdRelationship</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>thresholdRelationshipType</rdf:label>
<rdfs:comment>The kind of relationship between two MetricDefMeasureThresholdRules, such as depends on, follows, and so forth.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdRuleCondition -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdRuleCondition">
<InformationModel_v1:hasOrigin>PerformanceThresholdRule</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>thresholdRuleCondition</rdf:label>
<rdfs:comment>A threshold may have two possible values: "Raise" - a threshold was crossed or "Clear" - a threshold ceased crossing.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdRuleSeverity -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdRuleSeverity">
<InformationModel_v1:hasOrigin>AnomalyThresholdRule</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>thresholdRuleSeverity</rdf:label>
<rdfs:comment>A threshold can be generated in different severity levels. A crossing for each level may require a different condition and possibly trigger a different consequence.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdTarget -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdTarget">
<InformationModel_v1:hasOrigin>ServiceLevelObjective</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>thresholdTarget</rdf:label>
<rdfs:comment>A value that used to specify when a warning should be used that indicates an objective is danger of not being met.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_thresholdType">
<InformationModel_v1:hasOrigin>AnomalyThresholdSet</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>thresholdType</rdf:label>
<rdfs:comment>The type of AnomalyThresholdRule contained in the AnomalyThresholdSet.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ticketType -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ticketType">
<InformationModel_v1:hasOrigin>TroubleTicket</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>JSON::JSON_Attribute</InformationModel_v1:hasStereotype>
<rdf:label>ticketType</rdf:label>
<rdfs:comment>represent a business type of the trouble ticket e.g. incident, complain, request</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timeChanged -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timeChanged">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>timeChanged</rdf:label>
<rdfs:comment>Time the problem was last changed</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timeOfCall -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timeOfCall">
<InformationModel_v1:hasOrigin>VoiceCallUsage</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>timeOfCall</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timeOfDayMask -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timeOfDayMask">
<InformationModel_v1:hasOrigin>PolicyConditionTimePeriod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>timeOfDayMask</rdf:label>
<rdfs:comment>This is a string attribute that refines the definition of the valid time period that is defined by the timePeriod attribute. This is done by explicitly specifying a range of times in a day the PolicyRule is valid for. These attributes work together, with the timePeriod attribute used to specify the overall time period that the PolicyRule is valid for, and the timeOfDayMask attribute used to pick out which range of time periods in a given day of that time period the PolicyRule is valid for. This attribute is formatted in the style of RFC 2445: a time string beginning with the character 'T', followed by the solidus character ('/'), followed by a second time string. The first time indicates the beginning of the range, while the second time indicates the end. Times are expressed as substrings of the form "Thhmmss". The second substring always identifies a later time than the first substring. To allow for ranges that span midnight, however, the value of the second string may be smaller than the value of the first substring. Thus, "T080000/T210000" identifies the range from 0800 until 2100, while "T210000/T080000" identifies the range from 2100 until 0800 of the following day. When a range spans midnight, it by definition includes parts of two successive days. When one of these days is also selected by either the monthOfYearMask, dayOfMonthMask, and/or dayOfWeekMask, but the other day is not, then the policy is active only during the portion of the range that falls on the selected day. For example, if the range extends from 2100 until 0800, and the day of week mask selects Monday and Tuesday, then the policy is active during the following three intervals: From midnight Sunday until 0800 Monday; From 2100 Monday until 0800 Tuesday; From 2100 Tuesday until 23:59:59 Tuesday. If this attribute is not specified, then the PolicyRule is treated as valid for the entire day, for all days specified by the timePeriod attribute.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timePeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timePeriod">
<InformationModel_v1:hasOrigin>PolicyConditionTimePeriod</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>timePeriod</rdf:label>
<rdfs:comment>This is a string attribute that defines an overall range of calendar dates and times over which a PolicyRule is valid. As such, this is the most basic way to use date and/or time to enable or disable a given PolicyRule. Date/times are expressed as substrings of the form: "yyyymmddThhmmss".  This attribute is based on time as defined in RFC 2445. This calls for a string to represent a starting date and time, in which the character 'T' indicates the beginning of the time portion, followed by the solidus character ('/'), followed by a similar string representing an end date and time. The first date indicates the beginning of the range, while the second date indicates the end. The second date and time must be later than the first.  For example: 20000101T080000/20000131T120000 is interpreted as: January 1, 2000, 0800 through January 31, 2000, noon There are also two special cases in which one of the date/time strings is replaced with a special string defined in RFC 2445.  - If the first date/time is replaced with the string "THISANDPRIOR", then the property indicates that a policy rule is valid, from now until the date/time that appears after the '/'. - If the second date/time is replaced with the string "THISANDFUTURE", then the property indicates that a policy rule becomes valid on the date/time that appears before the '/', and remains valid from that point on. Notes: Not present in the ITU specs. The CIM defines a similar attribute called TimePeriod.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timeRaised -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timeRaised">
<InformationModel_v1:hasOrigin>Problem</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>timeRaised</rdf:label>
<rdfs:comment>Time the problem was raised</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timestamp -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timestamp">
<InformationModel_v1:hasOrigin>ServiceSpecVersion</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype>required</InformationModel_v1:hasStereotype>
<rdf:label>timestamp</rdf:label>
<rdfs:comment>This defines the date and time of the revision.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timeValue -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timeValue">
<InformationModel_v1:hasOrigin>SoftwareResource</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>timeValue</rdf:label>
<rdfs:comment>This attribute contains the value of the current Time.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timezoneUrl -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timezoneUrl">
<InformationModel_v1:hasOrigin>TimeZone</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>timezoneUrl</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timingConstraint -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timingConstraint">
<InformationModel_v1:hasOrigin>ProjectElement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>timingConstraint</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timingConstraintDate -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_timingConstraintDate">
<InformationModel_v1:hasOrigin>ProjectElement</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>timingConstraintDate</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_title -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_title">
<InformationModel_v1:hasOrigin>Project</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>title</rdf:label>
<rdfs:comment>A short description of the Project</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_to -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_to">
<InformationModel_v1:hasOrigin>GoalDirection</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>to</rdf:label>
<rdfs:comment>Targets affected by the goal.</rdfs:comment>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_toBeInstalledTimeStamp -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_toBeInstalledTimeStamp">
<InformationModel_v1:hasOrigin>ServicePlaceDetails</InformationModel_v1:hasOrigin>
<InformationModel_v1:hasStereotype></InformationModel_v1:hasStereotype>
<rdf:label>toBeInstalledTimeStamp</rdf:label>
