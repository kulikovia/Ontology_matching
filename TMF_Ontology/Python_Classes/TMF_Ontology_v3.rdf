<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PartyRoleSpecification</rdf:label>
<rdfs:comment>The definition of a role a party may play. this is entityone Task </rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_PartyRoleSpecification -->

