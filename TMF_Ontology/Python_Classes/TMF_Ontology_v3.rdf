<TMF_v1:BriefDescription>Receive Customer Order Payment business activity is responsbile for receiving payments from customers (via any medium, channel or means).</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
