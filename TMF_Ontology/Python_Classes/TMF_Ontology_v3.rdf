<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Strategy Management"/>
<TMF_v1:BriefDescription>Define resource support principles for the operational organization providing resource support.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.2.3.1.4.1</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.1.4.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Define Resource support Principles</rdf:label>
<rdfs:comment>Define Resource Support Principles processes define principles for service levels and service quality on existing resources or new resources</rdfs:comment>
</owl:NamedIndividual>

