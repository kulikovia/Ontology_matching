<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>CompositeMarketingCampaignCharacteristic</rdf:label>
<rdfs:comment>A type of MarketingCampaignCharacteristic that is formed by aggregating other MarketingCampaignCharacteristic, which may be Composite or Atomic MarketingCampaignCharacteristic.</rdfs:comment>
</owl:Class>

