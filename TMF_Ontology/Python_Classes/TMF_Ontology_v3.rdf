<TMF_v1:hasStereotype></TMF_v1:hasStereotype>
<rdf:label>nickName</rdf:label>
<rdfs:comment>Nick name used to welcome when connecting.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#normalDays -->

