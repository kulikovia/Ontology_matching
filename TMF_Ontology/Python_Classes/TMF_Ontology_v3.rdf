<rdf:label>hasAttribute_for_SalesOpportunityItem</rdf:label>
<rdfs:comment>hasAttribute_for_SalesOpportunityItem</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SalesProject -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SalesProject">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>SalesProject</rdf:label>
<rdfs:comment>A SalesProject is a type of Project which achieves a business goal in the context of a sale and concerns a SalesOpportunity. The aims of a SalesProject is to detail the need of the Prospect up to lead to Agreement(s) and / or CustomerProductOrders.</rdfs:comment>
</owl:Class>

