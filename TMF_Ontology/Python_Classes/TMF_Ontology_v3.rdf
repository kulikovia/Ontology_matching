<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#periodCoverage"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#date"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#quantity"/>
<rdf:label>hasAttribute_for_AppliedCustomerBillingProductRecurringCharge</rdf:label>
<rdfs:comment>hasAttribute_for_AppliedCustomerBillingProductRecurringCharge</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingProductUsageRate -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingProductUsageRate">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>AppliedCustomerBillingProductUsageRate</rdf:label>
<rdfs:comment>AppliedCustomerBillingProductUsageCharge represents the charge for a product usage event typically produced by a rating engine.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AppliedCustomerBillingProductUsageRate -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AppliedCustomerBillingProductUsageRate">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
