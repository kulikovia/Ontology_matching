<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Sales Performance Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Sales Performance Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Market and Sales Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Sales Performance Management direct and control sales activities that establish, manage, analyze, report, and incentives for sales accomplishments.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.1.26</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.1.13</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">2</TMF_v1:ProcessLevel>
<rdf:label>Sales Performance Management</rdf:label>
<rdfs:comment>Sales Performance Management direct and control sales activities that establish, manage, analyze, report,  incentives for sales accomplishments. Sales Performance Management capabilities include managing incentive compensation, planning quotas, managing quotas, managing sales territory, analyzing and gamification of selling.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Analyze Sales Performance -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Analyze Sales Performance">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
