<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TerminationPointEncapsulation"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TopologicalLink"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TrafficMappingTable"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TrafficMappingTableRow"/>
<rdfs:comment>hasBE_for_Logical Resource ABE.Converged Network ABE</rdfs:comment>
