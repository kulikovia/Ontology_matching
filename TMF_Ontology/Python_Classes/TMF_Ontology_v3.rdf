</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#HolderAtomic -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#HolderAtomic">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>HolderAtomic</rdf:label>
<rdfs:comment>This class represents atomic holders of Equipment that are individually manageable and do NOT form composite, or nested, Equipment Holders.

Each HolderAtomic object can be a FRU.</rdfs:comment>
</owl:Class>

