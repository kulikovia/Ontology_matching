</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BundledProdOfferOption -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BundledProdOfferOption">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>BundledProdOfferOption</rdf:label>
<rdfs:comment>A set of numbers that specifies the lower and upper limits for a ProductOffering that can be procured as part of the related BundledProductOffering.

Values can range from 0 to unbounded.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BundledProdOfferOption -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BundledProdOfferOption">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BundledProdOfferOption"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#defaultRelOfferNumber"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#numberRelOfferLowerLimit"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#numberRelOfferUpperLimit"/>
<rdf:label>hasAttribute_for_BundledProdOfferOption</rdf:label>
<rdfs:comment>hasAttribute_for_BundledProdOfferOption</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BundledProductOffering -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BundledProductOffering">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>BundledProductOffering</rdf:label>
<rdfs:comment>A type of ProductOffering that represents a grouping of ProductOfferings made available to the market.  The grouping may consist of other BundledProductOffering(s) or SimpleProductOffering(s).</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BundledProductOffering -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BundledProductOffering">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
