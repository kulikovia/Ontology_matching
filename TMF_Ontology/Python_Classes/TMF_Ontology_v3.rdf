<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BrokerCoordinationDetails -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BrokerCoordinationDetails">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>BrokerCoordinationDetails</rdf:label>
<rdfs:comment>This class implements the semantics of the BrokerCoordinates association, which defines which PolicyServers are coordinated by which PolicyBrokers.
This association defines the set of PolicyServers that this PolicyBroker coordinates the actions of.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BrokerCoordinationDetails -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BrokerCoordinationDetails">
