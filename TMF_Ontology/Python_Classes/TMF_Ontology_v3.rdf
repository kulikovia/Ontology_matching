</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Enterprise Domain.Finance ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Enterprise Domain.Finance ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
