<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>hasAttribute_for_ConfigurationFeature</rdf:label>
<rdfs:comment>hasAttribute_for_ConfigurationFeature</rdfs:comment>
</owl:ObjectProperty>

