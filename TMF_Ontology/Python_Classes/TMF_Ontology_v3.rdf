<TMF_v1:BriefDescription>Manage Supply Chain Strategic Planning: Manage Supply Chain Strategic Planning leverage the Enterprise strategic planning to identify demand and optimize inventory, supplier network plans, procurement sourcing plans (in-sourcing, out-sourcing), and distri</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.7.10.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Manage Supply Chain Strategic Planning</rdf:label>
<rdfs:comment>Manage Supply Chain Strategic Planning: Manage Supply Chain Strategic Planning leverage the Enterprise strategic planning to identify demand and optimize inventory, supplier network plans, procurement sourcing plans (in-sourcing, out-sourcing), and distribution plans, etc.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Plan Logistics -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Plan Logistics">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Enterprise Domain"/>
