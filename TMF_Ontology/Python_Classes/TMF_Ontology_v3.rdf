<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SimpleAmountTaxDefinition">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>SimpleAmountTaxDefinition</rdf:label>
<rdfs:comment>A tax that is a fixed amount, e.g. 0.50 euro levied as an environmental surcharge for mobile device sales.</rdfs:comment>
</owl:Class>

