<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>RevenueSharingModelRelationship</rdf:label>
<rdfs:comment>A relationship between two PartyRevenueSharingModels. For example, a partner may provide their equivalent of a model to an enterprise to ensure both parties involved are in agreement as to the revenue that will be shared.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_RevenueSharingModelRelationship -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_RevenueSharingModelRelationship">
