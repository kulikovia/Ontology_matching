<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LoyaltyAction"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LoyaltyCondition"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LoyaltyEvent"/>
