<TMF_v1:BriefDescription>Manage Product Capacity Utilization business activity is in charge of fulfilling and assuring the effective use of product capacity.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
