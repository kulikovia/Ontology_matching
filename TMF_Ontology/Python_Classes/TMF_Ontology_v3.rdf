<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ProdCatProdOffer</rdf:label>
<rdfs:comment>ProdCatProdOffer characterizes the membership of a ProductOffering to a ProductCatalog.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_ProdCatProdOffer -->

