<TMF_v1:BriefDescription>Create Resource Work Order Task business activity sets up and defines tasks that need to be completed.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
