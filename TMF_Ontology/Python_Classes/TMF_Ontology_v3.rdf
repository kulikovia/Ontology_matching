<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ResourceSpecCharacteristic -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ResourceSpecCharacteristic">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ResourceSpecCharacteristic</rdf:label>
<rdfs:comment>A characteristic quality or distinctive feature of a ResourceSpecification. The characteristic can be take on a discrete value, such as color, can take on a range of values, (for example, sensitivity of 100-240 mV), or can be derived from a formula (for example, usage time (hrs) = 30 - talk time *3). Certain characteristics, such as color, may be configured during the ordering or some other process.</rdfs:comment>
</owl:Class>

