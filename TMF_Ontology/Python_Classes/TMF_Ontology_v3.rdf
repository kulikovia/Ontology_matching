<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#pin"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#type"/>
<rdf:label>hasAttribute_for_BusinessPartnerAccount</rdf:label>
<rdfs:comment>hasAttribute_for_BusinessPartnerAccount</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BusinessPartnerAccountAssignment -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BusinessPartnerAccountAssignment">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>BusinessPartnerAccountAssignment</rdf:label>
<rdfs:comment>The BusinessPartnerAccountAssignment specifies rules for a BusinessPartnerAccount on how assignment to a FinancialAccount has to be done for each accounting event.</rdfs:comment>
</owl:Class>

