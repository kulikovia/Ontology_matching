<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRevenueSharingAgreementItem -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRevenueSharingAgreementItem">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PartyRevenueSharingAgreementItem</rdf:label>
<rdfs:comment>The purpose of a PartyRevenueSharingAgreement expressed in terms of the agreed upon terms and conditions specific to the item and the PartyRevenueSharingModel that specifies how revenue will be shared among parties invovled in the agreement.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_PartyRevenueSharingAgreementItem -->

