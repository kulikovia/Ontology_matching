<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#value"/>
<rdf:label>hasAttribute_for_SalesQuote</rdf:label>
<rdfs:comment>hasAttribute_for_SalesQuote</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SalesQuoteAgreement -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SalesQuoteAgreement">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>SalesQuoteAgreement</rdf:label>
<rdfs:comment>A SalesQuoteAgreement is a type of Agreement. It enables tracking the approval made by the Party within CSP for the SalesQuote.</rdfs:comment>
</owl:Class>

