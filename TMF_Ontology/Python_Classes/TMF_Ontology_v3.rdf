<rdfs:comment>hasAttribute_for_PermissionScopeSpecPolicyRuleSpec</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionSet -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionSet">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PermissionSet</rdf:label>
<rdfs:comment>Each PermissionSet may refer to a PermissionSpecSet if it corresponds to applying permissions specified for a PartyRoleSpecification. If PermissionSet corresponds to permissions granted by another PartyRole it has no relationship with a PermissionSpecSet.</rdfs:comment>
</owl:Class>

