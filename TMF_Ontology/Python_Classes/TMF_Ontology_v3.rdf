<rdfs:comment>hasAttribute_for_PermissionScope</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopePolicyRule -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopePolicyRule">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PermissionScopePolicyRule</rdf:label>
<rdfs:comment>PermissionScopePolicyRule is used for describing PermissionScope criterias and the value(s) that limit the scope of permission.</rdfs:comment>
</owl:Class>

