<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Bill Collection ABE.Dunning ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Bill Collection ABE.Dunning ABE">
<rdfs:subClassOf rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TMFDomain"/>
<rdfs:comment>The Dunning ABE represents attempts to collect payment from a customer for overdue payments.</rdfs:comment>
<rdfs:label>Business Entity.Customer Bill Collection ABE.Dunning ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Customer Bill Collection ABE.Dunning ABE -->

