<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ProdOfferPricePolicyValue -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ProdOfferPricePolicyValue">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ProdOfferPricePolicyValue</rdf:label>
<rdfs:comment>An amount expressed in money or another medium of exchange that is thought to be a fair exchange for a ProductOffering as the result of the evaluation of a PolicyStatement.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_ProdOfferPricePolicyValue -->

