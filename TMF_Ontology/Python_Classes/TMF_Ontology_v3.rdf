<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>SimpleRateTaxDefinition</rdf:label>
<rdfs:comment>A tax that is calculated by a rate, e.g. Value Added Tax is 17% of the purchase price.</rdfs:comment>
</owl:Class>

