<TMF_v1:BriefDescription>Define Market Problem business activity is in charge of establishing a clear case for a market issue, challenge or concern.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
