<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Fulfillment"/>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">1220</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">3830</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Internal Service Order Initialization</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Internal Service Order Initialization Function permit to initialize Customer Facing Service Orders (a.k.a. CFS Orders) for operator internal needs, for example to change (part of) a technical solution and migrate operational Installed CFS on the new solution elements (ex: VOIP H323 -> VOIP SIP).</rdfs:comment>
</owl:NamedIndividual>

