<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalTargetEntityType -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalTargetEntityType">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>GoalTargetEntityType</rdf:label>
<rdfs:comment>Represents the classification of the type entities affected by the goal. Usually, a goal may have two types, the object and the entities that exist/must exist for the goal to be achieved. E.g. identify the customers choice. "Customer choice" is a result of the achievement of the goal.</rdfs:comment>
</owl:Class>

