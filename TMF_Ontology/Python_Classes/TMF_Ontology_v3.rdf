<rdf:label>hasAttribute_for_CustomerBillingAccountAssignment</rdf:label>
<rdfs:comment>hasAttribute_for_CustomerBillingAccountAssignment</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CustomerBillingAccountBalance -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CustomerBillingAccountBalance">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>CustomerBillingAccountBalance</rdf:label>
<rdfs:comment>BillingAccountBalance represents and tracks the amount remained or owed in certain account which is owned by certain customer.</rdfs:comment>
</owl:Class>

