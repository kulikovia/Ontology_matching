<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#valueType"/>
<rdf:label>hasAttribute_for_TestMeasureDefinition</rdf:label>
<rdfs:comment>hasAttribute_for_TestMeasureDefinition</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TestSpecificationRole -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TestSpecificationRole">
