<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Usage Event Distribution -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Usage Event Distribution">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
