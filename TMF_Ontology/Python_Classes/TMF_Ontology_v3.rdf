<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>hasAttribute_for_Resource</rdf:label>
<rdfs:comment>hasAttribute_for_Resource</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ResourceCharacteristicValue -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ResourceCharacteristicValue">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ResourceCharacteristicValue</rdf:label>
<rdfs:comment>A value of a ResourceSpecCharacteristic chosen for a Resource that further defines what the Resource is.</rdfs:comment>
</owl:Class>

