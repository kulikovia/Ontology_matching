<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<rdf:label>hasAttribute_for_ServiceLevelAgreement</rdf:label>
<rdfs:comment>hasAttribute_for_ServiceLevelAgreement</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AgreementTermOrCondition -->

