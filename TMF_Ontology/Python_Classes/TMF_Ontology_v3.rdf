<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServiceSpecCharUse -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServiceSpecCharUse">
