<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Work Item Decomposition</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Orchestration Manager will know the necessary steps (workflow items) to be carried through.</rdfs:comment>
</owl:NamedIndividual>

