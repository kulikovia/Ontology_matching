<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SalesOpportunity -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SalesOpportunity">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>SalesOpportunity</rdf:label>
<rdfs:comment>A SalesOpportunity is an opportunity to generate revenue from a SalesLead that can already be an existing Customer. Opportunities are the pending deals that need to be tracked. Opportunities build the pipeline, which will contribute to the forecast. A SalesOpportunity represents an interest expressed by a Party known as a SalesLead to at least one ProductOffering/ProductSpecification proposed by the CSP.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_SalesOpportunity -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_SalesOpportunity">
