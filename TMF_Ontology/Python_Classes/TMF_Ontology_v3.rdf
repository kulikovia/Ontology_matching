<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Bill-time Fee Calculation</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Bill-time Fee Calculation calculates and applies bill-time fees where necessary.</rdfs:comment>
</owl:NamedIndividual>

