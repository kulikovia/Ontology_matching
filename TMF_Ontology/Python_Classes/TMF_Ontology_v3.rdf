</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1# hasBE_for_Agreement ABE.Commitment ABE -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasBE_for_Agreement ABE.Commitment ABE">
