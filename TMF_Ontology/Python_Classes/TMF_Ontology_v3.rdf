<rdf:label>Report Service Quality Issues</rdf:label>
<rdfs:comment>Report Service Quality Issues business activity provides detailed account of both internal and external service performance excellence concerns.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Report Service Quality Control Activity -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Report Service Quality Control Activity">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Service Domain"/>
