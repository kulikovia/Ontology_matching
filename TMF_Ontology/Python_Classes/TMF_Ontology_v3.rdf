<TMF_v1:BriefDescription>Monitor Resource Order Provisioning business activity tracks the progress of resource order provisioning and accounts for all activties in support of the resource order provisioning.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
