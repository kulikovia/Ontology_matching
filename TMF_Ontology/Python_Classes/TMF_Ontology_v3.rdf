<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.2.6.12.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Research Product Performance</rdf:label>
<rdfs:comment>Research Product Performance business activity review and investigate product performance concerns. Research Product Performance may leverage case studies etc. to clarify product performance against product performance requirements and to support making a business decision.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Evaluate Product Performance Insights -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Evaluate Product Performance Insights">
