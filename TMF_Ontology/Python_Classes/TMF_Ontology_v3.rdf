<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BooleanValue -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BooleanValue">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>BooleanValue</rdf:label>
<rdfs:comment>This class is used to represent a Boolean (TRUE/FALSE) value.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BooleanValue -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BooleanValue">
