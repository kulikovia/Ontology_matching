<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CommunicationInteractionResult"/>
<rdf:label>hasAttribute_for_CommunicationInteractionResult</rdf:label>
<rdfs:comment>hasAttribute_for_CommunicationInteractionResult</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CommunicationInteractionUseCase -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CommunicationInteractionUseCase">
