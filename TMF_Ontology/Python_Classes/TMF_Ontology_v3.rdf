<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Capability Management"/>
<TMF_v1:BriefDescription>Align Resource Capacity Planning Goals business activity correlates Resource Capacity Plans with business demand.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.14.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Align Resource Capacity Planning Goals</rdf:label>
<rdfs:comment>Align Resource Capacity Planning Goals business activity correlates Resource Capacity Plans with business demand.</rdfs:comment>
</owl:NamedIndividual>

