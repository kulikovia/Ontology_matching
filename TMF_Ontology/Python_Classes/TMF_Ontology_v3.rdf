<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Intelligence Analysis Result Notification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Intelligence Analysis Result Notification assist the delivery functions by sending alerts to Customers/Users about new or changed Analytics, Metrics, KPI etc. data according to requested criteria.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Content Management Data Versioning -->

