<rdfs:comment>hasAttribute_for_DisputedAmountActivity</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Common Domain.Base Types ABE -->

