<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Market and Sales Domain.Sales Channel ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Market and Sales Domain.Sales Channel ABE">
<rdfs:subClassOf rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TMFDomain"/>
<rdfs:comment>Sales Channel ABE keeps track of distribution channels and sales activities, sales quotas, sales, contests, commission/bonus plans, commissions/bonuses, and maintain groups of individuals that make up the sales force.</rdfs:comment>
<rdfs:label>Business Entity.Market and Sales Domain.Sales Channel ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Market and Sales Domain.Sales Channel ABE -->

