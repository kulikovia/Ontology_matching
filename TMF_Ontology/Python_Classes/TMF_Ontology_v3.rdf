<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Assess and Report Resource Performance Management Processes -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Assess and Report Resource Performance Management Processes">
