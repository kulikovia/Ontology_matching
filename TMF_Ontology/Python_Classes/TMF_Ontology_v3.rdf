<TMF_v1:hasOrigin>TimeZoneRule</TMF_v1:hasOrigin>
<TMF_v1:hasStereotype></TMF_v1:hasStereotype>
<rdf:label>abbreviation</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#acceptableEquipmentList -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#acceptableEquipmentList">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Attribute"/>
<TMF_v1:hasOrigin>EquipmentHolder</TMF_v1:hasOrigin>
<TMF_v1:hasStereotype>required</TMF_v1:hasStereotype>
<rdf:label>acceptableEquipmentList</rdf:label>
<rdfs:comment>This is an array of strings, based on M.3100, that identifies the types of equipment objects that can be supported by this object. This is an optional attribute.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#acceptableEquipmentTypeList -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#acceptableEquipmentTypeList">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Attribute"/>
<TMF_v1:hasOrigin>EquipmentHolder</TMF_v1:hasOrigin>
<TMF_v1:hasStereotype>required</TMF_v1:hasStereotype>
<rdf:label>acceptableEquipmentTypeList</rdf:label>
<rdfs:comment>This attribute identifies the types of equipment that can be supported by the Equipment Holder.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#acceptedAmount -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#acceptedAmount">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Attribute"/>
<TMF_v1:hasOrigin>DAAAccepted</TMF_v1:hasOrigin>
<TMF_v1:hasStereotype></TMF_v1:hasStereotype>
<rdf:label>acceptedAmount</rdf:label>
<rdfs:comment>The amount which the enterprise agreed to refund the Customer as a result of this DisputedAmount. This amount is less or equal the disputedAmount (in DAACreated entity), pending of the DisputedAmount was partially or completely accepted respectively.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#accessClassification -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#accessClassification">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Attribute"/>
<TMF_v1:hasOrigin>CalendarEntry</TMF_v1:hasOrigin>
<TMF_v1:hasStereotype>required</TMF_v1:hasStereotype>
<rdf:label>accessClassification</rdf:label>
<rdfs:comment>The access intended for this entry Permitted Values: PUBLIC, PRIVATE or CONFIDENTIAL</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#accessDecision -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#accessDecision">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Attribute"/>
<TMF_v1:hasOrigin>NACSecurityEvent</TMF_v1:hasOrigin>
<TMF_v1:hasStereotype>required</TMF_v1:hasStereotype>
<rdf:label>accessDecision</rdf:label>
<rdfs:comment>Final decision by the NAC to permit or deny access to the network (Permit/Deny).</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#accessLevel -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#accessLevel">
