<rdfs:label>hasBE_for_Customer Domain.Customer Party Roles ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Buyer -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Buyer">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>Buyer</rdf:label>
<rdfs:comment>A PartyRole played by a Party, who imposed a Supplier to provide a deliverable by a formal Agreement (Commitment).</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_Buyer -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_Buyer">
