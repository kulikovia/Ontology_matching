<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2100</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Internal Recommended Action Guiding</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Internal Recommended Action Guiding gives recommendations and a guided action flow to complete the suitable customer treatment for Inbound, Self-Service or Call Center touch points (ex. Credit Adjustment handled by agent, or bill dispute initiation via self-service).</rdfs:comment>
</owl:NamedIndividual>

