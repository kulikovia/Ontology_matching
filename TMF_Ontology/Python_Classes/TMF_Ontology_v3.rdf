<TMF_v1:BriefDescription>Analyze an existing product offering to identify if it is economically or strategically unviable.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
