<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>hasAttribute_for_ServiceSpecVersion</rdf:label>
<rdfs:comment>hasAttribute_for_ServiceSpecVersion</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Service Specification ABE.Customer Facing Service Spec ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Service Specification ABE.Customer Facing Service Spec ABE">
<rdfs:subClassOf rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TMFDomain"/>
<rdfs:comment>The Customer Facing Service Spec ABE defines the common characteristics for a set of CustomerFacingServices. This scales by enabling multiple CustomerFacingServiceSpecs to be defined to model the common characteristics of different groups of CustomerFacingServices.</rdfs:comment>
<rdfs:label>Business Entity.Service Specification ABE.Customer Facing Service Spec ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Service Specification ABE.Customer Facing Service Spec ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Service Specification ABE.Customer Facing Service Spec ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<rdfs:comment>The Customer Facing Service Spec ABE defines the common characteristics for a set of CustomerFacingServices. This scales by enabling multiple CustomerFacingServiceSpecs to be defined to model the common characteristics of different groups of CustomerFacingServices.</rdfs:comment>
<rdfs:label>Service Specification ABE.Customer Facing Service Spec ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasDomain_for_Service Specification ABE.Customer Facing Service Spec ABE -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasDomain_for_Service Specification ABE.Customer Facing Service Spec ABE">
