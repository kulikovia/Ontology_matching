<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PayRollAgency</rdf:label>
<rdfs:comment>PayRollAgency is a PartyRole played by a Party being an equitable partner in a business interaction with other parties, playing the Agency involved in the PayRoll Execution for the Organisation. </rdfs:comment>
</owl:Class>

