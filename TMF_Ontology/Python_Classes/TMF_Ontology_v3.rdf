<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ResourceRoleDetails -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ResourceRoleDetails">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ResourceRoleDetails</rdf:label>
<rdfs:comment>This class implements the semantics of the ResourceTakesOnRoles aggregation. It also serves as the parent class for defining the classes that implement the RolesDescribePhysicalResource, RolesDescribeLogicalResource, and RolesDescribeCompoundResource aggregations. These three classes are named RolesDescribePhysicalResourceDetails, RolesDescribeLogicalResourceDetails, and RolesDescribeCompoundResourceDetailsm respectively.</rdfs:comment>
</owl:Class>

