<TMF_v1:BriefDescription>Gather marketing communications metrics to gauge the effectiveness of one or more communications.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
