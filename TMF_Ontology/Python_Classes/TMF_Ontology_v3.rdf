<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sales Opportunities Dispatching</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Sales Opportunities Dispatching creates and dispatches opportunities to relevant employees/sales personnel. Captures customer information and qualifies leads according to the guidelines set by your company (cf Customer Information Management). Sales opportunities are dispatched to sales representatives in the field.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Commissioning Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Commissioning Management">
