<rdf:label>hasAttribute_for_CompAtomicConfigSpecRel</rdf:label>
<rdfs:comment>hasAttribute_for_CompAtomicConfigSpecRel</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ConfigSpecConstraintMember -->

