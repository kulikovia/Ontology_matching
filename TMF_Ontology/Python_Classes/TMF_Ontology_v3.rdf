<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.2.7.2.1.4.1.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">7</TMF_v1:ProcessLevel>
<rdf:label>Identify Product Offering Acceptance Test Participants</rdf:label>
<rdfs:comment>Not used for this process element</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Conduct Product Offering Acceptance Test -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Conduct Product Offering Acceptance Test">
