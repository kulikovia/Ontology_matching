<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Usage"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VoiceCallUsage"/>
<rdfs:comment>hasBE_for_Common Domain.Usage ABE</rdfs:comment>
