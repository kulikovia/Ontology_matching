<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>hasAttribute_for_StockLocation</rdf:label>
<rdfs:comment>hasAttribute_for_StockLocation</rdfs:comment>
</owl:ObjectProperty>

