<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#softwareVersionMinReq"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<rdf:label>hasAttribute_for_ResourceSpecRunsSoftwareSpec</rdf:label>
<rdfs:comment>hasAttribute_for_ResourceSpecRunsSoftwareSpec</rdfs:comment>
</owl:ObjectProperty>

