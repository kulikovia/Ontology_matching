<rdf:label>Gather Forecast Data</rdf:label>
<rdfs:comment>Not used for this process</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Gather Industry Forecast Data -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Gather Industry Forecast Data">
