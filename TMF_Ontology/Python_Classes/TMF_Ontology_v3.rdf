<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ServiceLevelSpecConsequence</rdf:label>
<rdfs:comment>An action that takes place in the event that a ServiceLevelObjective is not met.</rdfs:comment>
</owl:Class>

