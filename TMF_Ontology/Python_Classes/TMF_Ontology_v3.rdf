<rdfs:comment>hasBE_for_Applied Customer Billing Rate ABE.Applied Customer Billing Rate Spec ABE</rdfs:comment>
<rdfs:label>hasBE_for_Applied Customer Billing Rate ABE.Applied Customer Billing Rate Spec ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingRateSpec -->

