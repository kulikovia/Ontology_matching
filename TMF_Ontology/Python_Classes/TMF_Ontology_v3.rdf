<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>BusinessObjectiveSpecification</rdf:label>
<rdfs:comment>Detailed description of a BusinessObjective. The composite and entity charactieristic pattern may be applied for BusinessEntitySpecifications if applicable.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BusinessObjectiveSpecification -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BusinessObjectiveSpecification">
