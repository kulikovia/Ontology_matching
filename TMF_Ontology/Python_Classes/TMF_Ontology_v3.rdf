<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRole -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRole">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PartyRole</rdf:label>
<rdfs:comment>The part played by a party in a given con text with any characteristics, such as expected pattern of behavior, attributes, and/or associations that it entails. PartyRole should be used in places where the business refers to a Party playing a Role.  </rdfs:comment>
</owl:Class>

