<rdfs:comment>hasAttribute_for_ServiceLevelSpecParameter</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TemplateServiceLevelSpec -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TemplateServiceLevelSpec">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>TemplateServiceLevelSpec</rdf:label>
<rdfs:comment>A pre-defined set of service level objectives, and consequences that occur, if the objectives are not met.</rdfs:comment>
