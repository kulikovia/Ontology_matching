<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Report Customer interaction -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Report Customer interaction">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Monitor the status of a customer interaction.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.1.18.7</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.3.5.7</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Report Customer interaction</rdf:label>
<rdfs:comment>The purpose of this process is to monitor the status of a customer interaction, provide notifications of any changes and provide management report. These processes record, analyze and assess the customer interaction status changes to provide management reports and any specialized summaries of the efficiency and effectiveness of the overall Customer Interaction Management process. These specialized summaries could be specific reports required by specific customers.</rdfs:comment>
</owl:NamedIndividual>

