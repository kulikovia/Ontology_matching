<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">3996</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Service Problem Test Analyzing</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Service Problem Test Analyzing provides an analysis function for analysis of service problem test results.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Service End to End Testing -->

