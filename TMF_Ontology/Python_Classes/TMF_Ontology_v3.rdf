<TMF_v1:BriefDescription>Manage Product Order Delivery business activity directs and controls the activities to validate products in the product order.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.2.27.3</TMF_v1:ProcessIdentifier>
