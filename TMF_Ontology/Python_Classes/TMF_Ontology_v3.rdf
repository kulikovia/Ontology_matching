<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#IPv6Variable -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#IPv6Variable">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>IPv6Variable</rdf:label>
<rdfs:comment>This class represents using the value of IPv6 source and/or destination addresses as part of a condition expression. Thus, only IPv6AddressValue classes can be used in the value portion of the condition expression with this PolicyVariable.</rdfs:comment>
</owl:Class>

