<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2670</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Availability Checking</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Availability Checking determines facility and equipment availability needed for service designing/assigning. It checks appropriate network facility route(s) according to engineering rules.</rdfs:comment>
</owl:NamedIndividual>

