</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Sales Force Objectives follow-up -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Sales Force Objectives follow-up">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
<TMF_v1:AF_Lev.1 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Sales and Sales Force Management"/>
<TMF_v1:AF_Lev.2 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Sales Force Management"/>
