<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>GoalDirection</rdf:label>
<rdfs:comment>Represents the first and the last location of objects to be communicated. E.g. Send an alert to the customer. In this case, the Direction is towards the Customer and the Customer is the destination.</rdfs:comment>
</owl:Class>

