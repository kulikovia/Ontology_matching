<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Capacity Tuning</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Network Capacity Tuning function adjusts allocation of resources in response to Network Capacity Planning.  It also  triggers activation of components to meet the current demand.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Network Change Verification and Closure -->

