<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Business Value Development"/>
<TMF_v1:BriefDescription>Conduct acceptance test using pilots and/or market trials.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.2.7.2.1.4.1.3</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">7</TMF_v1:ProcessLevel>
<rdf:label>Conduct Product Offering Acceptance Test</rdf:label>
<rdfs:comment>Conduct Product Offering Acceptance Test uses commercial pilots and/or market trials of the offering or prototypes of the offering.</rdfs:comment>
</owl:NamedIndividual>

