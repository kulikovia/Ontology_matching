<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingProductCharge -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingProductCharge">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>AppliedCustomerBillingProductCharge</rdf:label>
<rdfs:comment>An amount, usually of money, for which a person or organization is financially liable when a Product is bought, rented, leased, or used in some manner.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AppliedCustomerBillingProductCharge -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AppliedCustomerBillingProductCharge">
