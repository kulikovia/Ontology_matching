<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Competitor -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Competitor">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>Competitor</rdf:label>
<rdfs:comment>A Party playing a PartyRole that offers ProductOfferings similar to the enterprises ProductOfferings in a MarketSegment.</rdfs:comment>
</owl:Class>

