<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#value"/>
<rdf:label>hasAttribute_for_SalesOpportunity</rdf:label>
<rdfs:comment>hasAttribute_for_SalesOpportunity</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SalesOpportunityItem -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SalesOpportunityItem">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>SalesOpportunityItem</rdf:label>
<rdfs:comment>A SalesOpportunityItem is the smallest entity in a SalesOpportunity. Each SalesOpportunityItem details a wished ProductOffering of the Prospect.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_SalesOpportunityItem -->

