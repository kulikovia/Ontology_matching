<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ImplicitPermissionSpec</rdf:label>
<rdfs:comment>ImplicitPermissionSpec defines one or many actions allowed on a type of Entity (RootEntityType).</rdfs:comment>
</owl:Class>

