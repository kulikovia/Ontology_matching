<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Workforce ABE.Work Specification ABE"/>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1# hasBE_for_Workforce ABE.Work Specification ABE -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasBE_for_Workforce ABE.Work Specification ABE">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasBE"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Work Specification ABE"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecFulfillmentRate"/>
