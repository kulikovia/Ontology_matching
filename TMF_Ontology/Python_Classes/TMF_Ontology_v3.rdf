<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2904</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Collaboration Blogging</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Collaboration Blogging is a website formed to present a writer's or group of writers' contributions, observations and opinions about common matters for the collaborative community. It also allows for commenting and improvements of the contributed material.</rdfs:comment>
</owl:NamedIndividual>

