<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Record Business Partner Bill Inquiry Resolution -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Record Business Partner Bill Inquiry Resolution">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Business Partner Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Billing"/>
<TMF_v1:BriefDescription>Resolve a Business Partner bill inquiry and record how an inquiry was resolved.</TMF_v1:BriefDescription>
