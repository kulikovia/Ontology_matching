<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Authenticate User -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Authenticate User">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Authenticate the person involved in the interaction.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.1.18.8</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.3.5.8</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Authenticate User</rdf:label>
<rdfs:comment>The purpose of this process is to authenticate the person involved in the interaction from the customer side. In self service channels the user may need to login in order to authenticate himself, in other channels the user my need to answer identity verification questions.</rdfs:comment>
</owl:NamedIndividual>

