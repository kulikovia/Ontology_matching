<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MarketStrategy -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MarketStrategy">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>MarketStrategy</rdf:label>
<rdfs:comment>A carefully devised plan of action on how to address the market with appropriate ProductOfferings and SalesChannesl.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MarketStrategy -->

