<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalType -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalType">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>GoalType</rdf:label>
<rdfs:comment>Represents a classification scheme for goals. This can be based on functional or non-functional, where functional goals underlie services that are expected to be delivered, while non-functional goals refer to expected qualities such as security, safety, performance, usability, flexibility, etc. Other forms of classification are viable, and not mandated by this information models entity.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_GoalType -->

