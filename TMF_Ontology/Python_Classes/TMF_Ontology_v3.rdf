<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Notify Customer Problem -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Notify Customer Problem">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
