<rdfs:comment>Manage Efficiency business activity is in charge of directing and controlling amount of enterprise asset or resources that produce results for the enterprise.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Enterprise Resource Allocation -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Enterprise Resource Allocation">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
