<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>SalesQuoteSpecificationType</rdf:label>
<rdfs:comment>A SalesQuoteSpecificationType is a Classification that groups SalesQuoteSpecification.</rdfs:comment>
</owl:Class>

