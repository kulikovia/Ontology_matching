<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LogicalResourceSpecVersion -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LogicalResourceSpecVersion">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>LogicalResourceSpecVersion</rdf:label>
<rdfs:comment>The purpose of this class is to be able to track LogicalResourceSpecifications separately from other types of ResourceSpecifications. Note that this class inherits the modifiesResourceSpec aggregation, and therefore can be used with the corresponding LogicalResourceSpecification class.</rdfs:comment>
</owl:Class>

