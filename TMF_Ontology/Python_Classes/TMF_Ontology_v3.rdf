<rdfs:label>Business Entity.Customer Domain.Customer Bill Inquiry ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Customer Domain.Customer Bill Inquiry ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Customer Domain.Customer Bill Inquiry ABE">
