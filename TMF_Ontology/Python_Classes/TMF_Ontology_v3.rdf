<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">4005</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Activation Notification</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Activation Notification function provides notifications on successful activation and, in cases of exceptions, sends fallouts to Service Order Orchestration and manages rollbacks activities (if applicable).</rdfs:comment>
</owl:NamedIndividual>

