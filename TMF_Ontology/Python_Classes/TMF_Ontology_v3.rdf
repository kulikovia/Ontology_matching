<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Perform Service Capacity and Capacity Demand Trend Analysis -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Perform Service Capacity and Capacity Demand Trend Analysis">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Service Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Capability Management"/>
<TMF_v1:BriefDescription>Perform Service Capacity and Capacity Demand Trend Analysis business activity analysis trends between available service capacity and service capacity demand according to business and ongoing service usage.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
