<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Operate Asset -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Operate Asset">
