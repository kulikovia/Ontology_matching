<rdf:label>AccountCurrency</rdf:label>
<rdfs:comment>AccountCurrency represents the currency that might be used for the Account. One of them specifies the default Currency used.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AccountCurrency -->

