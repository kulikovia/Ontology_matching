<TMF_v1:BriefDescription>Manage Customer Order Placement business activity directs and controls the capture of information to enable create customer order, change customer order and validate customer order based on ordering information from customer.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
