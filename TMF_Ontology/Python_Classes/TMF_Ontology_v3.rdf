<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServiceTest"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServiceTestSpec"/>
<rdfs:comment>hasBE_for_Service Domain.Service Test ABE</rdfs:comment>
<rdfs:label>hasBE_for_Service Domain.Service Test ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServiceTest -->

