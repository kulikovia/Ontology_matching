<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingProductCharge"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#date"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#quantity"/>
<rdf:label>hasAttribute_for_AppliedCustomerBillingProductCharge</rdf:label>
<rdfs:comment>hasAttribute_for_AppliedCustomerBillingProductCharge</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingProductOneTimeCharge -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingProductOneTimeCharge">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>AppliedCustomerBillingProductOneTimeCharge</rdf:label>
<rdfs:comment>AppliedCustomerBillingProductOneTimeCharge represents an amount, usually of money, for which an Individual or Organization is financially liable due to a one-time event relating to a Product. For example, $20 installation fee for a home gateway, $600 purchase price for an iPhone, $10 shipping fee for a router.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AppliedCustomerBillingProductOneTimeCharge -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AppliedCustomerBillingProductOneTimeCharge">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingProductOneTimeCharge"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#date"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#quantity"/>
<rdf:label>hasAttribute_for_AppliedCustomerBillingProductOneTimeCharge</rdf:label>
<rdfs:comment>hasAttribute_for_AppliedCustomerBillingProductOneTimeCharge</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingProductRecurringCharge -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingProductRecurringCharge">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>AppliedCustomerBillingProductRecurringCharge</rdf:label>
<rdfs:comment>AppliedCustomerBillingProductRecurringCharge represents an amount, usually of money, for which an Individual or Organization is financially liable over recurring period (e.g. monthly) for the right to use a Product. For example, $15/month for basic TV channel access, $10/month for renting a home gateway, $3/month for extended warranty for an iPhone.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AppliedCustomerBillingProductRecurringCharge -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AppliedCustomerBillingProductRecurringCharge">
