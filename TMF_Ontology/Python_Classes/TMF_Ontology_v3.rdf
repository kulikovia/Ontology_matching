<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>hasAttribute_for_GeographicLocationName</rdf:label>
<rdfs:comment>hasAttribute_for_GeographicLocationName</rdfs:comment>
</owl:ObjectProperty>

