<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Update Customer Interaction -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Update Customer Interaction">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Update the customer interaction.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.1.18.2</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.3.5.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Update Customer Interaction</rdf:label>
<rdfs:comment>The purpose of this process is to update the customer interaction, typically when additional action is carried out during long-lived interactions. When the customer should be notified about the update, this process triggers the Notify Customer process to perform the notification.</rdfs:comment>
</owl:NamedIndividual>

