<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Service Domain.Service Performance ABE"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServicePerformance"/>
<rdfs:comment>hasBE_for_Service Domain.Service Performance ABE</rdfs:comment>
<rdfs:label>hasBE_for_Service Domain.Service Performance ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServicePerformance -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServicePerformance">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ServicePerformance</rdf:label>
<rdfs:comment>A measure of the manner in which a Service is functioning.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_ServicePerformance -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_ServicePerformance">
