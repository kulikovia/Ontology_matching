<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Report Resource Usage Records -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Report Resource Usage Records">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
