<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Establish Resource Capacity GAP</rdf:label>
<rdfs:comment>Establish Resource Capacity GAP business activity identifies any disparity between resource capacity goals and business objectives.</rdfs:comment>
</owl:NamedIndividual>

