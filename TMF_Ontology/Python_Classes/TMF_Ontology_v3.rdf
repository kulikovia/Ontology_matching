<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyCreditProfile -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyCreditProfile">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PartyCreditProfile</rdf:label>
