<TMF_v1:AF_Lev.2 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Resource Trouble Ticket Management"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Resource Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">1185</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">4099</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Ticket Escalation Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Resource Trouble Ticket Escalation Management Function identifies if an escalation has to be triggered and find corresponding actions when relevant.</rdfs:comment>
</owl:NamedIndividual>

