<TMF_v1:BriefDescription>Notify Product Order Delivery business activity is responsible for sending information or alerts/advice on product product order delivery stages or to advice the product order delivery completion.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
