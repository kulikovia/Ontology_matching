<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PrivacyUsagePurpose -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PrivacyUsagePurpose">
