<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Resource Data Repository Synchronization -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Resource Data Repository Synchronization">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
