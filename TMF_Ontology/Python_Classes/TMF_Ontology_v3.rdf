<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#speakingProficiency"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#writingProficiency"/>
<rdf:label>hasAttribute_for_LanguageAbility</rdf:label>
