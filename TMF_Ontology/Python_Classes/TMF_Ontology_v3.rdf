<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasDomain"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Resource Facing Service ABE.Resource Facing Service Role ABE"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Resource Facing Service ABE.Resource Facing Service Role ABE"/>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1# hasBE_for_Resource Facing Service ABE.Resource Facing Service Role ABE -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasBE_for_Resource Facing Service ABE.Resource Facing Service Role ABE">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasBE"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Resource Facing Service ABE.Resource Facing Service Role ABE"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ResourceFacingServiceRole"/>
<rdfs:comment>hasBE_for_Resource Facing Service ABE.Resource Facing Service Role ABE</rdfs:comment>
<rdfs:label>hasBE_for_Resource Facing Service ABE.Resource Facing Service Role ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ResourceFacingServiceRole -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ResourceFacingServiceRole">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ResourceFacingServiceRole</rdf:label>
<rdfs:comment>This class defines a Service in terms of a set of ServiceRoles for a ResourceFacingService.
This is the base class for defining ServiceRoles that are used to represent the variable characteristics of a ResourceFacingService in terms of roles that this Service plays. This enables the ResourceFacingService to be managed abstractly using ServiceRoles. It also helps define the Service in terms of the functions that it has or provides.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_ResourceFacingServiceRole -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_ResourceFacingServiceRole">
