</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CommunicationInteractionAction -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CommunicationInteractionAction">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>CommunicationInteractionAction</rdf:label>
<rdfs:comment>A CommunicationInteractionAction specifies which action is done on a RootEntity in the context of a CommunicationInteractionUseCase or CommunicationInteractionResult.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_CommunicationInteractionAction -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_CommunicationInteractionAction">
