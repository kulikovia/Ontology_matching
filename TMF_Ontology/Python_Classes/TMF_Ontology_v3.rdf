<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BusinessObjectiveSpecification"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>hasAttribute_for_BusinessObjectiveSpecification</rdf:label>
<rdfs:comment>hasAttribute_for_BusinessObjectiveSpecification</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CompositeBusinessObjective -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CompositeBusinessObjective">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>CompositeBusinessObjective</rdf:label>
<rdfs:comment>A type of BusinessObjective that is formed by aggregating other BusinessObjectives, which may be composite or atomic BusinessObjectives.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_CompositeBusinessObjective -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_CompositeBusinessObjective">
