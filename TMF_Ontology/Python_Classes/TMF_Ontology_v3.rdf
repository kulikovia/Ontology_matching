<rdf:label>GoalTargetPartRole</rdf:label>
<rdfs:comment>Represents entities affected by the goal.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_GoalTargetPartRole -->

