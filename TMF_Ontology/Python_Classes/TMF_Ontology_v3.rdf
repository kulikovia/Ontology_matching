<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#API -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#API">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>API</rdf:label>
<rdfs:comment>An API, an abbreviation of application program interface, is a set of routines, protocols, and tools for building software applications.</rdfs:comment>
</owl:Class>

