<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Commissioning Management</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">The Commissioning Management function consists in calculating commissions for dealers or resellers from information such as orders, activation, usage.</rdfs:comment>
</owl:NamedIndividual>

