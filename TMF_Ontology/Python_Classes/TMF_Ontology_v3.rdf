<TMF_v1:BriefDescription>Determine Product Performance Data Source business activity source and identify all relevant data to support product performance management.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
