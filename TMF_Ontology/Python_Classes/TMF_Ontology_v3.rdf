<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SRTBridging -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SRTBridging">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>SRTBridging</rdf:label>
<rdfs:comment>Source-route transparent (SRT) bridges are a hybrid of translational bridges and source-route bridges, as they are able to forward traffic from both transparent and source-route end nodes.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_SRTBridging -->

