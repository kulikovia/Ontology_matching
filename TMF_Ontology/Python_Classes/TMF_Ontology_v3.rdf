<TMF_v1:BriefDescription>Manage Resource Catalog Access business activity handles access to the catalog according to the Catalog Content Management standards and policies.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.17.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Manage Resource Catalog Access</rdf:label>
<rdfs:comment>Manage Resource Catalog Access business activity handles access to the catalog according to the Catalog Content Management standards and policies.
Manage Resource Catalog Access will handle assigning catalog managers and granting privileges.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Resource Catalog Content Lifecycle -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Resource Catalog Content Lifecycle">
