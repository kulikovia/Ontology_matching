<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PartyRevenueSharingModelInvolvement</rdf:label>
<rdfs:comment>Specification of a party, including an enterprise, who participates in revenue sharing, their type of involvement, and their associated offering(s).</rdfs:comment>
</owl:Class>

