<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<rdfs:comment>Groups main entities within currency model.</rdfs:comment>
<rdfs:label>Party ABE.Currency ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasDomain_for_Party ABE.Currency ABE -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasDomain_for_Party ABE.Currency ABE">
