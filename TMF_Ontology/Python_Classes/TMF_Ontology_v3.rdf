<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Market and Sales Domain.Sales Channel ABE"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SalesChannel"/>
