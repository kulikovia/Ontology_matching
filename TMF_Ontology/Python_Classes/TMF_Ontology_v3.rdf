<TMF_v1:BriefDescription>Ascertain a sales prospects requirements. This process commences following approval by the Qualify Opportunity process.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
