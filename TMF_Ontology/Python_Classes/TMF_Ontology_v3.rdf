<rdfs:comment>hasBE_for_Product Offering ABE.Product Offering Price Tax ABE</rdfs:comment>
<rdfs:label>hasBE_for_Product Offering ABE.Product Offering Price Tax ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ComplexTaxDefinition -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ComplexTaxDefinition">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ComplexTaxDefinition</rdf:label>
<rdfs:comment>A ComplexTaxDefinition is defined by one or many TaxRules. It can be a Tax based on the age of the building or a tax with a different rate according to the amount.</rdfs:comment>
</owl:Class>

