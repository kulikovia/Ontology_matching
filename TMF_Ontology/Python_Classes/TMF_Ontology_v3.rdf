<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Pattern Event Monitoring</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">This function collects, analyzes, and signals event occurrences to subscribers such as operating system processes, active database rules as well as human operators etc. Input to this function is event occurrence and the output is signaled event of the occurrence to the event subscribers.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Pattern Learning Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Pattern Learning Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
<TMF_v1:AF_Lev.1 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Data Analytics"/>
