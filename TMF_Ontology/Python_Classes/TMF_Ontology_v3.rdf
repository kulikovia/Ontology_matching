</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Product Domain.Product Configuration ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Product Domain.Product Configuration ABE">
<rdfs:subClassOf rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TMFDomain"/>
<rdfs:comment>The definition of how a Product operates or functions in terms of CharacteristicSpecification(s) and related ResourceSpec(s), ProductSpec(s), ServiceSpec(s) as well as a representation of how a Product operates or functions in terms of characteristics and related Resource(s), Product(s), Service(s).</rdfs:comment>
<rdfs:label>Business Entity.Product Domain.Product Configuration ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Product Domain.Product Configuration ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Product Domain.Product Configuration ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<rdfs:comment>The definition of how a Product operates or functions in terms of CharacteristicSpecification(s) and related ResourceSpec(s), ProductSpec(s), ServiceSpec(s) as well as a representation of how a Product operates or functions in terms of characteristics and related Resource(s), Product(s), Service(s).</rdfs:comment>
<rdfs:label>Product Domain.Product Configuration ABE</rdfs:label>
</owl:Class>

