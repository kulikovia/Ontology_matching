<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingRebate -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedCustomerBillingRebate">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>AppliedCustomerBillingRebate</rdf:label>
<rdfs:comment>An amount, usually of money, which is paid back to a customers account, for example, because a customer is entitled to a refund.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AppliedCustomerBillingRebate -->

