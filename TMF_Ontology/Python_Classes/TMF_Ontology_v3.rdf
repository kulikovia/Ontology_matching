<TMF_v1:OriginalProcessIdentifier>1.2.2.2.2.2</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.4.2.2.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Capture Service Performance Shortfalls</rdf:label>
<rdfs:comment>These processes identify specific or imminent service performance shortfalls. These processes take information available from the Service Management and Operations processes to establish detailed views of anticipated service performance issues.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Capture Service Operational Support Shortfalls -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Capture Service Operational Support Shortfalls">
