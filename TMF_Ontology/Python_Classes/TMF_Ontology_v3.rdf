<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ResourceCatalogSpecification</rdf:label>
<rdfs:comment>A ResourceCatalogSpecification defines attributes shared by all instances of related ResourceCatalogs.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_ResourceCatalogSpecification -->

