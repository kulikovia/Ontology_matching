<TMF_v1:BriefDescription>Track Product Order Fulfilment business activity records all the product order fulfilment processing status.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
