<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ProjectEvent"/>
<rdf:label>hasAttribute_for_ProjectEvent</rdf:label>
<rdfs:comment>hasAttribute_for_ProjectEvent</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Vision -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Vision">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>Vision</rdf:label>
<rdfs:comment>The Vision is the common understanding of all parties involved in a project (either directly or as a stakeholder) about the goals of a project, the key success criteria, timeline and impact of not doing the project. The Vision is associated to a business objective.</rdfs:comment>
</owl:Class>

