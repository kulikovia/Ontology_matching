<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Update Business Partner Interaction -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Update Business Partner Interaction">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Business Partner Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Update the Business Partner interaction log</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.0.7.10.1.2</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.6.9.1.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Update Business Partner Interaction</rdf:label>
<rdfs:comment>The purpose of this process is to update the Business Partner interaction, typically when additional action is carried out during long-lived interactions. When the Business Partner should be notified about the update, this process triggers the Notify Business Partner process to perform the notification.</rdfs:comment>
</owl:NamedIndividual>

