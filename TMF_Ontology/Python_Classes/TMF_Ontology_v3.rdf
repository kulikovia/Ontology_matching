<rdf:label>Identify Overdue Business Partner Bill/Invoice Write-off Candidate</rdf:label>
<rdfs:comment>Not used for this process element.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Write Off Overdue Business Partner Bill/Invoice -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Write Off Overdue Business Partner Bill/Invoice">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
