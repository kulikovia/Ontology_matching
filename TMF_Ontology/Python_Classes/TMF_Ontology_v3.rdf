<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServiceSpecVersion"/>
<rdfs:comment>hasBE_for_Service Domain.Service Specification ABE</rdfs:comment>
<rdfs:label>hasBE_for_Service Domain.Service Specification ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServiceSpecCharacteristic -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServiceSpecCharacteristic">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ServiceSpecCharacteristic</rdf:label>
<rdfs:comment>This is an abstract base class that represents the key features of this ServiceSpecification. For example, bandwidth is characteristic of many different types of services; if bandwidth is important (e.g., from the point-of-view of a Customer obtaining this Service via a Product) then bandwidth would be a ServiceSpecCharacteristic for that particular Service.</rdfs:comment>
</owl:Class>

