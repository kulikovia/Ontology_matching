<rdf:label>MatrixCellCharValue</rdf:label>
<rdfs:comment>Holds the value of a single cell of MarixCharacteristic and associations to the indices of this value in the matrix</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MatrixCellCharValue -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MatrixCellCharValue">
