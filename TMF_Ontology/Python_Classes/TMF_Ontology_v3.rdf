<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#usageStatus"/>
<rdf:label>hasAttribute_for_ContextUsage</rdf:label>
<rdfs:comment>hasAttribute_for_ContextUsage</rdfs:comment>
</owl:ObjectProperty>

