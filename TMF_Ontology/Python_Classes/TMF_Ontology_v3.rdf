<TMF_v1:BriefDescription>These processes capture all activities required to provide management oversight on the tender process. These processes cover the establishment of any tender selection boards, the reporting processes and timetables</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.0.7.1.4.1</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.6.2.4.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
