<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ProductBundleUsage</rdf:label>
<rdfs:comment>A detailed product bundle usage event, It is comprised of other ProductUsage(s), that may be either ProductBundleUsage(s) or ProductComponentUsage(s).</rdfs:comment>
</owl:Class>

