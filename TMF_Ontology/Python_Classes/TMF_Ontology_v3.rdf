<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>hasAttribute_for_ReplacementProdPriceAlteration</rdf:label>
<rdfs:comment>hasAttribute_for_ReplacementProdPriceAlteration</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#UsageProdPriceCharge -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#UsageProdPriceCharge">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>UsageProdPriceCharge</rdf:label>
<rdfs:comment>A UsageProdPriceCharge represents a charge applicable to ProductCharges for a Product.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_UsageProdPriceCharge -->

