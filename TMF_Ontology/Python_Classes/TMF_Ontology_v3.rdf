<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ImplicitPermission</rdf:label>
<rdfs:comment>An ImplicitPermission is a type of Permission and describes permissions granted to a PartyRole according to an ImplicitPermissionSpec.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_ImplicitPermission -->

