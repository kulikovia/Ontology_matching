<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Audit Product Configuration -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Audit Product Configuration">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Product Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Fulfillment"/>
<TMF_v1:BriefDescription>Audit Product Configuration business activities examine and verify product configurations for compliance to assurance needs.</TMF_v1:BriefDescription>
