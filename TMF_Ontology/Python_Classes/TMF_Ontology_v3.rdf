<TMF_v1:ProcessIdentifier>1.2.27.3.2.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">5</TMF_v1:ProcessLevel>
<rdf:label>Track Product Order Delivery</rdf:label>
<rdfs:comment>Track Product Order Delivery business activity is responsible for tracing or following up with the status and stages in the a product order delivery acivity.

Track Product Order enables the organization and product order consignees to effectively know the status of product order in a the product order delivery stage.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Notify Product Order Delivery -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Notify Product Order Delivery">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
