<rdf:label>TestSpecificationRole</rdf:label>
<rdfs:comment>This is the abstract base class for all TestSpecificationRole subclasses. It exists to enable relationships to be defined between it and the test specification in the test model.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_TestSpecificationRole -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_TestSpecificationRole">
