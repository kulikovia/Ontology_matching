<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LogicalAddress -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LogicalAddress">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>LogicalAddress</rdf:label>
<rdfs:comment>An address that allows sending something (tangible or intangible) to a central point where it can be retrieved.
For example, with email, a message is sent to the recipients ISP mail server. The recipient can then connect to the server from anywhere in the world and retrieve the message. The intermediate location is not of interest to the message sender.</rdfs:comment>
</owl:Class>

