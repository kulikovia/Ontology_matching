<rdf:label>TaxProdOfferPriceAlteration</rdf:label>
<rdfs:comment>A TaxProdOfferPriceAlteration is a type of ProdOfferPriceAlteration defined by a TaxDefinition.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_TaxProdOfferPriceAlteration -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_TaxProdOfferPriceAlteration">
