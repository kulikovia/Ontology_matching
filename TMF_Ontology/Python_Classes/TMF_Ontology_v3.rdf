<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<rdfs:comment></rdfs:comment>
<rdfs:label>Enterprise Security ABE.Security Entity ABE</rdfs:label>
</owl:Class>

