<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#number"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#reason"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#semantics"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#timestamp"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>hasAttribute_for_CustomerFacingServiceSpecVersion</rdf:label>
<rdfs:comment>hasAttribute_for_CustomerFacingServiceSpecVersion</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Facing Service Spec ABE.Customer Facing Service Spec Role ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Facing Service Spec ABE.Customer Facing Service Spec Role ABE">
<rdfs:subClassOf rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TMFDomain"/>
<rdfs:comment>The Customer Facing Service Spec Role ABE defines a ServiceSpecification, in terms of a set of ServiceSpecificationRoles, for a CustomerFacingService. It is used to represent the shared characteristics of a CustomerFacingService. This enables the CustomerFacingService to be managed abstractly using ServiceSpecificationRoles. It also helps define a CustomerFacingServiceSpecification in terms of the functions that it has or provides.</rdfs:comment>
<rdfs:label>Business Entity.Customer Facing Service Spec ABE.Customer Facing Service Spec Role ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Customer Facing Service Spec ABE.Customer Facing Service Spec Role ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Customer Facing Service Spec ABE.Customer Facing Service Spec Role ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<rdfs:comment>The Customer Facing Service Spec Role ABE defines a ServiceSpecification, in terms of a set of ServiceSpecificationRoles, for a CustomerFacingService. It is used to represent the shared characteristics of a CustomerFacingService. This enables the CustomerFacingService to be managed abstractly using ServiceSpecificationRoles. It also helps define a CustomerFacingServiceSpecification in terms of the functions that it has or provides.</rdfs:comment>
<rdfs:label>Customer Facing Service Spec ABE.Customer Facing Service Spec Role ABE</rdfs:label>
</owl:Class>

