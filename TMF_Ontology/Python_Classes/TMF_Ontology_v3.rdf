<rdf:label>hasAttribute_for_TestSpecificationRole</rdf:label>
<rdfs:comment>hasAttribute_for_TestSpecificationRole</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TestSpecification -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TestSpecification">
