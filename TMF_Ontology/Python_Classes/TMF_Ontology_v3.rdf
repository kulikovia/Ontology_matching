<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#valueType"/>
<rdf:label>hasAttribute_for_StockItemCharacteristic</rdf:label>
<rdfs:comment>hasAttribute_for_StockItemCharacteristic</rdfs:comment>
</owl:ObjectProperty>

