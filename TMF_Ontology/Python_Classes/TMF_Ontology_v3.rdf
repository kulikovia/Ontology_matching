<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdConsequence"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdRelationship"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdRule"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdSet"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricThresholdRuleDefinition"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PreDefinedMetricThresholdRule"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PreDefinedMetricThresholdRuleParam"/>
<rdfs:comment>hasBE_for_Metric Definition Measure ABE.Metric Definition Measure Threshold ABE</rdfs:comment>
<rdfs:label>hasBE_for_Metric Definition Measure ABE.Metric Definition Measure Threshold ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThreshConsDependency -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThreshConsDependency">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>MetricDefMeasureThreshConsDependency</rdf:label>
<rdfs:comment>A dependency a MetricDefMeasureConsequence has on a MetricDefMeasureThresholdRule.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MetricDefMeasureThreshConsDependency -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MetricDefMeasureThreshConsDependency">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThreshConsDependency"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#typeDependency"/>
<rdf:label>hasAttribute_for_MetricDefMeasureThreshConsDependency</rdf:label>
<rdfs:comment>hasAttribute_for_MetricDefMeasureThreshConsDependency</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdConsequence -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdConsequence">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>MetricDefMeasureThresholdConsequence</rdf:label>
<rdfs:comment>The sequence in which a MetricDefMeasureConsequence should be applied for a MetricDefMeasureThresholdRule.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MetricDefMeasureThresholdConsequence -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MetricDefMeasureThresholdConsequence">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdConsequence"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#sequenceOfApplication"/>
<rdf:label>hasAttribute_for_MetricDefMeasureThresholdConsequence</rdf:label>
<rdfs:comment>hasAttribute_for_MetricDefMeasureThresholdConsequence</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdRelationship -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdRelationship">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>MetricDefMeasureThresholdRelationship</rdf:label>
<rdfs:comment>The MetricDefMeasureThresholdRelationship enables specifying any kind of relationships between MetricDefMeasureThresholdRule such as depends on, follows, and so forth.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MetricDefMeasureThresholdRelationship -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MetricDefMeasureThresholdRelationship">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdRelationship"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#thresholdRelationshipType"/>
<rdf:label>hasAttribute_for_MetricDefMeasureThresholdRelationship</rdf:label>
<rdfs:comment>hasAttribute_for_MetricDefMeasureThresholdRelationship</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdRule -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdRule">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>MetricDefMeasureThresholdRule</rdf:label>
<rdfs:comment>A MetricDefMeasureThresholdRule is a rule that defines the condition (raise or clear) to achieve to apply consequences when a threshold (MetricDefMeasureThreshold) is crossed or ceased to be crossed. It also defines the severity of the raise or clear of the threshold.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MetricDefMeasureThresholdRule -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_MetricDefMeasureThresholdRule">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdRule"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#thresholdRuleSeverity"/>
<rdf:label>hasAttribute_for_MetricDefMeasureThresholdRule</rdf:label>
<rdfs:comment>hasAttribute_for_MetricDefMeasureThresholdRule</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#MetricDefMeasureThresholdSet -->

