<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#nativeEmsName"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#owner"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#userLabel"/>
<rdf:label>hasAttribute_for_CommonObjectInfo</rdf:label>
<rdfs:comment>hasAttribute_for_CommonObjectInfo</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Root Business Entities ABE.Association ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Root Business Entities ABE.Association ABE">
<rdfs:subClassOf rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TMFDomain"/>
<rdfs:comment>A pattern that enables associations to be dynamically created between explicitly modeled SID entities (classes and subclasses) as well as implicit subclasses created using the EntitySpecification/Entity pattern.</rdfs:comment>
<rdfs:label>Business Entity.Root Business Entities ABE.Association ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Root Business Entities ABE.Association ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Root Business Entities ABE.Association ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<rdfs:comment>A pattern that enables associations to be dynamically created between explicitly modeled SID entities (classes and subclasses) as well as implicit subclasses created using the EntitySpecification/Entity pattern.</rdfs:comment>
<rdfs:label>Root Business Entities ABE.Association ABE</rdfs:label>
</owl:Class>

