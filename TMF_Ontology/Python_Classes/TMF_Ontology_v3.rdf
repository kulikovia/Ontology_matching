<TMF_v1:ProcessIdentifier>1.4.12.6.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Assess Available Service Capacity</rdf:label>
<rdfs:comment>Assess Available Service Capacity business activity evaluates unused service capacity in relation to service capacity plans, and service utilization trends.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Model Service Capacity -->

