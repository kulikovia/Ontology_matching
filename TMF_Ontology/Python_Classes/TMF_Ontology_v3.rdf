<rdfs:comment>hasAttribute_for_PaySpecification</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Workforce ABE.Work Specification ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Workforce ABE.Work Specification ABE">
<rdfs:subClassOf rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TMFDomain"/>
<rdfs:comment>The WorkSpecification specifies a kind of work that can be performed manually by a technician. Two key entities that comprise the WorkSpecification ABE are WorkSpecification and WorkSpecFulfillmentRate.</rdfs:comment>
<rdfs:label>Business Entity.Workforce ABE.Work Specification ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Work Specification ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Work Specification ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<rdfs:comment>The WorkSpecification specifies a kind of work that can be performed manually by a technician. Two key entities that comprise the WorkSpecification ABE are WorkSpecification and WorkSpecFulfillmentRate.</rdfs:comment>
<rdfs:label>Workforce ABE.Work Specification ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasDomain_for_Workforce ABE.Work Specification ABE -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasDomain_for_Workforce ABE.Work Specification ABE">
