<TMF_v1:ProcessIdentifier>1.6.8.6.3</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Report Business Partner Orders Status</rdf:label>
<rdfs:comment>Record, analyze and assess the Business Partner orders status changes to provide management reports and any specialized summaries of the efficiency and effectiveness of the overall Business Partner Order Handling process, including specific reports required by specific audiences.</rdfs:comment>
