<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supply Demand Forecasting</rdf:label>
<rdfs:comment rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Supply Demand Forecasting provides demand planning and forecasting, including coordinating the demand forecast of all marketing plans and requisitions, and sharing the forecast with all suppliers.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Resource Task Item Decomposition -->

