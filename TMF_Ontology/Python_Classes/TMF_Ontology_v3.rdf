<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CommunicationInteractionAction"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#action"/>
<rdf:label>hasAttribute_for_CommunicationInteractionAction</rdf:label>
<rdfs:comment>hasAttribute_for_CommunicationInteractionAction</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CommunicationInteractionResult -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CommunicationInteractionResult">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>CommunicationInteractionResult</rdf:label>
<rdfs:comment>A CommunicationInteractionResult specifies describes the main result which entity (RootEntity) is impacted and for which action (CommunicationInteractionAction) by the CommunicationInteractionItem.
For example:
  - Action: "creates" for Entity: "CustomerProductOrder CO1"
  - Action: "create" for Entity: "CustomerProblem CP1"
  - Action: "Help for use" for Entity: "Billys Broadband"
  - Action: "explain" Entity: "Billys Customer Bill"</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_CommunicationInteractionResult -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_CommunicationInteractionResult">
