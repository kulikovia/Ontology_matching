<rdfs:label>hasBE_for_Customer Domain.Customer Statistic ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ChurnRetentionStatistic -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ChurnRetentionStatistic">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ChurnRetentionStatistic</rdf:label>
<rdfs:comment>A meaure of Customer churn (turnover of Customers) or Customer retention (keeping Customers).</rdfs:comment>
</owl:Class>

