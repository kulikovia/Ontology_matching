<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CommunicationInteractionMeans -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CommunicationInteractionMeans">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>CommunicationInteractionMeans</rdf:label>
<rdfs:comment>A CommunicationInteractionMeans represents the content of A CommunicationInteraction such as email, phonecall, SMS, MMS</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_CommunicationInteractionMeans -->

