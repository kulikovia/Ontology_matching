<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dY"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dZ"/>
