<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Handle Business Partner Interaction (Including Self Service) -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Handle Business Partner Interaction (Including Self Service)">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Business Partner Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Handle all interactions (inbound and outbound) made by potential and existing Parties</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.0.7.10.5</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.6.9.4</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Handle Business Partner Interaction (Including Self Service)</rdf:label>
<rdfs:comment>The purpose of this process is to manage all requests (inbound and outbound) made by potential and existing Parties. It receives the request and either enables its originator to automatically fulfill it, or identifies and activates the opportune process to accomplish the request; it manages the status of the request and is able to provide status information at any moment in which the request is active; it formally closes the request when all related activities have been terminated.</rdfs:comment>
</owl:NamedIndividual>

