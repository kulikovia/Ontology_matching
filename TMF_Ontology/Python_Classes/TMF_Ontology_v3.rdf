<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<rdfs:comment>The Metric Definition Measure Threshold ABE contains all entities describing the threshold used for MetricDefMeasure.</rdfs:comment>
<rdfs:label>Metric Definition Measure ABE.Metric Definition Measure Threshold ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasDomain_for_Metric Definition Measure ABE.Metric Definition Measure Threshold ABE -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasDomain_for_Metric Definition Measure ABE.Metric Definition Measure Threshold ABE">
