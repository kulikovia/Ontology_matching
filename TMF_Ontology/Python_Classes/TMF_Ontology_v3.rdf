<rdf:label>AppliedCustomerBillingProductAlteration</rdf:label>
<rdfs:comment>A credit that is applied in order to reduce the associated charge.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AppliedCustomerBillingProductAlteration -->

