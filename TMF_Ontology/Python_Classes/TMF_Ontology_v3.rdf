<rdf:label>hasAttribute_for_CompositeBusinessObjective</rdf:label>
<rdfs:comment>hasAttribute_for_CompositeBusinessObjective</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Enterprise Domain.Finance ABE -->

