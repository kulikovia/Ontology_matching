<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>AtomicBusinessObjective</rdf:label>
<rdfs:comment>A type of BusinessObjective that does not have any subordinate BusinessObjectives, that is, an AtomicBusinessObjective is a leaf-level BusinessObjective.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AtomicBusinessObjective -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AtomicBusinessObjective">
