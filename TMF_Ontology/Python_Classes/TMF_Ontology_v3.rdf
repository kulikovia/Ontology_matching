<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Determine Product Performance Data Source</rdf:label>
<rdfs:comment>Determine Product Performance Data Source business activity source and identify all relevant data to support product performance management. Determine Product Performance assures the validity, reliability and relevance of data in the computation and tracking of product performance over a product's lifecycle.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Collect Product Performance Data -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Collect Product Performance Data">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Product Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Collect Product Performance Data business activity gather data according to prescribed data sources.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.2.6.11.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Collect Product Performance Data</rdf:label>
<rdfs:comment>Collect Product Performance Data business activity gather data according to prescribed data sources. Product Performance Data may includes all data that impact on the products meeting established performance objectives, including QoS, SLAs and any other form of enumerated qualitative information.</rdfs:comment>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Track Product Performance Measures -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Track Product Performance Measures">
