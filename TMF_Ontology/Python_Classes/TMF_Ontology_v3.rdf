<rdfs:comment>hasBE_for_Enterprise Domain.Finance ABE</rdfs:comment>
<rdfs:label>hasBE_for_Enterprise Domain.Finance ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AtomicBudget -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AtomicBudget">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>AtomicBudget</rdf:label>
<rdfs:comment>An AtomicBudget is a type of Budget that isnt broken into other Budgets. It might be part of a CompositeBudget or not.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AtomicBudget -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_AtomicBudget">
