<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Not used for this process element.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.3.4.6.1</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.9.6.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Coordinate Resource Performance</rdf:label>
<rdfs:comment>This process schedules, assigns and coordinates analysis and specific service performance restoration activities and/or repair activities delegated to other processes, undertakes necessary tracking of the execution progress, modifies information in an existing Resource Performance Degradation Report based on assignments, and modifies the Resource Performance Degradation Report status</rdfs:comment>
</owl:NamedIndividual>

