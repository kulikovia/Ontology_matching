<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Enterprise Performance Consolidation, Reconciliation and Close -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Enterprise Performance Consolidation, Reconciliation and Close">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Enterprise Domain"/>
