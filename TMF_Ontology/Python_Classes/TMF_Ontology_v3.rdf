<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>BusinessInteractionLocation</rdf:label>
<rdfs:comment>A Location involved in an interaction. For example, John R.s home address is the location where an ordered Product will be installed.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BusinessInteractionLocation -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BusinessInteractionLocation">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BusinessInteractionLocation"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#locationRole"/>
<rdf:label>hasAttribute_for_BusinessInteractionLocation</rdf:label>
<rdfs:comment>hasAttribute_for_BusinessInteractionLocation</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BusinessInteractionItemRelationship -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BusinessInteractionItemRelationship">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>BusinessInteractionItemRelationship</rdf:label>
<rdfs:comment>The BusinessInteractionItemRelationship enables specifying any kind of relationships between BusinessInteractionItemRelationship such as contains, relies on...</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BusinessInteractionItemRelationship -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute_for_BusinessInteractionItemRelationship">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
