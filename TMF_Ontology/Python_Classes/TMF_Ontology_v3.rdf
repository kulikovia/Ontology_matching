<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasBE_for_Service Specification ABE.Customer Facing Service Spec ABE">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasBE"/>
