<TMF_v1:hasOrigin>TimeZone</TMF_v1:hasOrigin>
<TMF_v1:hasStereotype></TMF_v1:hasStereotype>
<rdf:label>timezoneUrl</rdf:label>
<rdfs:comment></rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#timingConstraint -->

