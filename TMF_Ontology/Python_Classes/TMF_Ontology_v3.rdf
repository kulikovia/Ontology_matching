<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>hasAttribute_for_NetworkForwardingDomain</rdf:label>
<rdfs:comment>hasAttribute_for_NetworkForwardingDomain</rdfs:comment>
</owl:ObjectProperty>

