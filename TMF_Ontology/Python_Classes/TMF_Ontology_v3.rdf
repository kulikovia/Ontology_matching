<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LogicalResourceSpecVersion"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#format"/>
