<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasAttribute"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#StockItem"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#codeModel"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<rdf:label>hasAttribute_for_StockItem</rdf:label>
<rdfs:comment>hasAttribute_for_StockItem</rdfs:comment>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#StockItemCharacteristic -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#StockItemCharacteristic">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>StockItemCharacteristic</rdf:label>
<rdfs:comment>The StockItemCharacteristic represents parameters describing StockItems such as Color, Height, Weight...

Note: A StockItem has only one value for each StockItemCharacteristic describing the StockItem.</rdfs:comment>
</owl:Class>

