<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ProductCatalogSpecification"/>
<rdfs:comment>hasBE_for_Product Offering ABE.Product Catalog ABE</rdfs:comment>
<rdfs:label>hasBE_for_Product Offering ABE.Product Catalog ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ProdCatProdOffer -->

