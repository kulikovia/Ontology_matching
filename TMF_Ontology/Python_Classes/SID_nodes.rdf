<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SecVulnerabilityScoreAlgorithm -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SecVulnerabilityScoreAlgorithm">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Security Vulnerability Scoring Algorithm ABE"/>
<rdf:label>SecVulnerabilityScoreAlgorithm</rdf:label>
<rdfs:comment>A step-by-step procedure for calculating the a security vulnerability score.

Notes: For example, BaseScore = round-to-1-decimal(((0.6 * Impact) + (0.4 * Exploitability) - 1.5) * f(Impact)).</rdfs:comment>
</owl:Class>

