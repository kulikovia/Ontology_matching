<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Permission ABE"/>
<rdf:label>ExplicitPermission</rdf:label>
<rdfs:comment>A Party playing a role may delegate all or part of his permissions to another Party through ExplicitPermission.
ExplicitPermission is a type of Permission.</rdfs:comment>
</owl:Class>

