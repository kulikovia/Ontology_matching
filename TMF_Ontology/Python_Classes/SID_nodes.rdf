<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRoleProdOffRelationship"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRoleProductOffering"/>
<rdfs:comment>hasBE_for_Party Role Product Offering ABE</rdfs:comment>
<rdfs:label>hasBE_for_Party Role Product Offering ABE</rdfs:label>
</owl:ObjectProperty>

