<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Metric Definition Dimension ABE"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MetricDefDimValueUse"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MetricDefinitionDimensionUse"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MetricDimension"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MetricDimensionValue"/>
<rdfs:comment>hasBE_for_Metric Definition Dimension ABE</rdfs:comment>
<rdfs:label>hasBE_for_Metric Definition Dimension ABE</rdfs:label>
</owl:ObjectProperty>

