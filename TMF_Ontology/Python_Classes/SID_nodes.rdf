<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#LinearRing -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#LinearRing">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#OpenGisSFS ABE"/>
<rdf:label>LinearRing</rdf:label>
<rdfs:comment>A LineString which is both closed and simple.  In other words, the first and last coordinate in the ring must be equal, and the interior of the ring must not self-intersect.</rdfs:comment>
</owl:Class>

