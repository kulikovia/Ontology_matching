</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#EntitySpecificationType -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#EntitySpecificationType">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Root Business Entities ABE"/>
<rdf:label>EntitySpecificationType</rdf:label>
<rdfs:comment>An EntitySpecificationType is a classification that groups EntitySpecifications.
Multiple EntitySpecificationTypes can be related to each other using the association through EntitySpecificationTypeRelationship.</rdfs:comment>
</owl:Class>

