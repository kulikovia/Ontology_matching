<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Party Privacy ABE"/>
<rdfs:comment>The Party Privacy Profile ABE contains all entities used by the Party Privacy Management process for specifying 
   - the information concerned by Privacy rules,
   - the Privacy rules themselves.</rdfs:comment>
<rdfs:label>Party Privacy Profile Type ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasDomain_for_Party Privacy Profile Type ABE -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasDomain_for_Party Privacy Profile Type ABE">
