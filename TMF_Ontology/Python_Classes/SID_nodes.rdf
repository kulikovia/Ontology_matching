<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Project ABE"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProjectEvent"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Vision"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SimpleProject"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProjectSpec"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProjectDeliverableVersion"/>
