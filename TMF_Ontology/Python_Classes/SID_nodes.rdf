<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Metric Definition Dimension ABE"/>
<rdf:label>MetricDefDimValueUse</rdf:label>
<rdfs:comment>Values of the MetricDimension used by a MetricDefinition, for example for payment timing dimension values can be prepaid or postpaid.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_validFor -->

