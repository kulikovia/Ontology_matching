</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Sales Lead and Opportunity ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Sales Lead and Opportunity ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ABE"/>
<rdfs:comment>Sales Lead and Opportunity ABE provides the ability to track sales leads through their life cycle up until the time the prospect become customers, including proposals made to potential customers, and the amount of potential revenue the leads represent in the form of a sales pipeline.</rdfs:comment>
<rdfs:label>Sales Lead and Opportunity ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasDomain_for_Sales Lead and Opportunity ABE -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasDomain_for_Sales Lead and Opportunity ABE">
