<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Account -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Account">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Account ABE"/>
<rdf:label>Account</rdf:label>
<rdfs:comment>An Account specifies basic attributes and relationships that describes an account.
An Account aims to register all Credits and Debits according to criteria. It carries one or many Balances (results of Credits and Debits) and might use one or many Currencies.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ID -->

