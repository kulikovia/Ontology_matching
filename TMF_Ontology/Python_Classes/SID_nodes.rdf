<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#TaxExemptionCertificate -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#TaxExemptionCertificate">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Party ABE"/>
<rdf:label>TaxExemptionCertificate</rdf:label>
<rdfs:comment>The certificate describing an exemption from tax (partial or complete) granted for a party and/or a place. 
Examples include:
    - Party-based
 - Individual might be exempt due to health or other personal situation
 - Organization might be exempt due to its business (e.g. a charity, or government)
    - Location-based
 - A City might have a global exemption from purchase tax</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ID">
