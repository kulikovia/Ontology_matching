<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Customer"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerServiceRepresentative"/>
<rdfs:comment>hasBE_for_Customer Party Roles ABE</rdfs:comment>
<rdfs:label>hasBE_for_Customer Party Roles ABE</rdfs:label>
</owl:ObjectProperty>

