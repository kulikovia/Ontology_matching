</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#DistributionChannel -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#DistributionChannel">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Offering ABE"/>
<rdf:label>DistributionChannel</rdf:label>
<rdfs:comment>A distribution channel is the organization or entity by which a product catalog is presented to a customer.</rdfs:comment>
</owl:Class>

