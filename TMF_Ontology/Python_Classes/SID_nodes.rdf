<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerFacingServiceSpecAtomic"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerFacingServiceSpecComposite"/>
