<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#TrafficMappingTable -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#TrafficMappingTable">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Converged Network ABE"/>
<rdf:label>TrafficMappingTable</rdf:label>
<rdfs:comment>The TrafficMappingTable provides the rules for complex manipulation of components flows within the flow dealt with by the instance of LayerTermination. An example of an application is for Etherenet where a particular flow may require CTAG subflow manipulation.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#TrafficMappingTableRow -->

