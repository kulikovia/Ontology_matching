<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SystemCard -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SystemCard">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Equipment ABE"/>
<rdf:label>SystemCard</rdf:label>
<rdfs:comment>This is a type of Card that is dedicated to providing system functions. Main processor boards and controller boards are examples of this type of Card. The SID differentiates between this and other types of Cards, such as NetworkCards and MemoryCards.</rdfs:comment>
</owl:Class>

