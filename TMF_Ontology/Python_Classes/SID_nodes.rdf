<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Sales Channel ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Sales Channel ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ABE"/>
<rdfs:comment>Sales Channel ABE keeps track of distribution channels and sales activities, sales quotas, sales, contests, commission/bonus plans, commissions/bonuses, and maintain groups of individuals that make up the sales force.</rdfs:comment>
<rdfs:label>Sales Channel ABE</rdfs:label>
</owl:Class>

