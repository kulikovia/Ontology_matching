<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CommunicationInteractionAction -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CommunicationInteractionAction">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Communication Interaction ABE"/>
<rdf:label>CommunicationInteractionAction</rdf:label>
<rdfs:comment>A CommunicationInteractionAction specifies which action is done on a RootEntity in the context of a CommunicationInteractionUseCase or CommunicationInteractionResult.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_action -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_action">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CommunicationInteractionAction"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CommunicationInteractionResult -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CommunicationInteractionResult">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Communication Interaction ABE"/>
<rdf:label>CommunicationInteractionResult</rdf:label>
<rdfs:comment>A CommunicationInteractionResult specifies describes the main result which entity (RootEntity) is impacted and for which action (CommunicationInteractionAction) by the CommunicationInteractionItem.
For example:
  - Action: "creates" for Entity: "CustomerProductOrder CO1"
  - Action: "create" for Entity: "CustomerProblem CP1"
  - Action: "Help for use" for Entity: "Billys Broadband"
  - Action: "explain" Entity: "Billys Customer Bill"</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CommunicationInteractionUseCase -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CommunicationInteractionUseCase">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Communication Interaction ABE"/>
<rdf:label>CommunicationInteractionUseCase</rdf:label>
<rdfs:comment>A CommunicationInteractionUseCase specifies which entity (RootEntity) is concerned and which action (CommunicationInteractionAction) are concerned by the CommunicationInteractionItem.
For example:
  - Action: "buy" for Entity: "ProductOffering PO1"
  - Action: "ask for recovery" for Entity: "Billys Broadband"
  - Action: "notify" Entity: "Billys Customer Bill"</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CommunicationInteractionRole -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CommunicationInteractionRole">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Communication Interaction ABE"/>
<rdf:label>CommunicationInteractionRole</rdf:label>
<rdfs:comment>A CommunicationInteractionRole specifies which roles (PartyRole or ResourceRole) are involved in a CommunicationInteractionItem.</rdfs:comment>
</owl:Class>

