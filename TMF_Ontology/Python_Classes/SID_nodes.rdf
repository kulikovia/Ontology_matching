<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProductLine -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProductLine">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Specification ABE"/>
<rdf:label>ProductLine</rdf:label>
<rdfs:comment>A method used to group related ProductSpecifications that have some characteristics in common but others that are not. For example, health monitoring device product line whose ProductSpecifications have a number of common characteristics, but come in different colors and can be used to monitor a variety of bodily functions.</rdfs:comment>
</owl:Class>

