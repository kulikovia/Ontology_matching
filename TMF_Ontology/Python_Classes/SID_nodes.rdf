<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PolicySet -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PolicySet">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Policy Framework ABE"/>
<rdf:label>PolicySet</rdf:label>
<rdfs:comment>This is an abstract class for defining two types of collection classes. PolicyRule collects PolicyEvents, PolicyConditions, and PolicyActions, while PolicyGroup collects PolicyRules and PolicyGroups.
Two important and powerful features of this arrangement are that a PolicySet defines a common decision strategy and a common set of PolicyRoles to be used by the PolicyGroups and the PolicyRules that inherit from it.</rdfs:comment>
</owl:Class>

