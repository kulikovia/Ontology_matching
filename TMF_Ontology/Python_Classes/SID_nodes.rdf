<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Customer Bill Inquiry ABE"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerBillingInquiry"/>
<rdfs:comment>hasBE_for_Customer Bill Inquiry ABE</rdfs:comment>
<rdfs:label>hasBE_for_Customer Bill Inquiry ABE</rdfs:label>
</owl:ObjectProperty>

