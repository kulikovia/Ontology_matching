<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MarketingIndicator -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MarketingIndicator">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Marketing Performance ABE"/>
<rdf:label>MarketingIndicator</rdf:label>
<rdfs:comment>A MarketingIndicator is a type of MetricMeasure described by MarketingIndicatorDefinition that contains the result of MarketingIndicatorDefinitions evaluation for an instance of Entity for a specific period.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_value -->

