<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceLevelSpecExpression"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceLevelSpecification"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceLevelSpecParameter"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#TemplateServiceLevelSpec"/>
<rdfs:comment>hasBE_for_Service Level Spec ABE</rdfs:comment>
<rdfs:label>hasBE_for_Service Level Spec ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#KeyPerformanceIndicatorSLSParm -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#KeyPerformanceIndicatorSLSParm">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Service Level Spec ABE"/>
<rdf:label>KeyPerformanceIndicatorSLSParm</rdf:label>
<rdfs:comment>A measure of a specific aspect of the performance of a ServiceResource (network or non-network) or a group of ServiceResources of the same type.</rdfs:comment>
</owl:Class>

