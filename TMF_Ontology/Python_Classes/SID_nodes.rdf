<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_name -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_name">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SalesCommission"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SalesCommissionRule -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SalesCommissionRule">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Sales Commission ABE"/>
<rdf:label>SalesCommissionRule</rdf:label>
<rdfs:comment>A SalesCommissionRule is a type of PolicyRule. The SalesCommissionRule is used to add complex rule, as the formula supplied as part of the SalesCommissionSpecification is simple in nature. The SalesCommissionRule specifies:

              Events triggering the evaluation of the rule (Sales Events)

                  Ex: Every first of a month, on reaching a predefined amount of sale or on the request of an employee/agent

              Conditions that need to be checked

                  Ex: If the invoice amount is above 100 $, If more than 2 hours of international call etc.,

              Actions that should be performed if the condition clause is evaluated to TRUE 

                  Ex: Calculate the Sales Commission based upon percentage of the Sales Value.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasSubRules -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_hasSubRules">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SalesCommissionRule"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isCNF -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isCNF">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SalesCommissionRule"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_isMandatoryEvaluation -->

