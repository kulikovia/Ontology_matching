<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PolicyGroup -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PolicyGroup">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Policy Framework ABE"/>
<rdf:label>PolicyGroup</rdf:label>
<rdfs:comment>This class is a generalized aggregation container. It enables PolicyRules and/or PolicyGroups to be aggregated in a single container. Note that loops, including the degenerate case of a PolicyGroup that contains itself, are not allowed when PolicyGroups contain other PolicyGroups.</rdfs:comment>
</owl:Class>

