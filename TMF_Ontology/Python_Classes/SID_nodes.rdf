<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Business Partner Account ABE"/>
<rdf:label>BusinessPartnerAccountAssignment</rdf:label>
<rdfs:comment>The BusinessPartnerAccountAssignment specifies rules for a BusinessPartnerAccount on how assignment to a FinancialAccount has to be done for each accounting event.</rdfs:comment>
</owl:Class>

