<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Customer Party Roles ABE"/>
<rdf:label>CustomerServiceRepresentative</rdf:label>
<rdfs:comment>CustomerServiceRepresentative (CSR) is an Employee from the Operator or Dealer. A CSR is in charge of customer relationship, may act on behalf of the customer for sales and in support of the customer.</rdfs:comment>
</owl:Class>

