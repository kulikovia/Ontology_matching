<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerPaymentItem"/>
<rdfs:comment>hasBE_for_Customer Payment ABE</rdfs:comment>
<rdfs:label>hasBE_for_Customer Payment ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerPayment -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerPayment">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Customer Payment ABE"/>
<rdf:label>CustomerPayment</rdf:label>
<rdfs:comment>CustomerPayment is a type of PartyPayment and represents the transfer of wealth from a customer for a product or usage of product to the CSP.</rdfs:comment>
</owl:Class>

