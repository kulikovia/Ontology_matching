<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PolicyOperator -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PolicyOperator">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Policy Statement ABE"/>
<rdf:label>PolicyOperator</rdf:label>
<rdfs:comment>This is a concrete class for modeling different types of operators in a PolicyStatement. By restricting the type of operator used in a PolicyStatement, one can effectively restrict the semantics of that PolicyStatement.</rdfs:comment>
</owl:Class>

