<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ResourceSpecVersion -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ResourceSpecVersion">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Resource Specification ABE"/>
<rdf:label>ResourceSpecVersion</rdf:label>
<rdfs:comment>This class represents the ability to distinguish between different instances of ResourceSpecifications. It represents a particular form or variety of a ResourceSpecification that is different from others or from the original. The form represents differences in attributes, methods, relationships, and/or constraints that characterize this particular ResourceSpecification, but which are not enough to warrant creating a new ResourceSpecification.</rdfs:comment>
</owl:Class>

