<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Commitment ABE"/>
<rdf:label>CommitmentFulfilmentRole</rdf:label>
<rdfs:comment>A role a party plays in a relationship to a Commitment and in that role the party, such as a Buyer, Supplier, or Partner, has to fulfill the commitment.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_name -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_name">
