</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Policy -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Policy">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Policy Framework ABE"/>
<rdf:label>Policy</rdf:label>
<rdfs:comment>This is an abstract base class, and is the root of the Policy model. As such, it defines common attributes, methods and relationships that all policy subclasses use and take part in.</rdfs:comment>
</owl:Class>

