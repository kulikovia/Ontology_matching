</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#RootEntityType -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#RootEntityType">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Root Business Entities ABE"/>
<rdf:label>RootEntityType</rdf:label>
<rdfs:comment>A SID entity, such as Customer, Product, Service, and so forth.</rdfs:comment>
</owl:Class>

