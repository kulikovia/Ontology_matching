<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Price ABE"/>
<rdf:label>ProductPricePartyRole</rdf:label>
<rdfs:comment>A Party playing a PartyRole that is involved in the pricing/charging of a Product. For example, a parents usage results in free SMS messaging being allocated to a child of the parent.</rdfs:comment>
</owl:Class>

