<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Permission ABE"/>
<rdf:label>PermissionScope</rdf:label>
<rdfs:comment>PermissionScope specifies for each criteria the value(s) for the Permission if different values are possible in the PermissionScopeSpec.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PermissionScopePolicyRule -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PermissionScopePolicyRule">
