<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Metric Definition Measure Threshold ABE"/>
<rdf:label>MetricDefMeasureThresholdConsequence</rdf:label>
<rdfs:comment>The sequence in which a MetricDefMeasureConsequence should be applied for a MetricDefMeasureThresholdRule.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_sequenceOfApplication -->

