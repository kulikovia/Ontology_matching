<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#HostingPlatformRequirementSpec -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#HostingPlatformRequirementSpec">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Software Specification ABE"/>
<rdf:label>HostingPlatformRequirementSpec</rdf:label>
<rdfs:comment>HostingPlatformRequirementsSpec is used to represent the requirements that must be fulfilled by the platform on which the InstalledSoftware will run (e.g. compute, storage, network).

The derived association /SoftwareSpecificatonRequires is used to document the set of requirements of a platform which can host the concerned software.</rdfs:comment>
</owl:Class>

