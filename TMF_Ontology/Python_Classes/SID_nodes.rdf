<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Performance ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Performance ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ABE"/>
<rdfs:comment>The Product Performance ABE handles product performance goals, the results of end-to-end product performance assessments, and the comparison of assessments against goals. The results may include the identification of potential capacity issues. 

This ABE is not fully developed</rdfs:comment>
<rdfs:label>Product Performance ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasDomain_for_Product Performance ABE -->

