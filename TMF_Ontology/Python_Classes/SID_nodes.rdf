<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRevShareReconciliationItem -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRevShareReconciliationItem">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Party Revenue Share Reconciliation ABE"/>
<rdf:label>PartyRevShareReconciliationItem</rdf:label>
<rdfs:comment>A PartyRevenueShare, Party/CustomerBill, or Party/CustomerPayment used to reconcile revenue shared with an enterprise and another party.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_description -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_description">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRevShareReconciliationItem"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRevShareReconDiscrepancy -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRevShareReconDiscrepancy">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Party Revenue Share Reconciliation ABE"/>
<rdf:label>PartyRevShareReconDiscrepancy</rdf:label>
<rdfs:comment>A difference between information received from another party with the revenue share determined by an enterprise that is to be resolved. For example, an enterprises calculated revenue share for a product offering may be missing a product that has been acquired that appears on an bill/invoice from another party.
Note: This entity is related to two of any combination of PartyPayment, PartyPaymentItem, ComponentShareProdOfferItem, AppliedPartyBillingRate.</rdfs:comment>
</owl:Class>

