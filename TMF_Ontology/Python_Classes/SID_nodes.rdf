<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Service Catalog ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Service Specification ABE"/>
<rdfs:comment>A collection of entities that represent the specification of ServiceCatalogs and catalogs described by them that contain ServiceSpecifications.</rdfs:comment>
<rdfs:label>Service Catalog ABE</rdfs:label>
</owl:Class>

