<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProductCatalog -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProductCatalog">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Catalog ABE"/>
<rdf:label>ProductCatalog</rdf:label>
<rdfs:comment>A list of ProductOfferings for sale, with prices and illustrations, for example in book form or on the web. ProductCatalogs can be used by Customers during a self-care ordering process and may be used across one or more DistributionChannels.</rdfs:comment>
</owl:Class>

