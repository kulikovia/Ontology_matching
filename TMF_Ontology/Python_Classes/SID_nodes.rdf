<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#StockItem -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#StockItem">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Stock Item ABE"/>
<rdf:label>StockItem</rdf:label>
<rdfs:comment>A StockItem represents items used Supply Chain for Stock and Shipping Management.

The codeModel specifies the type of codification used for the stockItemCode.

Two main types exist: EAN (European Article Numbering) or GTIN (Global Trade Item Numbering). A GTIN consists of a GS1 Company Prefix, an Item Reference Number and a Check Digit. 

Each of them is further defined by the length of the number such as EAN 13, GTIN-12 (USA / Canada for individual products), GTIN-13 (Rest of World for Individual products), GTIN-14 (Worldwide for Product groupings).</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_codeModel -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_codeModel">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#StockItem"/>
