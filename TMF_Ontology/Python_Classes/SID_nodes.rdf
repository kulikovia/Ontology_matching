<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProdOfferPriceCharge -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProdOfferPriceCharge">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Offering Price ABE"/>
<rdf:label>ProdOfferPriceCharge</rdf:label>
<rdfs:comment>An amount, usually of money, that is asked for when a ProductOffering is bought, rented, or leased.</rdfs:comment>
</owl:Class>

