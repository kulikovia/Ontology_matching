<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#NetworkCredential -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#NetworkCredential">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Digital Identity ABE"/>
<rdf:label>NetworkCredential</rdf:label>
<rdfs:comment>A NetworkCredential is an implicit credential (automatically retrieved via network access like MSISDN, IP address, IMPU).
It may provide a lower level of confidence than a LoginPasswordCredential for example. Thus some permissions requesting a high level of confidence might not be available.</rdfs:comment>
</owl:Class>

