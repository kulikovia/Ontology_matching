<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerFacing Service Role ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerFacing Service Role ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Service ABE"/>
<rdfs:comment>The Customer Facing Service Role ABE defines CustomerServiceRoles that are used to represent the variable characteristics of a CustomerFacingService in terms of roles that this type of Service plays.</rdfs:comment>
<rdfs:label>CustomerFacing Service Role ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasDomain_for_CustomerFacing Service Role ABE -->

