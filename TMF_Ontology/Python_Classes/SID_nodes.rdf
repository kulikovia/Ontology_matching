<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Business Interaction ABE"/>
<rdf:label>Request</rdf:label>
<rdfs:comment>The act of asking that something be done that typically involves a Response. Request is a type of Business Interaction.</rdfs:comment>
</owl:Class>

