<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#EntitySpecificationTypeRelationship -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#EntitySpecificationTypeRelationship">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Root Business Entities ABE"/>
<rdf:label>EntitySpecificationTypeRelationship</rdf:label>
<rdfs:comment>The EntitySpecificationTypeRelationship enables specifying any kind of relationships between EntitySpecificationTypes such as contains.
As an example, an EntitySpecificationType Family roles may contain many EntitySpecificationTypes such as parent, children, grand parents</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_type -->

