</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Test -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Test">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Test ABE"/>
<rdf:label>Test</rdf:label>
<rdfs:comment>An abstract entity that exists for a controlled test invocation on a product, service, or resource. The test is executed according to a schedule. and contains configuration parameters that are to be applied at execution time, and measures that result.</rdfs:comment>
</owl:Class>

