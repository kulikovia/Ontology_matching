<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_name -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_name">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerFacingServiceSpec"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerFacingServiceSpecAtomic -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CustomerFacingServiceSpecAtomic">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Customer Facing Service Spec ABE"/>
<rdf:label>CustomerFacingServiceSpecAtomic</rdf:label>
<rdfs:comment>This is an abstract base class for defining CustomerFacingServiceSpecifications that do not have any subordinate CustomerFacingServiceSpecifications. In other words, a CustomerFacingServiceSpecAtomic is a stand-alone CustomerFacingServiceSpecification, and doesnt require any supporting CustomerFacingServiceSpecifications to define the shared characteristics (i.e., attributes, relationships, and constraints) of any CustomerFacingServices that it serves as a template for.</rdfs:comment>
</owl:Class>

