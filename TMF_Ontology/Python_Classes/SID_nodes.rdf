<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ShippingCarrier -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ShippingCarrier">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
