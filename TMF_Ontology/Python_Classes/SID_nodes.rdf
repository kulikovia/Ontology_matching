</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1# hasBE_for_Customer Statistic ABE -->

<owl:ObjectProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasBE_for_Customer Statistic ABE">
<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasBE"/>
