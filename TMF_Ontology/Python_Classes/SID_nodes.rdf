</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceDesigner -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceDesigner">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
