<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProductConfiguration"/>
<rdfs:comment>hasBE_for_Product Configuration ABE</rdfs:comment>
<rdfs:label>hasBE_for_Product Configuration ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProductConfigSpec -->

