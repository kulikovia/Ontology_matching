<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MemoryCard -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MemoryCard">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Equipment ABE"/>
<rdf:label>MemoryCard</rdf:label>
<rdfs:comment>This is a type of Card that is dedicated to providing additional memory for use by other components of a Resource. Cards that are used to expand memory, or provide different types of memory, are examples of this type of Card. The SID differentiates between this and other types of Cards, such as NetworkCards and MemoryCards.</rdfs:comment>
</owl:Class>

