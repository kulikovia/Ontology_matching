<rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasBE"/>
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Test ABE"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProductTest"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProductTestSpec"/>
<rdfs:comment>hasBE_for_Product Test ABE</rdfs:comment>
<rdfs:label>hasBE_for_Product Test ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProductTest -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProductTest">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Test ABE"/>
<rdf:label>ProductTest</rdf:label>
<rdfs:comment>An entity that exists for a controlled test invocation on a product. The product test is executed according to a schedule. and contains product test configuration parameters that are to be applied at execution time, and product test measures that result.</rdfs:comment>
</owl:Class>

