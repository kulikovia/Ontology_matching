<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ResourceInstaller -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ResourceInstaller">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Resource Party Roles ABE"/>
<rdf:label>ResourceInstaller</rdf:label>
<rdfs:comment>An individual who installs PhysicalResources. It specifically doesnt provide all of the capabilities of a Technician role, but also represents a less costly PartyRole. Specifically, a ResourceInstaller is limited to simple physical installation of Equipment. A ResourceInstaller does not configure Resources or Services. </rdfs:comment>
</owl:Class>

