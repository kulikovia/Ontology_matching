<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Pricing Logic Algorithm ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Pricing Logic Algorithm ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Offering ABE"/>
<rdfs:comment>The Pricing Logic Algorithm ABE contains entities representing an instantiation of an interface specification to external rating function (without a modeled bahavior in SID).</rdfs:comment>
<rdfs:label>Pricing Logic Algorithm ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasDomain_for_Pricing Logic Algorithm ABE -->

