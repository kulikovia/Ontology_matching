<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MetricMeasurementObservation -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MetricMeasurementObservation">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Metric Monitoring ABE"/>
<rdf:label>MetricMeasurementObservation</rdf:label>
<rdfs:comment>A MetricMeasurementObservation represents the contextual information of a measurement such as the observation period, the MetricMeasurementJob used,  the requester of the observation and the scope of the observation through the related MonitoredMetricObjectCriterion.
The MonitoredMetricObjectCriterion related to MetricMeasurementObservation has to be equal to or a sub-set of the one related to the concerned MetricMeasurementJob.
A MetricMeasurementObservation also specifies the MectricMeasures resulting from this observation.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_observationPeriod -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_observationPeriod">
