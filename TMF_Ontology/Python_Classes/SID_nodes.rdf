<rdfs:comment>hasBE_for_Product Catalog ABE</rdfs:comment>
<rdfs:label>hasBE_for_Product Catalog ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProdCatProdOffer -->

