</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ResourceCandidate -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ResourceCandidate">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Resource Catalog ABE"/>
<rdf:label>ResourceCandidate</rdf:label>
<rdfs:comment>A ResourceCandidate is an entity that enables the ResourceSpecifications to a catalog. A ResourceCandidate and its ResourceSpecification may be published - made visible - in any number of ResourceCatalogs, or in none.  One ResourceSpecification can be composed of other ResourceSpecifications.</rdfs:comment>
</owl:Class>

