<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Security Event ABE"/>
<rdf:label>SecurityEventCollectionMethod</rdf:label>
<rdfs:comment>Method in which the event was detected or sensed.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_description -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_description">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SecurityEventCollectionMethod"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SecurityEventEndpoint -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SecurityEventEndpoint">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Security Event ABE"/>
<rdf:label>SecurityEventEndpoint</rdf:label>
<rdfs:comment>Represents an IP address and a port in a connection during a security event</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_endpointRole -->

