<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SRTBridging -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SRTBridging">
