<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Commitment ABE"/>
<rdf:label>CommitmentApproverRole</rdf:label>
<rdfs:comment>A role a party plays when approving a commitment  such as Buyer, Supplier or Partner</rdfs:comment>
</owl:Class>

