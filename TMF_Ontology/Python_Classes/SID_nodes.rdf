<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ResourceCatalog -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ResourceCatalog">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Resource Catalog ABE"/>
<rdf:label>ResourceCatalog</rdf:label>
<rdfs:comment>A ResourceCatalog is a collection of ResourceCandidates representing ResourceSpecifications.  ResourceCandidates define the underlying resources.  ResourceCandidates can be exposed to one or more ResourceCatalogs to be utilized to configure or incorporated in one or more ServiceCandidates or ProductOfferings.   A ResourceCatalog contents can expose a collection of ResourceCandidates to be utilized internal/external to an enterprise.</rdfs:comment>
</owl:Class>

