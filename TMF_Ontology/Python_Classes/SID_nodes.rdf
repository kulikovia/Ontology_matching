</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PRGSpecFriends -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PRGSpecFriends">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Party Role Group ABE"/>
<rdf:label>PRGSpecFriends</rdf:label>
<rdfs:comment>A PRGSpecFriends is a type of PartyRoleGroupSpecification specifying rules applying for being member of a Friends Group.</rdfs:comment>
