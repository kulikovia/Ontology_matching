<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceStateInfo -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceStateInfo">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Service State ABE"/>
<rdf:label>ServiceStateInfo</rdf:label>
<rdfs:comment>ServiceStateInfo is an abstract base class for representing different types of management information that describes the state of a particular Service. This can be a CustomerFacingService or a ResourceFacingService.

Subclasses of this class include classes to represent Faults, Outages, Alarms, the usage of this Resource, and its current operational state.</rdfs:comment>
</owl:Class>

