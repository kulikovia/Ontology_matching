<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CompositeVision -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CompositeVision">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Project ABE"/>
<rdf:label>CompositeVision</rdf:label>
<rdfs:comment>A type of Vision that is formed by aggregating other Visions, which may be composite or atomic Visions.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CompositeProjectDeliverable -->

