<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#WorkflowType"/>
<rdfs:comment>hasBE_for_Workflow ABE</rdfs:comment>
<rdfs:label>hasBE_for_Workflow ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Workflow -->

