<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#AppliedCustomerBillingProductCharge -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#AppliedCustomerBillingProductCharge">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Applied Customer Billing Rate ABE"/>
<rdf:label>AppliedCustomerBillingProductCharge</rdf:label>
<rdfs:comment>An amount, usually of money, for which a person or organization is financially liable when a Product is bought, rented, leased, or used in some manner.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_date -->

