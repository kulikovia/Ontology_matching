<rdfs:label>hasBE_for_Product Offering Price Rule ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ProdOfferPriceAction -->

