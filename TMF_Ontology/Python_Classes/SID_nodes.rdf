</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CompositeSecVulScoringMetricDefn -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CompositeSecVulScoringMetricDefn">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Security Vulnerability Scoring Definition ABE"/>
<rdf:label>CompositeSecVulScoringMetricDefn</rdf:label>
<rdfs:comment>A type of SecurityVulnerabilityMetricDefn that is formed by aggregating other SecurityVulnerabilityMetricDefns, which may be Composite or Atomic SecurityVulnerabilityMetricDefns.

Notes: A Base Score Metric which is made up of Base Exploitability and Base Impact, Base Exploitability made up of Acess Vector, Authentication, and so forth.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_datatype -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_datatype">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#CompositeSecVulScoringMetricDefn"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_description -->

