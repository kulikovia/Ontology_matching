<rdfs:comment>hasBE_for_Customer Statistic ABE</rdfs:comment>
<rdfs:label>hasBE_for_Customer Statistic ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ChurnRetentionStatistic -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ChurnRetentionStatistic">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Customer Statistic ABE"/>
<rdf:label>ChurnRetentionStatistic</rdf:label>
<rdfs:comment>A meaure of Customer churn (turnover of Customers) or Customer retention (keeping Customers).</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Customer Bill Inquiry ABE -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Customer Bill Inquiry ABE">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ABE"/>
<rdfs:comment>Represents invoice inquiries associated with invoices sent to customers and handles disputes and adjustments on individual charges, invoices, and accounts.</rdfs:comment>
<rdfs:label>Customer Bill Inquiry ABE</rdfs:label>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasDomain_for_Customer Bill Inquiry ABE -->

