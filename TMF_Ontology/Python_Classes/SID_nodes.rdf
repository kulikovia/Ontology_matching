<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#GoalTargetPartRole"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#GoalType"/>
<rdfs:comment>hasBE_for_Goal ABE</rdfs:comment>
<rdfs:label>hasBE_for_Goal ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Goal -->

