<rdfs:comment>hasBE_for_Employee Pay ABE</rdfs:comment>
<rdfs:label>hasBE_for_Employee Pay ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#EmployeePay -->

