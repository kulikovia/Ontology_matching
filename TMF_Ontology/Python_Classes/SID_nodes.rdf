<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SalesAgent -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SalesAgent">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Market Sales Party Roles ABE"/>
<rdf:label>SalesAgent</rdf:label>
<rdfs:comment>A SalesAgent is a role played by a Party. A SalesAgent is responsible for selling the Service Providers ProductOfferings to wholesale and / or retail customers.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_status -->

