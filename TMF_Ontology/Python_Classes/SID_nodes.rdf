</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRevenueSharingModelInvolvement -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRevenueSharingModelInvolvement">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Party Revenue Sharing Model ABE"/>
<rdf:label>PartyRevenueSharingModelInvolvement</rdf:label>
<rdfs:comment>Specification of a party, including an enterprise, who participates in revenue sharing, their type of involvement, and their associated offering(s).</rdfs:comment>
