</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceSpecificationRole -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceSpecificationRole">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Service Specification ABE"/>
<rdf:label>ServiceSpecificationRole</rdf:label>
<rdfs:comment>ServiceSpecificationRole is an abstract base class that defines a ServiceSpecification in terms of a set of roles. The roles are then used to characterize the shared functionality of the Service, regardless of whether it is a resource or a customer facing service.
ServiceSpecificationRoles represent the shared functionality of a ServiceRole. Representing a Service in terms of ServiceSpecificationRoles enables the functionality of the Service to be defined independently of BusinessActor, PhysicalResource, LogicalResource, or other Services.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_description -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_description">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceSpecificationRole"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ID -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_ID">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceSpecificationRole"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_name -->

