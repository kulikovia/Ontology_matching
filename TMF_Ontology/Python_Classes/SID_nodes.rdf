<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Security Event ABE"/>
<rdf:label>SecurityEventSpecificationType</rdf:label>
<rdfs:comment>Used to dynamically define new types of events.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SecuritySignature -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SecuritySignature">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Security Event ABE"/>
<rdf:label>SecuritySignature</rdf:label>
<rdfs:comment>Preconfigured and predetermined attack patterns, known as signatures, that can be monitored. Many attacks today have 

distinct signatures.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SignatureSecurityEvent -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SignatureSecurityEvent">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Security Event ABE"/>
<rdf:label>SignatureSecurityEvent</rdf:label>
