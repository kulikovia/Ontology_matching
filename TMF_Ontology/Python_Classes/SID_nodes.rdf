<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MarketingOperator"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Prospect"/>
<rdfs:range rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#SalesAgent"/>
<rdfs:comment>hasBE_for_Market Sales Party Roles ABE</rdfs:comment>
<rdfs:label>hasBE_for_Market Sales Party Roles ABE</rdfs:label>
</owl:ObjectProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#MarketingCampaignRole -->

