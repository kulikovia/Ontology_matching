</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceSpecVersion -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServiceSpecVersion">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Service Specification ABE"/>
<rdf:label>ServiceSpecVersion</rdf:label>
<rdfs:comment>This class represents the ability to distinguish between different instances of ServiceSpecifications. It represents a particular form or variety of a ServiceSpecification that is different from others or from the original. The form represents differences in attributes, methods, relationships, and/or constraints that characterize this particular ServiceSpecification, but which are not enough to warrant creating a new ServiceSpecification.</rdfs:comment>
</owl:Class>

