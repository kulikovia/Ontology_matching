<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServicePackageSpecComposite -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#ServicePackageSpecComposite">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Service Package ABE"/>
<rdf:label>ServicePackageSpecComposite</rdf:label>
<rdfs:comment>This models different packages as the combination of other existing ServicePackages (as well as providing its own extensions). This is fundamentally different than ServicePackageAtomic, which models different ServicePackages as a set of different instances.</rdfs:comment>
</owl:Class>

