</owl:DatatypeProperty>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRevenueShareAdjustment -->

<owl:Class rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRevenueShareAdjustment">
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#BE"/>
<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Party Revenue Share ABE"/>
<rdf:label>PartyRevenueShareAdjustment</rdf:label>
<rdfs:comment>An adjustment to the revenue to be shared among an enterprise and one or more other parties. This could be required, but not limited to, based on changes to a revenue sharing model associated with a party revenue sharing agreement or based on discrepancies found by the Party Revenue Share Reconciliation process.</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_adjustmentReason -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_adjustmentReason">
<rdfs:domain rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#PartyRevenueShareAdjustment"/>
<rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

