<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Configuration ABE"/>
<rdf:label>ProductConfiguration</rdf:label>
<rdfs:comment>A representation of how a Product operates or functions in terms of characteristics and related Resource(s), Product(s), Service(s).</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateCreated -->

<owl:DatatypeProperty rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_dateCreated">
