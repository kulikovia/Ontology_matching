<rdfs:subClassOf rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#Product Offering ABE"/>
<rdf:label>DistChannelProdOffer</rdf:label>
<rdfs:comment>The ability of a distribution channel to distribute a product that has been ordered (as a product offering).</rdfs:comment>
</owl:Class>

<!--http://www.semanticweb.org/igork/ontologies/2024/1/InformationModel_v1#hasAttr_validFor -->

