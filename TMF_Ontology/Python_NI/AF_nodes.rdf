<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">333</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Enterprise Audit Management Enterprise Audit Management Aggregate Function is in charge of auditing the enterprise according to SOX and tracking the compliance results.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Patent and Invention Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Patent and Invention Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
