<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">359</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Privacy Development The Privacy Development Aggregate Function are in charge of specifying Privacy Rules to be applied.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Privacy Definition  Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Privacy Definition  Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.3.1.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">360</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Privacy Definition  Management Privacy Definition Management Aggregate Function is in charge of specifying Privacy Profile Types and related rules, possible values and default configuration.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Privacy Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Privacy Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.4.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">361</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Privacy Management The Privacy Management Aggregate Function are in charge of applying the Privacy Rules when required.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Privacy Control -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Privacy Control">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.4.1.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">362</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Privacy Control Privacy Control Aggregate Function controls that records retention rules are applied as well as privacy rules.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Privacy Repository Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Privacy Repository Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.4.1.2</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">363</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Privacy Repository Management Privacy Repository Management Aggregate Function manages Privacy Profiles initialized by default or customized by the Party and obtains consent from the Data Subject Party for the Party Profile.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Content Delivery Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Content Delivery Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.5.1.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">364</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Content Delivery Management The Content Delivery AF groups functions that ensuring the effective and efficient dissemination of digital content to end-users. Their responsibilities include:
1.	Content Distribution: Efficiently delivering digital content to end-users across various platforms and devices (Source: "Content Delivery Network (CDN)" - TechTarget).
2.	Load Balancing: Ensuring even distribution of network traffic to prevent overloads and improve performance.
3.	Caching Management: Implementing cache strategies to reduce load times and optimize content delivery.
4.	Traffic Routing: Directing user requests to the nearest server for faster content access.
5.	Security: Protecting content and networks from cyber threats and DDoS attacks .
6.	Quality of Service: Maintaining high-quality content delivery, including minimizing latency and packet loss 
7.	Scalability: Ensuring the system can handle increased demand without performance degradation
8.	Monitoring and Analytics: Constantly tracking content delivery performance and analyzing data for optimization.
9.	Content Optimization: Compressing, transcoding, or adapting content for better delivery to various devices.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Anomaly Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Anomaly Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.6.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">365</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Anomaly Management Anomaly Management Aggregate Function groups functions that detect, predict, mitigate and maintain knowledge of anomalies for products, services and/or resources.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Anomaly Detection -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Anomaly Detection">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.6.1.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">366</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Anomaly Detection Anomaly Detection Aggregate function group functions to identify rare items, events, or observations for products, services or resources which deviate significantly from well-defined notion of normal behavior.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Anomaly Prediction -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Anomaly Prediction">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.6.1.2</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">367</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Anomaly Prediction Anomaly Prediction Aggregate function group functions to forecast future anomalies based on historical data.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Anomaly Mitigation -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Anomaly Mitigation">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.6.1.3</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">368</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Anomaly Mitigation Anomaly Mitigation Aggregate function group functions to define strategies and plan  to reduce the impact or prevent the occurence of detected predicted anomaly.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Content Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Content Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">369</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Content Management The Content Management Aggregate Function enables documents and contents management, sharing and archiving.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Content Repository Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Content Repository Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.1.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">370</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Content Repository Management Content Repository Management Aggregate Function is in charge of collecting and formatting contents and managing it collaboratively.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Document Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Document Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.1.2</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">371</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Document Management The Document Management Aggregate Function handles creation and management of electronic documents.
Documents managed by an EDM (Electronic Document Management) system are both working documents, which can be modified, and final documents. The sub-function Versioning allows the identification of successive releases of the document. Documents are accessed by the user according to the granted access rights.
Subfunctions :
- Capture and integration in the EDM system (for examples GED, sharepoint, social network, )
- Retention and disposal
- Access and grant control
- Traceability, security and administration
- Versioning.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Records Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Records Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.1.3</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">372</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Records Management The Records Management Aggregate Function handles document and data to be archived.
Documents or data which must be archived are those which are valuable and useful for the company:
- Legal value: information that must be preserved for reasons that are legal (when a law requires retention) and regulatory or judicial (proof in court).
- Informational value: information that must be preserved for professional needs and for the smooth conduct of business activities.
- Historical value: information preserved for its contribution to the collective company memory.
All of these documents and data must be sorted and classified according to their level of sensitivity, preserved (or destroyed) in a structured and secure manner.
The Records Management Aggregate Function contains the 4 sub-functions:
1) Records Capture
2) Record Access
3) Records Retention and Disposal
4) Records Traceability, Security and Administration</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Master Data Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Master Data Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.2</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">373</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Master Data Management The Master Data Management Aggregate Function gathers all required functions for enterprise master data administration. It aims at unifying data repositories management whatever the business domain.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Data Repository Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Data Repository Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.2.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">374</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Data Repository Management Data Repository Management Aggregate Function is in charge of all activities od Data management such as formatting, security access, distribution, archiving</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Data Structure Definition -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Data Structure Definition">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.2.2</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">375</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Data Structure Definition Data Structure Definition Aggregate Function defines Data Structure and related rules.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Project Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Project Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.3</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">376</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Project Management The Project Management Aggregate Function contains functions concerning the management of all kinds of projects.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Project Repository Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Project Repository Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.3.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">377</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Project Repository Management Project Repository Management Aggregate Function is in charge of managing the Project Inventory and produces reports and KPI to measure the progress of the project.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Project Planning -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Project Planning">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.3.2</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">378</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Project Planning The Project Planning Aggregate Function handles all functions associated with the project management and not already implemented in other Aggregate Functions (resources management, budget management, ), that facilitate the work of the project managers.
Sub-functions used:
- Tasks and activities Building:
Based on a multi-level Work Breakdown Structure (WBS), this function allows to define, organize and interface all activities of the project necessary to meet the predefined objectives of the project: delivery of the agreed scope (offer, product, ), quality, time and cost constraints.
- Project Planning:
Management of the project estimating, the means of the project optimizing, tasks schedule and identifying the critical path, evaluating and re affecting task over resources.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Identification and Permission Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Identification and Permission Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.4</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">379</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Identification and Permission Management The Identification and Permission Management Aggregate Function consist in 

	- identifying, and potentially authenticating, a person whatever his/her role(s),
	- specifying roles and permissions definition, assignment and control for any actor implicated in the enterprise business processes (ex: customer, CSR, data protection manager, Business Partners, etc.)
</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Identification and Authentication -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Identification and Authentication">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.4.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">380</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Identification and Authentication Identification and Authentication Aggregate Function consists in identifying, and potentially authenticating, a person whatever his/her role. 
Authentication is not systematic but may be required for sensitive actions according to security matters.
Identification and authentication means may vary depending on the interaction channel. For automatic interaction channels, the means of identification and authentication are highly discriminant and should return at more one result (usually using personal credentials). For human interaction channels, on the other hand, a series of information may be necessary to identify and authenticate a person (for instance asking their name and first name for identification followed by birth date and birth place for authentication).</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Permission Control -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Permission Control">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.4.2</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">381</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Permission Control Permission Control Aggregate Function manages roles and related permissions and controls permissions according to roles and related rules.
It consists in evaluating if a requester is granted the permission to act by providing the required evidence. The evidence corresponds to the condition specified for each right (for instance keying the correct password to use a specific mailbox). If the action is protected via a right which is assigned (possibly via a role) to a person then the person has to be identified to retrieve their rights and verify if the request to act can be granted.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Roles & Permission Definition -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Roles & Permission Definition">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.4.3</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">382</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Roles & Permission Definition Roles &amp; Permission Definition Aggregate Function defines roles types and possible permissions with rules according to roles.
Roles catalogue consists in designing, creating, modifying and deleting role specifications. The aim is to identify the set of permissions (rights) that should be granted to any person who is assigned the role. Defining roles depends on processes and associated organization (internal or external), for example a fleet manager (external role) or a CSR level 1 (internal). As part of roles definitions, incompatibility in between roles or other types of constraints should also be specified. The purpose of a role is to ease the assignment of rights to a person by avoiding rights reassignment in case of re organization for instance.
Permission catalogue consists in designing, creating, modifying and deleting permission specifications. A permission specifies the conditions to access a set of actions on an object. For example, in order to access all usage functions of a mailbox product the condition is to provide the correct password.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Digital Identity Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Digital Identity Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.4.4</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">383</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Digital Identity Management Digital Identity Management Aggregate Function is in charge of providing  Digital Identities with their credentials and relationship with Party or Party Roles.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Role and Permission Assignment / Configuration -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Role and Permission Assignment / Configuration">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.4.5</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">384</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Role and Permission Assignment / Configuration Role and Permission Assignment / Configuration Aggregate Function consists in:

	- assigning a party role to a person according to a type of role such as Customer or Payer. Sometimes a party role might be not played by a Party when unknown. For example, we might not know the Party that uses a mail box.
	- specifying on which perimeter the permission carried by the Party Role applies on. A perimeter defines:

   - either an object or a set of objects such as a Product, a Billing Account, etc.
   - or using selection criteria to identify objects on which permission applies such as geographical area where the Distributor has right to sell</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Fallout Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Fallout Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.5</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">385</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Fallout Management Fallout Management Aggregate Function is in charge of fixing Fallout errors and managing Fallout inventory.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Fallout Correction Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Fallout Correction Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.5.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">386</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Fallout Correction Management Fallout Correction Management Aggregate Function is in charge of fixing Fallout errors either automatically or by queuing the Fallout error.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Fallout Repository Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Fallout Repository Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.5.2</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">387</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Fallout Repository Management Fallout Repository Management Aggregate Function is in charge of managing the Fallout Inventory, including orchestration, reporting and dashboard.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Party Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Party Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.6</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">390</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Party Management Party Management Aggregate Function includes functions that manage information describing the Third Parties, individuals or organizations, and their contact medium.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Party Repository Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Party Repository Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.6.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">391</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Party Repository Management Party Repository Management Aggregate Function allows the creation, modification, deletion of a Third Party (induvidual or organization).
For people, it allows to declare their marital status and official proof of identity.
For an organization (company, association, etc.), it manages its corporate name, the description of its internal organization according to several axes (legal, functional, etc.), its business justification (Kbis in France, etc.).
Party Management also includes the management of the life cycle of parties.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Systems and Applications Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Systems and Applications Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.7</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">393</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Systems and Applications Management The Systems and Applications Management AF groups functions responsible for managing IT systems and applications, from Planning though Retirement, including operations.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Systems Administration -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Systems Administration">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.7.3</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">396</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Systems Administration System Administration AF groups functions that involve managing and maintaining computer systems, networks, and servers to ensure their optimal performance, security, and reliability. The principal responsibilities include:
1.	Installing and configuring operating systems and software.
2.	Managing user accounts and access permissions.
3.	Monitoring system performance and resource utilization.
4.	Implementing security measures to safeguard data and networks.
5.	Performing backups and disaster recovery planning.
6.	Troubleshooting and resolving technical issues.
7.	Applying software updates and patches.
8.	Documenting system configurations and procedures.
9.	Capacity planning for future system growth.
10.	Ensuring compliance with industry standards and best practices.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Systems Infrastructure Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Systems Infrastructure Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.7.4</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">397</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Systems Infrastructure Management Systems Infrastructure Management AF groups functions responsible for overseeing the foundational technology components critical to an organization's operations. Its key responsibilities include:
1.	Infrastructure Planning: Strategically designing and scaling the IT infrastructure to meet business needs.
2.	Hardware Procurement: Sourcing, purchasing, and maintaining server, storage, and networking equipment.
3.	Software Integration: Ensuring seamless integration of software solutions across the infrastructure.
4.	Security Management: Safeguarding systems and data through security measures and protocols.
5.	Capacity Optimization: Efficiently utilizing resources to meet performance demands.
6.	Disaster Recovery: Developing and testing plans for data and system recovery.
7.	Network Management: Managing network connectivity and reliability.
8.	Performance Monitoring: Constantly assessing system performance and addressing issues.
9.	Vendor Relations: Managing relationships with technology suppliers and service providers.
10.	Compliance and Documentation: Ensuring adherence to industry standards and maintaining comprehensive system documentation</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Systems and Applications Support -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Systems and Applications Support">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.7.5</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">398</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Systems and Applications Support The Systems and Applications Support function plays a critical role in ensuring the smooth operation of software systems within an organization. Its responsibilities include:
1.	Troubleshooting: Identifying and resolving software issues and user problems.
2.	Maintenance: Regularly updating, patching, and optimizing applications.
3.	Monitoring: Keeping a watchful eye on system performance and responding to anomalies.
4.	Documentation: Maintaining comprehensive records of configurations and procedures.
5.	User Assistance: Offering guidance and assistance to users facing technical difficulties.
6.	Incident Management: Managing and resolving software-related incidents promptly.
7.	Release Management: Coordinating software updates, ensuring a smooth transition.
8.	Compliance: Ensuring applications adhere to regulatory and security standards.
9.	Vendor Liaison: Interacting with software vendors for support and issue resolution.
10.	Performance Analysis: Analyzing application performance data to drive improvements</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Applications Portfolio Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Applications Portfolio Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.7.7</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">400</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Applications Portfolio Management Application Portfolio Management (APM) AF groups functions responsible for overseeing an organization's software and application assets to optimize their performance and strategic alignment. Its principal responsibilities include:
1.	Inventory Management: Maintain a comprehensive inventory of all applications and software within the organization.
2.	Strategic Alignment: Ensure that applications align with the organization's goals and objectives.
3.	Performance Assessment: Evaluate application performance, efficiency, and effectiveness.
4.	Rationalization: Identify redundant or outdated applications and recommend consolidation or retirement.
5.	Prioritization: Rank applications based on their strategic importance and business impact.
6.	Risk Management: Assess and mitigate risks associated with the application portfolio.
7.	Cost Control: Monitor and control application-related costs, aiming for efficiency.
8.	Roadmapping: Develop a strategic roadmap for the application portfolio, including upgrades and replacements.
9.	Vendor Management: Oversee relationships with third-party vendors and software providers.
10.	Reporting and Communication: Provide regular reports and communicate the status and value of the application portfolio to stakeholders.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Data Center Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Data Center Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.7.8</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">401</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Data Center Management Data Center Management AF includes functions responsible for overseeing critical infrastructure and ensuring efficient operations within a data center environment. Its principal responsibilities include:
1.	Infrastructure Maintenance: Managing and maintaining hardware, power, and cooling systems to ensure optimal performance.
2.	Security Management: Implementing security measures to safeguard data, equipment, and personnel.
3.	Capacity Planning: Evaluating resource needs and scalability to meet current and future demands.
4.	Disaster Recovery: Developing and testing contingency plans to minimize downtime during emergencies.
5.	Energy Efficiency: Implementing energy-saving measures to reduce operational costs and environmental impact.
6.	Compliance: Ensuring adherence to industry regulations and standards for data center operations.
7.	Performance Monitoring: Continuously tracking and optimizing system performance and uptime.
8.	Asset Inventory: Maintaining an accurate inventory of all data center equipment and resources.
9.	Budget Management: Managing financial resources to meet operational needs and cost-efficiency goals.
10.	Documentation: Maintaining detailed records and documentation for operational transparency and troubleshooting.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Technology Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Technology Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.8</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">402</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Technology Management The Technology Management AF groups functions responsible for the investigation,lifecycle management , and utilization oversight of technologies and technology approaches.  These responsibilities include:
1.	Strategic Planning: Developing technology strategies aligned with business goals.
2.	Resource Allocation: Managing budgets and resources for tech initiatives.
3.	Risk Assessment: Identifying and mitigating technology-related risks.
4.	Rollout: Managing the introduction and adoption of technologies
5.	Innovation Oversight: Promoting and implementing innovative tech solutions.
6.	Vendor Management: Managing relationships with technology vendors.
7.	Cybersecurity: Protecting digital assets and data from threats.
8.	Compliance: Ensuring adherence to legal and regulatory tech standards.
9.	Lifecycle management: Tracking and coordinating the progress of technologies employed within the organization through the lifecycle stages (including piloting, adoption, growth, sunsetting and retirement) of technologies and technology implementations.
10.	Utilization oversight: Planning, monitoring and adjusting for the acceptance of and utilization of technologies.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Data Analytics -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Data Analytics">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">1</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.9</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">403</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Data Analytics The Data Analytics aggregate function bridges the gap between raw data and actionable insights, enabling organizations to make data-informed choices and enhance their competitiveness.  It groups functions involving the collection, interpretation, and utilization of data to drive informed decision-making and optimize business strategies. Its responsibilities encompass:
1.	Data Collection: Gathering and consolidating data from various sources.
2.	Data Processing: Cleaning, transforming, and structuring data for analysis.
3.	Data Analysis: Employing statistical and computational techniques to extract insights.
4.	Performance Metrics: Defining and tracking key performance indicators (KPIs).
5.	Predictive Modeling: Building models to forecast trends and outcomes.
6.	Data Visualization: Presenting findings through graphs, charts, and dashboards.
7.	Reporting: Communicating analysis results to stakeholders.
8.	A/B Testing: Conducting experiments to evaluate changes or hypotheses.
9.	Business Intelligence: Supporting strategic decisions with data-driven insights.
10.	Continuous Improvement: Enhancing data analytics processes and tools.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Business Intelligence -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Business Intelligence">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.9.1</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">405</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Business Intelligence The Business Intelligence aggregate function groups functions that leverage data to inform decision-making and drive strategic insights. Its responsibilities include:
1.	Data Gathering: Collecting and aggregating data from various sources.
2.	Data Analysis: Analyzing data to identify trends, patterns, and key insights.
3.	Reporting: Creating reports and dashboards for stakeholders.
4.	Forecasting: Using historical data to predict future trends.
5.	Data Visualization: Presenting data in a visually understandable format.
6.	Performance Metrics: Developing KPIs to measure business success.
7.	Competitive Analysis: Evaluating the organization's position in the market.
8.	Decision Support: Providing data-driven insights for informed decision-making.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Analytics Information Support -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Analytics Information Support">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">9.10.9.2</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">407</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Analytics Information Support The Analytics Information Support aggregate function groups functions involved in the collection, preparation and organization of information so that it can be used efficently and effectively in data analytics.  Their responsibilities include:
1.	Data Collection: Gathering, organizing, and storing relevant data from various sources.
2.	Data Quality Assurance: Ensuring the accuracy and reliability of collected data.
3. 	Reference and Metadata Management: Defining reference data and dimensions that can be used to express the data consistently
4.	Data Transformation: Converting raw data into usable formats for analysis.
5.	Database Management: Maintaining data repositories and optimizing data access.
6.	Data Security: Implementing safeguards to protect sensitive information.
7.	Troubleshooting: Resolving data-related issues and providing technical support.</rdf:label>
</owl:NamedIndividual>

