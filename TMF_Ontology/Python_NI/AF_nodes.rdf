<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Loyalty Program Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Loyalty Program Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">3.3.3.1</TMF_v1:hasID>
