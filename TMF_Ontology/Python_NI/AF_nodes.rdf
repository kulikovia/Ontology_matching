<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">86</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Customer Billing Definition The Customer Billing Definition Aggregate Function manages the data that are necessary to pilot invoice production: billing cycle data, management of runs, groups and cycles of invoicing.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Customer Risk Mitigation Definition -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Customer Risk Mitigation Definition">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF"/>
<TMF_v1:AFLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#decimal">2</TMF_v1:AFLevel>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">3.3.2.2</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">87</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Customer Risk Mitigation Definition The Risk Mitigation Definition Aggregate Function is meant to define an array of actions, related to triggering conditions such as threshold(s) of billable amounts defined according to risk level, to avoid bill shock.
It also defines Customer criteria (such as VIP) to identify the corresponding prevention scenario to be applied.</rdf:label>
</owl:NamedIndividual>

