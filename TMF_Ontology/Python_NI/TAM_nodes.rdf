<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Product Test Restitution Design -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Product Test Restitution Design">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
