<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Receivable Balance Transferring Accounts Receivable (A/R) Management function of Applying adjustments and balance transfer: Adjustments to be carried out (manually or in bulk) or transfer of transactions to customers accounts after corrections.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Accounting Event Creation -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Accounting Event Creation">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
