<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Customer Ordering External Access -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Customer Ordering External Access">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
