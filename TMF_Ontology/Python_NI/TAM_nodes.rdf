<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Shared Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Operations Readiness & Support,Business Value Development,Strategy Management,Capability Management,Billing,Fulfillment,Assurance"/>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">1391</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2181</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Natural Language Speech Recognition Natural Language Speech Recognition function converts spoken language into text. The input is an audio file or a stream of spoken language, and the output is the transcribed text.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Natural Language Prompt Manager -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Natural Language Prompt Manager">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
<TMF_v1:AF_Lev.1 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Communications"/>
<TMF_v1:AF_Lev.2 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Natural Language Processor"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Shared Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Operations Readiness & Support,Business Value Development,Strategy Management,Capability Management,Billing,Fulfillment,Assurance"/>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">1392</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2182</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Natural Language Prompt Manager Natural Language Prompt Manager function is responsible for designing input prompts or queries that elicit specific responses from a language model. The input is a language model and a set of criteria, and the output is a set of prompts.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Natural Language Response Manager -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Natural Language Response Manager">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
