<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2355</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Collection Execution Monitoring Monitors events that may change the collection execution. Such events includes: customer paid, customer status has been changed, payment back-outs. As a result stop, resume or reselect the collection policy.</rdf:label>
</owl:NamedIndividual>

