<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Enterprise Security Risk Identification -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Enterprise Security Risk Identification">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
<TMF_v1:AF_Lev.1 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Security Management"/>
<TMF_v1:AF_Lev.2 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Security Strategy Definition and Management"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Enterprise Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance,Billing,Fulfillment,Operations Readiness & Support,Strategy Management"/>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">1228</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2027</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Enterprise Security Risk Identification The Enterprise Security Risk Identification Function is in charge of identifying security risk and security risk level on various security aspects.

Security concerns several parts: 
- CSP financial and legal security
- Personnel security (employees in their work environment, customers)
- Site security (buildings)
- Network, Service Platform and IS infrastructure security
- Information security (GDPR, confidentiality, defense secrecy)

The CSP Security Policy may be applied to these different parts, and its implementation may be carried out in operational functions of collection, control, supervision and analysis.</rdf:label>
</owl:NamedIndividual>

