<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Simulation Data Logger Simulation Data Logger function logs the data generated during the simulation. It involve storing the state of the simulation at different time points.
    - Input: Data to be logged and the format in which it should be stored.
    - Output: Log files containing the simulation data.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Simulation Data Analysis -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Simulation Data Analysis">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
