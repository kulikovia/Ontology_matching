<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Service Problem Receiving -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Service Problem Receiving">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
