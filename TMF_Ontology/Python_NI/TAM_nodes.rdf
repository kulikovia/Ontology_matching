<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Fraud & Anomaly Detection -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Fraud & Anomaly Detection">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
