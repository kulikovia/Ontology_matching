<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Multi Variate Anomaly Detection Detects anomalies in multiple variables with correlations, which are usually gathered from products, services or resources (including devices, IoT and equipment etc.) or other complex systems. It takes as input a multivariate dataset and outputs the identified anomalies.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Anomaly Model Selection -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Anomaly Model Selection">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
<TMF_v1:AF_Lev.1 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Anomaly Management"/>
