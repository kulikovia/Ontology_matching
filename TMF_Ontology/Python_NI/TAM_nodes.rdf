<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Loan Securitization -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Loan Securitization">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
<TMF_v1:AF_Lev.1 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Asset Management"/>
<TMF_v1:AF_Lev.2 rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AF.Loan Securitization AF"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Enterprise Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Billing"/>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">1259</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2056</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Loan Securitization Loan Securitization function is supporting responsible for the processes of pooling loans and converting them into securities that can be sold to investors. The principal responsibilities processes include: Structuring loan pools, Assessing credit quality, Engaging rating agencies, Preparing offering documents, Complying with regulatory requirements, Coordinating with stakeholders, Managing the issuance process, Monitoring loan performance, and Implementing best practices. These responsibilities ensure a well-structured, compliant, and successful securitization process while maintaining transparency and investor confidence.</rdf:label>
</owl:NamedIndividual>

