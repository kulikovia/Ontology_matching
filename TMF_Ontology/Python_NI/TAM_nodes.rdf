</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Transactional Document Delivering -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Transactional Document Delivering">
