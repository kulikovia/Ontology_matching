<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2249</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Account Receivable Direct Debiting Account Receivable Direct Debiting provides Direct debit by generating flows of requests for direct debits. It is based upon the billing accounts and on the banks' opening schedule.</rdf:label>
</owl:NamedIndividual>

