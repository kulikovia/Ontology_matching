<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Balance Data Retrieval Balance Data Retrieval provides a retrieval function to requests regarding balances statuses, values etc.</rdf:label>
</owl:NamedIndividual>

