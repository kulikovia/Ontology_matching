<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Service Instance Lifecycle Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Service Instance Lifecycle Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
