<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2350</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Pause/Resume Collection Treatment Pause/Resume Collection Treatment manages the pausing and resuming of accounts into collection treatment. It corresponds to dunning activities according to dunning rules.</rdf:label>
</owl:NamedIndividual>

