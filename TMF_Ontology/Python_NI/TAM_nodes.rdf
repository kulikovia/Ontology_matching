<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2402</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Customer Order Distribution Customer Order Distribution function enables distributing finalized customer orders to any parties and systems that need the order information and/or the notification that the order has been finalized.</rdf:label>
</owl:NamedIndividual>

