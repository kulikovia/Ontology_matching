<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Anomaly Prediction Description Capture Anomaly Prediction Description Capture the prediction expectation and goal. It takes as input a machine/man provided prediction requirement scenario and outputs a categorize prediction pattern expectation confirmation.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Anomaly Prediction Data Preprocessing -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Anomaly Prediction Data Preprocessing">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
