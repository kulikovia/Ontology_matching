<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Operations Readiness & Support"/>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">1108</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">3748</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Customer Behavior Tracking Customer Behavior Tracking Function tracks the customer behavior concerning the use of his Products in order to provide a global and personalized vision of its real consumption on all its products based on a detailed view of each product consumption.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Customer Order Activity Supervision -->

