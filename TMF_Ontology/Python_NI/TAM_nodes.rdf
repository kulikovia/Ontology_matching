<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Realtime Anomaly Inferencing This function (a.k.a Streaming Detection) performs anomaly detection on real-time data streams using a given or selected model. It takes as input new data and the selected model, and outputs identified anomalies in real-time.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Anomaly Batch Inferencing -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Anomaly Batch Inferencing">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Function"/>
