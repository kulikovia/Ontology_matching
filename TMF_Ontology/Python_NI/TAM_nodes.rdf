<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">106</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2623</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Case Tracking Threshold Notification Case Tracking Threshold Notification provides notification of jeopardies on the case as appropriate if specified dates and milestones are not met.</rdf:label>
</owl:NamedIndividual>

