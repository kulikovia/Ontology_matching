<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Voice Channel Contact Routing Voice Channel Contact Routing function provides the means for a customer to speak to a service representative, including the mechanism to query the customer (e.g. - IVR) on the nature of their request, and routing of the contact to the best available agent with the skills required for the contact and presents to the agent selected call information.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Customer Support Guiding -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#F.Customer Support Guiding">
