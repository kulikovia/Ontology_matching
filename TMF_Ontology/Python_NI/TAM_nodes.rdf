<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Business Value Development"/>
<TMF_v1:hasID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">721</TMF_v1:hasID>
<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2004</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Customer Order Rules Configuration Customer Order Rules Configuration function provides in addition to the Product rules, rules like cross/up sell rules, eligibility rules (i.e. we agree to make the requested Product available), address/service availability rules, etc. Some specific types of rules must be available for all decision-based actions on customer order. These rules could be: customer fraud check, priority rules, order duplication prevention rules, complex rules involving multi-system checks, etc.</rdf:label>
</owl:NamedIndividual>

