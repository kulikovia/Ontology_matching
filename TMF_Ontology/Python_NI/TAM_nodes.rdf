<TMF_v1:hasUID rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">2005</TMF_v1:hasUID>
<rdf:label rdf:datatype = "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString">Centralized Ordering Rules Management Centralized Ordering Rules Management provides centralized business rules for ordering (eligibility, compatibility).</rdf:label>
</owl:NamedIndividual>

