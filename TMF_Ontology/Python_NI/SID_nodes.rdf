</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkflowType -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkflowType">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#creationDate"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#subType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>WorkflowType Represents information that characterizes a workflow. Workflows can be typified by the way they are triggered (event-driven or rules-driven etc.), how they are structured (sequential, non-sequential, etc.), or based on specific objectives (decision control, data ingestion, etc.).</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Common Domain.Goal ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Common Domain.Goal ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Goal"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalApproach"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalDirection"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalInstrument"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalMetric"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalModel"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalPartyRole"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalSpecification"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalSpecificationRelationship"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalStrategy"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalTargetEntityType"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalTargetPartRole"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalType"/>
<rdf:label>Common Domain.Goal ABE Goal ABE represents a set of information that captures the definition of a goal or target for a process (task/activity/workflow/etc.) to reach or achieve. 
Goals trigger and guide behavior help to guide focus and enable sustain momentum. Goals are needed to give direction, identify whats important, measure progress towards success, foster motivation, assure accountability, and assert control. 
There is a distinction between Goal and Metric. This ABE is intended to reflect that distinction, as well as address the need for both. While a GOAL captures information about a target, a METRIC provides the yardstick or unit of measuring such achievement. Goal and Metric work hand-in-hand and each can be managed and modeled independently to bring flexibility to automation. The importance of this ABE is to capture the essence of dynamic goal setup and updates, which is key to enabler higher levels of goals management and goals management automation.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Goal -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Goal">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#creationDate"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#state"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>Goal Represents the information on a target a stakeholder wishes to achieve for a "process" (task/activity/workflow/closedloop etc.) theyd like to do or get done.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalApproach -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalApproach">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#creationDate"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>GoalApproach Represents the way in which a goal is to be achieved. For some complex goals, a goal can be recursively defined. E.g. Improve customer experience by increasing direct engagement calls to our corporate customers from sales reps in the closest proximity. The goalApproach in this regard is through salesReps with"close proximity"</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalDirection -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalDirection">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#creationDate"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#from"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#to"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>GoalDirection Represents the first and the last location of objects to be communicated. E.g. Send an alert to the customer. In this case, the Direction is towards the Customer and the Customer is the destination.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalInstrument -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GoalInstrument">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#creationDate"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>GoalInstrument Designates entities that act as instruments to which a goal is to be performed. E.g. Increase revenue of product-x via "offline shops". in this case Offline shops" in this case is a goalInstriument.</rdf:label>
</owl:NamedIndividual>

