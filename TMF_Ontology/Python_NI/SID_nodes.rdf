<rdf:label>SoftwareSpecConstraintRelationship The specfication of additional constraints to be defined for the related SoftwareResourceSpecifications.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SoftwareSpecRefinementRelationship -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SoftwareSpecRefinementRelationship">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#relationshipReason"/>
