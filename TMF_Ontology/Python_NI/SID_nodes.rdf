<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#rank"/>
<rdf:label>CompetitorIntelligenceMarketSegment A MarketSegment in which a Competitor makes ProductOfferings available.</rdf:label>
</owl:NamedIndividual>

