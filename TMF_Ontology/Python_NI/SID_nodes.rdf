<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>UsageRatingPLA PLA that rates ProductUsage events and generates type of AppliedCustomerBillingProductUsageRate</rdf:label>
</owl:NamedIndividual>

