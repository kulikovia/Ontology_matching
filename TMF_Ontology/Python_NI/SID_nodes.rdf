</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CompetitorProductCorrelation -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CompetitorProductCorrelation">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#degreeOfCorrelation"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#lifeCycleStage"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>CompetitorProductCorrelation A comparison or relationship between an enterprises ProductOffering with a Competitors ProductOfferings.  Information about the correlation may include MarketSegments.</rdf:label>
</owl:NamedIndividual>

