<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>ClosedLoopGoal Represents information that describes the target to be achieved by a closed loop along with all expected behavior and requirements to be fulfilled when the closed loop is ever instantiated. . Its an instance of Goal ABE with extensions particular for Closed Loops.</rdf:label>
</owl:NamedIndividual>

