<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PublicWLANAccessUsageEntry">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PublicWLANAccessUsageEntry </rdf:label>
</owl:NamedIndividual>

