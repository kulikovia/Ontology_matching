<rdf:label>LandUseType The kind of land use, such as the kinds of human uses of land.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#NetworkRoute -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#NetworkRoute">
