<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#quantity"/>
<rdf:label>AppliedPartyBillingProductCharge A charge applied to a product.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedPartyBillingProductUsageRate -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedPartyBillingProductUsageRate">
