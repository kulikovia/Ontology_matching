<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>AnomalyThresholdSet A threshold for an AnomalyIndicator used as a guiding value for initiating the Anomaly Management process</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ProductAnomaly -->

