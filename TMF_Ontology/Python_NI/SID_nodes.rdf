<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleProductOffering"/>
<rdf:label>Party Product Specification and Offering ABE.Party Role Product Offering ABE The Party Role Product Offering ABE represents the involvement parties playing roles have with ProductOfferings.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleProdOffRelationship -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleProdOffRelationship">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#partyRoleProdOffRelType"/>
