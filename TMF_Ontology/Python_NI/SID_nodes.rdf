<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PhysicalDevice -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PhysicalDevice">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
