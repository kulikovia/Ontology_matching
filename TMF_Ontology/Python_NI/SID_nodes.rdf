<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>SecurityThreatTool Organized and distributed software that can be used to attack</rdf:label>
</owl:NamedIndividual>

