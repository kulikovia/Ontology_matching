<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AnomalyThresholdRule -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AnomalyThresholdRule">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#conformanceComparatorLower"/>
