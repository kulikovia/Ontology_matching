<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#quantity"/>
<rdf:label>AppliedPartyBillingRate A charge or a credit assigned to the partys account in the course or for the purpose of the billing process. Subclasses further define these elements.</rdf:label>
</owl:NamedIndividual>

