<rdf:label>EmployeeIdentification A medium, such as a card or document, used to identify an employee.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#IndividualIdentification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#IndividualIdentification">
