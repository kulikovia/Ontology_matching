<rdf:label>AnomalyCategorySpecCharacteristic A characteristic quality or distinctive feature of a AnomalyCategorySpecification</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AnomalyCategorySpecCharacteristicValue -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AnomalyCategorySpecCharacteristicValue">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
