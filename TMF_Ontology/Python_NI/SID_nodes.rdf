<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ProjectDeliverableVersion -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ProjectDeliverableVersion">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ProjectDeliverableVersion A ProjectDeliverableVersion is the recorded version of a ProjectDeliverable</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ProjectDeliverable -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ProjectDeliverable">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>ProjectDeliverable A ProjectDeliverable is the agreed output of a project. A ProjectDeliverable enables Service-, Ressource- and ProductSpecifications or ProductOfferings.</rdf:label>
</owl:NamedIndividual>

