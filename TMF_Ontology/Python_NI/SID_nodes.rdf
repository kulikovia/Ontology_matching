<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#overall"/>
<rdf:label>SecurityIncidentOperationalImpactLevel Operational impact due to the security incident to confidentiality, integrity, avabaility, and overall</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SecurityIncidentRelatedParty -->

