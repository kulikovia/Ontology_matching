<rdf:label>IndividualIdentification Individual Identification represents our registration of information used as proof of identity by an Individual</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#NationalIdentityCardIdentification -->

