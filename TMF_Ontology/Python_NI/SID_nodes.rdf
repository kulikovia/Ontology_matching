<rdf:label>AppliedPartyBillingProductUsageRate A rated usage event typically produced by a rating engine.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedPartyBillingRate -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AppliedPartyBillingRate">
