<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#physicalCapacityStatus"/>
<rdf:label>PowerCapacity This is a concrete class that defines the type of power that a ManagedHardware instance can use, along with its minimum and maximum limits.</rdf:label>
</owl:NamedIndividual>

