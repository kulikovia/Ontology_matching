<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>P2PFileSharingSecurityThreatTool A peer-to-peer file sharing application or network used to perform a cyber attack</rdf:label>
</owl:NamedIndividual>

