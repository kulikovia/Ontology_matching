<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SocialSecurityNrIdentification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#SocialSecurityNrIdentification">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
