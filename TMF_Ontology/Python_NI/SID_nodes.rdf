<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#NumberPortInRequest"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#NumberPortOutRequest"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#NumberPortOverRequest"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#NumberRetirementRequest"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PortabilityRequestPolicyRule"/>
<rdf:label>Resource Order ABE.Resource Number Portability ABE The Resource Number Portability ABE contains entities grouped for the portability itself. This means all the processes involved, like Port In, Port Out, Port Over, and Retirement of numbers.</rdf:label>
