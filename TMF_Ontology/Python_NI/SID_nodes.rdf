<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>ServiceProviderEmployee A Service ProviderEmployee is an Individual who is employed by the Service Provider for wages or salary. This is modeled as an Individual playing the role of ServiceProviderEmployee . A ServiceProviderEmployee is a type of PartyRole.</rdf:label>
</owl:NamedIndividual>

