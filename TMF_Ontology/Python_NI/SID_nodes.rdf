<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicArea -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicArea">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#code"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#type"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#accuracy"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#geometry"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>GeographicArea This is a generic entity, used to represent areas defined on maps that relate to areas of settlement.This is an example of a concrete Geographic Location entity.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicLocation -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicLocation">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#accuracy"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#geometry"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>GeographicLocation A defined place on or near the earths surface. It is an abstract modeling concept that provides a linking point to other parts of the SID model.It holds attributes common to all Geographic Location subclasses.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicLocationName -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicLocationName">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#nameType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>GeographicLocationName A word, term, or phrase by which a Geographic Location is known and distinguished from other Geographic Locations. A name is an informal way of identifying an object [Fowler]Separating Location Name from Location allows for a Location to have many names at the same time and for names to change over time.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicLocationRelationship -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicLocationRelationship">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#interactionType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#role"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>GeographicLocationRelationship This association allows us to show direct relationships between Geographic Locations.This should be used with care to ensure that the association reflects reality</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicLocationType -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicLocationType">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#symbol"/>
<rdf:label>GeographicLocationType This is a simple specification entity used to provide a list of allowable geographic location types. These types correspond to the concrete entity names shown on fig 10a</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicPlace -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicPlace">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>GeographicPlace Allows us to determine where things are in relation to the earths surface.
It is an abstract modeling concept that provides a linking point to other parts of the SID model.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicPostcode -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#GeographicPostcode">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#code"/>
