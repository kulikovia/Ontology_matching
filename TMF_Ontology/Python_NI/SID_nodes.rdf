<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>SoftBlackBoxSpecification SoftBlackBoxSpec is a box with embedded software in it.</rdf:label>
</owl:NamedIndividual>

