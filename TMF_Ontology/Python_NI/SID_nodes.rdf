<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>SecurityThreatIndicator Activity that by itself isnt harmful, but indicates malicious activity (e.g., a DNS call to resolve a known name known to be bad)</rdf:label>
</owl:NamedIndividual>

