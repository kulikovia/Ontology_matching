<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ComplementaryProvider"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Regulator"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServiceProvider"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ServiceProviderEmployee"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ThirdPartyServiceProvider"/>
<rdf:label>Enterprise Domain.Enterprise Party Roles ABE Enterprise Party Roles ABE contains all PartyRoles related to the Enterprise such as Employee, Employer, Regulator...</rdf:label>
</owl:NamedIndividual>

