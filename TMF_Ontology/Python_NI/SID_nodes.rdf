<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>DriversLicenseIdentification A permit, such as one issued by a states motor vehicle bureau, that allows the holder to drive a motor vehicle on public roads.</rdf:label>
</owl:NamedIndividual>

