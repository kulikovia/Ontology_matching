<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Employee Pay ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Employee Pay ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#EmployeePay"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#EmployeePayComponent"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayComponentSpecification"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayGrade"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayGroup"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayRange"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayRollAgency"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PaySpecification"/>
<rdf:label>Workforce ABE.Employee Pay ABE The Employee Pay ABE provides the details of the Employee Pay and related components , Pay Group, Pay Range and Pay Grade which is the core structure for any organisations Pay Structure defined in the HCM system. Below diagram is the detailed view of the entities and their relationships.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#EmployeePay -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#EmployeePay">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#/amount"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#/amoutPeriod"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>EmployeePay EmployeePay describes pay information for an Employee such as salary, bonus or any other monetary benefits.

This is useful reading all changes over a period of time. This is further defined with the frequency amount pay group. </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#EmployeePayComponent -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#EmployeePayComponent">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#amount"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>EmployeePayComponent EmployeePayComponent is where an Employees components of pay is defined. Each section of their pay is defined as an individual line item and can have different frequencies or currencies.

This entity includes effective dated history.  Pay Component object stores all elements that are paid to employees like: base salary bonus target car allowance. 

For each pay component you need to define  
 If the component is recurring or a one time payment 
 If recurring the frequency 
 If it is paid as an absolute amount or percentage 
 If percentage what is it a percentage of (other Pay Component or Pay Component Group 
 If it is an earning or a deduction 
 If it is actual pay or target 
 If it is taxable or non-taxable 
 If it should be visible in Self Service 
 If it is used by compensation planning  Recurring pay components such as base salary should be defined with recurring attribute set to Yes and target attribute set to No. </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayComponentSpecification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayComponentSpecification">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#amount"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#amountPeriod"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#paymentFrequency"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PayComponentSpecification PayComponentSpecification specifies components of a pay that might correspond to fixed salary, bonus...

Some of them have fixed amount and other amount might not be pre-defined when it can be specific to an employee while respecting PayRange threshold (minimum and maximum pay).</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayGrade -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayGrade">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#paySaleType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#sequenceNumber"/>
<rdf:label>PayGrade A pay grade is a step that defines the amount of pay an employee will receive. The pay grade may or may not be defined by the level of the responsibilities performed within the job description of the position the authority exercised by the position and the length of time the employee has performed the job. This is generally associated with the Pay Range providing further details of the grades  steps and validity. </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayGroup -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayGroup">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#frequency"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<rdf:label>PayGroup Pay Group entity provides the capability to hold the information around the group of the employees/individuals which falls under the same category.

This is further extended with the agency which executes the payroll as well as the frequency of the payment. </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayRange -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayRange">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#amountPeriod"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#averagePay"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#maximumPay"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#minimumPay"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PayRange PayRange defines a pay range for Employees. It specifies minimum, average and maximum amounts in the range.

It provides information which is primarily used for the calculation of Compensation Ratio and Range Penetration. 

Usually Pay Range is linked to Pay Grade. 

By default Pay Range is defined by Geographical Zone, Pay Grade and Legal Entity.  e.g. Organisation may define the PayRange associated with specific PayGrade.  

PayGrade G-1 - Sequence-1 can have Max Pay 70KGBP  Avg Pay 60K GBP and Min Pay 50K GBP</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayRollAgency -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PayRollAgency">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PayRollAgency PayRollAgency is a PartyRole played by a Party being an equitable partner in a business interaction with other parties, playing the Agency involved in the PayRoll Execution for the Organisation. </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PaySpecification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PaySpecification">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PaySpecification PaySpecification specifies PayComponents that are part of a Pay in a PayRange. </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Work Specification ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Work Specification ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecFulfillmentRate"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecification"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationCost"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationRole"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationType"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationVersion"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecRelationship"/>
<rdf:label>Workforce ABE.Work Specification ABE The WorkSpecification specifies a kind of work that can be performed manually by a technician. Two key entities that comprise the WorkSpecification ABE are WorkSpecification and WorkSpecFulfillmentRate.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecFulfillmentRate -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecFulfillmentRate">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#consumptionCapacity"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#quantity"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#standardDrivingTime"/>
<rdf:label>WorkSpecFulfillmentRate Entity that is used in Planning and WorkSpecification configuration. Represents a rate that shows how many particular work tasks (quantity attribute) can be performed by a given organization in a given location (or serving areas) with a given capacity (Consumption Capacity attribute). For example, with 100 man hours of Fiber layout skills, 200 works of Dig a trench for Underground Cable, 200m length can be performed in an urban area by an organization.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecification">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isAppointmentRequired"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#standardCapacityRequired"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#standardDuration"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<rdf:label>WorkSpecification WorkSpecification describes the characteristics of a type of (manual) work. The characteristic/characteristic value pattern may be applied for WorkSpecification (and work as an instance). For example, WorkSpecification could be Assembly of server blade in a shelf.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationCost -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationCost">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#costToBusiness"/>
<rdf:label>WorkSpecificationCost A monetary amount assigned to a WorkSpecification that represents the cost to the business to plan, develop, and implement the WorkSpecification.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationRole -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationRole">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>WorkSpecificationRole This is an abstract base class that defines a WorkSpecification in terms of a set of roles which are then used to characterize the invariant functionality of the Work. For example, a specification of cable layout work can have the role of network build, or the role of a service fulfillment task.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationType -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationType">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#type"/>
<rdf:label>WorkSpecificationType A classification that groups WorkSpecifications that share common characteristics. For example, Equipment maintenance work type, or network trouble shooting type. This class can be used to present a Catalog of work specifications.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationVersion -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecificationVersion">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#date"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#number"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#type"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>WorkSpecificationVersion A particular form or variety of a WorkSpecification that is different from others or from the original. The form represents differences in properties that characterize a WorkSpecification that are not enough to justify the creation of a new WorkSpecification.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecRelationship -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSpecRelationship">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#type"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>WorkSpecRelationship This association class specifies the relationship between WorkSpecifications. For example, an equipment maintenance work task requires a service re-routing work task. Note: this Relationship will affect the Relationship between corresponding WorkItems, i.e. WorkOrderFulfillment (start-to-start, start-to-finish, etc.) in Project ABE, as well as the Scheduling mechanism.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Workforce Resource ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Workforce Resource ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeePool"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeePoolAssignment"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeeRole"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceOrganizationRole"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforcePoolAssignment"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourcePool"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourcePoolAssignment"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceRole"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceTool"/>
<rdf:label>Workforce ABE.Workforce Resource ABE WorkforceResource ABE represents the employees and other non-human resources involved in field operations.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeePool -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeePool">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isWfSupplierEmployeePool"/>
<rdf:label>WorkforceEmployeePool Represents an employee pool, as a set or group of employees available for assignment to work tasks. A WorkforceOrganizationRole can have many workforce pools, and vice versa, a pool can contain employees from more than one organization. Examples of a Pool are Fiber installation team, service repair team, etc. A Pool contains people/resources with particular skills, availability, location, other restrictions, and preferences. Pool is associated with Capacity. For example, a WorkForceEmpolyeePool shows that on July 1, from 8 am to 12 pm there are 100 man hours available with the skill of fiber layout for the New York area. A detailed model of the capacity of the pool down to timeslot, skill/work level is a subject for a future SID release.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeePoolAssignment -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeePoolAssignment">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#poolAssignmentRestriction"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>WorkforceEmployeePoolAssignment Represents an association class and defines specific characteristics for the assignment of an employee to a pool. For example, assignment of fiber technicians to the Installation and Repair team pools, serving the New York Area in the first quarter.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeeRole -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeeRole">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#skillLevel"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>WorkforceEmployeeRole This is a PartyRole that represents individuals who are involved in the workforce process as employees with particular skills. For example, Field Technician, Network Engineer, Supervisor, etc.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceOrganizationRole -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceOrganizationRole">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#organizationRoleName"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>WorkforceOrganizationRole This is a PartyRole that represents organizations involved in field operations. It can be the CSP Field Technician department itself, or a 3rd-party contractor company. Note that OrganizationRole has Calendar, inherited from Calendar of PartyRole.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforcePoolAssignment -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforcePoolAssignment">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#poolAssignmentRestriction"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>WorkforcePoolAssignment An abstract class representing assignment of an employee or other resource to a pool. An employee can be assigned to more than one pool. The attribute poolAssignmentRestriction is a place holder that represents any limitation of the assignment other than time period. Pool assignment will update available capacity WorkSchedule of some organization.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourcePool -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourcePool">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isWfSupplierResourcePool"/>
<rdf:label>WorkforceResourcePool Represents a resource pool as a set of resources (both physical and logical) available for assignment to work tasks. For example, the Dallas pool for fiber rollout for a weekday contains X number of trucks, Y number of test kits, etc.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourcePoolAssignment -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourcePoolAssignment">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#poolAssignmentRestriction"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>WorkforceResourcePoolAssignment Represents an association class and defines specific characteristics for the assignment of a resource to a pool. For example, assign a fiber test kit to the Dallas Pool for July.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceRole -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceRole">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#roleCombination"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#roleSelectionMethod"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>WorkforceResourceRole Defines the concept of various types of roles associated with WorkforceResources (both physical and logical). For example, tools (meter, ladder), Truck, GPS, Handheld, etc.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceTool -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceTool">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#roleCombination"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#roleSelectionMethod"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>WorkforceResourceTool An example class that represents the specific role of workforce resources. Examples are tester kits, GPS, Trucks, etc.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce Resource ABE.Work ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce Resource ABE.Work ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Work"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkRole"/>
<rdf:label>Workforce Resource ABE.Work ABE </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Work -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Work">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#quantity"/>
<rdf:label>Work The Work entity is used to record actual executed work, i.e. an instance of that entity is created for the actual work described by the WorkSpecification. If there are characteristics defined for the WorkSpecification, the work instance has a distinct value assigned for those characteristics. Instances of Work are associated to the WorkOrderItem. The quantity attribute can be used if the same work has been done more than once identically (based on the similar attribute in WorkOrderItem).</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkRole -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkRole">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>WorkRole This is an abstract base class that defines a Work task in terms of a set of roles which are then used to characterize the functionality of the Work. For example, a particular work of fiber rollout at a location at a certain date can play the role of a build task of an infrastructure project or the role of an installation task in a service fulfillment project.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Workforce Schedule ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Workforce ABE.Workforce Schedule ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeeAssignment"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeeReservation"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceAssignment"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceReservation"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSchedule"/>
<rdf:label>Workforce ABE.Workforce Schedule ABE The Workforce Schedule ABE defines reservation and assignment of a technician or resource to a task.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeeAssignment -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeeAssignment">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<rdf:label>WorkforceEmployeeAssignment Represents an assignment of a particular WorforceEmployeeRole for a particular work task in a specific timeframe. For example, assignment of a person in a network engineer role to a trouble shooting work task for at least 2 hours. The assignment is associated with a CalendarEntry of an Assignment WorkSchedule.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeeReservation -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceEmployeeReservation">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>WorkforceEmployeeReservation Represents an implementation of a request for reservation of work time in some human resource pool. It is also possible to reserve the work time of an individual employee. Note: the reservation, or booking according to appointment, is associated to Calendar Entry. The CalendarEntry here can belong to a reservation WorkSchedule. This Calendar entry may be floating. Once the Reservation becomes an Assignment (to be dispatched), a particular time slot (Calendar Entry) can be fixed in the WorkSchedule.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceAssignment -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceAssignment">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#actualCost"/>
<rdf:label>WorkforceResourceAssignment Represents an assignment of a particular resource for particular work in a specific timeframe. For example, assignment of a fiber test kit (or, additional example, a role of a test kit) to a fiber rollout work for a date.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceReservation -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkforceResourceReservation">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>WorkforceResourceReservation Represents an implementation of a request for the reservation of usage time in some resource pool (tools, trucks, materials, etc.). It is also possible to reserve usage time of a particular resource.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSchedule -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#WorkSchedule">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#granularity"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#calendricalSystem"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<rdf:label>WorkSchedule Being a subclass of SimpleCalendar, WorkSchedule and its variants describes various appointment, reservation, and assignment schedules of an organization. For example, a WorkSchedule shows that a contractor team responsible for the New York area has been receiving 100 requests for fiber installation during July and is currently scheduled to perform 80 of them.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Revenue Assurance ABE.RA Action_Response ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Revenue Assurance ABE.RA Action_Response ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAction"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceActionSpec"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceResponse"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceResponseSpec"/>
<rdf:label>Revenue Assurance ABE.RA Action_Response ABE A step towards developing a RevenueAssuranceResponse.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAction -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAction">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#activityNr"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#actualCost"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#actualDuration"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ACWP"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BCWP"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BCWS"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#currentDuration"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#plannedDuration"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#priority"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#scheduledDuration"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#timingConstraint"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#timingConstraintDate"/>
<rdf:label>RevenueAssuranceAction A step towards developing a RevenueAssuranceResponse.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceActionSpec -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceActionSpec">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#specVersionNr"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#unit"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#expectedDuration"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#type"/>
<rdf:label>RevenueAssuranceActionSpec The invariant characteristics of a RevenueAssuranceAction. Each related RevenueAssuranceAction instance will have the same invariant characteristics. However, the values associated with other characteristics of the instantiated RevenueAssuranceAction are specific to each instance.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceResponse -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceResponse">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#endDate"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#startDate"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<rdf:label>RevenueAssuranceResponse The result of reconciling a RATroubleTicket represented by a series of one or more activities being initiated and performed. The RAResponse can also determine the root cause for RATroubleTickets based on rules that trigger the analysis.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceResponseSpec -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceResponseSpec">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>RevenueAssuranceResponseSpec The invariant characteristics of a RevenueAssuranceResponse. Each related RevenueAssuranceResponse instance will have the same invariant characteristics. However, the values associated with other characteristics of the instantiated RevenueAssuranceResponse are specific to each instance.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Revenue Assurance ABE.RA Assessment ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Revenue Assurance ABE.RA Assessment ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAssessment"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAssessmentItem"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAssessmentResult"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceRecommendation"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceTrend"/>
<rdf:label>Revenue Assurance ABE.RA Assessment ABE A measure of the effectiveness of RAControls, RAObjectives, and RA KPIs. RAAssessment also includes recommendations for refining RAControls, RAObjectives, and RAKPIs.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAssessment -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAssessment">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dateComplete"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dateCreated"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dateStarted"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#raAssessmentType"/>
<rdf:label>RevenueAssuranceAssessment A measure of the effectiveness of RevenueAssuranceControls, RevenueAssuranceObjectives, and RevenueAssuranceKPIs. RevenueAssuranceAssessment include recommendations for refining RevenueAssuranceControls, RevenueAssuranceObjectives and RevenueAssuranceKPIs.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAssessmentItem -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAssessmentItem">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dateComplete"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dateStarted"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<rdf:label>RevenueAssuranceAssessmentItem The purpose of a RevenueAssuranceAssessment expressed in terms of one or more RevenueAssuranceParameters, RevenueAssuranceObjectives, RevenueAssuranceConsequences, RevenueAssuranceApplicability.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAssessmentResult -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceAssessmentResult">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dateCreated"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<rdf:label>RevenueAssuranceAssessmentResult The outcome of a RevenueAssuranceAssessment. The outcome may be a recommendation to refine a RevenueAssuranceParameter, a RevenueAssuranceObjective, RevenueAssuranceConsequence, RevenueAssuranceApplicability or the identification of a RevenueAssuranceTrend.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceRecommendation -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceRecommendation">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dateCreated"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<rdf:label>RevenueAssuranceRecommendation A type of RevenueAssuranceAssessmentResult that represents a suggestion to refine a RevenueAssuranceParameter, RevenueAssuranceObjective, Revenue AssuranceConsequence, or RevenueAssuranceApplicability.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceTrend -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceTrend">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dateCreated"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<rdf:label>RevenueAssuranceTrend A type of RevenueAssuranceAssessment Result that represents a general tendency, movement, or direction of a Revenue Assurance KPI or Revenue Assurance KPI. For example, a variance from week to week of the number of unbilled customers.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Revenue Assurance ABE.RA Control ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Revenue Assurance ABE.RA Control ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#RevenueAssuranceApplicability"/>
