<rdf:label>Product Offering ABE.Product Offering Price ABE The Product Offering Price ABE describes all the prices related to ProductOfferings.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ComponentProdOfferPrice -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ComponentProdOfferPrice">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
