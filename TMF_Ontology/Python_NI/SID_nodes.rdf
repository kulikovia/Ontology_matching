<rdf:label>OrganizationIdentification Organization Identification represents our registration of information used as proof of identity by an Organization</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyIdentification -->

