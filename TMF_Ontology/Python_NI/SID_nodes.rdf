<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#relationshipTypeCode"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>SoftwareSpecRefinementRelationship A specification for an association that defines divisions of a SoftwareResourceSpecification into two or more other specifications.  Or fusions of two or more specifications into a single specification.  Or one specification can be substituted for another.</rdf:label>
</owl:NamedIndividual>

