<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#producingApplicationId"/>
<rdf:label>AdhocMetricCollection A job for collecting MetricMeasures produced by another job to make available MetricMeasures for subscribers.</rdf:label>
</owl:NamedIndividual>

