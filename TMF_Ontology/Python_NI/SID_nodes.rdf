<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>RMONMethod This is an abstract base class for defining different types of RMON methods to perform various FCAPS functions.</rdf:label>
</owl:NamedIndividual>

