<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ConsequencePerformanceNotificationSpec -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ConsequencePerformanceNotificationSpec">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>ConsequencePerformanceNotificationSpec The invariant characteristics that define a communication (notification) that occurs as part of a PerformanceConsquence. A Notification is typically one-sided, in that no Response is expected. For example, an alarm may be raised as the result of a PerformanceThreshold being violated.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceNotificationSpecification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceNotificationSpecification">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PerformanceNotificationSpecification The invariant characteristics that define a communication (notification) that occurs as part of performance measurement. A Notification is typically one-sided, in that no Response is expected.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceIndicatorDerivationParameter -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceIndicatorDerivationParameter">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PerformanceIndicatorDerivationParameter A parameter used in the calculation of a PerformanceIndicator. A CharacteristicSpecification can be used as a parameter or another PerformanceIndicatorSpecification can be used.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceIndicatorSpecRelationship -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceIndicatorSpecRelationship">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#relationshipType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PerformanceIndicatorSpecRelationship An association between two PerformanceIndicatorSpecifications, such as one indicator derived from another.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceSpecIntervalConversion -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceSpecIntervalConversion">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#conversionFactor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PerformanceSpecIntervalConversion The conversion factor that defines how many instances of one PerformanceSpecificationIntervals are contained in the related PerformanceSpecificationInterval.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceIndicatorSpecification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceIndicatorSpecification">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#collectionType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#derivationAlgorithm"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#derivationMethod"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#indicatorCategory"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#indicatorType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#indicatorUnit"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#perspective"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PerformanceIndicatorSpecification A measure of a specific aspect of the performance of an entity, such as a lost packets or average jitter, defined for a PeformanceSpecification that may trigger the creation of a PerformanceConsequence.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceSpecification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceSpecification">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PerformanceSpecification The invariant characteristics that define a measure that deterimines how a Service and/or Resource is functioning. Each related Performance instance will have the same invariant characteristics. However, the values associated with other characteristics of the instantiated Performance entity are specific to each instance.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Performance ABE.Performance Category ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Performance ABE.Performance Category ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCatCharacteristicValue"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCategory"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCategoryRelationship"/>
<rdf:label>Performance ABE.Performance Category ABE </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCatCharacteristicValue -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCatCharacteristicValue">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#value"/>
<rdf:label>PerformanceCatCharacteristicValue A value of a CharacteristicSpecification provided for PerformanceCategory that further defines what the PerformanceCategory is.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCategory -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCategory">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PerformanceCategory A group or set of performance qualities that are classified together because of common characteristics.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCategoryRelationship -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCategoryRelationship">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#relationshipType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PerformanceCategoryRelationship An association between two instances of PerformanceCategories. For example, a relationship between a Codec instance and BearerType instance.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Performance Category ABE.Performance Category Specification ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Performance Category ABE.Performance Category Specification ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCatSpecification"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCatSpecRelationship"/>
<rdf:label>Performance Category ABE.Performance Category Specification ABE </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCatSpecification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCatSpecification">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PerformanceCatSpecification The invariant characteristics that define a group or set of performance qualities that are classified together because of common characteristics.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCatSpecRelationship -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PerformanceCatSpecRelationship">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#numberRelCatLowerLimit"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#numberRelCatUpperLimit"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#relationshipType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PerformanceCatSpecRelationship A specification for an association that can be established between two instances of PerformanceCategories. For example, a relationship can be established between a Codec instance and BearerType instance.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party Privacy ABE.Party Privacy Profile ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party Privacy ABE.Party Privacy Profile ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyAgreement"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfile"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileCharValue"/>
<rdf:label>Party Privacy ABE.Party Privacy Profile ABE The Party Privacy Profile ABE contains all entities used by the Party Privacy Management process for specifying the choices made by Parties for their own Privacy.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyAgreement -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyAgreement">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#documentNumber"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#statementOfIntent"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#type"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#endDate"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#startDate"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<rdf:label>PartyPrivacyAgreement A PartyPrivacyAgreement is a type of Agreement. It enables tracking the approval made by the Party either globally for a PartyPrivacyProfile or just for a specific PartyPrivacyProfileCharValue.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfile -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfile">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dateCreated"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PartyPrivacyProfile A PartyPrivacyProfile corresponds of the instantiation of a PartyPrivacyProfileType agreed by a PartyRole.
The PartyPrivacyProfile is described by the Privacy choices made by the Party (related PartyPrivacyProfileCharValue).</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileCharValue -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileCharValue">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#value"/>
<rdf:label>PartyPrivacyProfileCharValue Each PartyPrivacyProfileCharValue instantiates a PartyPrivacyProfileTypeCharValue and specifies the chosen value.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party Privacy ABE.Party Privacy Profile Type ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party Privacy ABE.Party Privacy Profile Type ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileType"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileTypeCharacteristic"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileTypeCharValue"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PrivacyCategory"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PrivacyUsagePurpose"/>
<rdf:label>Party Privacy ABE.Party Privacy Profile Type ABE The Party Privacy Profile ABE contains all entities used by the Party Privacy Management process for specifying 
   - the information concerned by Privacy rules,
   - the Privacy rules themselves.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileType -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileType">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#category"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PartyPrivacyProfileType A PartyPrivacyProfileType is a type of PartyProfileType.
A PartyPrivacyProfileType specifies for a Party playing a type of PartyRole (PartyRoleSpecification) such as Customer or User and possibly restricted to a context such as a set of ProductOfferings, all the available options that the Party may choose for each information concerned by the Privacy.
A PartyPrivacyProfileType may specify Privacy for several information using PartyPrivacyProfileTypeCharacteristic.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileTypeCharacteristic -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileTypeCharacteristic">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#criticalityLevel"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#derivationFormula"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#extensible"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#maxCardinality"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#minCardinality"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#privacyType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#unique"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#valueType"/>
<rdf:label>PartyPrivacyProfileTypeCharacteristic Each PartyPrivacyProfileTypeCharacteristic specifies:
 the information concerned by the Privacy (CharacteristicSpecification via RootEntityTypeCharUse),
 and the corresponding Privacy rule (i.e. available choices for the party) using PartyPrivacyProfileTypeCharValue.
A PartyPrivacyProfileTypeCharacteristic has a privacyType such as Internal Purpose, External Purpose, Internal Retention or External Retention.
If the privacyType is Internal Purpose or External Purpose, then the PartyPrivacyProfileTypeCharacteristic specifies the usage purpose of the information concerned by the privacy such as Administration, Marketing, Research
Each PartyPrivacyProfileTypeCharacteristic is categorized by a PrivacyCategory for helping Graphical User Interface (GUI) to have a nice presentation for Privacy viewing and configuration.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileTypeCharValue -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyPrivacyProfileTypeCharValue">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#fromValue"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isDefault"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#rangeInterval"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#toValue"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#unitOfMeasure"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validityDuration"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#value"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#valueType"/>
<rdf:label>PartyPrivacyProfileTypeCharValue A PartyPrivacyProfileTypeCharValue specifies a confuguration that can be chosen for an information in a Privacy context.
For example, the usage of an information might Authorized or Unauthorized.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PrivacyCategory -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PrivacyCategory">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PrivacyCategory A PrivacyCategory specifies a category grouping PartyPrivacyProfileTypeCharacteristic for helping Graphical User Interface (GUI) to have a nice presentation for Privacy viewing and configuration.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PrivacyUsagePurpose -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PrivacyUsagePurpose">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PrivacyUsagePurpose A PrivacyUsagePurpose corresponds to a type of usage of an information concerned by Privacy such as Administration, Marketing, Research, Information,...</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Common Domain.Party ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Common Domain.Party ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleAssociation"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PlacePartyRoleAssoc"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyCreditProfileReference"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyCreditProfile"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AdditionalPartyAttributes"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TaxExemptionCertificate"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleCurrency"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Logo"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyName"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#OrganizationName"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Organization"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LanguageAbility"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Language"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#IndividualName"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Individual"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRole"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleSpecification"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleCategory"/>
<rdf:label>Common Domain.Party ABE A Party represents an individual, an organization, or an organization unit that are of interest, involved or that provide value directly or indirectly from an enterprise perspective (Enterprise is to be understood here as provider, service provider or operator). 
Hence the Party plays one or more roles with the enterprise or with another Party playing a role with the enterprise (indirectly). This is introduced to specify that the only party an enterprise would be interested in and will consider in its systems is a party playing a role (directly or indirectly). 
Roles would be represented by the PartyRole concept. Additional roles will be defined to cover the needs of the new digital ecosystem."
Examples of roles played by Parties include those:
Of interest, such as competitors, sales prospects
Involved, such as customers, users, employees
That provides value directly or indirectly, such as service providers, operators, cloud brokers, infrastructure providers, application developers.
This Party ABE defines information about companies and people. Implementations of this model are responsible for ensuring that the relevant privacy legislation standards are adhered to in the countries that will use the implementation.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleAssociation -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleAssociation">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#associationType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PartyRoleAssociation Allows PartyRoles to be associated.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PlacePartyRoleAssoc -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PlacePartyRoleAssoc">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#placeRole"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#relativeModifier"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PlacePartyRoleAssoc This is an example of an association linking Place to another part of the SID model.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyCreditProfileReference -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyCreditProfileReference">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#financialInstitutionAccountType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#financialInstitutionAccoutNumber"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#financialInstitutionName"/>
<rdf:label>PartyCreditProfileReference A source of information that helps define a Partys credit worthiness.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyCreditProfile -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyCreditProfile">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#creditRiskRating"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#creditScore"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#effectiveDate"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PartyCreditProfile An outline of a Partys credit worthiness.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AdditionalPartyAttributes -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AdditionalPartyAttributes">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#partyRank"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#partyStatus"/>
<rdf:label>AdditionalPartyAttributes A person or organization that buys products and services from the enterprise or receives free offers or services. This is modeled as a Party playing the role of Party. A Party is a type of PartyRole. Partys can also be other service providers who resell the enterprises products, other service providers that lease the enterprises resources for utilization by the other service providers products and services, and so forth.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TaxExemptionCertificate -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#TaxExemptionCertificate">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>TaxExemptionCertificate The certificate describing an exemption from tax (partial or complete) granted for a party and/or a place. 
Examples include:
    - Party-based
 - Individual might be exempt due to health or other personal situation
 - Organization might be exempt due to its business (e.g. a charity, or government)
    - Location-based
 - A City might have a global exemption from purchase tax</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleCurrency -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleCurrency">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isDefault"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#precision"/>
<rdf:label>PartyRoleCurrency Represents the currency that PartyRole may use.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Logo -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Logo">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#logo"/>
<rdf:label>Logo Logo of Organization.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyName -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyName">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PartyName A word, term, or phrase by which a party (individual or organization) is known and distinguished from other parties.A name is an informal way of identifying an object [Fowler].PartyName is an abstract concept that should be used in places where the business refers to an organization name, organization unit name or individual name</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>Party Represents an  individual, organization or organization unit.Party is an abstract concept that should be used in places where the business says something can be an organization , organization unit or an individual</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#OrganizationName -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#OrganizationName">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#nameType"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#tradingName"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>OrganizationName A word, term, or phrase by which an organization is known and distinguished from other organizations.A name is an informal way of identifying an object [Fowler]An OrganizationName is a type of PartyName.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Organization -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Organization">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isLegalEntity"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#legalPeriod"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#type"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>Organization A group of people identified by shared interests or purpose. Examples include business, department, enterprise. Because of the complex nature of many businesses, both organizations and organization units are represented by the same business entity in this model. An Organization is a type of Party.
An Organization might  be composite or atomic.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LanguageAbility -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#LanguageAbility">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#listeningProficiency"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#readingProficiency"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#speakingProficiency"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#writingProficiency"/>
<rdf:label>LanguageAbility Represents the ability of a Party to understand or converse in a Language</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Language -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Language">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#alphabetName"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#dialectNames"/>
<rdf:label>Language Represents a spoken and/or written language.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#IndividualName -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#IndividualName">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#aristocraticTitle"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#familyGeneration"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#familyNamePrefix"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#familyNames"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#formattedName"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#formOfAddress"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#generation"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#givenNames"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#legalName"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#middleNames"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#preferredGivenName"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#qualifications"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>IndividualName A word, term, or phrase by which an individual is known and distinguished from other individuals.A name is an informal way of identifying an object [Fowler]This entity allows for international naming variations. An IndividualName is a type of PartyName.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Individual -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Individual">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#aliveDuring"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#disabilities"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#gender"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#maritalStatus"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#nationality"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#placeOfBirth"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#skills"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>Individual Represents a single human being (a man, woman or child).
The individual could be a customer, an employee or any other person that the organization needs to store information about. An Individual is a type of Party.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRole -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRole">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PartyRole The part played by a party in a given con text with any characteristics, such as expected pattern of behavior, attributes, and/or associations that it entails. PartyRole should be used in places where the business refers to a Party playing a Role.  </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleSpecification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleSpecification">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PartyRoleSpecification The definition of a role a party may play. this is entityone Task </rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleCategory -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleCategory">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PartyRoleCategory This is an entity that can be used to provide simple grouping or categorization of PartyRoles. In some cases this is done in a more specific manner (e.g. Customer demographics).</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party ABE.Permission ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party ABE.Permission ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ExplicitPermission"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ImplicitPermission"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ImplicitPermissionSpec"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Permission"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScope"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopePolicyRule"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopeSpec"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopeSpecPolicyRuleSpec"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionSet"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionSpecSet"/>
<rdf:label>Party ABE.Permission ABE Pemission ABE contains all Business Entities for describing Permission Specifications, effective Permissions granted including the scope of permissions.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ExplicitPermission -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ExplicitPermission">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>ExplicitPermission A Party playing a role may delegate all or part of his permissions to another Party through ExplicitPermission.
ExplicitPermission is a type of Permission.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ImplicitPermission -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ImplicitPermission">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>ImplicitPermission An ImplicitPermission is a type of Permission and describes permissions granted to a PartyRole according to an ImplicitPermissionSpec.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ImplicitPermissionSpec -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ImplicitPermissionSpec">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>ImplicitPermissionSpec ImplicitPermissionSpec defines one or many actions allowed on a type of Entity (RootEntityType).</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Permission -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Permission">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>Permission Permission represents permissions granted to a PartyRole that might be either implicit (ImplicitPermission) or explicit through delegation (ExplicitPermission).</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScope -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScope">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PermissionScope PermissionScope specifies for each criteria the value(s) for the Permission if different values are possible in the PermissionScopeSpec.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopePolicyRule -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopePolicyRule">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasSubRules"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isCNF"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isMandatoryEvaluation"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#usage"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#keywords"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#policyName"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PermissionScopePolicyRule PermissionScopePolicyRule is used for describing PermissionScope criterias and the value(s) that limit the scope of permission.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopeSpec -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopeSpec">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<rdf:label>PermissionScopeSpec PermissionScopeSpec defines through PermissionScopeSpecPolicyRuleSpec criteria that might be used to define the scope such as market segment, geographic area, time
To describe these criteria that might be complex a PermissionScopeSpec might be managed by one or many PolicyRuleSpec (PermissionScopeSpecPolicyRuleSpec).</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopeSpecPolicyRuleSpec -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionScopeSpecPolicyRuleSpec">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#executionStrategy"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#policyActionSelectCriteria"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#policyConditionSelectCriteria"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#policyEventSelectCriteria"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#sequencedActions"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#decisionStrategy"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PermissionScopeSpecPolicyRuleSpec PermissionScopeSpecPolicyRuleSpec is used for describing PermissionScopeSpec criterias and the possible values.
To describe these criteria that might be complex a PermissionScopeSpec might be managed by one or many PermissionScopeSpecPolicyRuleSpec.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionSet -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionSet">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PermissionSet Each PermissionSet may refer to a PermissionSpecSet if it corresponds to applying permissions specified for a PartyRoleSpecification. If PermissionSet corresponds to permissions granted by another PartyRole it has no relationship with a PermissionSpecSet.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionSpecSet -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PermissionSpecSet">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PermissionSpecSet PermissionSpecSet specifies a set of permissions that might concern one or many PartyRoleSpecifications. A PermissionSpecSet contains one or many ImplicitPermissionSpec.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party ABE.Party Role Group ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party ABE.Party Role Group ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleGroup"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleGroupSpecification"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecClub"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecFamily"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecFriends"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecRule"/>
<rdf:label>Party ABE.Party Role Group ABE Party Role Group ABE contains all Business Entities used to specify PartyRoleGroups.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleGroup -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleGroup">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PartyRoleGroup Parties may play PartyRoles in a specific context. This context is represented by a PartyRoleGroup that groups PartyRoles. A PartyRoleGroup might be a Family, a Club, a Friends group...
A PartyRoleGroup may or may not represent an Organization that has a legal standing or not, meaning they may not have a formal means to identify them (think Facebook groups).
A PartyRoleGroup is described by a unique PartyRoleGroupSpecification.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleGroupSpecification -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PartyRoleGroupSpecification">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PartyRoleGroupSpecification A PartyRoleGroupSpecification specifies for a type of PartyRoleGroup, the applicable rules for the creation of a PartyRoleGroup:
- the type of PartyRole (PartyRoleSpecification) that might be part of a corresponding PartyRoleGroup,
- rules (PRGSpecRule) applying for the Party being part of the PartyRoleGroup through their PartyRole such as "all Parties must live at the same location to be considered as member of the same Family"
The type of PartyRoleGroupSpecification might be a Family, a Club, a group of Friends... 
- A family can include a number of Individuals. The individuals are part of this family (PartyRoleGroup) via PartyRoles such as father, mother, son, and daughter
- Individuals can also be part of PartyRoleGroups such as a Bridge Club, with PartyRoles such as Member, Chairman/Chairwoman, Treasurer, etc.  
A PartyRoleGroupSpecification may describe one or many PartyRoleGroups.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecClub -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecClub">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PRGSpecClub A PRGSpecClub is a type of PartyRoleGroupSpecification specifying rules applying for being member of a Club.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecFamily -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecFamily">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PRGSpecFamily A PRGSpecFamily is a type of PartyRoleGroupSpecification specifying rules applying for being part of a Family.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecFriends -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecFriends">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>PRGSpecFriends A PRGSpecFriends is a type of PartyRoleGroupSpecification specifying rules applying for being member of a Friends Group.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecRule -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#PRGSpecRule">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#hasSubRules"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isCNF"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isMandatoryEvaluation"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#usage"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#keywords"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#policyName"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>PRGSpecRule A PRGSpecRule is a type of PolicyRule specifying rules that have to be checked up to allow a PartyRole to be part of a PartyRoleGroup. For example, "all Parties must live at the same location to be considered as member of the same Family".</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party ABE.Currency ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party ABE.Currency ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Currency"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyExchangeRate"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyName"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyUnit"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyUnitName"/>
<rdf:label>Party ABE.Currency ABE Groups main entities within currency model.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Currency -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Currency">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#code"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#symbol"/>
<rdf:label>Currency Represent the currency in reality. Currency uses 1 or more CurrencyUnits. For example, Currency (code=CNY, symbol= YEN) use three CurrencyUnits (Yuan, Jiao, Fen). Currency is associated to CurrencyExchangeRate with CurrencyUsedAsSource and CurrencyUsedAsDestination. Currency can be used in different Countrys.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyExchangeRate -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyExchangeRate">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#status"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#value"/>
<rdf:label>CurrencyExchangeRate Exchange rate between currencies.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyName -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyName">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>CurrencyName Name of a currency. Under different  languages, a currency has differnent names,  e.g. Renminbi Yuan in English and in Chinese to express the same Chinese currency.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyUnit -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyUnit">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isMinUnit"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isStdUnit"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#rate"/>
<rdf:label>CurrencyUnit Measurement unit of a currency. For CurrencyUnitName Yuan associated to Chinese, rate =1, isStdUnit = True, isMinUnit = False.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyUnitName -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CurrencyUnitName">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>CurrencyUnitName Name of a currency unit. Under different  languages, a currency unit has differnent names,  e.g. Yuan in English and in Chinese to express the same basic currency unit in Chinese currency.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party ABE.Party Organization ABE -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Party ABE.Party Organization ABE">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ABE"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AtomicOrganization"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CompositeOrganization"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#OrganizationDecompositionComponent"/>
<TMF_v1:hasBE rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#OrganizationDecompositionType"/>
<rdf:label>Party ABE.Party Organization ABE Used to model Party Organization.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AtomicOrganization -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AtomicOrganization">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isLegalEntity"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#legalPeriod"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#type"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>AtomicOrganization AtomicOrganization is a type of Organization that does not have any subordinate Organization. That is, an AtomicOrganization  is a leaf-level Organization.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CompositeOrganization -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#CompositeOrganization">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#isLegalEntity"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#legalPeriod"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#type"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>CompositeOrganization CompositeOrganizaiton is a type of Organization that is formed by aggregating other Organizations, which may be atomic or composite Organizations.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#OrganizationDecompositionComponent -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#OrganizationDecompositionComponent">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#validFor"/>
<rdf:label>OrganizationDecompositionComponent The OrganizationDecompositionComponent specifies the valid period for the relationship between CompositeOrganization and Organization and relates to the OrganizationDecompositionType.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#OrganizationDecompositionType -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#OrganizationDecompositionType">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>OrganizationDecompositionType OrganizationDecompositionType describes and specifies certain type of organization decomposition such as geographical, hierarchical, financial.</rdf:label>
</owl:NamedIndividual>

