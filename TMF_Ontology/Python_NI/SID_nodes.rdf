<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AnomalyGrouping -->

<owl:NamedIndividual rdf:about="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#AnomalyGrouping">
<rdf:type rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#BE"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#description"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#ID"/>
<TMF_v1:hasAttribute rdf:resource="http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#name"/>
<rdf:label>AnomalyGrouping Represents the grouping of the Anomaly based on a particular need. For example, if the Anomaly need to be grouped based on a set of network nodes in a network topology or particular infrastructure deployment (rack/slot). AnomalyGrouping defines additional criteria for grouping the Anomaly management logic rather than limiting to individual entities. The grouping criteria are defined using AnomlayGroupingSpecification.</rdf:label>
</owl:NamedIndividual>

