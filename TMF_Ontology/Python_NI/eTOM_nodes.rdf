<TMF_v1:BriefDescription>Monitor Customer Order Delivery business activity checks and tracks customer order delivery activities with status reporting.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
