<TMF_v1:BriefDescription>Assess the risks and the competitive positioning of the product offering proposal.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
