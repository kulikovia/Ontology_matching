<rdf:label>Maintain Resource Catalog Content Version Maintain Resource Catalog Content Version business activity handles tracking and controlling changes for Resource catalog entries.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Maintain Resource Catalog Content Relationship -->

