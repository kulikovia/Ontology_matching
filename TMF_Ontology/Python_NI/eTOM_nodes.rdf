<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Analyze Service Capacity -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Analyze Service Capacity">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Service Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Capability Management"/>
<TMF_v1:BriefDescription>Analyze Service Capacity business activity establishes, and models insights, patterns and changes to service capacity, by assessing potential capacity needs, and actual capacity that a service currently achieves.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.4.12.6</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Analyze Service Capacity Analyze Service Capacity business activity establishes, and models insights, patterns and changes to service capacity, by assessing potential capacity needs, and actual capacity that a service currently achieves.
This business activity covers collection of service-related data (usage data, performance data, operational data etc.) to support Service Management manager to identify patterns and insights relating to a Service.

Analyze Service Capacity supports Service Capacity Management by providing relevant and timely insights, including available capability, service "time and material" needs, etc. and how capacity utilization (allocated, in-use, unused) can be optimized to increase business value.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Assess Available Service Capacity -->

