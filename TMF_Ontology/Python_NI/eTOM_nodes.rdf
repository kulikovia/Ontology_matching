<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Identify logistics for new resource capability introduction -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Identify logistics for new resource capability introduction">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
