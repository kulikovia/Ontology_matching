<TMF_v1:BriefDescription>Schedule Product Order Shipment business activity is responsible for supporting the product order delivery by providing schedule</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
