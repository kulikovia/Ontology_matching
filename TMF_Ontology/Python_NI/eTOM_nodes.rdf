<TMF_v1:BriefDescription>responsible for continuously monitoring the status of service orders; record, analyze and assess the service order status changes</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
