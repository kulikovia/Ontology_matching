<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Monitor Interaction Status -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Monitor Interaction Status">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Business Partner Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Manages the status of the ongoing interactions and is able to provide status information at any moment in which the request is active</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.0.7.10.5.2</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.6.9.4.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Monitor Interaction Status The purpose of this process is to  monitor the status of a Party interaction. These processes analyze and assess the Party interaction status changes to initiate notifications or reports.</rdf:label>
</owl:NamedIndividual>

