<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG."/>
<TMF_v1:BriefDescription>Collect Enterprise Performance Assessment Data business activity is responsible for gathering all data and information need to successfully support evaluating enterprise performance.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.7.13.7.3</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Collect Enterprise Performance Assessment Data Collect Enterprise Performance Assessment Data business activity is responsible for gathering all data and information need to successfully support evaluating enterprise performance.
This business activity will also include cleaning, storing, preparing and sharing enterprise performance assessment data.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Evaluate Enterprise Performance -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Evaluate Enterprise Performance">
