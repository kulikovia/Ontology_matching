<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.6.20.3.3</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Update Business Partner Bill Inquiry Status to Resolved Update Business Partner Bill Inquiry Status to Resolved updates the Business Partner bill inquiry status to resolved and informs the Close Business Partner Bill Inquiry process that a Business Partner bill inquiry/complaint issues have been resolved.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Business Partner Bill Inquiry -->

