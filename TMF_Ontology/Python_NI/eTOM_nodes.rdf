<TMF_v1:BriefDescription>Mange Project business activity is in charge of directing and controlling all responsibilities for activities involved in executing, reporting and closing projects according to program goals.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
