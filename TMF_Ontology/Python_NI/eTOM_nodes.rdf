<TMF_v1:BriefDescription>Manage Capital Financing business activity directs and controls the methods the corporate business uses to raise money.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
