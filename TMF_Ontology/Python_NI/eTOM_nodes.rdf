<rdf:label>Manage Information & Data Retention Manage Information & Data Retention business activity direct and control  that define the policies of persistent information and data for meeting enterprise and/or statutory archival requirements.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Information & Data Disposal -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Information & Data Disposal">
