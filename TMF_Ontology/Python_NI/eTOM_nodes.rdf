<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Deliver Marketing Communication Collateral -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Deliver Marketing Communication Collateral">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Market & Sales Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Fulfillment"/>
<TMF_v1:BriefDescription>Manage and co-ordinate the delivery of a marketing communication to the selected channels.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.1.14.4</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Deliver Marketing Communication Collateral Deliver Marketing Communication manages and co-ordinates the delivery of the communications to the selected channels. It ensures that the channels (owned and/or contracted) are adequately trained and/or informed to manage the message and/or campaign delivery, and that sufficient resources are available in the selected channel(s) to support the delivery.

Note that the actual contractual relationship with the supplier may be established by interacting with Engaged Party domain processes, such as Party Sourcing Management and Party Agreement Management.</rdf:label>
</owl:NamedIndividual>

