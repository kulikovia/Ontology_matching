<TMF_v1:ProcessIdentifier>1.5.17.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Manage Resource Catalog Access Manage Resource Catalog Access business activity handles access to the catalog according to the Catalog Content Management standards and policies.
Manage Resource Catalog Access will handle assigning catalog managers and granting privileges.</rdf:label>
</owl:NamedIndividual>

