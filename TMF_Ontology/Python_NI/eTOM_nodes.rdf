<TMF_v1:BriefDescription>Manage Enterprise Performance Goal Setting business activity is in charge of setting all enterprise performance goals.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
