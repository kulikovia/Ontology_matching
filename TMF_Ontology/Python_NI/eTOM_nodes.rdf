<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Resource Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Strategy Management"/>
<TMF_v1:BriefDescription>Develop and deliver quarterly, annual and multi-year resource plans, negotiations, approvals , resource development and management</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.2.3.1.5.1</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.1.5.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Develop & Deliver quarterly/annual/multi year resource business plans Develop & Deliver quarterly /annual/multi year resource business plans focus on developing and delivering  quarterly, annual and multi-year resource plans in support of  services, products and offers that include volume forecasts, negotiation for required levels of resources and budgets, gaining resource  development and management as well as supply chain commitment and executive approval for the plans.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Forecast high level resource demand & capture new opportunities -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Forecast high level resource demand & capture new opportunities">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Resource Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Strategy Management"/>
<TMF_v1:BriefDescription>Forecast resource demand and capture new opportunities for future needs of new/existing customers</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.2.3.1.5.2</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.1.5.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Forecast high level resource demand & capture new opportunities Forecast Resource demand & capture new opportunities  processes ensures that budgets are assigned which allow  the enterprise to implement the resource capabilities and capacity necessary for the future needs of their customers and potential customers. This may use AI techniques to simulate different scenarios for more accurate predictions.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Asses impact of Resource Business plans -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Asses impact of Resource Business plans">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
