<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Organize Resource Catalog Content Entry -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Organize Resource Catalog Content Entry">
