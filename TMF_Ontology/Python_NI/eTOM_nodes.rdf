<TMF_v1:BriefDescription>Authorize Product Order Return business activity is responsible for permitting a product order reverse order to be processed.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
