<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Product Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Undertaking proactive monitoring regimes of groups of similar purchased product offerings as required to ensure ongoing performance within agreed parameters over time.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.2.6.10</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Establish Product Performance Goals Undertaking proactive monitoring regimes of groups of similar purchased product offerings as required to ensure ongoing performance within agreed parameters over time.</rdf:label>
</owl:NamedIndividual>

