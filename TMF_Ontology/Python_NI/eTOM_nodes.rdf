<TMF_v1:ProcessIdentifier>1.4.1.3.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Develop Service Strategy Develop Service Strategy processes accept the changing service requirements and develop appropriate service strategies based on the changing needs of enterprise, and increasing expectations of  the markets. The service strategy is documented.</rdf:label>
</owl:NamedIndividual>

