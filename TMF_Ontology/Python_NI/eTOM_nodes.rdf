<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Business Partner Orders -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Business Partner Orders">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Business Partner Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Fulfillment"/>
<TMF_v1:BriefDescription>Processes ensure Business Partner orders are being processed and delivered efficiently and effectively.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.0.7.6.3.4</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.6.8.3.4</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Manage Business Partner Orders Manage Business Partner Orders processes manages orders to ensure they are being processed and delivered efficiently and effectively. These processes also manage notifications or requests from parties regarding forced or requested changes to the order or delivery schedule. These change requests may be caused by the Business Partner or may be outside their control. Change requests are provided to the originating  process(es) where a resolution is agreed.</rdf:label>
</owl:NamedIndividual>

