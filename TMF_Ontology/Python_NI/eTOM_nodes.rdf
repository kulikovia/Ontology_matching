<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Administer Commercial Arrangement for Third Party Supplier -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Administer Commercial Arrangement for Third Party Supplier">
