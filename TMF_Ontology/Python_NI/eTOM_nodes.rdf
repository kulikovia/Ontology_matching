<TMF_v1:BriefDescription>Analyze Change business activity examine changes planned based on enterprise needs, risks and benefits.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
