<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.2.2.1.1.1</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.4.1.1.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Gather Service Information Gather Service information processes  focus on establishment  and Management of relationships with external providers of service information, and management of internal resources used for providing service information.</rdf:label>
</owl:NamedIndividual>

