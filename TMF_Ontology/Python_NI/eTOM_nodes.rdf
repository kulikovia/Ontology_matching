<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">5</TMF_v1:ProcessLevel>
<rdf:label>Receive Returned Product Order Receive Returned Product Order business activity is responsible for accepting and processing the product order return.   

Receive Returned Product Order ensures that product order returns are compliant with product order return policies.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Close Product Order Return -->

