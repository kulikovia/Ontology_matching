<TMF_v1:ProcessIdentifier>1.1.21.2.2.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">5</TMF_v1:ProcessLevel>
<rdf:label>Prioritize Sales Problem Prioritize Sales Problem business activity is in charge of organizing Sales Problems by order of business established conditions or attributes.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Collect Sales Problem Information -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Collect Sales Problem Information">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Market & Sales Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Collect Sales Problem Information business activity is in charge of gathering all information/data that relate or apply to a defined sales problem.</TMF_v1:BriefDescription>
