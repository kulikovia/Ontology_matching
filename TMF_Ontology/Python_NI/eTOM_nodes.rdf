<TMF_v1:BriefDescription>Send a request to an external Business Partner asking for their support in assessing a Business Partner problem.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
