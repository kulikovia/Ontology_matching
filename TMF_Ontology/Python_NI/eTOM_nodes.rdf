<TMF_v1:BriefDescription>Develop an overall service solution design for a particular customer, including customer premises equipment, operational methods, resource assignments and pre-order feasibility;</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.2.2.1.1</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.4.5.1.1</TMF_v1:ProcessIdentifier>
