<TMF_v1:ProcessIdentifier>1.5.5.12</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Manage Resource Order Tracking Manage Resource Order Tracking business activity directs and controls the monitoring of resource order status from the time the order is placed to the time is confirmed delivered. 

Manage Resource Order Tracking business activity tracks the status of the resource order, provides updates to all related parties, and ensures that issues are escalated and managed promptly.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Resource Order Closure -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Resource Order Closure">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity."/>
