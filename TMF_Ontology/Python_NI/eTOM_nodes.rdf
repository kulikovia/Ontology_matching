<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG."/>
<TMF_v1:BriefDescription>Not used for this process element.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.7.13.7.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Implement Enterprise Performance Assessment Plan Implement Enterprise Performance Assessment Plan business activity device and apply the tasks, details and models for enterprise performance assessment. Through 'Implement Enterprise Performance Assessment Plan', the enterprise is able to observe and evaluate performance according to the enterprise performance goals set.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Collect Enterprise Performance Assessment Data -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Collect Enterprise Performance Assessment Data">
