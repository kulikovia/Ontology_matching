<TMF_v1:BriefDescription>Submit a Business Partner problem or send additional information if requested.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
