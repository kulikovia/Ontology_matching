<TMF_v1:BriefDescription>Receive Returned Product Order business activity is responsible for accepting and processing the product order return.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
