<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Gather Authentication Information -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Gather Authentication Information">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Gather Authentication Information from the customer.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.1.16.2.6</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.3.4.2.6</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Gather Authentication Information The purpose of this process is to gather information that enables the enterprise to authenticate the customer identity. This information can be documents issued by other authorities (such as ID card or passport) or information that will enable the enterprise to re-authenticate the customer (such as answer to a secret question).</rdf:label>
</owl:NamedIndividual>

