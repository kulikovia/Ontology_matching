<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.4.12.6.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Assess Available Service Capacity Assess Available Service Capacity business activity evaluates unused service capacity in relation to service capacity plans, and service utilization trends.</rdf:label>
</owl:NamedIndividual>

