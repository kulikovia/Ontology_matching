<TMF_v1:OriginalProcessIdentifier>1.1.3.1.3.5</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.4.3.5</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Track, Monitor and Manage RTM Processes Including other Parties - Tracking and monitoring of the Resource Trouble Management processes and associated costs (including where resource infrastructure is deployed and managed by third parties), and reporting on the capability of the Resource Trouble Management processes;</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Provide Support for RTM and SPM Processes -->

