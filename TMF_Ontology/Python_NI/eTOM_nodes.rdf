<TMF_v1:BriefDescription>Manage Change Approval business activity is in charge of evaluating changes based n the impact on enterprise.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
