<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Monitor, Report and Release Mgmt. of Resource Infrastructure and Capacity Utilization -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Monitor, Report and Release Mgmt. of Resource Infrastructure and Capacity Utilization">
