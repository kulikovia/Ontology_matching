<rdf:label>Assess New Product Offering Risks and Competitive Positioning Not used for this process element</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Develop New Product Offering Feasibility Assessment -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Develop New Product Offering Feasibility Assessment">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Product Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Business Value Development"/>
<TMF_v1:BriefDescription>Produce new product offering feasibility assessment.</TMF_v1:BriefDescription>
