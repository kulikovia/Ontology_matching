<rdf:label>Manage Resource Catalog Content Lifecycle Manage Resource Catalog Content Lifecycle business activity handles changes to catalog content according to the Catalog Content Management standards and policies.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Distribute Resource Catalog -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Distribute Resource Catalog">
