<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Optimize Product Capacity -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Optimize Product Capacity">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Product Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Capability Management"/>
<TMF_v1:BriefDescription>Optimize Product Capacity business activity enable improve Product use by managing underlying and related dependencies and constraints.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.2.8.9</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Optimize Product Capacity Optimize Product Capacity business activity enable improve Product use by managing underlying and related dependencies and constraints.
For Product Capacity Management, Optimize Product Capacity can enable reclaim unused Product capacity, allocate additional capacity just in time to meet demand, repurpose products based on capacity utilization patterns and support configuration management of constraints and dependencies.</rdf:label>
</owl:NamedIndividual>

