<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Analyze Marketing Communication Metrics -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Analyze Marketing Communication Metrics">
