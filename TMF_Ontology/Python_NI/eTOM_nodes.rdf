<TMF_v1:BriefDescription>Manage Resource Order Tracking business activity directs and controls the monitoring of resource order status from the time the order is placed to the time is confirmed delivered.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
