<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Clean-up & Archive Customer Identifying Information -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Clean-up & Archive Customer Identifying Information">
