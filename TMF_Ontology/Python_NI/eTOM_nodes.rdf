<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">5</TMF_v1:ProcessLevel>
<rdf:label>Authorize Product Order Return Authorize Product Order Return business activity is responsible for permitting a product order reverse order to be processed.  

Authorize Product Order Return ensures that product order returns are acceptable and valid according to product ordering rules.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Receive Returned Product Order -->

