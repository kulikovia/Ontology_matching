<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Close Interaction The purpose of this process is to close the Party interaction when both parties agree that the interaction is closed, or according to party interaction policies when an interaction is regarded as timed out.</rdf:label>
</owl:NamedIndividual>

