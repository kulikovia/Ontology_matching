<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Operations Readiness & Support"/>
<TMF_v1:BriefDescription>Maintain Product Catalog Content Relationship business activity handles associating Product catalog entries.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.2.22.1.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Maintain Product Catalog Content Relationship Maintain Product Catalog Content Relationship business activity handles associating Product catalog entries.
Catalog Content Relationship for Product catalog entries can be internal and external to the Product, Service or Resource domains.</rdf:label>
</owl:NamedIndividual>

