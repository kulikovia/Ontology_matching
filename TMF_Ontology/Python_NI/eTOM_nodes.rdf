<TMF_v1:ProcessIdentifier>1.3.9.4.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Obtain Billing Events Not used for this process element.</rdf:label>
</owl:NamedIndividual>

