<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.2.3.2.7.2</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.2.7.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Validate Resource Infrastructure Design Not used for this process element</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Ensure Resource Handover Support -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Ensure Resource Handover Support">
