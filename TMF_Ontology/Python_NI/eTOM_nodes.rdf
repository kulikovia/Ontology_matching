<TMF_v1:BriefDescription>Obtain stakeholder agreement for the product offering promotion.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
