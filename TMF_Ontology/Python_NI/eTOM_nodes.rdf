<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Track Product Order Fulfilment Track Product Order Fulfilment business activity records all the product order fulfilment processing status.

Track Product Order Fulfilment supports detecting early evidence of "something going wrong" or not according to business rules and polcies for a product order accepted for fulfilment. It supports escalation of product order fulfilment challenges and remediation.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Close Product Order Fulfilment -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Close Product Order Fulfilment">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
