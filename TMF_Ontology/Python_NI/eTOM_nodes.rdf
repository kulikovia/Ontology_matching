<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Customer Interface Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Customer Interface Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Managing all interfaces between the enterprise and potential and existing customers.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.1.18.9</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.3.5.9</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Customer Interface Management Customer Interface Management processes are responsible for managing all interfaces between the enterprise and potential and existing customers. They deal with contact management, understanding the reason for contact, directing customer contacts to the appropriate process, contact closure, exception management, contact results analysis and reporting. CRM contact may be related to one or several of Service Fulfillment, Service Assurance (service quality management and trouble or problem management) and Billing related customer enquiries or contacts.</rdf:label>
</owl:NamedIndividual>

