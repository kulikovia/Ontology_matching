<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Initiate Business Partner Performance Degradation Report -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Initiate Business Partner Performance Degradation Report">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
