<TMF_v1:ProcessIdentifier>1.6.16.1.2.1.1.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">7</TMF_v1:ProcessLevel>
<rdf:label>Add Business Partner Payment Method Type Not used for this process element.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Define Business Partner Payment Method Type Properties -->

