<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.3.3.7.1</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.8.7.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Generate Resource Trouble Not used for this process element</rdf:label>
</owl:NamedIndividual>

