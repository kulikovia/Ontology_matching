<TMF_v1:BriefDescription>Prioritize Sales Problem business activity is in charge of organizing Sales Problems by order of business established conditions or attributes.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
