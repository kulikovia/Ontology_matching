</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Track Business Partner Problem -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Track Business Partner Problem">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Business Partner Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Assign and monitor the jeopardy status of a Business Partner problem.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.6.10.4</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Track Business Partner Problem Track Business Partner Problem assigns and monitors the jeopardy status of a Business Partner problem, may escalate its jeopardy status, and notify applicable parties of a Business Partner problem in jeopardy.

Note that lists of contacts related to a process such as this can be maintained by a generalized process such as Process Management & Support that is part of Enterprise Effectiveness Management in the Enterprise domain.</rdf:label>
</owl:NamedIndividual>

