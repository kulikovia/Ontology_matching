<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Not used for this process element.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.1.16.2.3</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.3.4.2.3</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Clean-up & Archive Customer Identifying Information After termination, provides clean-up duplicates of customer identifying information that may exist within the organization. Profile and preference information for terminated customer relationships is archived if acceptable to the customer. All relevant parties are informed of the ended relationship. Other processes are triggered to dismantle the customer solution and servicing arrangements as necessary.</rdf:label>
</owl:NamedIndividual>

