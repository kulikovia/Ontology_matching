<TMF_v1:BriefDescription>Transition Project business activity handle tasks that manage the change of one project to another.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
