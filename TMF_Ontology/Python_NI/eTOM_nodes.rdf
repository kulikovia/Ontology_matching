<TMF_v1:ProcessIdentifier>1.1.1.2.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Establish Market Participation Establish Market Participation processes focus on agreement across the enterprise with respect to markets in which the enterprise will participate.</rdf:label>
</owl:NamedIndividual>

