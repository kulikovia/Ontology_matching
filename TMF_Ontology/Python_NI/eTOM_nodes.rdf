<TMF_v1:ProcessIdentifier>1.6.20.5.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Provide Business Partner Bill Inquiry Change Notification Provide Business Partner Bill Inquiry Change Notification manages Business Partner bill inquiry notifications to other processes and to other parties. A notification may be made to other processes and/or to other parties, including partners, registered to receive notifications of any status changes.  

Note that lists of contacts related to a process such as this can be maintained by a generalized process such as Process Management & Support that is part of Enterprise Effectiveness Management in the Enterprise domain.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Provide Business Partner Bill Inquiry Management Report -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Provide Business Partner Bill Inquiry Management Report">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Business Partner Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Billing"/>
<TMF_v1:BriefDescription>Provide management reports and any specialized summaries of the efficiency and effectiveness of the overall Business Partner Bill Inquiry Handling processes.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
