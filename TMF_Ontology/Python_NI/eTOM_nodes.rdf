<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Regulatory Management -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Regulatory Management">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Enterprise Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG."/>
<TMF_v1:BriefDescription>Ensure that the enterprise complies with all existing government regulations</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.3.6.4</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.7.14.8.4</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Regulatory Management Regulatory Management processes ensure that the enterprise complies with all existing government regulations. Additionally, this process is responsible for legally influencing pending regulations and statutes for the benefit of the enterprise and to inform the enterprise of potential consequences of pending legislation or regulations. In addition, these processes are responsible for tariff filings as required.</rdf:label>
</owl:NamedIndividual>

