<TMF_v1:BriefDescription>Gain enterprise commitment to the market strategy and segmentation.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
