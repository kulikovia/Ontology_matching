<TMF_v1:BriefDescription>Manage Information & Data Disposal business activity is in charge of directing and controlling term and manner in which information and data is destroyed.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
