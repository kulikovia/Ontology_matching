<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Business Value Development"/>
<TMF_v1:BriefDescription>Manage Catalog Design business activity cover the design of the Catalog in accordance to the Catalog Management Lifecycle.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier></TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.4.13.1</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Manage Service Catalog Design Manage Catalog Design business activity cover the design of the Catalog in accordance to the Catalog Management Lifecycle.
Manage Catalog Design business activity will leverage Catalog Specification requirement for all information (features, attributes etc.) to be managed by the catalog in order to enable support the Catalog Lifecycle Management.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Service Catalog Build -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Service Catalog Build">
