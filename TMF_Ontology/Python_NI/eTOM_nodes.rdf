<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Validate Customer Order Payment Validate Customer Order Payment business activity is responsible check that payment received is valid and approved. 

Validate Customer Order Payment will support fraud detection and preverntion policies.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Monitor Customer Order Payment -->

