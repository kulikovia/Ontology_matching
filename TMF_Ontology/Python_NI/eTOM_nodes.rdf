<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Analyze Market Segment purchase and issues Not used for this process element</rdf:label>
</owl:NamedIndividual>

