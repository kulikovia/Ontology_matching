<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Customer Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Update the customer data in the customer inventory.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.1.17.2</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.3.6.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Update Customer Data The purpose of this process is to update the customer data in the customer inventory. This can happen as a result of direct notification from the customer, as a result of information gathered as part of other processes (such as selling and order handling) or as a result of back office processes (such as customer data cleansing).</rdf:label>
</owl:NamedIndividual>

