<TMF_v1:ProcessIdentifier>1.1.19.2.1.3.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">6</TMF_v1:ProcessLevel>
<rdf:label>Produce Loyalty Program Participant Card Not used for this process element.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Issue Loyalty Program Participant Package -->

