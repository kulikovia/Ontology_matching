<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Collect Management and Security Information & Data -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Collect Management and Security Information & Data">
