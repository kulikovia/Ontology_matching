<rdf:label>Decommission Asset Decommission Asset business activity handle the activities that remove assets from active use by following the established asset management policy.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Operate Asset -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Operate Asset">
