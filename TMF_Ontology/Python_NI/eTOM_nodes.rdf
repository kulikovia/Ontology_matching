<rdf:label>Schedule Product Order Shipment Schedule Product Order Shipment business activity is responsible for supporting the product order delivery by providing schedule 

Schedile Product Order Shipment helps to plan out shipments and deliveries in advance based on the organizations supply chain and customer demand.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Authorize Product Order Return -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Authorize Product Order Return">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
