<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Report Service Quality -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Report Service Quality">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Service Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Monitor the status of service performance degradation reports, provide notifications of any changes and provide management reports</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.2.4.4</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.4.7.4</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Report Service Quality Report Service Quality business activity provides documented account of the degree of satisfaction of service performance and service expectation.  Report Service Quality detail the records of service engagement and describe service  tangibility, service reliability, service responsiveness, service assurance, service performance, service conformance, durability, serviceability, as well as empathy according to the definition of service quality.  Note: The definition of 'Service Quality' in here is the 'degree of excellence' of a service performance according to 'customer expectations'.</rdf:label>
</owl:NamedIndividual>

