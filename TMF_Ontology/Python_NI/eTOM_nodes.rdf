<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Performance Activity Reconciliation -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Manage Performance Activity Reconciliation">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
