<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.3.1.3.3</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.4.3.3</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Create Report - Reporting outcomes of trend analysis to Resource Development & Management processes to influence new and/or modified resource infrastructure development;</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Establish Warehouse and Manage Spares Including other Parties -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Establish Warehouse and Manage Spares Including other Parties">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Resource Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Operations Readiness & Support"/>
<TMF_v1:BriefDescription>Establishing and managing the spares houses and managing the spares including other parties spares.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.3.1.3.4</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.5.4.3.4</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:ProcessLevel>
<rdf:label>Establish Warehouse and Manage Spares Including other Parties - Establishing and managing resource instance spares holding facilities, including arrangements with other parties for vendor managed spares (the actual commercial agreement is negotiated using Supply Chain Development & Management processes);
- Management of issuing and re-stocking of spares;
- Establishing and managing resource instance return and repair programs and associated processes, including both service provider and other parties repair activities;</rdf:label>
</owl:NamedIndividual>

