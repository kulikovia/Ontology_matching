<TMF_v1:BriefDescription>Accept billing events that have been collected, translated, correlated, assembled, guided and service rated before determining the information would be applied to the customers bill invoice(s).</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
