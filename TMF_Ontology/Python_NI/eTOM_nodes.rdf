<rdf:label>Close Product Order Return Close Product Order Return business activity is responsible for ensuring communication and confirmation of product order returns with conginees. 

Close Product Order Return ensures that all activities to ensure the closure of product order return are completed successfully.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Track Product Order Fulfilment -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Track Product Order Fulfilment">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
