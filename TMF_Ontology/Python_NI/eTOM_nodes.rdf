<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Analyze Service Quality -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Analyze Service Quality">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Service Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Analyze Service Quality business activity assess, research and evaluate captured service quality experiences to customer satisfaction expectations.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.2.4.2</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.4.7.2</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Analyze Service Quality Analyze Service Quality business activity assess, research and evaluate captured service quality experiences to customer satisfaction expectations. Analyze Service Quality assess and validate information to evaluate the service quality performance. Sub-activities include correlating captured service performance and customer feedback events, gaining insights on customer expectations and service delivery performance.</rdf:label>
</owl:NamedIndividual>

<!-- http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Improve Service Quality -->

<owl:NamedIndividual rdf:about = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Improve Service Quality">
<rdf:type rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Process"/>
<TMF_v1:hasDomain rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#Business_Entity.Service Domain"/>
<TMF_v1:hasVerticalGroup rdf:resource = "http://www.semanticweb.org/igork/ontologies/2024/1/TMF_v1#VG.Assurance"/>
<TMF_v1:BriefDescription>Improve Service Quality business activity builds on prior service quality standards and outcome to enhance/refine future service quality.</TMF_v1:BriefDescription>
<TMF_v1:MaturityLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">4</TMF_v1:MaturityLevel>
<TMF_v1:OriginalProcessIdentifier>1.1.2.4.3</TMF_v1:OriginalProcessIdentifier>
<TMF_v1:ProcessIdentifier>1.4.7.3</TMF_v1:ProcessIdentifier>
<TMF_v1:ProcessLevel rdf:datatype = "http://www.w3.org/2001/XMLSchema#integer">3</TMF_v1:ProcessLevel>
<rdf:label>Improve Service Quality Improve Service Quality business activity builds on prior service quality standards and outcome to enhance/refine future service quality. Improve Service Quality supports 'Define Service Quality' business activity to enable business functions improve capability and capacity for service fulfillment and service assurance.</rdf:label>
</owl:NamedIndividual>

